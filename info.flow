let mut info_states_blob: ptr<u8> = null
let mut info_mobjinfo_blob: ptr<u8> = null
let mut info_sprnames_list: ptr<string> = null
let mut info_ready: i32 = 0

function info_write_i32(base: ptr<u8>, off: i32, v: i32) -> void {
    let p: ptr<i32> = ((base as i64) + off as i64) as ptr<i32>
    p[0] = v
}

function info_write_i64(base: ptr<u8>, off: i32, v: i64) -> void {
    let p: ptr<i64> = ((base as i64) + off as i64) as ptr<i64>
    p[0] = v
}

function info_read_i32(base: ptr<u8>, off: i32) -> i32 {
    let p: ptr<i32> = ((base as i64) + off as i64) as ptr<i32>
    return p[0]
}

function info_read_i64(base: ptr<u8>, off: i32) -> i64 {
    let p: ptr<i64> = ((base as i64) + off as i64) as ptr<i64>
    return p[0]
}

function info_ensure() -> void {
    if info_ready != 0 {
        return
    }
    info_states_blob = calloc(INFO_NUMSTATES as i64, INFO_STATE_SIZE as i64) as ptr<u8>
    info_mobjinfo_blob = calloc(INFO_NUMMOBJTYPES as i64, INFO_MOBJINFO_SIZE as i64) as ptr<u8>
    info_sprnames_list = malloc(((INFO_SPRNAMES_COUNT + 1) as i64) * 8) as ptr<string>
    for i in 0 to INFO_SPRNAMES_COUNT {
        info_sprnames_list[i] = info_sprname_strs[i]
    }
    info_sprnames_list[INFO_SPRNAMES_COUNT] = null as string

    for i in 0 to INFO_NUMSTATES {
        let st: ptr<u8> = ((info_states_blob as i64) + (i * INFO_STATE_SIZE) as i64) as ptr<u8>
        info_write_i32(st, 0, info_state_sprite[i])
        info_write_i32(st, 4, info_state_frame[i])
        info_write_i32(st, 8, info_state_tics[i])
        info_write_i64(st, INFO_STATE_OFF_ACTION, info_state_action[i] as i64)
        info_write_i32(st, INFO_STATE_OFF_NEXT, info_state_next[i])
        info_write_i32(st, INFO_STATE_OFF_MISC1, info_state_misc1[i])
        info_write_i32(st, INFO_STATE_OFF_MISC2, info_state_misc2[i])
    }
    for i in 0 to INFO_NUMMOBJTYPES {
        let mi: ptr<u8> = ((info_mobjinfo_blob as i64) + (i * INFO_MOBJINFO_SIZE) as i64) as ptr<u8>
        for f in 0 to INFO_MOBJINFO_FIELDS {
            info_write_i32(mi, f * 4, info_mobjinfo_flat[i * INFO_MOBJINFO_FIELDS + f])
        }
    }
    info_ready = 1
}

@flow_api
function info_sprnames_addr() -> ptr<string> {
    info_ensure()
    return info_sprnames_list
}

@flow_api
function info_states_addr() -> ptr<void> {
    info_ensure()
    return info_states_blob as ptr<void>
}

@flow_api
function info_mobjinfo_addr() -> ptr<void> {
    info_ensure()
    return info_mobjinfo_blob as ptr<void>
}

function INFO_sprnames(idx: i32) -> string {
    info_ensure()
    return info_sprname_strs[idx]
}

function INFO_states_base() -> ptr<void> { return info_states_addr() }
function INFO_mobjinfo_base() -> ptr<void> { return info_mobjinfo_addr() }

function INFO_state_at(idx: i32) -> ptr<void> {
    info_ensure()
    return ((info_states_blob as i64) + (idx as i64) * (INFO_STATE_SIZE as i64)) as ptr<void>
}

@flow_api
function INFO_mobjinfo_at(idx: i32) -> ptr<void> {
    info_ensure()
    return ((info_mobjinfo_blob as i64) + (idx as i64) * (INFO_MOBJINFO_SIZE as i64)) as ptr<void>
}

@flow_api
function STATE_at(i: i32) -> ptr<void> { return INFO_state_at(i) }

@flow_api
function STATE_index(st: ptr<void>) -> i32 {
    info_ensure()
    if (st as i64) == 0 {
        return 0
    }
    return ((st as i64) - (info_states_blob as i64)) as i32 / INFO_STATE_SIZE
}

@flow_api
function STATE_tics(st: ptr<void>) -> i32 {
    return info_read_i32(st as ptr<u8>, INFO_STATE_OFF_TICS)
}

@flow_api
function STATE_set_tics(st: ptr<void>, v: i32) -> void {
    info_write_i32(st as ptr<u8>, INFO_STATE_OFF_TICS, v)
}

@flow_api
function STATE_sprite(st: ptr<void>) -> i32 {
    return info_read_i32(st as ptr<u8>, 0)
}

@flow_api
function STATE_frame(st: ptr<void>) -> i32 {
    return info_read_i32(st as ptr<u8>, 4)
}

@flow_api
function STATE_nextstate(st: ptr<void>) -> i32 {
    return info_read_i32(st as ptr<u8>, INFO_STATE_OFF_NEXT)
}

@flow_api
function STATE_misc1(st: ptr<void>) -> i32 {
    return info_read_i32(st as ptr<u8>, INFO_STATE_OFF_MISC1)
}

@flow_api
function STATE_misc2(st: ptr<void>) -> i32 {
    return info_read_i32(st as ptr<u8>, INFO_STATE_OFF_MISC2)
}

@flow_api
function STATE_action_id(st: ptr<void>) -> i32 {
    return info_read_i64(st as ptr<u8>, INFO_STATE_OFF_ACTION) as i32
}

# Legacy names: null-check helpers used by pspr (non-zero action?).
@flow_api
function STATE_action(st: ptr<void>) -> ptr<void> {
    if STATE_action_id(st) == 0 {
        return null
    }
    return (1 as i64) as ptr<void>
}

@flow_api
function STATE_action_acp2(st: ptr<void>) -> ptr<void> {
    return STATE_action(st)
}

@flow_api
function STATE_call_acp1(st: ptr<void>, arg: ptr<void>) -> void {
    let id: i32 = STATE_action_id(st)
    if id == 0 { return }
    elif id == 1 { A_BFGSpray(arg) }
    elif id == 3 { A_BabyMetal(arg) }
    elif id == 4 { A_BossDeath(arg) }
    elif id == 5 { A_BrainAwake(arg) }
    elif id == 6 { A_BrainDie(arg) }
    elif id == 7 { A_BrainExplode(arg) }
    elif id == 8 { A_BrainPain(arg) }
    elif id == 9 { A_BrainScream(arg) }
    elif id == 10 { A_BrainSpit(arg) }
    elif id == 11 { A_BruisAttack(arg) }
    elif id == 12 { A_BspiAttack(arg) }
    elif id == 13 { A_CPosAttack(arg) }
    elif id == 14 { A_CPosRefire(arg) }
    elif id == 15 { A_Chase(arg) }
    elif id == 18 { A_CyberAttack(arg) }
    elif id == 19 { A_Explode(arg) }
    elif id == 20 { A_FaceTarget(arg) }
    elif id == 21 { A_Fall(arg) }
    elif id == 22 { A_FatAttack1(arg) }
    elif id == 23 { A_FatAttack2(arg) }
    elif id == 24 { A_FatAttack3(arg) }
    elif id == 25 { A_FatRaise(arg) }
    elif id == 26 { A_Fire(arg) }
    elif id == 29 { A_FireCrackle(arg) }
    elif id == 36 { A_HeadAttack(arg) }
    elif id == 37 { A_Hoof(arg) }
    elif id == 38 { A_KeenDie(arg) }
    elif id == 43 { A_Look(arg) }
    elif id == 45 { A_Metal(arg) }
    elif id == 47 { A_Pain(arg) }
    elif id == 48 { A_PainAttack(arg) }
    elif id == 49 { A_PainDie(arg) }
    elif id == 50 { A_PlayerScream(arg) }
    elif id == 51 { A_PosAttack(arg) }
    elif id == 55 { A_SPosAttack(arg) }
    elif id == 56 { A_SargAttack(arg) }
    elif id == 58 { A_Scream(arg) }
    elif id == 59 { A_SkelFist(arg) }
    elif id == 60 { A_SkelMissile(arg) }
    elif id == 61 { A_SkelWhoosh(arg) }
    elif id == 62 { A_SkullAttack(arg) }
    elif id == 63 { A_SpawnFly(arg) }
    elif id == 64 { A_SpawnSound(arg) }
    elif id == 65 { A_SpidRefire(arg) }
    elif id == 66 { A_StartFire(arg) }
    elif id == 67 { A_Tracer(arg) }
    elif id == 68 { A_TroopAttack(arg) }
    elif id == 69 { A_VileAttack(arg) }
    elif id == 70 { A_VileChase(arg) }
    elif id == 71 { A_VileStart(arg) }
    elif id == 72 { A_VileTarget(arg) }
    elif id == 74 { A_XScream(arg) }
}

@flow_api
function STATE_call_acp2(st: ptr<void>, arg1: ptr<void>, arg2: ptr<void>) -> void {
    let id: i32 = STATE_action_id(st)
    if id == 0 { return }
    elif id == 2 { A_BFGsound(arg1, arg2) }
    elif id == 16 { A_CheckReload(arg1, arg2) }
    elif id == 17 { A_CloseShotgun2(arg1, arg2) }
    elif id == 27 { A_FireBFG(arg1, arg2) }
    elif id == 28 { A_FireCGun(arg1, arg2) }
    elif id == 30 { A_FireMissile(arg1, arg2) }
    elif id == 31 { A_FirePistol(arg1, arg2) }
    elif id == 32 { A_FirePlasma(arg1, arg2) }
    elif id == 33 { A_FireShotgun(arg1, arg2) }
    elif id == 34 { A_FireShotgun2(arg1, arg2) }
    elif id == 35 { A_GunFlash(arg1, arg2) }
    elif id == 39 { A_Light0(arg1, arg2) }
    elif id == 40 { A_Light1(arg1, arg2) }
    elif id == 41 { A_Light2(arg1, arg2) }
    elif id == 42 { A_LoadShotgun2(arg1, arg2) }
    elif id == 44 { A_Lower(arg1, arg2) }
    elif id == 46 { A_OpenShotgun2(arg1, arg2) }
    elif id == 52 { A_Punch(arg1, arg2) }
    elif id == 53 { A_Raise(arg1, arg2) }
    elif id == 54 { A_ReFire(arg1, arg2) }
    elif id == 57 { A_Saw(arg1, arg2) }
    elif id == 73 { A_WeaponReady(arg1, arg2) }
}


function mobjinfo_field(typ: i32, field: i32) -> i32 {
    info_ensure()
    let mi: ptr<u8> = ((info_mobjinfo_blob as i64) + (typ * INFO_MOBJINFO_SIZE) as i64) as ptr<u8>
    return info_read_i32(mi, field * 4)
}

function mobjinfo_set_field(typ: i32, field: i32, v: i32) -> void {
    info_ensure()
    let mi: ptr<u8> = ((info_mobjinfo_blob as i64) + (typ * INFO_MOBJINFO_SIZE) as i64) as ptr<u8>
    info_write_i32(mi, field * 4, v)
}

@flow_api
function MOBJINFO_doomednum(typ: i32) -> i32 { return mobjinfo_field(typ, 0) }
@flow_api
function MOBJINFO_spawnstate(typ: i32) -> i32 { return mobjinfo_field(typ, 1) }
@flow_api
function MOBJINFO_spawnhealth(typ: i32) -> i32 { return mobjinfo_field(typ, 2) }
@flow_api
function MOBJINFO_seestate(typ: i32) -> i32 { return mobjinfo_field(typ, 3) }
@flow_api
function MOBJINFO_seesound(typ: i32) -> i32 { return mobjinfo_field(typ, 4) }
@flow_api
function MOBJINFO_reactiontime(typ: i32) -> i32 { return mobjinfo_field(typ, 5) }
@flow_api
function MOBJINFO_meleestate(typ: i32) -> i32 { return mobjinfo_field(typ, 10) }
@flow_api
function MOBJINFO_missilestate(typ: i32) -> i32 { return mobjinfo_field(typ, 11) }
@flow_api
function MOBJINFO_deathstate(typ: i32) -> i32 { return mobjinfo_field(typ, 12) }
@flow_api
function MOBJINFO_deathsound(typ: i32) -> i32 { return mobjinfo_field(typ, 14) }
@flow_api
function MOBJINFO_speed(typ: i32) -> i32 { return mobjinfo_field(typ, 15) }
@flow_api
function MOBJINFO_set_speed(typ: i32, v: i32) -> void { mobjinfo_set_field(typ, 15, v) }
@flow_api
function MOBJINFO_radius(typ: i32) -> i32 { return mobjinfo_field(typ, 16) }
@flow_api
function MOBJINFO_height(typ: i32) -> i32 { return mobjinfo_field(typ, 17) }
@flow_api
function MOBJINFO_flags(typ: i32) -> i32 { return mobjinfo_field(typ, 21) }
