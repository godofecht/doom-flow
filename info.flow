# Thing frame/state LUTs — fully Flow-owned (was info_data.c).
#
# states/mobjinfo live in calloc'd LP64 blobs so STATE_at pointers and
# byte offsets (tics @8, mobjinfo speed @60) stay valid. Action slots
# store integer action IDs; STATE_call_acp1/acp2 dispatch to A_* in
# enemy.flow / pspr.flow.

extern { function calloc(n: i64, size: i64) -> ptr<void> }
extern { function malloc(n: i64) -> ptr<void> }

