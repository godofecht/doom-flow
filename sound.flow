# s_sound.c distance / stereo
const SOUND_CLIPPING_DIST: i32 = 1200 * SOUND_FRACUNIT
const SOUND_CLOSE_DIST: i32 = 200 * SOUND_FRACUNIT
const SOUND_ATTENUATOR: i32 = (SOUND_CLIPPING_DIST - SOUND_CLOSE_DIST) >> SOUND_FRACBITS
const SOUND_STEREO_SWING: i32 = 96 * SOUND_FRACUNIT

const SOUND_NORM_PITCH: i32 = 128
const SOUND_NORM_PRIORITY: i32 = 64
const SOUND_NORM_SEP: i32 = 128

