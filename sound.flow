# ---- C-visible volume / channel count (s_sound.c definitions) ---------

let mut sfxVolume: i32 = 8
let mut musicVolume: i32 = 8
let mut snd_channels: i32 = 8

@flow_api
function SOUND_sfxvolume_addr() -> ptr<i32> { return &sfxVolume }

@flow_api
function SOUND_musicvolume_addr() -> ptr<i32> { return &musicVolume }

@flow_api
function SOUND_snd_channels_addr() -> ptr<i32> { return &snd_channels }

@flow_api
function sound_stat_sfxvolume() -> i32 { return sfxVolume }

@flow_api
function sound_set_stat_sfxvolume(v: i32) -> void { sfxVolume = v }

@flow_api
function sound_stat_musicvolume() -> i32 { return musicVolume }

@flow_api
function sound_set_stat_musicvolume(v: i32) -> void { musicVolume = v }

# ---- sfxinfo_t / musicinfo_t (i_sound.h, LP64) ------------------------
# sizeof(sfxinfo_t) = 64, sizeof(musicinfo_t) = 32

const SOUND_SIZEOF_SFXINFO: i32 = 64
const SOUND_SIZEOF_MUSICINFO: i32 = 32

const SFX_OFF_NAME: i32 = 8
const SFX_OFF_PRIORITY: i32 = 20
const SFX_OFF_LINK: i32 = 24
const SFX_OFF_PITCH: i32 = 32
const SFX_OFF_VOLUME: i32 = 36
const SFX_OFF_USEFULNESS: i32 = 40
const SFX_OFF_LUMPNUM: i32 = 44
const SFX_OFF_NUMCHANNELS: i32 = 48

const MUSIC_OFF_NAME: i32 = 0
const MUSIC_OFF_LUMPNUM: i32 = 8
const MUSIC_OFF_DATA: i32 = 16
const MUSIC_OFF_HANDLE: i32 = 24

function sound_addr(base: ptr<u8>, off: i32) -> ptr<u8> {
    return ((base as i64) + off as i64) as ptr<u8>
}

function sound_sfx_table() -> ptr<u8> {
    return sound_data_sfx() as ptr<u8>
}

function sound_sfx(id: i32) -> ptr<u8> {
    let base: ptr<u8> = sound_sfx_table()
    return ((base as i64) + (id * SOUND_SIZEOF_SFXINFO) as i64) as ptr<u8>
}

function sound_music(id: i32) -> ptr<u8> {
    let base: ptr<u8> = sound_data_music() as ptr<u8>
    return ((base as i64) + (id * SOUND_SIZEOF_MUSICINFO) as i64) as ptr<u8>
}

function sfx_priority(s: ptr<u8>) -> i32 {
    let p: ptr<i32> = sound_addr(s, SFX_OFF_PRIORITY) as ptr<i32>
    return p[0]
}

function sfx_link(s: ptr<u8>) -> ptr<u8> {
    let p: ptr<i64> = sound_addr(s, SFX_OFF_LINK) as ptr<i64>
    return p[0] as ptr<u8>
}

function sfx_volume(s: ptr<u8>) -> i32 {
    let p: ptr<i32> = sound_addr(s, SFX_OFF_VOLUME) as ptr<i32>
    return p[0]
}

function sfx_usefulness(s: ptr<u8>) -> i32 {
    let p: ptr<i32> = sound_addr(s, SFX_OFF_USEFULNESS) as ptr<i32>
    return p[0]
}

function sfx_set_usefulness(s: ptr<u8>, v: i32) -> void {
    let p: ptr<i32> = sound_addr(s, SFX_OFF_USEFULNESS) as ptr<i32>
    p[0] = v
}

function sfx_lumpnum(s: ptr<u8>) -> i32 {
    let p: ptr<i32> = sound_addr(s, SFX_OFF_LUMPNUM) as ptr<i32>
    return p[0]
}

function sfx_set_lumpnum(s: ptr<u8>, v: i32) -> void {
    let p: ptr<i32> = sound_addr(s, SFX_OFF_LUMPNUM) as ptr<i32>
    p[0] = v
}

function music_name(m: ptr<u8>) -> ptr<u8> {
    let p: ptr<i64> = sound_addr(m, MUSIC_OFF_NAME) as ptr<i64>
    return p[0] as ptr<u8>
}

function music_lumpnum(m: ptr<u8>) -> i32 {
    let p: ptr<i32> = sound_addr(m, MUSIC_OFF_LUMPNUM) as ptr<i32>
    return p[0]
}

function music_set_lumpnum(m: ptr<u8>, v: i32) -> void {
    let p: ptr<i32> = sound_addr(m, MUSIC_OFF_LUMPNUM) as ptr<i32>
    p[0] = v
}

function music_data(m: ptr<u8>) -> ptr<u8> {
    let p: ptr<i64> = sound_addr(m, MUSIC_OFF_DATA) as ptr<i64>
    return p[0] as ptr<u8>
}

function music_set_data(m: ptr<u8>, v: ptr<u8>) -> void {
    let p: ptr<i64> = sound_addr(m, MUSIC_OFF_DATA) as ptr<i64>
    p[0] = v as i64
}

function music_song(m: ptr<u8>) -> ptr<u8> {
    let p: ptr<i64> = sound_addr(m, MUSIC_OFF_HANDLE) as ptr<i64>
    return p[0] as ptr<u8>
}

function music_set_song(m: ptr<u8>, v: ptr<u8>) -> void {
    let p: ptr<i64> = sound_addr(m, MUSIC_OFF_HANDLE) as ptr<i64>
    p[0] = v as i64
}

