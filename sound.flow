# High-level sound / music, ported from s_sound.c to Flow.
#
# channel_t is private to this module → Flow struct Channel with field
# access (chan_handle; "handle" is a Flow keyword). C-visible globals
# sfxVolume / musicVolume / snd_channels and S_sfx[] / S_music[] live here
# (tables were sounds_data.c).

# ---- libc / engine ----------------------------------------------------

extern { function abs(x: i32) -> i32 }
extern { function calloc(n: i64, size: i64) -> ptr<void> }
extern { function snprintf(buf: string, n: i64, fmt: string, s: string) -> i32 }
