@flow_api
function configdata_doom_count() -> i32 { return 76 }
@flow_api
function configdata_extra_count() -> i32 { return 125 }
@flow_api
function configdata_doom_name(i: i32) -> string { return config_doom_names[i] }
@flow_api
function configdata_extra_name(i: i32) -> string { return config_extra_names[i] }
@flow_api
function configdata_doom_kind(i: i32) -> i32 { return config_doom_kinds[i] }
@flow_api
function configdata_extra_kind(i: i32) -> i32 { return config_extra_kinds[i] }

function ensure_config_tables() -> void {
    if config_tables_ready != 0 {
        return
    }

    doom_numdefaults = configdata_doom_count()
    extra_numdefaults = configdata_extra_count()

    doom_defaults_ptr = malloc((doom_numdefaults as i64) * (CONFIG_DEFAULT_SIZE as i64)) as ptr<Default>
    extra_defaults_ptr = malloc((extra_numdefaults as i64) * (CONFIG_DEFAULT_SIZE as i64)) as ptr<Default>

    for i in 0 to doom_numdefaults {
        doom_defaults_ptr[i] = Default {
            name: configdata_doom_name(i),
            location: null,
            kind: configdata_doom_kind(i),
            untranslated: 0,
            original_translated: 0,
            bound: 0
        }
    }

    for i in 0 to extra_numdefaults {
        extra_defaults_ptr[i] = Default {
            name: configdata_extra_name(i),
            location: null,
            kind: configdata_extra_kind(i),
            untranslated: 0,
            original_translated: 0,
            bound: 0
        }
    }

    config_tables_ready = 1
}

function search_collection(defaults: ptr<Default>, numdefaults: i32, name: string) -> ptr<Default> {
    for i in 0 to numdefaults {
        if strcmp(name, defaults[i].name) == 0 {
            return ((defaults as i64) + (i as i64) * (CONFIG_DEFAULT_SIZE as i64)) as ptr<Default>
        }
    }
    return null
}

function get_default_for_name(name: string) -> ptr<Default> {
    ensure_config_tables()

    let mut result: ptr<Default> = search_collection(doom_defaults_ptr, doom_numdefaults, name)
    if (result as i64) == 0 {
        result = search_collection(extra_defaults_ptr, extra_numdefaults, name)
    }

    if (result as i64) == 0 {
        configshim_error_unknown(name)
    }
    return result
}

# ORIGCODE off: no-op (matches doomgeneric m_config.c).
function save_default_collection(filename: ptr<u8>, defaults: ptr<Default>, numdefaults: i32) -> void {
    # Keep parameters live so empty stubs stay ABI-shaped.
    if (filename as i64) == 0 and (defaults as i64) == 0 and numdefaults == 0 {
        return
    }
}

# ORIGCODE off: no-op (matches doomgeneric m_config.c).
function load_default_collection(filename: ptr<u8>, defaults: ptr<Default>, numdefaults: i32) -> void {
    if (filename as i64) == 0 and (defaults as i64) == 0 and numdefaults == 0 {
        return
    }
}

function parse_int_parameter(strparm: string) -> i32 {
    return configshim_parse_int(strparm)
}

function set_variable(def: ptr<Default>, value: string) -> void {
    let kind: i32 = def[0].kind

    if kind == CONFIG_DEFAULT_STRING {
        configshim_store_str(def[0].location, configshim_strdup(value))
    } elif kind == CONFIG_DEFAULT_INT or kind == CONFIG_DEFAULT_INT_HEX {
        let loc: ptr<i32> = def[0].location as ptr<i32>
        loc[0] = parse_int_parameter(value)
    } elif kind == CONFIG_DEFAULT_KEY {
        let mut intparm: i32 = parse_int_parameter(value)
        def[0].untranslated = intparm
        if intparm >= 0 and intparm < 128 {
            intparm = scantokey[intparm]
        } else {
            intparm = 0
        }
        def[0].original_translated = intparm
        let loc: ptr<i32> = def[0].location as ptr<i32>
        loc[0] = intparm
    } elif kind == CONFIG_DEFAULT_FLOAT {
        configshim_store_f32(def[0].location, configshim_atof(value))
    }
}

function get_default_config_dir() -> string {
    let result: ptr<u8> = malloc(2) as ptr<u8>
    result[0] = 46 as u8
    result[1] = 0 as u8
    return result as string
}

@flow_api
function configflow_get_configdir() -> string {
    if (configdir_storage as i64) == 0 {
        return ""
    }
    return configdir_storage as string
}

@flow_api
function configflow_set_configdir(dir: string) -> void {
    configdir_storage = dir as ptr<u8>
}

@flow_api
function M_SetConfigFilenames(main_config: string, extra_config: string) -> void {
    default_main_config = main_config as ptr<u8>
    default_extra_config = extra_config as ptr<u8>
}

@flow_api
function M_SaveDefaults() -> void {
    ensure_config_tables()
    save_default_collection(doom_filename, doom_defaults_ptr, doom_numdefaults)
    save_default_collection(extra_filename, extra_defaults_ptr, extra_numdefaults)
}

@flow_api
function M_SaveDefaultsAlternate(main: string, extra: string) -> void {
    ensure_config_tables()
    let orig_main: ptr<u8> = doom_filename
    let orig_extra: ptr<u8> = extra_filename

    doom_filename = main as ptr<u8>
    extra_filename = extra as ptr<u8>

    M_SaveDefaults()

    doom_filename = orig_main
    extra_filename = orig_extra
}

@flow_api
function M_LoadDefaults() -> void {
    ensure_config_tables()

    let mut i: i32 = M_CheckParmWithArgs("-config", 1)
    if i != 0 {
        let words: ptr<i64> = argvflow_argv()
        doom_filename = words[i + 1] as ptr<u8>
        printf("	default file: %s\n", doom_filename as string)
    } else {
        doom_filename = string_join2(configflow_get_configdir(), default_main_config as string) as ptr<u8>
    }

    printf("saving config in %s\n", doom_filename as string)

    i = M_CheckParmWithArgs("-extraconfig", 1)
    if i != 0 {
        let words2: ptr<i64> = argvflow_argv()
        extra_filename = words2[i + 1] as ptr<u8>
        printf("        extra configuration file: %s\n", extra_filename as string)
    } else {
        extra_filename = string_join2(configflow_get_configdir(), default_extra_config as string) as ptr<u8>
    }

    load_default_collection(doom_filename, doom_defaults_ptr, doom_numdefaults)
    load_default_collection(extra_filename, extra_defaults_ptr, extra_numdefaults)
}

@flow_api
function M_BindVariable(name: string, location: ptr<void>) -> void {
    let variable: ptr<Default> = get_default_for_name(name)
    variable[0].location = location
    variable[0].bound = 1
}

@flow_api
function M_SetVariable(name: string, value: string) -> i32 {
    let variable: ptr<Default> = get_default_for_name(name)

    if (variable as i64) == 0 or variable[0].bound == 0 {
        return 0
    }

    set_variable(variable, value)
    return 1
}

@flow_api
function M_GetIntVariable(name: string) -> i32 {
    let variable: ptr<Default> = get_default_for_name(name)

    if (variable as i64) == 0 or variable[0].bound == 0 {
        return 0
    }
    if variable[0].kind != CONFIG_DEFAULT_INT and variable[0].kind != CONFIG_DEFAULT_INT_HEX {
        return 0
    }

    let loc: ptr<i32> = variable[0].location as ptr<i32>
    return loc[0]
}

@flow_api
function M_GetStrVariable(name: string) -> string {
    let variable: ptr<Default> = get_default_for_name(name)

    if (variable as i64) == 0 or variable[0].bound == 0 {
        return null as string
    }
    if variable[0].kind != CONFIG_DEFAULT_STRING {
        return null as string
    }

    return configshim_load_str(variable[0].location)
}

@flow_api
function M_GetFloatVariable(name: string) -> f32 {
    let variable: ptr<Default> = get_default_for_name(name)

    if (variable as i64) == 0 or variable[0].bound == 0 {
        return 0.0
    }
    if variable[0].kind != CONFIG_DEFAULT_FLOAT {
        return 0.0
    }

    return configshim_load_f32(variable[0].location)
}

@flow_api
function M_SetConfigDir(dir: string) -> void {
    if (dir as ptr<u8> as i64) != 0 {
        configflow_set_configdir(dir)
    } else {
        configflow_set_configdir(get_default_config_dir())
    }

    let cfg: string = configflow_get_configdir()
    if strcmp(cfg, "") != 0 {
        printf("Using %s for configuration and saves\n", cfg)
    }

    M_MakeDirectory(cfg as ptr<u8>)
}

@flow_api
function M_GetSaveGameDir(iwadname: string) -> string {
    # iwadname is unused in the non-ORIGCODE branch (same as C).
    let _iwad_unused: i64 = iwadname as ptr<u8> as i64

    let cfg: string = configflow_get_configdir()

    if strcmp(cfg, "") == 0 {
        return configshim_strdup("")
    }

    # Non-ORIGCODE branch from m_config.c
    let savegamedir: string = configshim_savegame_dir(cfg)
    M_MakeDirectory(savegamedir as ptr<u8>)
    printf("Using %s for savegames\n", savegamedir)
    return savegamedir
}
