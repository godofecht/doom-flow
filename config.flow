# Configuration file interface, ported from m_config.c to Flow.
#
# configdir and Default/collection state live here. Doom/extra default
# name+kind tables live in this module (@flow_api configdata_*).
# This module exports the M_* config API with @flow_api.
#
# ORIGCODE is #undef in config.h, so LoadDefaultCollection /
# SaveDefaultCollection are empty stubs here (same as the C build).
# SetVariable / bind / get APIs remain fully active.
#
# Reserved Flow names: field `type` -> `kind`; avoid `handle`.

extern { function malloc(n: i64) -> ptr<void> }
extern { function strcmp(a: string, b: string) -> i32 }
extern { function strlen(s: string) -> i64 }
extern { function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void> }
extern { function printf(fmt: string, s: string) -> i32 }
extern { function I_Error(msg: string) -> void }

extern { function M_CheckParmWithArgs(check: string, num_args: i32) -> i32 }
extern { function M_MakeDirectory(path: ptr<u8>) -> void }

extern { function argvflow_argv() -> ptr<i64> }

# ---- libc/format helpers (formerly config_shim.c) ---------------------

function string_join2(a: string, b: string) -> string {
    let la: i64 = strlen(a)
    let lb: i64 = strlen(b)
    let result: ptr<u8> = malloc(la + lb + 1) as ptr<u8>
    memcpy(result as ptr<void>, a as ptr<void>, la)
    memcpy(((result as i64) + la) as ptr<void>, b as ptr<void>, lb)
    result[la + lb] = 0 as u8
    return result as string
}

function configshim_savegame_dir(configdir_arg: string) -> string {
    return string_join2(configdir_arg, "/.savegame/")
}

function configshim_strdup(s: string) -> string {
    let l: i64 = strlen(s)
    let result: ptr<u8> = malloc(l + 1) as ptr<u8>
    memcpy(result as ptr<void>, s as ptr<void>, l + 1)
    return result as string
}

function configshim_error_unknown(name: string) -> void {
    I_Error(string_join2(string_join2("Unknown configuration variable: '", name), "'"))
}

function parse_hex_digits(s: ptr<u8>) -> i32 {
    let mut i: i32 = 0
    let mut v: i32 = 0
    let mut c: i32 = s[i] as i32
    while (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70) {
        let mut digit: i32 = 0
        if c >= 48 and c <= 57 {
            digit = c - 48
        } elif c >= 97 and c <= 102 {
            digit = c - 97 + 10
        } else {
            digit = c - 65 + 10
        }
        v = v * 16 + digit
        i = i + 1
        c = s[i] as i32
    }
    return v
}

# Mirrors sscanf(strparm, "%i", &parm): optional sign, octal on a leading
# '0' followed by an octal digit, decimal otherwise.
function parse_dec_or_octal(s: ptr<u8>) -> i32 {
    let mut i: i32 = 0
    let mut sign: i32 = 1
    if s[0] as i32 == 45 {
        sign = 0 - 1
        i = 1
    } elif s[0] as i32 == 43 {
        i = 1
    }

    let mut base: i32 = 10
    if s[i] as i32 == 48 and s[i + 1] as i32 >= 48 and s[i + 1] as i32 <= 55 {
        base = 8
        i = i + 1
    }

    let mut v: i32 = 0
    let mut c: i32 = s[i] as i32
    while c >= 48 and c < 48 + base {
        v = v * base + (c - 48)
        i = i + 1
        c = s[i] as i32
    }
    return v * sign
}

function configshim_parse_int(strparm: string) -> i32 {
    let sp: ptr<u8> = strparm as ptr<u8>
    if sp[0] as i32 == 48 and sp[1] as i32 == 120 {
        return parse_hex_digits(((sp as i64) + 2) as ptr<u8>)
    }
    return parse_dec_or_octal(sp)
}

function configshim_atof(s: string) -> f32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    let mut sign: f32 = 1.0
    if p[0] as i32 == 45 {
        sign = 0.0 - 1.0
        i = 1
    } elif p[0] as i32 == 43 {
        i = 1
    }

    let mut v: f32 = 0.0
    let mut c: i32 = p[i] as i32
    while c >= 48 and c <= 57 {
        v = v * 10.0 + ((c - 48) as f32)
        i = i + 1
        c = p[i] as i32
    }

    if c == 46 {
        i = i + 1
        let mut frac: f32 = 0.1
        c = p[i] as i32
        while c >= 48 and c <= 57 {
            v = v + ((c - 48) as f32) * frac
            frac = frac * 0.1
            i = i + 1
            c = p[i] as i32
        }
    }

    return v * sign
}

function configshim_load_f32(p: ptr<void>) -> f32 {
    return (p as ptr<f32>)[0]
}

function configshim_store_f32(p: ptr<void>, v: f32) -> void {
    (p as ptr<f32>)[0] = v
}

function configshim_load_str(p: ptr<void>) -> string {
    let words: ptr<i64> = p as ptr<i64>
    return words[0] as ptr<u8> as string
}

function configshim_store_str(p: ptr<void>, v: string) -> void {
    let words: ptr<i64> = p as ptr<i64>
    words[0] = v as ptr<u8> as i64
}

# ---- default_type_t (m_config.c) --------------------------------------

const CONFIG_DEFAULT_INT: i32 = 0
const CONFIG_DEFAULT_INT_HEX: i32 = 1
const CONFIG_DEFAULT_STRING: i32 = 2
const CONFIG_DEFAULT_FLOAT: i32 = 3
const CONFIG_DEFAULT_KEY: i32 = 4

# doomkeys.h: KEY_RSHIFT (used when ORIGCODE save path is restored)
const CONFIG_KEY_RSHIFT: i32 = 128 + 54

# sizeof(Default) on LP64: 8+8+4+4+4+4 = 32
const CONFIG_DEFAULT_SIZE: i32 = 32

struct Default {
    name: string,
    location: ptr<void>,
    kind: i32,
    untranslated: i32,
    original_translated: i32,
    bound: i32
}

# Collection metadata (filename + counts). Entries live in heap arrays.
# Filenames are ptr<u8>: module-static `string` is unsupported.
let mut doom_defaults_ptr: ptr<Default> = null
let mut doom_numdefaults: i32 = 0
let mut doom_filename: ptr<u8> = null

let mut extra_defaults_ptr: ptr<Default> = null
let mut extra_numdefaults: i32 = 0
let mut extra_filename: ptr<u8> = null

let mut default_main_config: ptr<u8> = null
let mut default_extra_config: ptr<u8> = null
let mut config_tables_ready: i32 = 0
let mut configdir_storage: ptr<u8> = null

