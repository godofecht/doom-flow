# Doom selection menu, ported from m_menu.c to Flow.
#
# Public ABI (m_menu.h): M_Responder, M_Ticker, M_Drawer, M_Init,
# M_StartControlPanel. C-visible globals (mouseSensitivity, showMessages,
# detailLevel, screenblocks, menuactive, inhelpscreens) live in menu.flow.
# String tables / save buffers live here (@flow_api menushim_*).
# Menu tables use Flow structs + integer routine IDs (no C fnptr tables).
#
# Private helpers are prefixed menu_*. Consts use MENU_ prefix.

extern { function strlen(s: string) -> i64 }
extern { function strcmp(a: string, b: string) -> i32 }
extern { function fopen(path: string, mode: string) -> ptr<void> }
extern { function fclose(f: ptr<void>) -> i32 }
extern { function fread(dest: ptr<void>, size: i64, n: i64, f: ptr<void>) -> i64 }
extern { function printf(fmt: string) -> i32 }
extern { function snprintf(buf: string, n: i64, fmt: string, s: string) -> i32 }

extern { function W_CacheLumpName(name: string, tag: i32) -> ptr<void> }
extern { function V_DrawPatchDirect(x: i32, y: i32, patch: ptr<void>) -> void }
extern { function S_StartSound(origin: ptr<void>, sound_id: i32) -> void }
extern { function S_SetSfxVolume(volume: i32) -> void }
extern { function S_SetMusicVolume(volume: i32) -> void }
extern { function R_SetViewSize(blocks: i32, detail: i32) -> void }
extern { function G_LoadGame(name: string) -> void }
extern { function G_SaveGame(slot: i32, description: string) -> void }
extern { function G_DeferedInitNew(skill: i32, episode: i32, map: i32) -> void }
extern { function G_ScreenShot() -> void }
extern { function D_StartTitle() -> void }
extern { function I_Quit() -> void }
extern { function I_WaitVBL(count: i32) -> void }
extern { function I_SetPalette(pal: ptr<u8>) -> void }
extern { function I_Error(msg: string) -> void }
extern { function I_GetTime() -> i32 }
extern { function P_SaveGameFile(slot: i32) -> string }
extern { function M_StringCopy(dest: ptr<u8>, src: ptr<u8>, dest_size: i64) -> i32 }

extern { function ctrlshim_var(id: i32) -> ptr<i32> }
extern { function INPUT_vanilla_keyboard_mapping() -> i32 }
extern { function hushim_hu_font() -> ptr<void> }
extern { function PATCH_width(p: ptr<void>) -> i32 }
extern { function PATCH_height(p: ptr<void>) -> i32 }
extern { function loopshim_gametic() -> i32 }
extern { function STAT_logical_gamemission() -> i32 }
