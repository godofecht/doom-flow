function menu_save_slot_ptr(slot: i32) -> ptr<u8> {
    return ((&menu_savegamestrings[0] as i64) + ((slot * MENU_SAVESTRINGSIZE) as i64)) as ptr<u8>
}

@flow_api
function menushim_gammamsg(i: i32) -> string { return menu_gammamsg[i] }
@flow_api
function menushim_skull_name(i: i32) -> string { return menu_skull_name[i] }
@flow_api
function menushim_detail_name(i: i32) -> string { return menu_detail_name[i] }
@flow_api
function menushim_msg_name(i: i32) -> string { return menu_msg_name[i] }

@flow_api
function menushim_save_string(i: i32) -> string { return menu_save_slot_ptr(i) as string }
@flow_api
function menushim_endstring() -> string { return (&menu_endstring[0]) as string }
@flow_api
function menushim_tempstring() -> string { return (&menu_tempstring[0]) as string }

@flow_api
function menudata_doom1_endmsg(i: i32) -> string { return menu_doom1_endmsg[i] }
@flow_api
function menudata_doom2_endmsg(i: i32) -> string { return menu_doom2_endmsg[i] }

const MENU_NUM_QUITMESSAGES: i32 = 8
const MENU_QSPROMPT: string = "quicksave over your game named\n\n'%s'?\n\npress y or n."
const MENU_QLPROMPT: string = "do you want to quickload the game named\n\n'%s'?\n\npress y or n."

@flow_api
function menushim_toupper(c: i32) -> i32 {
    if c >= 97 and c <= 122 {
        return c - 32
    }
    return c
}

@flow_api
function menushim_read_save_slot(i: i32) -> i32 {
    let slot: ptr<u8> = menu_save_slot_ptr(i)
    let fh: ptr<void> = fopen(P_SaveGameFile(i), "rb")
    if (fh as i64) == 0 {
        M_StringCopy(slot, MENU_EMPTYSTRING as ptr<u8>, MENU_SAVESTRINGSIZE as i64)
        return 0
    }
    fread(slot as ptr<void>, 1, MENU_SAVESTRINGSIZE as i64, fh)
    fclose(fh)
    return 1
}

@flow_api
function menushim_fmt_qsprompt(slot: i32) -> void {
    snprintf(menushim_tempstring(), 80, MENU_QSPROMPT, menushim_save_string(slot))
}

@flow_api
function menushim_fmt_qlprompt(slot: i32) -> void {
    snprintf(menushim_tempstring(), 80, MENU_QLPROMPT, menushim_save_string(slot))
}

@flow_api
function menushim_fmt_endstring(msg: string) -> void {
    snprintf(menushim_endstring(), 160, "%s\n\n(press y to quit to dos.)", msg)
}

@flow_api
function menushim_select_end_message() -> string {
    let idx: i32 = loopshim_gametic() % MENU_NUM_QUITMESSAGES
    if STAT_logical_gamemission() == 0 {
        return menudata_doom1_endmsg(idx)
    }
    return menudata_doom2_endmsg(idx)
}

@flow_api
function menushim_episode_warn() -> void {
    printf("M_Episode: 4th episode requires UltimateDOOM\n")
}

@flow_api
function menushim_copy_save_to_old(slot: i32) -> void {
    M_StringCopy(&menu_save_old_string[0], menu_save_slot_ptr(slot), MENU_SAVESTRINGSIZE as i64)
}

@flow_api
function menushim_restore_save_from_old(slot: i32) -> void {
    M_StringCopy(menu_save_slot_ptr(slot), &menu_save_old_string[0], MENU_SAVESTRINGSIZE as i64)
}

@flow_api
function menushim_clear_save_slot(slot: i32) -> void {
    menu_save_slot_ptr(slot)[0] = 0 as u8
}

@flow_api
function menushim_save_strlen(slot: i32) -> i32 {
    return strlen(menu_save_slot_ptr(slot) as string) as i32
}

@flow_api
function menushim_save_char(slot: i32, idx: i32) -> i32 {
    return menu_savegamestrings[slot * MENU_SAVESTRINGSIZE + idx] as i32
}

@flow_api
function menushim_set_save_char(slot: i32, idx: i32, ch: i32) -> void {
    menu_savegamestrings[slot * MENU_SAVESTRINGSIZE + idx] = ch as u8
}

@flow_api
function menushim_save_eq_empty(slot: i32) -> i32 {
    if strcmp(menu_save_slot_ptr(slot) as string, MENU_EMPTYSTRING) == 0 {
        return 1
    }
    return 0
}

@flow_api
function DS_select_end_message() -> string { return menushim_select_end_message() }

struct MenuItem {
    status: i32,
    name: string,
    routine: i32,
    alpha_key: i32
}

struct MenuDef {
    numitems: i32,
    prev: i32,
    draw: i32,
    x: i32,
    y: i32,
    last_on: i32
}

