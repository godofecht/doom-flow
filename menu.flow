# Menu-owned doomstat-adjacent globals (storage in menu.flow)
let mut menu_mouse_sensitivity: i32 = 5
let mut menu_show_messages: i32 = 1
let mut menu_detail_level: i32 = 0
let mut menu_screenblocks: i32 = 10
let mut menu_menuactive: i32 = 0
let mut menu_inhelpscreens: i32 = 0

@flow_api
function menushim_mouse_sensitivity() -> i32 { return menu_mouse_sensitivity }
@flow_api
function menushim_set_mouse_sensitivity(v: i32) -> void { menu_mouse_sensitivity = v }
@flow_api
function menushim_show_messages() -> i32 { return menu_show_messages }
@flow_api
function menushim_set_show_messages(v: i32) -> void { menu_show_messages = v }
@flow_api
function menushim_detail_level() -> i32 { return menu_detail_level }
@flow_api
function menushim_set_detail_level(v: i32) -> void { menu_detail_level = v }
@flow_api
function menushim_screenblocks() -> i32 { return menu_screenblocks }
@flow_api
function menushim_set_screenblocks(v: i32) -> void { menu_screenblocks = v }
@flow_api
function menushim_menuactive() -> i32 { return menu_menuactive }
@flow_api
function menushim_set_menuactive(v: i32) -> void { menu_menuactive = v }
@flow_api
function menushim_inhelpscreens() -> i32 { return menu_inhelpscreens }
@flow_api
function menushim_set_inhelpscreens(v: i32) -> void { menu_inhelpscreens = v }

@flow_api
function menushim_bind_addr(id: i32) -> ptr<void> {
    if id == 0 { return &menu_mouse_sensitivity as ptr<void> }
    if id == 3 { return &menu_show_messages as ptr<void> }
    if id == 4 { return &menu_screenblocks as ptr<void> }
    if id == 5 { return &menu_detail_level as ptr<void> }
    return null
}

@flow_api
function STAT_menuactive() -> i32 { return menu_menuactive }
@flow_api
function STAT_set_menuactive(v: i32) -> void { menu_menuactive = v }
