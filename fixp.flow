# Fixed-point math, bounding boxes and the RNG, ported from m_fixed.c,
# m_bbox.c and m_random.c.
#
# fixed_t is i32 with 16 fraction bits. FixedDiv saturates to INT_MIN /
# INT_MAX on overflow, exactly as the original did.

const FRACBITS: i32 = 16
const INT_MAX_C: i32 = 2147483647
const INT_MIN_C: i32 = -2147483648

# g_game.c reads the demo consistency value from the `rndindex` global
# (formerly dg_shim.c); other C/Flow modules reach it through this pointer.
let mut rndindex: i32 = 0

@flow_api
function rndindex_addr() -> ptr<i32> { return &rndindex }

@flow_api
function FixedMul(a: i32, b: i32) -> i32 {
    return (((a as i64) * (b as i64)) >> FRACBITS) as i32
}

function fixp_abs(a: i32) -> i32 {
    if a < 0 {
        return 0 - a
    }
    return a
}

@flow_api
function FixedDiv(a: i32, b: i32) -> i32 {
    if (fixp_abs(a) >> 14) >= fixp_abs(b) {
        if (a ^ b) < 0 {
            return INT_MIN_C
        }
        return INT_MAX_C
    }
    return (((a as i64) << 16) / (b as i64)) as i32
}

# Bounding boxes: box[0]=top, box[1]=bottom, box[2]=left, box[3]=right.

@flow_api
function M_ClearBox(box: ptr<i32>) -> void {
    box[0] = INT_MIN_C
    box[3] = INT_MIN_C
    box[1] = INT_MAX_C
    box[2] = INT_MAX_C
}

@flow_api
function M_AddToBox(box: ptr<i32>, x: i32, y: i32) -> void {
    if x < box[2] {
        box[2] = x
    } else {
        if x > box[3] {
            box[3] = x
        }
    }
    if y < box[1] {
        box[1] = y
    } else {
        if y > box[0] {
            box[0] = y
        }
    }
}

# The famous 256-entry random table.
let mut rndtable: array<i32, 256> = [
    0, 8, 109, 220, 222, 241, 149, 107, 75, 248, 254, 140, 16, 66,
    74, 21, 211, 47, 80, 242, 154, 27, 205, 128, 161, 89, 77, 36,
    95, 110, 85, 48, 212, 140, 211, 249, 22, 79, 200, 50, 28, 188,
    52, 140, 202, 120, 68, 145, 62, 70, 184, 190, 91, 197, 152, 224,
    149, 104, 25, 178, 252, 182, 202, 182, 141, 197, 4, 81, 181, 242,
    145, 42, 39, 227, 156, 198, 225, 193, 219, 93, 122, 175, 249, 0,
    175, 143, 70, 239, 46, 246, 163, 53, 163, 109, 168, 135, 2, 235,
    25, 92, 20, 145, 138, 77, 69, 166, 78, 176, 173, 212, 166, 113,
    94, 161, 41, 50, 239, 49, 111, 164, 70, 60, 2, 37, 171, 75,
    136, 156, 11, 56, 42, 146, 138, 229, 73, 146, 77, 61, 98, 196,
    135, 106, 63, 197, 195, 86, 96, 203, 113, 101, 170, 247, 181, 113,
    80, 250, 108, 7, 255, 237, 129, 226, 79, 107, 112, 166, 103, 241,
    24, 223, 239, 120, 198, 58, 60, 82, 128, 3, 184, 66, 143, 224,
    145, 224, 81, 206, 163, 45, 63, 90, 168, 114, 59, 33, 159, 95,
    28, 139, 123, 98, 125, 196, 15, 70, 194, 253, 54, 14, 109, 226,
    71, 17, 161, 93, 186, 87, 244, 138, 20, 52, 123, 251, 26, 36,
    17, 46, 52, 231, 232, 76, 31, 221, 84, 37, 216, 165, 212, 106,
    197, 242, 98, 43, 39, 175, 254, 145, 190, 84, 118, 222, 187, 136,
    120, 163, 236, 249
]

let mut prndindex: i32 = 0

# P_Random drives the game simulation and must stay deterministic for
# demo playback; M_Random is for effects that don't affect sync.

@flow_api
function P_Random() -> i32 {
    prndindex = (prndindex + 1) & 255
    return rndtable[prndindex]
}

@flow_api
function M_Random() -> i32 {
    let ri: ptr<i32> = rndindex_addr()
    ri[0] = (ri[0] + 1) & 255
    return rndtable[ri[0]]
}

@flow_api
function M_ClearRandom() -> void {
    prndindex = 0
    let ri: ptr<i32> = rndindex_addr()
    ri[0] = 0
}
