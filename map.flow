# Mirrors M_StrToInt: "0x"/"0X" prefix means hex, else decimal.
function map_strtouint(s: ptr<u8>) -> u32 {
    let mut i: i32 = 0
    let mut base: i32 = 10
    if s[0] as i32 == 48 and (s[1] as i32 == 120 or s[1] as i32 == 88) {
        base = 16
        i = 2
    }
    let mut v: u32 = 0
    let mut c: i32 = s[i] as i32
    while (c >= 48 and c < 48 + base) or (base == 16 and ((c >= 97 and c <= 102) or (c >= 65 and c <= 70))) {
        let mut digit: i32 = 0
        if c >= 48 and c <= 57 {
            digit = c - 48
        } elif c >= 97 and c <= 102 {
            digit = c - 97 + 10
        } else {
            digit = c - 65 + 10
        }
        v = v * (base as u32) + (digit as u32)
        i = i + 1
        c = s[i] as i32
    }
    return v
}

