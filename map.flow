# ---- helpers ----------------------------------------------------------

function map_abs(x: i32) -> i32 {
    if x < 0 {
        return 0 - x
    }
    return x
}

# ---- PIT_StompThing ---------------------------------------------------

@flow_api
function PIT_StompThing(thing: ptr<void>) -> i32 {
    if (MOBJ_flags(thing) & MAP_MF_SHOOTABLE) == 0 {
        return 1
    }

    let tm: ptr<void> = MAP_tmthing()
    let blockdist: i32 = MOBJ_radius(thing) + MOBJ_radius(tm)

    if map_abs(MOBJ_x(thing) - MAP_tmx()) >= blockdist
        or map_abs(MOBJ_y(thing) - MAP_tmy()) >= blockdist {
        return 1
    }

    if (thing as i64) == (tm as i64) {
        return 1
    }

    # monsters don't stomp things except on boss level
    if (MOBJ_player(tm) as i64) == 0 and STAT_gamemap() != 30 {
        return 0
    }

    P_DamageMobj(thing, tm, tm, 10000)
    return 1
}

# ---- P_TeleportMove ---------------------------------------------------

@flow_api
function P_TeleportMove(thing: ptr<void>, x: i32, y: i32) -> i32 {
    MAP_set_tmthing(thing)
    MAP_set_tmflags(MOBJ_flags(thing))
    MAP_set_tmx(x)
    MAP_set_tmy(y)

    let r: i32 = MOBJ_radius(thing)
    MAP_set_tmbbox(MAP_BOXTOP, y + r)
    MAP_set_tmbbox(MAP_BOXBOTTOM, y - r)
    MAP_set_tmbbox(MAP_BOXRIGHT, x + r)
    MAP_set_tmbbox(MAP_BOXLEFT, x - r)

    let newsubsec: ptr<void> = R_PointInSubsector(x, y)
    MAP_set_ceilingline(null)

    let sec: ptr<void> = GEOM_subsector_sector(newsubsec)
    let fh: i32 = GEOM_sector_floorheight(sec)
    MAP_set_tmfloorz(fh)
    MAP_set_tmdropoffz(fh)
    MAP_set_tmceilingz(GEOM_sector_ceilingheight(sec))

    RMAIN_set_validcount(RMAIN_validcount() + 1)
    MAP_set_numspechit(0)

    let xl: i32 = (MAP_tmbbox(MAP_BOXLEFT) - GEOM_bmaporgx() - MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT
    let xh: i32 = (MAP_tmbbox(MAP_BOXRIGHT) - GEOM_bmaporgx() + MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT
    let yl: i32 = (MAP_tmbbox(MAP_BOXBOTTOM) - GEOM_bmaporgy() - MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT
    let yh: i32 = (MAP_tmbbox(MAP_BOXTOP) - GEOM_bmaporgy() + MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT

    for bx in xl to (xh + 1) {
        for by in yl to (yh + 1) {
            if P_BlockThingsIterator(bx, by, PIT_StompThing) == 0 {
                return 0
            }
        }
    }

    P_UnsetThingPosition(thing)
    MOBJ_set_floorz(thing, MAP_tmfloorz())
    MOBJ_set_ceilingz(thing, MAP_tmceilingz())
    MOBJ_set_x(thing, x)
    MOBJ_set_y(thing, y)
    P_SetThingPosition(thing)
    return 1
}

# ---- PIT_CheckLine ----------------------------------------------------

@flow_api
function PIT_CheckLine(ld: ptr<void>) -> i32 {
    if MAP_tmbbox(MAP_BOXRIGHT) <= GEOM_line_bbox(ld, MAP_BOXLEFT)
        or MAP_tmbbox(MAP_BOXLEFT) >= GEOM_line_bbox(ld, MAP_BOXRIGHT)
        or MAP_tmbbox(MAP_BOXTOP) <= GEOM_line_bbox(ld, MAP_BOXBOTTOM)
        or MAP_tmbbox(MAP_BOXBOTTOM) >= GEOM_line_bbox(ld, MAP_BOXTOP) {
        return 1
    }

    if P_BoxOnLineSide(MAP_tmbbox_addr(), ld) != (0 - 1) {
        return 1
    }

    if (GEOM_line_backsector(ld) as i64) == 0 {
        return 0
    }

    let tm: ptr<void> = MAP_tmthing()
    if (MOBJ_flags(tm) & MAP_MF_MISSILE) == 0 {
        if (GEOM_line_flags(ld) & MAP_ML_BLOCKING) != 0 {
            return 0
        }
        if (MOBJ_player(tm) as i64) == 0
            and (GEOM_line_flags(ld) & MAP_ML_BLOCKMONSTERS) != 0 {
            return 0
        }
    }

    P_LineOpening(ld)

    if MAPUTL_opentop() < MAP_tmceilingz() {
        MAP_set_tmceilingz(MAPUTL_opentop())
        MAP_set_ceilingline(ld)
    }

    if MAPUTL_openbottom() > MAP_tmfloorz() {
        MAP_set_tmfloorz(MAPUTL_openbottom())
    }

    if MAPUTL_lowfloor() < MAP_tmdropoffz() {
        MAP_set_tmdropoffz(MAPUTL_lowfloor())
    }

    if GEOM_line_special(ld) != 0 {
        let n: i32 = MAP_numspechit()
        MAP_set_spechit(n, ld)
        MAP_set_numspechit(n + 1)
        if MAP_numspechit() > MAP_MAXSPECIALCROSS_ORIGINAL {
            mapshim_SpechitOverrun(ld)
        }
    }

    return 1
}

# ---- PIT_CheckThing ---------------------------------------------------

@flow_api
function PIT_CheckThing(thing: ptr<void>) -> i32 {
    let thingflags: i32 = MOBJ_flags(thing)
    if (thingflags & (MAP_MF_SOLID | MAP_MF_SPECIAL | MAP_MF_SHOOTABLE)) == 0 {
        return 1
    }

    let tm: ptr<void> = MAP_tmthing()
    let blockdist: i32 = MOBJ_radius(thing) + MOBJ_radius(tm)

    if map_abs(MOBJ_x(thing) - MAP_tmx()) >= blockdist
        or map_abs(MOBJ_y(thing) - MAP_tmy()) >= blockdist {
        return 1
    }

    if (thing as i64) == (tm as i64) {
        return 1
    }

    let tmflags_m: i32 = MOBJ_flags(tm)

    if (tmflags_m & MAP_MF_SKULLFLY) != 0 {
        let damage: i32 = ((P_Random() % 8) + 1) * MOBJ_info_damage(tm)
        P_DamageMobj(thing, tm, tm, damage)
        MOBJ_set_flags(tm, tmflags_m & (0 - 1 - MAP_MF_SKULLFLY))
        MOBJ_zero_mom(tm)
        P_SetMobjState(tm, MOBJ_info_spawnstate(tm))
        return 0
    }

    if (tmflags_m & MAP_MF_MISSILE) != 0 {
        if MOBJ_z(tm) > MOBJ_z(thing) + MOBJ_height(thing) {
            return 1
        }
        if MOBJ_z(tm) + MOBJ_height(tm) < MOBJ_z(thing) {
            return 1
        }

        let target: ptr<void> = MOBJ_target(tm)
        if (target as i64) != 0 {
            let ttype: i32 = MOBJ_type(target)
            let otype: i32 = MOBJ_type(thing)
            if ttype == otype
                or (ttype == MAP_MT_KNIGHT and otype == MAP_MT_BRUISER)
                or (ttype == MAP_MT_BRUISER and otype == MAP_MT_KNIGHT) {
                if (thing as i64) == (target as i64) {
                    return 1
                }
                if otype != MAP_MT_PLAYER and MAP_DEH_SPECIES_INFIGHTING == 0 {
                    return 0
                }
            }
        }

        if (thingflags & MAP_MF_SHOOTABLE) == 0 {
            if (thingflags & MAP_MF_SOLID) != 0 {
                return 0
            }
            return 1
        }

        let damage2: i32 = ((P_Random() % 8) + 1) * MOBJ_info_damage(tm)
        P_DamageMobj(thing, tm, MOBJ_target(tm), damage2)
        return 0
    }

    if (thingflags & MAP_MF_SPECIAL) != 0 {
        let solid: i32 = thingflags & MAP_MF_SOLID
        if (MAP_tmflags() & MAP_MF_PICKUP) != 0 {
            P_TouchSpecialThing(thing, tm)
        }
        if solid != 0 {
            return 0
        }
        return 1
    }

    if (thingflags & MAP_MF_SOLID) != 0 {
        return 0
    }
    return 1
}

# ---- P_CheckPosition --------------------------------------------------

@flow_api
function P_CheckPosition(thing: ptr<void>, x: i32, y: i32) -> i32 {
    MAP_set_tmthing(thing)
    MAP_set_tmflags(MOBJ_flags(thing))
    MAP_set_tmx(x)
    MAP_set_tmy(y)

    let r: i32 = MOBJ_radius(thing)
    MAP_set_tmbbox(MAP_BOXTOP, y + r)
    MAP_set_tmbbox(MAP_BOXBOTTOM, y - r)
    MAP_set_tmbbox(MAP_BOXRIGHT, x + r)
    MAP_set_tmbbox(MAP_BOXLEFT, x - r)

    let newsubsec: ptr<void> = R_PointInSubsector(x, y)
    MAP_set_ceilingline(null)

    let sec: ptr<void> = GEOM_subsector_sector(newsubsec)
    let fh: i32 = GEOM_sector_floorheight(sec)
    MAP_set_tmfloorz(fh)
    MAP_set_tmdropoffz(fh)
    MAP_set_tmceilingz(GEOM_sector_ceilingheight(sec))

    RMAIN_set_validcount(RMAIN_validcount() + 1)
    MAP_set_numspechit(0)

    if (MAP_tmflags() & MAP_MF_NOCLIP) != 0 {
        return 1
    }

    let xl: i32 = (MAP_tmbbox(MAP_BOXLEFT) - GEOM_bmaporgx() - MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT
    let xh: i32 = (MAP_tmbbox(MAP_BOXRIGHT) - GEOM_bmaporgx() + MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT
    let yl: i32 = (MAP_tmbbox(MAP_BOXBOTTOM) - GEOM_bmaporgy() - MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT
    let yh: i32 = (MAP_tmbbox(MAP_BOXTOP) - GEOM_bmaporgy() + MAP_MAXRADIUS) >> MAP_MAPBLOCKSHIFT

    for bx in xl to (xh + 1) {
        for by in yl to (yh + 1) {
            if P_BlockThingsIterator(bx, by, PIT_CheckThing) == 0 {
                return 0
            }
        }
    }

    let xl2: i32 = (MAP_tmbbox(MAP_BOXLEFT) - GEOM_bmaporgx()) >> MAP_MAPBLOCKSHIFT
    let xh2: i32 = (MAP_tmbbox(MAP_BOXRIGHT) - GEOM_bmaporgx()) >> MAP_MAPBLOCKSHIFT
    let yl2: i32 = (MAP_tmbbox(MAP_BOXBOTTOM) - GEOM_bmaporgy()) >> MAP_MAPBLOCKSHIFT
    let yh2: i32 = (MAP_tmbbox(MAP_BOXTOP) - GEOM_bmaporgy()) >> MAP_MAPBLOCKSHIFT

    for bx2 in xl2 to (xh2 + 1) {
        for by2 in yl2 to (yh2 + 1) {
            if P_BlockLinesIterator(bx2, by2, PIT_CheckLine) == 0 {
                return 0
            }
        }
    }

    return 1
}

# ---- P_TryMove --------------------------------------------------------

@flow_api
function P_TryMove(thing: ptr<void>, x: i32, y: i32) -> i32 {
    MAP_set_floatok(0)
    if P_CheckPosition(thing, x, y) == 0 {
        return 0
    }

    if (MOBJ_flags(thing) & MAP_MF_NOCLIP) == 0 {
        if MAP_tmceilingz() - MAP_tmfloorz() < MOBJ_height(thing) {
            return 0
        }

        MAP_set_floatok(1)

        if (MOBJ_flags(thing) & MAP_MF_TELEPORT) == 0
            and MAP_tmceilingz() - MOBJ_z(thing) < MOBJ_height(thing) {
            return 0
        }

        if (MOBJ_flags(thing) & MAP_MF_TELEPORT) == 0
            and MAP_tmfloorz() - MOBJ_z(thing) > MAP_STEP {
            return 0
        }

        if (MOBJ_flags(thing) & (MAP_MF_DROPOFF | MAP_MF_FLOAT)) == 0
            and MAP_tmfloorz() - MAP_tmdropoffz() > MAP_STEP {
            return 0
        }
    }

    P_UnsetThingPosition(thing)

    let oldx: i32 = MOBJ_x(thing)
    let oldy: i32 = MOBJ_y(thing)
    MOBJ_set_floorz(thing, MAP_tmfloorz())
    MOBJ_set_ceilingz(thing, MAP_tmceilingz())
    MOBJ_set_x(thing, x)
    MOBJ_set_y(thing, y)

    P_SetThingPosition(thing)

    if (MOBJ_flags(thing) & (MAP_MF_TELEPORT | MAP_MF_NOCLIP)) == 0 {
        # Match C while (numspechit--): body uses post-decremented index;
        # after the loop numspechit is -1.
        let mut keep_going: i32 = 1
        while keep_going != 0 {
            let cur: i32 = MAP_numspechit()
            MAP_set_numspechit(cur - 1)
            if cur == 0 {
                keep_going = 0
            } else {
                let ld: ptr<void> = MAP_spechit(MAP_numspechit())
                let side: i32 = P_PointOnLineSide(MOBJ_x(thing), MOBJ_y(thing), ld)
                let oldside: i32 = P_PointOnLineSide(oldx, oldy, ld)
                if side != oldside {
                    if GEOM_line_special(ld) != 0 {
                        P_CrossSpecialLine(GEOM_line_index(ld), oldside, thing)
                    }
                }
            }
        }
    }

    return 1
}

# ---- P_ThingHeightClip ------------------------------------------------

function P_ThingHeightClip(thing: ptr<void>) -> i32 {
    let mut onfloor: i32 = 0
    if MOBJ_z(thing) == MOBJ_floorz(thing) {
        onfloor = 1
    }

    P_CheckPosition(thing, MOBJ_x(thing), MOBJ_y(thing))

    MOBJ_set_floorz(thing, MAP_tmfloorz())
    MOBJ_set_ceilingz(thing, MAP_tmceilingz())

    if onfloor != 0 {
        MOBJ_set_z(thing, MOBJ_floorz(thing))
    } else {
        if MOBJ_z(thing) + MOBJ_height(thing) > MOBJ_ceilingz(thing) {
            MOBJ_set_z(thing, MOBJ_ceilingz(thing) - MOBJ_height(thing))
        }
    }

    if MOBJ_ceilingz(thing) - MOBJ_floorz(thing) < MOBJ_height(thing) {
        return 0
    }
    return 1
}

# ---- P_HitSlideLine ---------------------------------------------------

function P_HitSlideLine(ld: ptr<void>) -> void {
    if GEOM_line_slopetype(ld) == MAP_ST_HORIZONTAL {
        tmymove = 0
        return
    }

    if GEOM_line_slopetype(ld) == MAP_ST_VERTICAL {
        tmxmove = 0
        return
    }

    let side: i32 = P_PointOnLineSide(MOBJ_x(slidemo), MOBJ_y(slidemo), ld)
    let mut lineangle: u32 = R_PointToAngle2(0, 0, GEOM_line_dx(ld), GEOM_line_dy(ld))

    if side == 1 {
        lineangle = lineangle + MAP_ANG180
    }

    let moveangle: u32 = R_PointToAngle2(0, 0, tmxmove, tmymove)
    let mut deltaangle: u32 = moveangle - lineangle

    if deltaangle > MAP_ANG180 {
        deltaangle = deltaangle + MAP_ANG180
    }

    let la: u32 = lineangle >> MAP_ANGLETOFINESHIFT
    let da: u32 = deltaangle >> MAP_ANGLETOFINESHIFT

    let movelen: i32 = P_AproxDistance(tmxmove, tmymove)
    let newlen: i32 = FixedMul(movelen, TABLES_finecosine(da as i32))

    tmxmove = FixedMul(newlen, TABLES_finecosine(la as i32))
    tmymove = FixedMul(newlen, TABLES_finesine(la as i32))
}

# ---- PTR_SlideTraverse ------------------------------------------------

@flow_api
function PTR_SlideTraverse(icpt: ptr<void>) -> i32 {
    if MAPUTL_intercept_isaline(icpt) == 0 {
        I_Error("PTR_SlideTraverse: not a line?")
    }

    let li: ptr<void> = MAPUTL_intercept_line(icpt)
    let mut blocking: i32 = 0

    if (GEOM_line_flags(li) & MAP_ML_TWOSIDED) == 0 {
        if P_PointOnLineSide(MOBJ_x(slidemo), MOBJ_y(slidemo), li) != 0 {
            return 1
        }
        blocking = 1
    } else {
        P_LineOpening(li)
        if MAPUTL_openrange() < MOBJ_height(slidemo) {
            blocking = 1
        } elif MAPUTL_opentop() - MOBJ_z(slidemo) < MOBJ_height(slidemo) {
            blocking = 1
        } elif MAPUTL_openbottom() - MOBJ_z(slidemo) > MAP_STEP {
            blocking = 1
        }
    }

    if blocking == 0 {
        return 1
    }

    if MAPUTL_intercept_frac(icpt) < bestslidefrac {
        secondslidefrac = bestslidefrac
        secondslideline = bestslideline
        bestslidefrac = MAPUTL_intercept_frac(icpt)
        bestslideline = li
    }

    return 0
}

# ---- P_SlideMove ------------------------------------------------------

@flow_api
function P_SlideMove(mo: ptr<void>) -> void {
    slidemo = mo
    let mut hitcount: i32 = 0
    let mut done: i32 = 0

    while done == 0 {
        hitcount = hitcount + 1
        if hitcount == 3 {
            # stairstep
            if P_TryMove(mo, MOBJ_x(mo), MOBJ_y(mo) + MOBJ_momy(mo)) == 0 {
                P_TryMove(mo, MOBJ_x(mo) + MOBJ_momx(mo), MOBJ_y(mo))
            }
            return
        }

        let mut leadx: i32 = 0
        let mut leady: i32 = 0
        let mut trailx: i32 = 0
        let mut traily: i32 = 0

        if MOBJ_momx(mo) > 0 {
            leadx = MOBJ_x(mo) + MOBJ_radius(mo)
            trailx = MOBJ_x(mo) - MOBJ_radius(mo)
        } else {
            leadx = MOBJ_x(mo) - MOBJ_radius(mo)
            trailx = MOBJ_x(mo) + MOBJ_radius(mo)
        }

        if MOBJ_momy(mo) > 0 {
            leady = MOBJ_y(mo) + MOBJ_radius(mo)
            traily = MOBJ_y(mo) - MOBJ_radius(mo)
        } else {
            leady = MOBJ_y(mo) - MOBJ_radius(mo)
            traily = MOBJ_y(mo) + MOBJ_radius(mo)
        }

        bestslidefrac = MAP_FRACUNIT + 1

        P_PathTraverse(leadx, leady, leadx + MOBJ_momx(mo), leady + MOBJ_momy(mo),
            MAP_PT_ADDLINES, PTR_SlideTraverse)
        P_PathTraverse(trailx, leady, trailx + MOBJ_momx(mo), leady + MOBJ_momy(mo),
            MAP_PT_ADDLINES, PTR_SlideTraverse)
        P_PathTraverse(leadx, traily, leadx + MOBJ_momx(mo), traily + MOBJ_momy(mo),
            MAP_PT_ADDLINES, PTR_SlideTraverse)

        if bestslidefrac == MAP_FRACUNIT + 1 {
            if P_TryMove(mo, MOBJ_x(mo), MOBJ_y(mo) + MOBJ_momy(mo)) == 0 {
                P_TryMove(mo, MOBJ_x(mo) + MOBJ_momx(mo), MOBJ_y(mo))
            }
            return
        }

        bestslidefrac = bestslidefrac - 2048
        if bestslidefrac > 0 {
            let newx: i32 = FixedMul(MOBJ_momx(mo), bestslidefrac)
            let newy: i32 = FixedMul(MOBJ_momy(mo), bestslidefrac)
            if P_TryMove(mo, MOBJ_x(mo) + newx, MOBJ_y(mo) + newy) == 0 {
                # stairstep via loop continue path: bump hitcount to 2 so next iter hits 3
                # Match C goto stairstep: try y then x and return.
                if P_TryMove(mo, MOBJ_x(mo), MOBJ_y(mo) + MOBJ_momy(mo)) == 0 {
                    P_TryMove(mo, MOBJ_x(mo) + MOBJ_momx(mo), MOBJ_y(mo))
                }
                return
            }
        }

        bestslidefrac = MAP_FRACUNIT - (bestslidefrac + 2048)

        if bestslidefrac > MAP_FRACUNIT {
            bestslidefrac = MAP_FRACUNIT
        }

        if bestslidefrac <= 0 {
            return
        }

        tmxmove = FixedMul(MOBJ_momx(mo), bestslidefrac)
        tmymove = FixedMul(MOBJ_momy(mo), bestslidefrac)

        P_HitSlideLine(bestslideline)

        MOBJ_set_momx(mo, tmxmove)
        MOBJ_set_momy(mo, tmymove)

        if P_TryMove(mo, MOBJ_x(mo) + tmxmove, MOBJ_y(mo) + tmymove) != 0 {
            done = 1
        }
    }
}

# ---- PTR_AimTraverse --------------------------------------------------

@flow_api
function PTR_AimTraverse(icpt: ptr<void>) -> i32 {
    if MAPUTL_intercept_isaline(icpt) != 0 {
        let li: ptr<void> = MAPUTL_intercept_line(icpt)

        if (GEOM_line_flags(li) & MAP_ML_TWOSIDED) == 0 {
            return 0
        }

        P_LineOpening(li)

        if MAPUTL_openbottom() >= MAPUTL_opentop() {
            return 0
        }

        let dist: i32 = FixedMul(MAP_attackrange(), MAPUTL_intercept_frac(icpt))

        let back: ptr<void> = GEOM_line_backsector(li)
        let front: ptr<void> = GEOM_line_frontsector(li)

        if (back as i64) == 0
            or GEOM_sector_floorheight(front) != GEOM_sector_floorheight(back) {
            let slope: i32 = FixedDiv(MAPUTL_openbottom() - shootz, dist)
            if slope > SIGHT_bottomslope() {
                SIGHT_set_bottomslope(slope)
            }
        }

        if (back as i64) == 0
            or GEOM_sector_ceilingheight(front) != GEOM_sector_ceilingheight(back) {
            let slope2: i32 = FixedDiv(MAPUTL_opentop() - shootz, dist)
            if slope2 < SIGHT_topslope() {
                SIGHT_set_topslope(slope2)
            }
        }

        if SIGHT_topslope() <= SIGHT_bottomslope() {
            return 0
        }
        return 1
    }

    let th: ptr<void> = MAPUTL_intercept_thing(icpt)
    if (th as i64) == (shootthing as i64) {
        return 1
    }

    if (MOBJ_flags(th) & MAP_MF_SHOOTABLE) == 0 {
        return 1
    }

    let dist2: i32 = FixedMul(MAP_attackrange(), MAPUTL_intercept_frac(icpt))
    let mut thingtopslope: i32 = FixedDiv(
        MOBJ_z(th) + MOBJ_height(th) - shootz, dist2)

    if thingtopslope < SIGHT_bottomslope() {
        return 1
    }

    let mut thingbottomslope: i32 = FixedDiv(MOBJ_z(th) - shootz, dist2)

    if thingbottomslope > SIGHT_topslope() {
        return 1
    }

    if thingtopslope > SIGHT_topslope() {
        thingtopslope = SIGHT_topslope()
    }
    if thingbottomslope < SIGHT_bottomslope() {
        thingbottomslope = SIGHT_bottomslope()
    }

    aimslope = (thingtopslope + thingbottomslope) / 2
    MAP_set_linetarget(th)
    return 0
}

# ---- PTR_ShootTraverse ------------------------------------------------

@flow_api
function PTR_ShootTraverse(icpt: ptr<void>) -> i32 {
    if MAPUTL_intercept_isaline(icpt) != 0 {
        let li: ptr<void> = MAPUTL_intercept_line(icpt)

        if GEOM_line_special(li) != 0 {
            P_ShootSpecialLine(shootthing, li)
        }

        let mut hitline: i32 = 0

        if (GEOM_line_flags(li) & MAP_ML_TWOSIDED) == 0 {
            hitline = 1
        } else {
            P_LineOpening(li)
            let dist: i32 = FixedMul(MAP_attackrange(), MAPUTL_intercept_frac(icpt))
            let back: ptr<void> = GEOM_line_backsector(li)
            let front: ptr<void> = GEOM_line_frontsector(li)

            if (back as i64) == 0 {
                let slope: i32 = FixedDiv(MAPUTL_openbottom() - shootz, dist)
                if slope > aimslope {
                    hitline = 1
                }
                if hitline == 0 {
                    let slope2: i32 = FixedDiv(MAPUTL_opentop() - shootz, dist)
                    if slope2 < aimslope {
                        hitline = 1
                    }
                }
            } else {
                if GEOM_sector_floorheight(front) != GEOM_sector_floorheight(back) {
                    let slope3: i32 = FixedDiv(MAPUTL_openbottom() - shootz, dist)
                    if slope3 > aimslope {
                        hitline = 1
                    }
                }
                if hitline == 0
                    and GEOM_sector_ceilingheight(front) != GEOM_sector_ceilingheight(back) {
                    let slope4: i32 = FixedDiv(MAPUTL_opentop() - shootz, dist)
                    if slope4 < aimslope {
                        hitline = 1
                    }
                }
            }
        }

        if hitline == 0 {
            return 1
        }

        let frac: i32 = MAPUTL_intercept_frac(icpt) - FixedDiv(4 * MAP_FRACUNIT, MAP_attackrange())
        let x: i32 = MAPUTL_trace_x() + FixedMul(MAPUTL_trace_dx(), frac)
        let y: i32 = MAPUTL_trace_y() + FixedMul(MAPUTL_trace_dy(), frac)
        let z: i32 = shootz + FixedMul(aimslope, FixedMul(frac, MAP_attackrange()))

        let front2: ptr<void> = GEOM_line_frontsector(li)
        if GEOM_sector_ceilingpic(front2) == SKY_skyflatnum() {
            if z > GEOM_sector_ceilingheight(front2) {
                return 0
            }
            let back2: ptr<void> = GEOM_line_backsector(li)
            if (back2 as i64) != 0 and GEOM_sector_ceilingpic(back2) == SKY_skyflatnum() {
                return 0
            }
        }

        P_SpawnPuff(x, y, z)
        return 0
    }

    let th: ptr<void> = MAPUTL_intercept_thing(icpt)
    if (th as i64) == (shootthing as i64) {
        return 1
    }

    if (MOBJ_flags(th) & MAP_MF_SHOOTABLE) == 0 {
        return 1
    }

    let dist2: i32 = FixedMul(MAP_attackrange(), MAPUTL_intercept_frac(icpt))
    let thingtopslope: i32 = FixedDiv(
        MOBJ_z(th) + MOBJ_height(th) - shootz, dist2)

    if thingtopslope < aimslope {
        return 1
    }

    let thingbottomslope: i32 = FixedDiv(MOBJ_z(th) - shootz, dist2)
    if thingbottomslope > aimslope {
        return 1
    }

    let frac2: i32 = MAPUTL_intercept_frac(icpt) - FixedDiv(10 * MAP_FRACUNIT, MAP_attackrange())
    let x2: i32 = MAPUTL_trace_x() + FixedMul(MAPUTL_trace_dx(), frac2)
    let y2: i32 = MAPUTL_trace_y() + FixedMul(MAPUTL_trace_dy(), frac2)
    let z2: i32 = shootz + FixedMul(aimslope, FixedMul(frac2, MAP_attackrange()))

    if (MOBJ_flags(th) & MAP_MF_NOBLOOD) != 0 {
        P_SpawnPuff(x2, y2, z2)
    } else {
        P_SpawnBlood(x2, y2, z2, la_damage)
    }

    if la_damage != 0 {
        P_DamageMobj(th, shootthing, shootthing, la_damage)
    }

    return 0
}

# ---- P_AimLineAttack --------------------------------------------------

@flow_api
function P_AimLineAttack(t1_in: ptr<void>, angle_in: u32, distance: i32) -> i32 {
    let t1: ptr<void> = P_SubstNullMobj(t1_in)
    let angle: u32 = angle_in >> MAP_ANGLETOFINESHIFT
    shootthing = t1

    let x2: i32 = MOBJ_x(t1) + (distance >> MAP_FRACBITS) * TABLES_finecosine(angle as i32)
    let y2: i32 = MOBJ_y(t1) + (distance >> MAP_FRACBITS) * TABLES_finesine(angle as i32)
    shootz = MOBJ_z(t1) + (MOBJ_height(t1) >> 1) + 8 * MAP_FRACUNIT

    SIGHT_set_topslope(100 * MAP_FRACUNIT / 160)
    SIGHT_set_bottomslope(0 - (100 * MAP_FRACUNIT / 160))

    MAP_set_attackrange(distance)
    MAP_set_linetarget(null)

    P_PathTraverse(MOBJ_x(t1), MOBJ_y(t1), x2, y2,
        MAP_PT_ADDLINES | MAP_PT_ADDTHINGS, PTR_AimTraverse)

    if (MAP_linetarget() as i64) != 0 {
        return aimslope
    }
    return 0
}

# ---- P_LineAttack -----------------------------------------------------

@flow_api
function P_LineAttack(t1: ptr<void>, angle_in: u32, distance: i32, slope: i32, damage: i32) -> void {
    let angle: u32 = angle_in >> MAP_ANGLETOFINESHIFT
    shootthing = t1
    la_damage = damage
    let x2: i32 = MOBJ_x(t1) + (distance >> MAP_FRACBITS) * TABLES_finecosine(angle as i32)
    let y2: i32 = MOBJ_y(t1) + (distance >> MAP_FRACBITS) * TABLES_finesine(angle as i32)
    shootz = MOBJ_z(t1) + (MOBJ_height(t1) >> 1) + 8 * MAP_FRACUNIT
    MAP_set_attackrange(distance)
    aimslope = slope

    P_PathTraverse(MOBJ_x(t1), MOBJ_y(t1), x2, y2,
        MAP_PT_ADDLINES | MAP_PT_ADDTHINGS, PTR_ShootTraverse)
}

# ---- PTR_UseTraverse --------------------------------------------------

@flow_api
function PTR_UseTraverse(icpt: ptr<void>) -> i32 {
    let line: ptr<void> = MAPUTL_intercept_line(icpt)

    if GEOM_line_special(line) == 0 {
        P_LineOpening(line)
        if MAPUTL_openrange() <= 0 {
            S_StartSound(usething, MAP_SFX_NOWAY)
            return 0
        }
        return 1
    }

    let mut side: i32 = 0
    if P_PointOnLineSide(MOBJ_x(usething), MOBJ_y(usething), line) == 1 {
        side = 1
    }

    P_UseSpecialLine(usething, line, side)
    return 0
}

# ---- P_UseLines -------------------------------------------------------

@flow_api
function P_UseLines(player: ptr<void>) -> void {
    usething = PLAYER_mo(player)
    let angle: u32 = MOBJ_angle(usething) >> MAP_ANGLETOFINESHIFT
    let x1: i32 = MOBJ_x(usething)
    let y1: i32 = MOBJ_y(usething)
    let x2: i32 = x1 + (MAP_USERANGE >> MAP_FRACBITS) * TABLES_finecosine(angle as i32)
    let y2: i32 = y1 + (MAP_USERANGE >> MAP_FRACBITS) * TABLES_finesine(angle as i32)
    P_PathTraverse(x1, y1, x2, y2, MAP_PT_ADDLINES, PTR_UseTraverse)
}

# ---- PIT_RadiusAttack -------------------------------------------------

@flow_api
function PIT_RadiusAttack(thing: ptr<void>) -> i32 {
    if (MOBJ_flags(thing) & MAP_MF_SHOOTABLE) == 0 {
        return 1
    }

    let mtype: i32 = MOBJ_type(thing)
    if mtype == MAP_MT_CYBORG or mtype == MAP_MT_SPIDER {
        return 1
    }

    let dx: i32 = map_abs(MOBJ_x(thing) - MOBJ_x(bombspot))
    let dy: i32 = map_abs(MOBJ_y(thing) - MOBJ_y(bombspot))
    let mut dist: i32 = dx
    if dy > dx {
        dist = dy
    }
    dist = (dist - MOBJ_radius(thing)) >> MAP_FRACBITS
    if dist < 0 {
        dist = 0
    }

    if dist >= bombdamage {
        return 1
    }

    if P_CheckSight(thing, bombspot) != 0 {
        P_DamageMobj(thing, bombspot, bombsource, bombdamage - dist)
    }
    return 1
}

# ---- P_RadiusAttack ---------------------------------------------------

@flow_api
function P_RadiusAttack(spot: ptr<void>, source: ptr<void>, damage: i32) -> void {
    let dist: i32 = (damage + MAP_MAXRADIUS) << MAP_FRACBITS
    let yh: i32 = (MOBJ_y(spot) + dist - GEOM_bmaporgy()) >> MAP_MAPBLOCKSHIFT
    let yl: i32 = (MOBJ_y(spot) - dist - GEOM_bmaporgy()) >> MAP_MAPBLOCKSHIFT
    let xh: i32 = (MOBJ_x(spot) + dist - GEOM_bmaporgx()) >> MAP_MAPBLOCKSHIFT
    let xl: i32 = (MOBJ_x(spot) - dist - GEOM_bmaporgx()) >> MAP_MAPBLOCKSHIFT
    bombspot = spot
    bombsource = source
    bombdamage = damage

    for y in yl to (yh + 1) {
        for x in xl to (xh + 1) {
            P_BlockThingsIterator(x, y, PIT_RadiusAttack)
        }
    }
}

# ---- PIT_ChangeSector -------------------------------------------------

@flow_api
function PIT_ChangeSector(thing: ptr<void>) -> i32 {
    if P_ThingHeightClip(thing) != 0 {
        return 1
    }

    if MOBJ_health(thing) <= 0 {
        P_SetMobjState(thing, MAP_S_GIBS)
        MOBJ_set_flags(thing, MOBJ_flags(thing) & (0 - 1 - MAP_MF_SOLID))
        MOBJ_set_height(thing, 0)
        MOBJ_set_radius(thing, 0)
        return 1
    }

    if (MOBJ_flags(thing) & MAP_MF_DROPPED) != 0 {
        P_RemoveMobj(thing)
        return 1
    }

    if (MOBJ_flags(thing) & MAP_MF_SHOOTABLE) == 0 {
        return 1
    }

    mapshim_set_nofit(1)

    if MAP_crushchange() != 0 and (STAT_leveltime() & 3) == 0 {
        P_DamageMobj(thing, null, null, 10)
        let blood: ptr<void> = P_SpawnMobj(
            MOBJ_x(thing),
            MOBJ_y(thing),
            MOBJ_z(thing) + MOBJ_height(thing) / 2,
            MAP_MT_BLOOD)
        MOBJ_set_momx(blood, (P_Random() - P_Random()) << 12)
        MOBJ_set_momy(blood, (P_Random() - P_Random()) << 12)
    }

    return 1
}

# ---- P_ChangeSector ---------------------------------------------------

@flow_api
function P_ChangeSector(sector: ptr<void>, crunch: i32) -> i32 {
    mapshim_set_nofit(0)
    mapshim_set_crushchange(crunch)

    let xl: i32 = GEOM_sector_blockbox(sector, MAP_BOXLEFT)
    let xh: i32 = GEOM_sector_blockbox(sector, MAP_BOXRIGHT)
    let yl: i32 = GEOM_sector_blockbox(sector, MAP_BOXBOTTOM)
    let yh: i32 = GEOM_sector_blockbox(sector, MAP_BOXTOP)

    for x in xl to (xh + 1) {
        for y in yl to (yh + 1) {
            P_BlockThingsIterator(x, y, PIT_ChangeSector)
        }
    }

    return MAP_nofit()
}
