# PrBoom-plus / Chocolate Doom SpechitOverrun vanilla-emulation address poke.
@flow_api
function mapshim_SpechitOverrun(ld: ptr<void>) -> void {
    if map_spechit_baseaddr == 0 {
        let p: i32 = M_CheckParmWithArgs("-spechit", 1)
        if p > 0 {
            let words: ptr<i64> = argvflow_argv()
            map_spechit_baseaddr = map_strtouint(words[p + 1] as ptr<u8>)
        } else {
            map_spechit_baseaddr = 0x01C09C98 as u32
        }
    }

    let line_idx: i32 = GEOM_line_index(ld)
    let addr: u32 = map_spechit_baseaddr + ((line_idx as u32) * (0x3E as u32))

    if map_numspechit == 9 or map_numspechit == 10 or map_numspechit == 11 or map_numspechit == 12 {
        MAP_set_tmbbox(map_numspechit - 9, addr as i32)
    } elif map_numspechit == 13 {
        MAP_set_crushchange(addr as i32)
    } elif map_numspechit == 14 {
        MAP_set_nofit(addr as i32)
    } else {
        mapshim_overrun_warn(map_numspechit)
    }
}

