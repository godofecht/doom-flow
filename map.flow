# Movement / collision / aiming / shooting, ported from p_map.c to Flow.
#
# tm* scalars, floatok, crushchange/nofit, tmbbox, and pointer globals
# (tmthing, ceilingline, spechit, linetarget) are Flow-owned.
# open*/lowfloor/trace/intercepts stay maputl-owned.
#
# PIT_*/PTR_* keep exact C names via @flow_api so P_Block*Iterator /
# P_PathTraverse can take their addresses.
#
# Prefer GEOM_/MOBJ_/MAPUTL_ shared APIs.
#
# LP64 offsetof notes (same as sight.flow / user.flow):
#   mobj_t 224; line_t 88; sector_t 128; intercept_t 16
#     intercept: frac 0, isaline 4, d 8
#     line: special 26, bbox 36, slopetype 52, frontsector 56, backsector 64
#     sector: ceilingpic 10, blockbox 32
#     mobj: radius 104, height 108, momz 120, type 128, info 136,
#           health 164, target 176, player 192

