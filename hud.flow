const HU_SCREENWIDTH: i32 = 320       # i_video.h
const MAXPLAYERS: i32 = 4          # doomdef.h
const HU_MAXLINELENGTH: i32 = 80   # hu_lib.h
const HU_FONTSTART: i32 = 33       # hu_stuff.h: '!'
const HU_FONTEND: i32 = 95         # hu_stuff.h: '_'
const HU_FONTSIZE: i32 = 63        # hu_stuff.h
const HU_BROADCAST: i32 = 5        # hu_stuff.h
const HU_MSGX: i32 = 0             # hu_stuff.h
const HU_MSGY: i32 = 0             # hu_stuff.h
const HU_MSGHEIGHT: i32 = 1        # hu_stuff.h, in lines
const HU_MSGTIMEOUT: i32 = 140     # hu_stuff.h: 4*TICRATE
const HU_TITLEX: i32 = 0           # hu_stuff.c
const QUEUESIZE: i32 = 128         # hu_stuff.c

const KEY_ENTER: i32 = 13          # doomkeys.h
const KEY_ESCAPE: i32 = 27         # doomkeys.h
const KEY_BACKSPACE: i32 = 127     # doomkeys.h: 0x7f
const KEY_RSHIFT: i32 = 182       # doomkeys.h: 0x80+0x36
const KEY_RALT: i32 = 184         # doomkeys.h: 0x80+0x38
const KEY_LALT: i32 = 184         # doomkeys.h: == KEY_RALT

const HU_EV_KEYDOWN: i32 = 0          # d_event.h evtype_t
const HU_PU_STATIC: i32 = 1           # z_zone.h
const SFX_TINK: i32 = 87           # sounds.h sfx_tink
const SFX_RADIO: i32 = 108         # sounds.h sfx_radio

# d_mode.h GameMission_t / GameMode_t / GameVersion_t
const HU_MISSION_DOOM: i32 = 0
const MISSION_DOOM2: i32 = 1
const MISSION_PACK_TNT: i32 = 2
const MISSION_PACK_PLUT: i32 = 3
const HU_GM_COMMERCIAL: i32 = 2
const HU_EXE_CHEX: i32 = 9

# textline field offsets
const TL_X: i32 = 0
const TL_Y: i32 = 4
const TL_F: i32 = 8
const TL_SC: i32 = 16
const TL_LEN: i32 = 20
const TL_UPD: i32 = 24
const TL_L: i32 = 28
const TL_STRIDE: i32 = 112

# stext field offsets (after 4 textlines)
const ST_H: i32 = 448
const ST_CL: i32 = 452
const ST_ON: i32 = 456
const ST_LASTON: i32 = 460

# itext field offsets (after 1 textline)
const IT_LM: i32 = 112
const IT_ON: i32 = 116
const IT_LASTON: i32 = 120

# "on" ids
const ON_OFF: i32 = 0       # was &always_off
const ON_MESSAGE: i32 = 1   # was &message_on
const ON_CHAT: i32 = 2      # was &chat_on (C-side, hu_shim.c)

# chat_on owned here; menu.flow reads via HU_chat_on
@flow_api
function HU_chat_on() -> i32 { return chat_on }
@flow_api
function HU_set_chat_on(v: i32) -> void { chat_on = v }
@flow_api
function hushim_message_dontfuckwithme() -> i32 { return message_dontfuckwithme }
@flow_api
function hushim_set_message_dontfuckwithme(v: i32) -> void { message_dontfuckwithme = v }

