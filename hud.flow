@flow_api
function hushim_set_hu_font(i: i32, p: ptr<void>) -> void {
    hu_font[i] = p as i64
}

@flow_api
function hushim_hu_font() -> ptr<void> {
    return &hu_font[0] as ptr<void>
}

@flow_api
function hushim_chat_macro_bind_addr(i: i32) -> ptr<void> {
    return &chat_macros[i] as ptr<void>
}

@flow_api
function hushim_chat_macro(i: i32) -> ptr<u8> {
    return chat_macros[i]
}

@flow_api
function hushim_player_name(i: i32) -> ptr<u8> {
    return player_names[i]
}

