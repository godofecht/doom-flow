# ---- P_SetMobjState ---------------------------------------------------

@flow_api
function P_SetMobjState(mobj: ptr<void>, state_in: i32) -> i32 {
    let mut state: i32 = state_in

    while 1 != 0 {
        if state == MOBJ_S_NULL {
            mobj_set_ptr(mobj as i64, MOBJ_OFF_STATE, null)
            P_RemoveMobj(mobj)
            return 0
        }

        let st: ptr<void> = STATE_at(state)
        MOBJ_set_state(mobj, st)
        MOBJ_set_tics(mobj, STATE_tics(st))
        MOBJ_set_sprite(mobj, STATE_sprite(st))
        MOBJ_set_frame(mobj, STATE_frame(st))

        STATE_call_acp1(st, mobj)

        state = STATE_nextstate(st)
        if MOBJ_tics(mobj) != 0 {
            break
        }
    }

    return 1
}

# ---- P_ExplodeMissile -------------------------------------------------

function P_ExplodeMissile(mo: ptr<void>) -> void {
    MOBJ_zero_mom(mo)
    P_SetMobjState(mo, MOBJ_info_deathstate(mo))
    MOBJ_set_tics(mo, MOBJ_tics(mo) - (P_Random() & 3))
    if MOBJ_tics(mo) < 1 {
        MOBJ_set_tics(mo, 1)
    }
    MOBJ_set_flags(mo, mobj_clear_flag(MOBJ_flags(mo), MOBJ_MF_MISSILE))
    if MOBJ_info_deathsound(mo) != 0 {
        S_StartSound(mo, MOBJ_info_deathsound(mo))
    }
}

# ---- P_XYMovement -----------------------------------------------------

function P_XYMovement(mo: ptr<void>) -> void {
    if MOBJ_momx(mo) == 0 and MOBJ_momy(mo) == 0 {
        if (MOBJ_flags(mo) & MOBJ_MF_SKULLFLY) != 0 {
            MOBJ_set_flags(mo, mobj_clear_flag(MOBJ_flags(mo), MOBJ_MF_SKULLFLY))
            MOBJ_zero_mom(mo)
            P_SetMobjState(mo, MOBJ_info_spawnstate(mo))
        }
        return
    }

    let player: ptr<void> = MOBJ_player(mo)

    if MOBJ_momx(mo) > MOBJ_MAXMOVE {
        MOBJ_set_momx(mo, MOBJ_MAXMOVE)
    } elif MOBJ_momx(mo) < 0 - MOBJ_MAXMOVE {
        MOBJ_set_momx(mo, 0 - MOBJ_MAXMOVE)
    }

    if MOBJ_momy(mo) > MOBJ_MAXMOVE {
        MOBJ_set_momy(mo, MOBJ_MAXMOVE)
    } elif MOBJ_momy(mo) < 0 - MOBJ_MAXMOVE {
        MOBJ_set_momy(mo, 0 - MOBJ_MAXMOVE)
    }

    let mut xmove: i32 = MOBJ_momx(mo)
    let mut ymove: i32 = MOBJ_momy(mo)

    while 1 != 0 {
        let mut ptryx: i32 = 0
        let mut ptryy: i32 = 0
        if xmove > MOBJ_MAXMOVE / 2 or ymove > MOBJ_MAXMOVE / 2 {
            ptryx = MOBJ_x(mo) + xmove / 2
            ptryy = MOBJ_y(mo) + ymove / 2
            xmove = xmove >> 1
            ymove = ymove >> 1
        } else {
            ptryx = MOBJ_x(mo) + xmove
            ptryy = MOBJ_y(mo) + ymove
            xmove = 0
            ymove = 0
        }

        if P_TryMove(mo, ptryx, ptryy) == 0 {
            if (MOBJ_player(mo) as i64) != 0 {
                P_SlideMove(mo)
            } elif (MOBJ_flags(mo) & MOBJ_MF_MISSILE) != 0 {
                let cl: ptr<void> = MAP_ceilingline()
                if (cl as i64) != 0 {
                    let back: ptr<void> = GEOM_line_backsector(cl)
                    if (back as i64) != 0 and GEOM_sector_ceilingpic(back) == SKY_skyflatnum() {
                        P_RemoveMobj(mo)
                        return
                    }
                }
                P_ExplodeMissile(mo)
            } else {
                MOBJ_set_momx(mo, 0)
                MOBJ_set_momy(mo, 0)
            }
        }

        if xmove == 0 and ymove == 0 {
            break
        }
    }

    if (player as i64) != 0 and (PLAYER_cheats(player) & MOBJ_CF_NOMOMENTUM) != 0 {
        MOBJ_set_momx(mo, 0)
        MOBJ_set_momy(mo, 0)
        return
    }

    if (MOBJ_flags(mo) & (MOBJ_MF_MISSILE | MOBJ_MF_SKULLFLY)) != 0 {
        return
    }

    if MOBJ_z(mo) > MOBJ_floorz(mo) {
        return
    }

    if (MOBJ_flags(mo) & MOBJ_MF_CORPSE) != 0 {
        if MOBJ_momx(mo) > MOBJ_FRACUNIT / 4
            or MOBJ_momx(mo) < 0 - MOBJ_FRACUNIT / 4
            or MOBJ_momy(mo) > MOBJ_FRACUNIT / 4
            or MOBJ_momy(mo) < 0 - MOBJ_FRACUNIT / 4 {
            let ss: ptr<void> = MOBJ_subsector(mo)
            let sec: ptr<void> = GEOM_subsector_sector(ss)
            if MOBJ_floorz(mo) != GEOM_sector_floorheight(sec) {
                return
            }
        }
    }

    if MOBJ_momx(mo) > 0 - MOBJ_STOPSPEED
        and MOBJ_momx(mo) < MOBJ_STOPSPEED
        and MOBJ_momy(mo) > 0 - MOBJ_STOPSPEED
        and MOBJ_momy(mo) < MOBJ_STOPSPEED
        and ((player as i64) == 0
            or (PLAYER_cmd_forwardmove(player) == 0 and PLAYER_cmd_sidemove(player) == 0)) {
        if (player as i64) != 0 {
            let pmo: ptr<void> = PLAYER_mo(player)
            let st_off: i32 = STATE_index(MOBJ_state(pmo)) - MOBJ_S_PLAY_RUN1
            if (st_off as u32) < 4 as u32 {
                P_SetMobjState(pmo, MOBJ_S_PLAY)
            }
        }
        MOBJ_set_momx(mo, 0)
        MOBJ_set_momy(mo, 0)
    } else {
        MOBJ_set_momx(mo, FixedMul(MOBJ_momx(mo), MOBJ_FRICTION))
        MOBJ_set_momy(mo, FixedMul(MOBJ_momy(mo), MOBJ_FRICTION))
    }
}

# ---- P_ZMovement ------------------------------------------------------

function P_ZMovement(mo: ptr<void>) -> void {
    let player: ptr<void> = MOBJ_player(mo)

    if (player as i64) != 0 and MOBJ_z(mo) < MOBJ_floorz(mo) {
        PLAYER_set_viewheight(
            player,
            PLAYER_viewheight(player) - (MOBJ_floorz(mo) - MOBJ_z(mo)))
        PLAYER_set_deltaviewheight(
            player,
            (MOBJ_VIEWHEIGHT - PLAYER_viewheight(player)) >> 3)
    }

    MOBJ_set_z(mo, MOBJ_z(mo) + MOBJ_momz(mo))

    if (MOBJ_flags(mo) & MOBJ_MF_FLOAT) != 0 and (MOBJ_target(mo) as i64) != 0 {
        if (MOBJ_flags(mo) & MOBJ_MF_SKULLFLY) == 0
            and (MOBJ_flags(mo) & MOBJ_MF_INFLOAT) == 0 {
            let tgt: ptr<void> = MOBJ_target(mo)
            let dist: i32 = P_AproxDistance(
                MOBJ_x(mo) - MOBJ_x(tgt),
                MOBJ_y(mo) - MOBJ_y(tgt))
            let delta: i32 = (MOBJ_z(tgt) + (MOBJ_height(mo) >> 1)) - MOBJ_z(mo)
            if delta < 0 and dist < 0 - (delta * 3) {
                MOBJ_set_z(mo, MOBJ_z(mo) - MOBJ_FLOATSPEED)
            } elif delta > 0 and dist < (delta * 3) {
                MOBJ_set_z(mo, MOBJ_z(mo) + MOBJ_FLOATSPEED)
            }
        }
    }

    if MOBJ_z(mo) <= MOBJ_floorz(mo) {
        let correct_lost_soul_bounce: i32 = 0
        if STAT_gameversion() >= MOBJ_EXE_ULTIMATE {
            correct_lost_soul_bounce = 1
        }

        if correct_lost_soul_bounce != 0 and (MOBJ_flags(mo) & MOBJ_MF_SKULLFLY) != 0 {
            MOBJ_set_momz(mo, 0 - MOBJ_momz(mo))
        }

        if MOBJ_momz(mo) < 0 {
            if (player as i64) != 0 and MOBJ_momz(mo) < 0 - MOBJ_GRAVITY * 8 {
                PLAYER_set_deltaviewheight(player, MOBJ_momz(mo) >> 3)
                S_StartSound(mo, MOBJ_SFX_OOF)
            }
            MOBJ_set_momz(mo, 0)
        }
        MOBJ_set_z(mo, MOBJ_floorz(mo))

        if correct_lost_soul_bounce == 0 and (MOBJ_flags(mo) & MOBJ_MF_SKULLFLY) != 0 {
            MOBJ_set_momz(mo, 0 - MOBJ_momz(mo))
        }

        if (MOBJ_flags(mo) & MOBJ_MF_MISSILE) != 0
            and (MOBJ_flags(mo) & MOBJ_MF_NOCLIP) == 0 {
            P_ExplodeMissile(mo)
            return
        }
    } elif (MOBJ_flags(mo) & MOBJ_MF_NOGRAVITY) == 0 {
        if MOBJ_momz(mo) == 0 {
            MOBJ_set_momz(mo, 0 - MOBJ_GRAVITY * 2)
        } else {
            MOBJ_set_momz(mo, MOBJ_momz(mo) - MOBJ_GRAVITY)
        }
    }

    if MOBJ_z(mo) + MOBJ_height(mo) > MOBJ_ceilingz(mo) {
        if MOBJ_momz(mo) > 0 {
            MOBJ_set_momz(mo, 0)
        }
        MOBJ_set_z(mo, MOBJ_ceilingz(mo) - MOBJ_height(mo))

        if (MOBJ_flags(mo) & MOBJ_MF_SKULLFLY) != 0 {
            MOBJ_set_momz(mo, 0 - MOBJ_momz(mo))
        }

        if (MOBJ_flags(mo) & MOBJ_MF_MISSILE) != 0
            and (MOBJ_flags(mo) & MOBJ_MF_NOCLIP) == 0 {
            P_ExplodeMissile(mo)
            return
        }
    }
}

# ---- P_NightmareRespawn -----------------------------------------------

function P_NightmareRespawn(mobj: ptr<void>) -> void {
    let sp: ptr<void> = mobj_spawnpoint(mobj)
    let x: i32 = MTHING_x(sp) << MOBJ_FRACBITS
    let y: i32 = MTHING_y(sp) << MOBJ_FRACBITS

    if P_CheckPosition(mobj, x, y) == 0 {
        return
    }

    let ss0: ptr<void> = MOBJ_subsector(mobj)
    let sec0: ptr<void> = GEOM_subsector_sector(ss0)
    let mut mo: ptr<void> = P_SpawnMobj(
        MOBJ_x(mobj),
        MOBJ_y(mobj),
        GEOM_sector_floorheight(sec0),
        MOBJ_MT_TFOG)
    S_StartSound(mo, MOBJ_SFX_TELEPT)

    let ss: ptr<void> = R_PointInSubsector(x, y)
    mo = P_SpawnMobj(x, y, GEOM_sector_floorheight(GEOM_subsector_sector(ss)), MOBJ_MT_TFOG)
    S_StartSound(mo, MOBJ_SFX_TELEPT)

    let mut z: i32 = MOBJ_ONFLOORZ
    if (MOBJ_info_flags(mobj) & MOBJ_MF_SPAWNCEILING) != 0 {
        z = MOBJ_ONCEILINGZ
    }

    mo = P_SpawnMobj(x, y, z, MOBJ_type(mobj))
    mobj_copy_mthing(mobj_spawnpoint(mo), mobj_spawnpoint(mobj))
    MOBJ_set_angle(mo, mobj_angle_from_thing(sp))
    if (MTHING_options(sp) & MOBJ_MTF_AMBUSH) != 0 {
        MOBJ_set_flags(mo, MOBJ_flags(mo) | MOBJ_MF_AMBUSH)
    }
    MOBJ_set_reactiontime(mo, 18)
    P_RemoveMobj(mobj)
}

# ---- P_MobjThinker ----------------------------------------------------

@flow_api
function P_MobjThinker(mobj: ptr<void>) -> void {
    if MOBJ_momx(mobj) != 0
        or MOBJ_momy(mobj) != 0
        or (MOBJ_flags(mobj) & MOBJ_MF_SKULLFLY) != 0 {
        P_XYMovement(mobj)
        if THINKER_is_removed(mobj) != 0 {
            return
        }
    }

    if MOBJ_z(mobj) != MOBJ_floorz(mobj) or MOBJ_momz(mobj) != 0 {
        P_ZMovement(mobj)
        if THINKER_is_removed(mobj) != 0 {
            return
        }
    }

    if MOBJ_tics(mobj) != 0 - 1 {
        MOBJ_set_tics(mobj, MOBJ_tics(mobj) - 1)
        if MOBJ_tics(mobj) == 0 {
            if P_SetMobjState(mobj, STATE_nextstate(MOBJ_state(mobj))) == 0 {
                return
            }
        }
    } else {
        if (MOBJ_flags(mobj) & MOBJ_MF_COUNTKILL) == 0 {
            return
        }
        if STAT_respawnmonsters() == 0 {
            return
        }
        MOBJ_set_movecount(mobj, MOBJ_movecount(mobj) + 1)
        if MOBJ_movecount(mobj) < 12 * MOBJ_TICRATE {
            return
        }
        if (STAT_leveltime() & 31) != 0 {
            return
        }
        if P_Random() > 4 {
            return
        }
        P_NightmareRespawn(mobj)
    }
}

# ---- P_SpawnMobj ------------------------------------------------------

@flow_api
function P_SpawnMobj(x: i32, y: i32, z: i32, typ: i32) -> ptr<void> {
    let mobj: ptr<void> = Z_Malloc(MOBJ_SIZEOF_MOBJ, MOBJ_PU_LEVEL, null)
    memset(mobj, 0, MOBJ_SIZEOF_MOBJ as i64)

    MOBJ_set_type(mobj, typ)
    mobj_set_info(mobj, typ)
    MOBJ_set_x(mobj, x)
    MOBJ_set_y(mobj, y)
    MOBJ_set_radius(mobj, MOBJINFO_radius(typ))
    MOBJ_set_height(mobj, MOBJINFO_height(typ))
    MOBJ_set_flags(mobj, MOBJINFO_flags(typ))
    MOBJ_set_health(mobj, MOBJINFO_spawnhealth(typ))

    if STAT_gameskill() != MOBJ_SK_NIGHTMARE {
        MOBJ_set_reactiontime(mobj, MOBJINFO_reactiontime(typ))
    }

    MOBJ_set_lastlook(mobj, P_Random() % MOBJ_MAXPLAYERS)

    let st: ptr<void> = STATE_at(MOBJINFO_spawnstate(typ))
    MOBJ_set_state(mobj, st)
    MOBJ_set_tics(mobj, STATE_tics(st))
    MOBJ_set_sprite(mobj, STATE_sprite(st))
    MOBJ_set_frame(mobj, STATE_frame(st))

    P_SetThingPosition(mobj)

    let ss: ptr<void> = MOBJ_subsector(mobj)
    let sec: ptr<void> = GEOM_subsector_sector(ss)
    MOBJ_set_floorz(mobj, GEOM_sector_floorheight(sec))
    MOBJ_set_ceilingz(mobj, GEOM_sector_ceilingheight(sec))

    if z == MOBJ_ONFLOORZ {
        MOBJ_set_z(mobj, MOBJ_floorz(mobj))
    } elif z == MOBJ_ONCEILINGZ {
        MOBJ_set_z(mobj, MOBJ_ceilingz(mobj) - MOBJ_info_height(mobj))
    } else {
        MOBJ_set_z(mobj, z)
    }

    THINKER_set_mobj(mobj)
    P_AddThinker(mobj)
    return mobj
}

# ---- P_RemoveMobj -----------------------------------------------------

# Was mobjshim_que_store_spawnpoint (mobj_shim.c): stores the mobj's
# spawnpoint into the item-respawn queue and bumps iquehead/iquetail.
function mobj_que_store_spawnpoint(m: ptr<void>) -> void {
    let head: i32 = mobjshim_iquehead()
    mobj_copy_mthing(mobj_itemrespawnque_at(head), mobj_spawnpoint(m))
    mobj_itemrespawntime[head] = STAT_leveltime()
    let new_head: i32 = (head + 1) & (MOBJ_ITEMQUESIZE - 1)
    mobjshim_set_iquehead(new_head)
    if new_head == mobjshim_iquetail() {
        mobjshim_set_iquetail((mobjshim_iquetail() + 1) & (MOBJ_ITEMQUESIZE - 1))
    }
}

@flow_api
function P_RemoveMobj(mobj: ptr<void>) -> void {
    let flags: i32 = MOBJ_flags(mobj)
    let typ: i32 = MOBJ_type(mobj)
    if (flags & MOBJ_MF_SPECIAL) != 0
        and (flags & MOBJ_MF_DROPPED) == 0
        and typ != MOBJ_MT_INV
        and typ != MOBJ_MT_INS {
        mobj_que_store_spawnpoint(mobj)
    }

    P_UnsetThingPosition(mobj)
    S_StopSound(mobj)
    P_RemoveThinker(mobj)
}

# ---- P_RespawnSpecials ------------------------------------------------

@flow_api
function P_RespawnSpecials() -> void {
    if STAT_deathmatch() != 2 {
        return
    }
    if mobjshim_iquehead() == mobjshim_iquetail() {
        return
    }
    let tail: i32 = mobjshim_iquetail()
    mobj_ensure_respawn_storage()
    if STAT_leveltime() - mobj_itemrespawntime[tail] < 30 * MOBJ_TICRATE {
        return
    }

    let mthing: ptr<void> = mobj_itemrespawnque_at(tail)
    let x: i32 = MTHING_x(mthing) << MOBJ_FRACBITS
    let y: i32 = MTHING_y(mthing) << MOBJ_FRACBITS

    let ss: ptr<void> = R_PointInSubsector(x, y)
    let mo_fog: ptr<void> = P_SpawnMobj(
        x, y, GEOM_sector_floorheight(GEOM_subsector_sector(ss)), MOBJ_MT_IFOG)
    S_StartSound(mo_fog, MOBJ_SFX_ITMBK)

    let mut i: i32 = 0
    while i < MOBJ_NUMMOBJTYPES {
        if MTHING_type(mthing) == MOBJINFO_doomednum(i) {
            break
        }
        i = i + 1
    }

    let mut z: i32 = MOBJ_ONFLOORZ
    if (MOBJINFO_flags(i) & MOBJ_MF_SPAWNCEILING) != 0 {
        z = MOBJ_ONCEILINGZ
    }

    let mo: ptr<void> = P_SpawnMobj(x, y, z, i)
    mobj_copy_mthing(mobj_spawnpoint(mo), mthing)
    MOBJ_set_angle(mo, mobj_angle_from_thing(mthing))
    mobjshim_set_iquetail((tail + 1) & (MOBJ_ITEMQUESIZE - 1))
}

# ---- P_SpawnPlayer ----------------------------------------------------

@flow_api
function P_SpawnPlayer(mthing: ptr<void>) -> void {
    let mtype: i32 = MTHING_type(mthing)
    if mtype == 0 {
        return
    }
    if STAT_playeringame(mtype - 1) == 0 {
        return
    }

    let p: ptr<void> = PLAYER_at(mtype - 1)
    if PLAYER_playerstate(p) == MOBJ_PST_REBORN {
        G_PlayerReborn(mtype - 1)
    }

    let x: i32 = MTHING_x(mthing) << MOBJ_FRACBITS
    let y: i32 = MTHING_y(mthing) << MOBJ_FRACBITS
    let mobj: ptr<void> = P_SpawnMobj(x, y, MOBJ_ONFLOORZ, MOBJ_MT_PLAYER)

    if mtype > 1 {
        MOBJ_set_flags(
            mobj,
            MOBJ_flags(mobj) | ((mtype - 1) << MOBJ_MF_TRANSSHIFT))
    }

    MOBJ_set_angle(mobj, mobj_angle_from_thing(mthing))
    MOBJ_set_player(mobj, p)
    MOBJ_set_health(mobj, PLAYER_health(p))

    PLAYER_set_mo(p, mobj)
    PLAYER_set_playerstate(p, MOBJ_PST_LIVE)
    PLAYER_set_refire(p, 0)
    PLAYER_set_message(p, null)
    PLAYER_set_damagecount(p, 0)
    PLAYER_set_bonuscount(p, 0)
    PLAYER_set_extralight(p, 0)
    PLAYER_set_fixedcolormap(p, 0)
    PLAYER_set_viewheight(p, MOBJ_VIEWHEIGHT)

    P_SetupPsprites(p)

    if STAT_deathmatch() != 0 {
        for i in 0 to MOBJ_NUMCARDS {
            PLAYER_set_card(p, i, 1)
        }
    }

    if mtype - 1 == STAT_consoleplayer() {
        ST_Start()
        HU_Start()
    }
}

# ---- P_SpawnMapThing --------------------------------------------------

@flow_api
function P_SpawnMapThing(mthing: ptr<void>) -> void {
    let mtype: i32 = MTHING_type(mthing)

    if mtype == 11 {
        if setupshim_deathmatch_p_room() != 0 {
            setupshim_store_deathmatch_start(mthing)
        }
        return
    }

    if mtype <= 0 {
        return
    }

    if mtype <= 4 {
        setupshim_store_playerstart(mtype - 1, mthing)
        if STAT_deathmatch() == 0 {
            P_SpawnPlayer(mthing)
        }
        return
    }

    if STAT_netgame() == 0 and (MTHING_options(mthing) & 16) != 0 {
        return
    }

    let mut bit: i32 = 0
    if STAT_gameskill() == MOBJ_SK_BABY {
        bit = 1
    } elif STAT_gameskill() == MOBJ_SK_NIGHTMARE {
        bit = 4
    } else {
        bit = 1 << (STAT_gameskill() - 1)
    }

    if (MTHING_options(mthing) & bit) == 0 {
        return
    }

    let mut i: i32 = 0
    while i < MOBJ_NUMMOBJTYPES {
        if mtype == MOBJINFO_doomednum(i) {
            break
        }
        i = i + 1
    }

    if i == MOBJ_NUMMOBJTYPES {
        mobjshim_error_unknown_type(mtype, MTHING_x(mthing), MTHING_y(mthing))
    }

    if STAT_deathmatch() != 0 and (MOBJINFO_flags(i) & MOBJ_MF_NOTDMATCH) != 0 {
        return
    }

    if STAT_nomonsters() != 0
        and (i == MOBJ_MT_SKULL or (MOBJINFO_flags(i) & MOBJ_MF_COUNTKILL) != 0) {
        return
    }

    let x: i32 = MTHING_x(mthing) << MOBJ_FRACBITS
    let y: i32 = MTHING_y(mthing) << MOBJ_FRACBITS
    let mut z: i32 = MOBJ_ONFLOORZ
    if (MOBJINFO_flags(i) & MOBJ_MF_SPAWNCEILING) != 0 {
        z = MOBJ_ONCEILINGZ
    }

    let mobj: ptr<void> = P_SpawnMobj(x, y, z, i)
    mobj_copy_mthing(mobj_spawnpoint(mobj), mthing)

    if MOBJ_tics(mobj) > 0 {
        MOBJ_set_tics(mobj, 1 + (P_Random() % MOBJ_tics(mobj)))
    }
    if (MOBJ_flags(mobj) & MOBJ_MF_COUNTKILL) != 0 {
        STAT_inc_totalkills()
    }
    if (MOBJ_flags(mobj) & MOBJ_MF_COUNTITEM) != 0 {
        STAT_inc_totalitems()
    }

    MOBJ_set_angle(mobj, mobj_angle_from_thing(mthing))
    if (MTHING_options(mthing) & MOBJ_MTF_AMBUSH) != 0 {
        MOBJ_set_flags(mobj, MOBJ_flags(mobj) | MOBJ_MF_AMBUSH)
    }
}

# ---- P_SpawnPuff ------------------------------------------------------

@flow_api
function P_SpawnPuff(x: i32, y: i32, z_in: i32) -> void {
    let mut z: i32 = z_in + ((P_Random() - P_Random()) << 10)
    let th: ptr<void> = P_SpawnMobj(x, y, z, MOBJ_MT_PUFF)
    MOBJ_set_momz(th, MOBJ_FRACUNIT)
    MOBJ_set_tics(th, MOBJ_tics(th) - (P_Random() & 3))
    if MOBJ_tics(th) < 1 {
        MOBJ_set_tics(th, 1)
    }
    if MAP_attackrange() == MOBJ_MELEERANGE {
        P_SetMobjState(th, MOBJ_S_PUFF3)
    }
}

# ---- P_SpawnBlood -----------------------------------------------------

@flow_api
function P_SpawnBlood(x: i32, y: i32, z_in: i32, damage: i32) -> void {
    let mut z: i32 = z_in + ((P_Random() - P_Random()) << 10)
    let th: ptr<void> = P_SpawnMobj(x, y, z, MOBJ_MT_BLOOD)
    MOBJ_set_momz(th, MOBJ_FRACUNIT * 2)
    MOBJ_set_tics(th, MOBJ_tics(th) - (P_Random() & 3))
    if MOBJ_tics(th) < 1 {
        MOBJ_set_tics(th, 1)
    }
    if damage <= 12 and damage >= 9 {
        P_SetMobjState(th, MOBJ_S_BLOOD2)
    } elif damage < 9 {
        P_SetMobjState(th, MOBJ_S_BLOOD3)
    }
}

# ---- P_CheckMissileSpawn ----------------------------------------------

function P_CheckMissileSpawn(th: ptr<void>) -> void {
    MOBJ_set_tics(th, MOBJ_tics(th) - (P_Random() & 3))
    if MOBJ_tics(th) < 1 {
        MOBJ_set_tics(th, 1)
    }
    MOBJ_set_x(th, MOBJ_x(th) + (MOBJ_momx(th) >> 1))
    MOBJ_set_y(th, MOBJ_y(th) + (MOBJ_momy(th) >> 1))
    MOBJ_set_z(th, MOBJ_z(th) + (MOBJ_momz(th) >> 1))
    if P_TryMove(th, MOBJ_x(th), MOBJ_y(th)) == 0 {
        P_ExplodeMissile(th)
    }
}

# ---- P_SubstNullMobj --------------------------------------------------

@flow_api
function P_SubstNullMobj(mobj: ptr<void>) -> ptr<void> {
    return mobjshim_subst_null(mobj)
}

# ---- P_SpawnMissile ---------------------------------------------------

@flow_api
function P_SpawnMissile(source: ptr<void>, dest: ptr<void>, typ: i32) -> ptr<void> {
    let th: ptr<void> = P_SpawnMobj(
        MOBJ_x(source),
        MOBJ_y(source),
        MOBJ_z(source) + 4 * 8 * MOBJ_FRACUNIT,
        typ)

    if MOBJ_info_seesound(th) != 0 {
        S_StartSound(th, MOBJ_info_seesound(th))
    }

    MOBJ_set_target(th, source)
    let mut an: u32 = R_PointToAngle2(
        MOBJ_x(source), MOBJ_y(source),
        MOBJ_x(dest), MOBJ_y(dest))

    if (MOBJ_flags(dest) & MOBJ_MF_SHADOW) != 0 {
        an = an + (((P_Random() - P_Random()) << 20) as u32)
    }

    MOBJ_set_angle(th, an)
    let an_fine: u32 = an >> MOBJ_ANGLETOFINESHIFT
    let speed: i32 = MOBJ_info_speed(th)
    MOBJ_set_momx(th, FixedMul(speed, TABLES_finecosine(an_fine as i32)))
    MOBJ_set_momy(th, FixedMul(speed, TABLES_finesine(an_fine as i32)))

    let mut dist: i32 = P_AproxDistance(
        MOBJ_x(dest) - MOBJ_x(source),
        MOBJ_y(dest) - MOBJ_y(source))
    dist = dist / speed
    if dist < 1 {
        dist = 1
    }
    MOBJ_set_momz(th, (MOBJ_z(dest) - MOBJ_z(source)) / dist)
    P_CheckMissileSpawn(th)
    return th
}

# ---- P_SpawnPlayerMissile ---------------------------------------------

@flow_api
function P_SpawnPlayerMissile(source: ptr<void>, typ: i32) -> void {
    let mut an: u32 = MOBJ_angle(source)
    let mut slope: i32 = P_AimLineAttack(source, an, 16 * 64 * MOBJ_FRACUNIT)

    if (MAP_linetarget() as i64) == 0 {
        an = an + ((1 << 26) as u32)
        slope = P_AimLineAttack(source, an, 16 * 64 * MOBJ_FRACUNIT)
        if (MAP_linetarget() as i64) == 0 {
            an = an - ((2 << 26) as u32)
            slope = P_AimLineAttack(source, an, 16 * 64 * MOBJ_FRACUNIT)
        }
        if (MAP_linetarget() as i64) == 0 {
            an = MOBJ_angle(source)
            slope = 0
        }
    }

    let x: i32 = MOBJ_x(source)
    let y: i32 = MOBJ_y(source)
    let z: i32 = MOBJ_z(source) + 4 * 8 * MOBJ_FRACUNIT
    let th: ptr<void> = P_SpawnMobj(x, y, z, typ)

    if MOBJ_info_seesound(th) != 0 {
        S_StartSound(th, MOBJ_info_seesound(th))
    }

    MOBJ_set_target(th, source)
    MOBJ_set_angle(th, an)
    let speed: i32 = MOBJ_info_speed(th)
    let an_fine: u32 = an >> MOBJ_ANGLETOFINESHIFT
    MOBJ_set_momx(th, FixedMul(speed, TABLES_finecosine(an_fine as i32)))
    MOBJ_set_momy(th, FixedMul(speed, TABLES_finesine(an_fine as i32)))
    MOBJ_set_momz(th, FixedMul(speed, slope))
    P_CheckMissileSpawn(th)
}
