# Moving objects / spawn, ported from p_mobj.c to Flow.
#
# mobj_t / mapthing_t / state_t / mobjinfo_t / player_t stay C-owned
# (their storage is malloc'd/static in C), but mobj_t / mapthing_t /
# mobjinfo_t FIELD access happens directly from Flow via explicit LP64
# offsetof arithmetic (MOBJ_OFF_* / MOBJ_MTOFF_* / MOBJ_INFOOFF_* and the
# mobj_i32/mobj_ptr/... helpers below), mirroring setup.flow's
# GEOM_OFF_* / geom_i32 pattern. mapthing_t is exposed as shared MTHING_*.
# Size constants (MOBJ_SIZEOF / MOBJ_SIZEOF_MAPTHING) are the Flow source
# of truth; doom_layout.h mirrors them for the thin C shim.
#
# P_SubstNullMobj dummy sentinel is Flow-owned below. iquehead/iquetail
# are Flow-owned (setup.flow resets via mobjshim_set_*).
# itemrespawnque/itemrespawntime are Flow-owned (calloc'd) below.
#
# LP64 offsetof (verified against doomgeneric headers):
#
#   mobj_t (sizeof 224)
#     thinker 0, x 24, y 28, z 32, snext 40, sprev 48, angle 56,
#     sprite 60, frame 64, bnext 72, bprev 80, subsector 88,
#     floorz 96, ceilingz 100, radius 104, height 108,
#     momx 112, momy 116, momz 120, validcount 124, type 128, info 136,
#     tics 144, state 152, flags 160, health 164, movedir 168,
#     movecount 172, target 176, reactiontime 184, threshold 188,
#     player 192, lastlook 200, spawnpoint 204, tracer 216
#
#   mapthing_t (sizeof 10): x 0, y 2, angle 4, type 6, options 8
#
#   mobjinfo_t (sizeof 92): doomednum 0, spawnstate 4, spawnhealth 8,
#     seestate 12, seesound 16, reactiontime 20, attacksound 24,
#     painstate 28, painchance 32, painsound 36, meleestate 40,
#     missilestate 44, deathstate 48, xdeathstate 52, deathsound 56,
#     speed 60, radius 64, height 68, mass 72, damage 76, activesound 80,
#     flags 84, raisestate 88

