# ---- P_SubstNullMobj dummy sentinel ------------------------------------

let mut mobj_dummy_sentinel: ptr<void> = null

function mobjshim_subst_null(m: ptr<void>) -> ptr<void> {
    if (m as i64) != 0 {
        return m
    }
    if (mobj_dummy_sentinel as i64) == 0 {
        mobj_dummy_sentinel = calloc(1, MOBJ_SIZEOF as i64)
    }
    memset(mobj_dummy_sentinel, 0, MOBJ_SIZEOF as i64)
    MOBJ_set_x(mobj_dummy_sentinel, 0)
    MOBJ_set_y(mobj_dummy_sentinel, 0)
    MOBJ_set_z(mobj_dummy_sentinel, 0)
    MOBJ_set_flags(mobj_dummy_sentinel, 0)
    return mobj_dummy_sentinel
}

