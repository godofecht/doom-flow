# ---- offset helpers (mirrors setup.flow's geom_i32/geom_ptr) ----------

function mobj_i16(base: i64, off: i32) -> i32 {
    let p: ptr<i16> = (base + off as i64) as ptr<i16>
    return p[0] as i32
}

function mobj_set_i16(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i16> = (base + off as i64) as ptr<i16>
    p[0] = v as i16
}

function mobj_i32(base: i64, off: i32) -> i32 {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    return p[0]
}

function mobj_set_i32(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    p[0] = v
}

function mobj_u32(base: i64, off: i32) -> u32 {
    let p: ptr<u32> = (base + off as i64) as ptr<u32>
    return p[0]
}

function mobj_set_u32(base: i64, off: i32, v: u32) -> void {
    let p: ptr<u32> = (base + off as i64) as ptr<u32>
    p[0] = v
}

function mobj_ptr(base: i64, off: i32) -> ptr<void> {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    return p[0] as ptr<void>
}

function mobj_set_ptr(base: i64, off: i32, v: ptr<void>) -> void {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    p[0] = v as i64
}

# ---- item-respawn queue (Flow-owned; only Flow ever touched these) ---
# iquehead/iquetail are Flow-owned above; setup.flow resets them via
# mobjshim_set_iquehead/iquetail.

let mut mobj_itemrespawnque: ptr<i16> = null
let mut mobj_itemrespawntime: ptr<i32> = null

function mobj_ensure_respawn_storage() -> void {
    if (mobj_itemrespawnque as i64) == 0 {
        mobj_itemrespawnque = calloc((MOBJ_ITEMQUESIZE * 5) as i64, 2) as ptr<i16>
        mobj_itemrespawntime = calloc(MOBJ_ITEMQUESIZE as i64, 4) as ptr<i32>
    }
}

# &mobj_itemrespawnque[i*5]: each queue slot is 5 packed i16 fields
# (x,y,angle,type,options), matching mapthing_t's layout exactly.
function mobj_itemrespawnque_at(i: i32) -> ptr<void> {
    mobj_ensure_respawn_storage()
    return (&mobj_itemrespawnque[i * 5]) as ptr<void>
}

# ---- private helpers --------------------------------------------------

function mobj_clear_flag(flags: i32, bit: i32) -> i32 {
    return flags & ((0 - 1) - bit)
}

function mobj_info_ptr(m: ptr<void>) -> ptr<void> {
    return mobj_ptr(m as i64, MOBJ_OFF_INFO)
}

function mobj_set_info(m: ptr<void>, typ: i32) -> void {
    mobj_set_ptr(m as i64, MOBJ_OFF_INFO, INFO_mobjinfo_at(typ))
}

function mobj_spawnpoint(m: ptr<void>) -> ptr<void> {
    return ((m as i64) + MOBJ_OFF_SPAWNPOINT as i64) as ptr<void>
}

# Generic mapthing_t -> mapthing_t copy (mobj<->mobj spawnpoint, and
# mobj spawnpoint <-> item-respawn queue slot).
function mobj_copy_mthing(dst: ptr<void>, src: ptr<void>) -> void {
    MTHING_set_x(dst, MTHING_x(src))
    MTHING_set_y(dst, MTHING_y(src))
    MTHING_set_angle(dst, MTHING_angle(src))
    MTHING_set_type(dst, MTHING_type(src))
    MTHING_set_options(dst, MTHING_options(src))
}

# Shared mapthing_t field accessors. Prefer these over *shim_mthing_* clones.

@flow_api
function MTHING_x(mt: ptr<void>) -> i32 { return mobj_i16(mt as i64, MOBJ_MTOFF_X) }
@flow_api
function MTHING_y(mt: ptr<void>) -> i32 { return mobj_i16(mt as i64, MOBJ_MTOFF_Y) }
@flow_api
function MTHING_angle(mt: ptr<void>) -> i32 { return mobj_i16(mt as i64, MOBJ_MTOFF_ANGLE) }
@flow_api
function MTHING_type(mt: ptr<void>) -> i32 { return mobj_i16(mt as i64, MOBJ_MTOFF_TYPE) }
@flow_api
function MTHING_options(mt: ptr<void>) -> i32 { return mobj_i16(mt as i64, MOBJ_MTOFF_OPTIONS) }
@flow_api
function MTHING_set_x(mt: ptr<void>, v: i32) -> void { mobj_set_i16(mt as i64, MOBJ_MTOFF_X, v) }
@flow_api
function MTHING_set_y(mt: ptr<void>, v: i32) -> void { mobj_set_i16(mt as i64, MOBJ_MTOFF_Y, v) }
@flow_api
function MTHING_set_angle(mt: ptr<void>, v: i32) -> void { mobj_set_i16(mt as i64, MOBJ_MTOFF_ANGLE, v) }
@flow_api
function MTHING_set_type(mt: ptr<void>, v: i32) -> void { mobj_set_i16(mt as i64, MOBJ_MTOFF_TYPE, v) }
@flow_api
function MTHING_set_options(mt: ptr<void>, v: i32) -> void { mobj_set_i16(mt as i64, MOBJ_MTOFF_OPTIONS, v) }

function mobj_angle_from_thing(mt: ptr<void>) -> u32 {
    return MOBJ_ANG45 * ((MTHING_angle(mt) / 45) as u32)
}

# Shared mobj_t field accessors. Prefer these over per-module *shim_mobj_* clones.

@flow_api
function MOBJ_x(m: ptr<void>) -> i32 { return mobj_i32(m as i64, MOBJ_OFF_X) }
@flow_api
function MOBJ_set_x(m: ptr<void>, v: i32) -> void { mobj_set_i32(m as i64, MOBJ_OFF_X, v) }
@flow_api
function MOBJ_y(m: ptr<void>) -> i32 { return mobj_i32(m as i64, MOBJ_OFF_Y) }
@flow_api
function MOBJ_set_y(m: ptr<void>, v: i32) -> void { mobj_set_i32(m as i64, MOBJ_OFF_Y, v) }
@flow_api
function MOBJ_z(m: ptr<void>) -> i32 { return mobj_i32(m as i64, MOBJ_OFF_Z) }
@flow_api
