#
# setup.flow's P_SetupLevel resets them via mobjshim_set_iquehead/tail.

let mut mobj_iquehead: i32 = 0
let mut mobj_iquetail: i32 = 0

@flow_api
function mobjshim_iquehead() -> i32 { return mobj_iquehead }

@flow_api
function mobjshim_set_iquehead(v: i32) -> void { mobj_iquehead = v }

@flow_api
function mobjshim_iquetail() -> i32 { return mobj_iquetail }

@flow_api
function mobjshim_set_iquetail(v: i32) -> void { mobj_iquetail = v }

