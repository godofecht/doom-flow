# Q-DOOM Watch — train a Flow RL agent, then play episodes on a canvas.
#
# Same arena / Q-learning as doom-flow-rl/q_doom.flow, but presents the
# greedy policy live through stdlib/gfx so the GitHub Pages "Watch AI"
# mode can show an agent clearing the room after training.
#
# Build: FLOW_DIR=../flow ./scripts/build_wasm.sh --ai-only

import "stdlib/ai.flow"
import "stdlib/gfx.flow"

const GRID: i32 = 12
const CELL: i32 = 28
const PAD: i32 = 16
const N_ACTIONS: i32 = 4
const ACT_LEFT: i32 = 0
const ACT_RIGHT: i32 = 1
const ACT_FORWARD: i32 = 2
const ACT_FIRE: i32 = 3
const STEP_CAP: i32 = 200
const PLAYER_HP: i32 = 3
const IMP_HP: i32 = 2
const TRAIN_EPS: i32 = 2500

function dx_of(face: i32) -> i32 {
    if face == 1 { return 1 }
    if face == 3 { return 0 - 1 }
    return 0
}

function dy_of(face: i32) -> i32 {
    if face == 0 { return 0 - 1 }
    if face == 2 { return 1 }
    return 0
}

function turn_left(face: i32) -> i32 { return (face + 3) % 4 }
function turn_right(face: i32) -> i32 { return (face + 1) % 4 }

function abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

function in_bounds(x: i32, y: i32) -> bool {
    return x >= 1 and x < GRID - 1 and y >= 1 and y < GRID - 1
}

function env_rng_next(seed: u32) -> u32 {
    return seed * 1664525 + 1013904223
}

function clear_los(px: i32, py: i32, ex: i32, ey: i32) -> bool {
    if px != ex and py != ey { return false }
    if px == ex {
        let mut y0: i32 = py
        let mut y1: i32 = ey
        if y0 > y1 { let t: i32 = y0; y0 = y1; y1 = t }
        let mut y: i32 = y0 + 1
        while y < y1 {
            if !in_bounds(px, y) { return false }
            y = y + 1
        }
        return true
    }
    let mut x0: i32 = px
    let mut x1: i32 = ex
    if x0 > x1 { let t: i32 = x0; x0 = x1; x1 = t }
    let mut x: i32 = x0 + 1
    while x < x1 {
        if !in_bounds(x, py) { return false }
        x = x + 1
    }
    return true
}

function facing_enemy(face: i32, px: i32, py: i32, ex: i32, ey: i32) -> bool {
    let dx: i32 = dx_of(face)
    let dy: i32 = dy_of(face)
    if dx != 0 {
        if py != ey { return false }
        if dx > 0 { return ex > px }
        return ex < px
    }
    if px != ex { return false }
    if dy > 0 { return ey > py }
    return ey < py
}

function on_left(face: i32, px: i32, py: i32, ex: i32, ey: i32) -> bool {
    let rx: i32 = ex - px
    let ry: i32 = ey - py
    return dx_of(face) * ry - dy_of(face) * rx > 0
}

function on_right(face: i32, px: i32, py: i32, ex: i32, ey: i32) -> bool {
    let rx: i32 = ex - px
    let ry: i32 = ey - py
    return dx_of(face) * ry - dy_of(face) * rx < 0
}

function state_of(px: i32, py: i32, face: i32, php: i32, ex: i32, ey: i32, ehp: i32) -> i32 {
    let ax: i32 = px + dx_of(face)
    let ay: i32 = py + dy_of(face)
    let mut s: i32 = 0
    if !in_bounds(ax, ay) { s = s + 1 }
    if ehp > 0 and facing_enemy(face, px, py, ex, ey) and clear_los(px, py, ex, ey) {
        s = s + 2
    }
    if ehp > 0 and on_left(face, px, py, ex, ey) { s = s + 4 }
    if ehp > 0 and on_right(face, px, py, ex, ey) { s = s + 8 }
    let dist: i32 = abs_i32(px - ex) + abs_i32(py - ey)
    let mut db: i32 = 0
    if dist > 2 { db = 1 }
    if dist > 5 { db = 2 }
    if dist > 8 { db = 3 }
    s = s + db * 16
    let mut hb: i32 = 0
    if php <= 2 { hb = 1 }
    if php <= 1 { hb = 2 }
    s = s + hb * 64
    if ehp > 0 { s = s + 256 }
    return s
}

function train_agent() -> void {
    q_init(1337 as u32)
    let mut ep: i32 = 0
    while ep < TRAIN_EPS {
        let eps: f32 = q_epsilon(ep, 2000, 1.0, 0.05)
        let seed: u32 = 900 + (ep as u32) * 97
        # Lightweight train step (same dynamics as doom-flow-rl).
        let mut px: i32 = 2
        let mut py: i32 = 2
        let mut face: i32 = 1
        let mut php: i32 = PLAYER_HP
        let mut ex: i32 = GRID - 3
        let mut ey: i32 = GRID - 3
        let mut ehp: i32 = IMP_HP
        let mut steps: i32 = 0
        let mut alive: bool = true
        while alive and ehp > 0 and steps < STEP_CAP {
            let s: i32 = state_of(px, py, face, php, ex, ey, ehp)
            let a: i32 = q_select(s, N_ACTIONS, eps)
            let mut r: f32 = -0.01
            let mut terminal: bool = false
            if a == ACT_LEFT { face = turn_left(face) }
            if a == ACT_RIGHT { face = turn_right(face) }
            if a == ACT_FORWARD {
                let nx: i32 = px + dx_of(face)
                let ny: i32 = py + dy_of(face)
                if in_bounds(nx, ny) and !(nx == ex and ny == ey and ehp > 0) {
                    px = nx
                    py = ny
                } else {
                    r = r - 0.4
                }
            }
            if a == ACT_FIRE {
                if ehp > 0 and facing_enemy(face, px, py, ex, ey) and clear_los(px, py, ex, ey) {
                    ehp = ehp - 1
                    r = r + 5.0
                    if ehp <= 0 { r = r + 20.0; terminal = true }
                } else {
                    r = r - 0.5
                }
            }
            if !terminal and ehp > 0 and (steps % 2) == 0 {
                let mut ix: i32 = ex
                let mut iy: i32 = ey
                let adx: i32 = abs_i32(px - ex)
                let ady: i32 = abs_i32(py - ey)
                if adx >= ady {
                    if px > ex { ix = ex + 1 }
                    if px < ex { ix = ex - 1 }
                } else {
                    if py > ey { iy = ey + 1 }
                    if py < ey { iy = ey - 1 }
                }
                if in_bounds(ix, iy) and !(ix == px and iy == py) {
                    ex = ix
                    ey = iy
                } else {
                    if in_bounds(ix, iy) and ix == px and iy == py {
                        php = php - 1
                        r = r - 6.0
                        if php <= 0 { alive = false; terminal = true; r = r - 15.0 }
                    }
                }
            }
            if terminal or !alive {
                q_update_terminal(s, a, r, 0.12)
            } else {
                let s2: i32 = state_of(px, py, face, php, ex, ey, ehp)
                q_update(s, a, r, s2, N_ACTIONS, 0.12, 0.92)
            }
            steps = steps + 1
        }
        ep = ep + 1
    }
}

function draw_arena(g: Gfx, px: i32, py: i32, face: i32, php: i32,
                    ex: i32, ey: i32, ehp: i32, kills: i32, ep: i32) -> void {
    gfx_clear(g, 18 as u8, 16 as u8, 14 as u8)
    let mut y: i32 = 0
    while y < GRID {
        let mut x: i32 = 0
        while x < GRID {
            let sx: i32 = PAD + x * CELL
            let sy: i32 = PAD + y * CELL
            if !in_bounds(x, y) {
                gfx_fill_rect(g, sx, sy, CELL - 1, CELL - 1, 48 as u8, 42 as u8, 36 as u8)
            } else {
                gfx_fill_rect(g, sx, sy, CELL - 1, CELL - 1, 32 as u8, 28 as u8, 24 as u8)
            }
            x = x + 1
        }
        y = y + 1
    }
    if ehp > 0 {
        let ix: i32 = PAD + ex * CELL + 4
        let iy: i32 = PAD + ey * CELL + 4
        gfx_fill_rect(g, ix, iy, CELL - 8, CELL - 8, 180 as u8, 48 as u8, 36 as u8)
    }
    let qx: i32 = PAD + px * CELL + 4
    let qy: i32 = PAD + py * CELL + 4
    gfx_fill_rect(g, qx, qy, CELL - 8, CELL - 8, 220 as u8, 170 as u8, 40 as u8)
    # Facing notch
    let nx: i32 = qx + 6 + dx_of(face) * 8
    let ny: i32 = qy + 6 + dy_of(face) * 8
    gfx_fill_rect(g, nx, ny, 6, 6, 255 as u8, 230 as u8, 120 as u8)

    # HUD strip
    let hud_y: i32 = PAD + GRID * CELL + 8
    let mut h: i32 = 0
    while h < php {
        gfx_fill_rect(g, PAD + h * 18, hud_y, 14, 10, 70 as u8, 180 as u8, 90 as u8)
        h = h + 1
    }
    let mut e: i32 = 0
    while e < ehp {
        gfx_fill_rect(g, PAD + 120 + e * 18, hud_y, 14, 10, 180 as u8, 48 as u8, 36 as u8)
        e = e + 1
    }
    # episode / kill dots (tiny)
    let mut k: i32 = 0
    while k < kills and k < 20 {
        gfx_fill_rect(g, PAD + k * 8, hud_y + 18, 5, 5, 220 as u8, 170 as u8, 40 as u8)
        k = k + 1
    }
    let mut m: i32 = 0
    while m < (ep % 40) {
        gfx_fill_rect(g, PAD + m * 6, hud_y + 28, 4, 4, 90 as u8, 80 as u8, 70 as u8)
        m = m + 1
    }
}

function main() -> i32 {
    let w: i32 = PAD * 2 + GRID * CELL
    let h: i32 = PAD * 2 + GRID * CELL + 48
    let g: Gfx = gfx_open(w, h, "Q-DOOM Watch")

    train_agent()

    let mut episode: i32 = 0
    let mut kills: i32 = 0
    let mut px: i32 = 2
    let mut py: i32 = 2
    let mut face: i32 = 1
    let mut php: i32 = PLAYER_HP
    let mut ex: i32 = GRID - 3
    let mut ey: i32 = GRID - 3
    let mut ehp: i32 = IMP_HP
    let mut steps: i32 = 0
    let mut hold: i32 = 0

    while gfx_frame_pump(g) {
        if hold > 0 {
            hold = hold - 1
            draw_arena(g, px, py, face, php, ex, ey, ehp, kills, episode)
            gfx_present(g)
            continue
        }

        if php <= 0 or ehp <= 0 or steps >= STEP_CAP {
            if ehp <= 0 { kills = kills + 1 }
            episode = episode + 1
            px = 2
            py = 2
            face = 1
            php = PLAYER_HP
            ex = GRID - 3
            ey = GRID - 3
            ehp = IMP_HP
            steps = 0
            hold = 18
            draw_arena(g, px, py, face, php, ex, ey, ehp, kills, episode)
            gfx_present(g)
            continue
        }

        let s: i32 = state_of(px, py, face, php, ex, ey, ehp)
        let a: i32 = q_best(s, N_ACTIONS)

        if a == ACT_LEFT { face = turn_left(face) }
        if a == ACT_RIGHT { face = turn_right(face) }
        if a == ACT_FORWARD {
            let nx: i32 = px + dx_of(face)
            let ny: i32 = py + dy_of(face)
            if in_bounds(nx, ny) and !(nx == ex and ny == ey and ehp > 0) {
                px = nx
                py = ny
            }
        }
        if a == ACT_FIRE {
            if ehp > 0 and facing_enemy(face, px, py, ex, ey) and clear_los(px, py, ex, ey) {
                ehp = ehp - 1
            }
        }

        if ehp > 0 and (steps % 2) == 0 {
            let mut ix: i32 = ex
            let mut iy: i32 = ey
            let adx: i32 = abs_i32(px - ex)
            let ady: i32 = abs_i32(py - ey)
            if adx >= ady {
                if px > ex { ix = ex + 1 }
                if px < ex { ix = ex - 1 }
            } else {
                if py > ey { iy = ey + 1 }
                if py < ey { iy = ey - 1 }
            }
            if in_bounds(ix, iy) and !(ix == px and iy == py) {
                ex = ix
                ey = iy
            } else {
                if in_bounds(ix, iy) and ix == px and iy == py {
                    php = php - 1
                }
            }
        }

        steps = steps + 1
        draw_arena(g, px, py, face, php, ex, ey, ehp, kills, episode)
        gfx_present(g)
    }

    gfx_close(g)
    return 0
}
