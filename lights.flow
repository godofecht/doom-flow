# Sector lighting effects, ported from p_lights.c to Flow.
#
# Thinker structs (fireflicker_t, lightflash_t, strobe_t, glow_t) are
# allocated here with Z_Malloc and accessed by explicit LP64 offsets
# measured against p_spec.h. Engine sector_t / line_t fields and the
# sectors[] / sector fields go through GEOM_sector_* (setup.flow).
#
# Layouts (offsetof / sizeof on LP64):
#
#   thinker_t: prev=0 next=8 function=16  SIZEOF=24
#
#   fireflicker_t: thinker=0 sector=24 count=32 maxlight=36
#                  minlight=40  SIZEOF=48
#   lightflash_t:  thinker=0 sector=24 count=32 maxlight=36
#                  minlight=40 maxtime=44 mintime=48  SIZEOF=56
#   strobe_t:      thinker=0 sector=24 count=32 minlight=36
#                  maxlight=40 darktime=44 brighttime=48  SIZEOF=56
#   glow_t:        thinker=0 sector=24 minlight=32 maxlight=36
#                  direction=40  SIZEOF=48

extern { function Z_Malloc(size: i32, tag: i32, user: ptr<void>) -> ptr<void> }
extern { function P_Random() -> i32 }
extern { function P_AddThinker(thinker: ptr<void>) -> void }
extern { function P_FindMinSurroundingLight(sector: ptr<void>, max: i32) -> i32 }
extern { function P_FindSectorFromLineTag(line: ptr<void>, start: i32) -> i32 }
extern { function getNextSector(line: ptr<void>, sec: ptr<void>) -> ptr<void> }

extern { function GEOM_numsectors() -> i32 }
extern { function GEOM_sector(i: i32) -> ptr<void> }
extern { function GEOM_sector_lightlevel(s: ptr<void>) -> i32 }
extern { function GEOM_sector_set_lightlevel(s: ptr<void>, v: i32) -> void }
extern { function GEOM_sector_set_special(s: ptr<void>, v: i32) -> void }
extern { function GEOM_sector_tag(s: ptr<void>) -> i32 }
extern { function GEOM_sector_linecount(s: ptr<void>) -> i32 }
extern { function GEOM_sector_line(s: ptr<void>, i: i32) -> ptr<void> }
extern { function GEOM_sector_specialdata(s: ptr<void>) -> ptr<void> }
extern { function GEOM_line_tag(ld: ptr<void>) -> i32 }

# Constants from p_spec.h / z_zone.h.
const LIGHT_GLOWSPEED: i32 = 8
const LIGHT_STROBEBRIGHT: i32 = 5
const LIGHT_FASTDARK: i32 = 15
const LIGHT_SLOWDARK: i32 = 35
const LIGHT_PU_LEVSPEC: i32 = 6

const LIGHT_SIZEOF_FIREFLICKER: i32 = 48
const LIGHT_SIZEOF_LIGHTFLASH: i32 = 56
const LIGHT_SIZEOF_STROBE: i32 = 56
const LIGHT_SIZEOF_GLOW: i32 = 48

# ---- thinker.function.acp1 at offset 16 --------------------------------

function light_set_acp1(obj: i64, fn: i64) -> void {
    let p: ptr<i64> = (obj + 16) as ptr<i64>
    p[0] = fn
}

# ---- fireflicker_t ----------------------------------------------------

function ff_sector(f: i64) -> ptr<void> {
    let p: ptr<i64> = (f + 24) as ptr<i64>
    return p[0] as ptr<void>
}

function ff_set_sector(f: i64, s: ptr<void>) -> void {
    let p: ptr<i64> = (f + 24) as ptr<i64>
    p[0] = s as i64
}

function ff_count(f: i64) -> i32 {
    let p: ptr<i32> = (f + 32) as ptr<i32>
    return p[0]
}

function ff_set_count(f: i64, v: i32) -> void {
    let p: ptr<i32> = (f + 32) as ptr<i32>
    p[0] = v
}

function ff_maxlight(f: i64) -> i32 {
    let p: ptr<i32> = (f + 36) as ptr<i32>
    return p[0]
}

function ff_set_maxlight(f: i64, v: i32) -> void {
    let p: ptr<i32> = (f + 36) as ptr<i32>
    p[0] = v
}

function ff_minlight(f: i64) -> i32 {
    let p: ptr<i32> = (f + 40) as ptr<i32>
    return p[0]
}

function ff_set_minlight(f: i64, v: i32) -> void {
    let p: ptr<i32> = (f + 40) as ptr<i32>
    p[0] = v
}

