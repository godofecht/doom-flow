let mut enemy_brain_easy: i32 = 0

# P_NewChaseDir LUTs (dirtype_t)
let mut opposite: array<i32, 9> = [
    4, 5, 6, 7, 0, 1, 2, 3, 8
]
let mut diags: array<i32, 4> = [
    3, 1, 5, 7
]

# P_NewChaseDir direction LUTs (was enemy_shim.c)
let mut enemy_xspeed: array<i32, 8> = [
    65536, 47000, 0, 0 - 47000, 0 - 65536, 0 - 47000, 0, 47000
]
let mut enemy_yspeed: array<i32, 8> = [
    0, 47000, 65536, 47000, 0, 0 - 47000, 0 - 65536, 0 - 47000
]

let mut enemy_braintargets: array<ptr<void>, 32> = [
    null, null, null, null, null, null, null, null,
