@flow_api
function A_SkelMissile(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    A_FaceTarget(actor)
    MOBJ_set_z(actor, MOBJ_z(actor) + 16 * ENEMY_FRACUNIT)
    let mo: ptr<void> = P_SpawnMissile(actor, MOBJ_target(actor), ENEMY_MT_TRACER)
    MOBJ_set_z(actor, MOBJ_z(actor) - 16 * ENEMY_FRACUNIT)
    MOBJ_set_x(mo, MOBJ_x(mo) + MOBJ_momx(mo))
    MOBJ_set_y(mo, MOBJ_y(mo) + MOBJ_momy(mo))
    MOBJ_set_tracer(mo, MOBJ_target(actor))
}

@flow_api
function A_Tracer(actor: ptr<void>) -> void {
    if (STAT_gametic() & 3) != 0 {
        return
    }

    P_SpawnPuff(MOBJ_x(actor), MOBJ_y(actor), MOBJ_z(actor))

    let th: ptr<void> = P_SpawnMobj(
        MOBJ_x(actor) - MOBJ_momx(actor),
        MOBJ_y(actor) - MOBJ_momy(actor),
        MOBJ_z(actor), ENEMY_MT_SMOKE)
    MOBJ_set_momz(th, ENEMY_FRACUNIT)
    MOBJ_set_tics(th, MOBJ_tics(th) - (P_Random() & 3))
    if MOBJ_tics(th) < 1 {
        MOBJ_set_tics(th, 1)
    }

    let dest: ptr<void> = MOBJ_tracer(actor)
    if (dest as i64) == 0 or MOBJ_health(dest) <= 0 {
        return
    }

    let exact: u32 = R_PointToAngle2(
        MOBJ_x(actor), MOBJ_y(actor),
        MOBJ_x(dest), MOBJ_y(dest))

    if exact != MOBJ_angle(actor) {
        if exact - MOBJ_angle(actor) > ENEMY_ANGLE_HALF {
            MOBJ_set_angle(actor, MOBJ_angle(actor) - TRACEANGLE)
            if exact - MOBJ_angle(actor) < ENEMY_ANGLE_HALF {
                MOBJ_set_angle(actor, exact)
            }
        } else {
            MOBJ_set_angle(actor, MOBJ_angle(actor) + TRACEANGLE)
            if exact - MOBJ_angle(actor) > ENEMY_ANGLE_HALF {
                MOBJ_set_angle(actor, exact)
            }
        }
    }

    let an: u32 = MOBJ_angle(actor) >> ENEMY_ANGLETOFINESHIFT
    MOBJ_set_momx(actor, FixedMul(MOBJ_info_speed(actor), TABLES_finecosine(an as i32)))
    MOBJ_set_momy(actor, FixedMul(MOBJ_info_speed(actor), TABLES_finesine(an as i32)))

    let mut dist: i32 = P_AproxDistance(
        MOBJ_x(dest) - MOBJ_x(actor),
        MOBJ_y(dest) - MOBJ_y(actor))
    dist = dist / MOBJ_info_speed(actor)
    if dist < 1 {
        dist = 1
    }
    let slope: i32 = (MOBJ_z(dest) + 40 * ENEMY_FRACUNIT - MOBJ_z(actor)) / dist
    if slope < MOBJ_momz(actor) {
        MOBJ_set_momz(actor, MOBJ_momz(actor) - ENEMY_FRACUNIT / 8)
    } else {
        MOBJ_set_momz(actor, MOBJ_momz(actor) + ENEMY_FRACUNIT / 8)
    }
}

