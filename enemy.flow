let mut enemy_braintargeton: i32 = 0

# ---- enemy_RecursiveSound (was P_RecursiveSound) ----------------------

function enemy_RecursiveSound(sec: ptr<void>, soundblocks: i32) -> void {
    if GEOM_sector_validcount(sec) == RMAIN_validcount()
        and GEOM_sector_soundtraversed(sec) <= soundblocks + 1 {
        return
    }

    GEOM_sector_set_validcount(sec, RMAIN_validcount())
    GEOM_sector_set_soundtraversed(sec, soundblocks + 1)
    GEOM_sector_set_soundtarget(sec, soundtarget)

    let n: i32 = GEOM_sector_linecount(sec)
    for i in 0 to n {
        let check: ptr<void> = GEOM_sector_line(sec, i)
        if (GEOM_line_flags(check) & ENEMY_ML_TWOSIDED) == 0 {
            continue
        }

        P_LineOpening(check)
        if MAPUTL_openrange() <= 0 {
            continue
        }

        let other: ptr<void> = getNextSector(check, sec)

        if (GEOM_line_flags(check) & ENEMY_ML_SOUNDBLOCK) != 0 {
            if soundblocks == 0 {
                enemy_RecursiveSound(other, 1)
            }
        } else {
            enemy_RecursiveSound(other, soundblocks)
        }
    }
}

# ---- P_NoiseAlert -----------------------------------------------------

@flow_api
function P_NoiseAlert(target: ptr<void>, emmiter: ptr<void>) -> void {
    soundtarget = target
    RMAIN_set_validcount(RMAIN_validcount() + 1)
    enemy_RecursiveSound(MOBJ_sector(emmiter), 0)
}

# ---- enemy_CheckMeleeRange --------------------------------------------

function enemy_CheckMeleeRange(actor: ptr<void>) -> i32 {
    let pl: ptr<void> = MOBJ_target(actor)
    if (pl as i64) == 0 {
        return 0
    }

    let dist: i32 = P_AproxDistance(
        MOBJ_x(pl) - MOBJ_x(actor),
        MOBJ_y(pl) - MOBJ_y(actor))

    if dist >= ENEMY_MELEERANGE - 20 * ENEMY_FRACUNIT + MOBJ_info_radius(pl) {
        return 0
    }
    if P_CheckSight(actor, MOBJ_target(actor)) == 0 {
        return 0
    }
    return 1
}

# ---- enemy_CheckMissileRange ------------------------------------------

function enemy_CheckMissileRange(actor: ptr<void>) -> i32 {
    if P_CheckSight(actor, MOBJ_target(actor)) == 0 {
        return 0
    }

    if (MOBJ_flags(actor) & ENEMY_MF_JUSTHIT) != 0 {
        MOBJ_set_flags(actor, MOBJ_flags(actor) & (0 - 1 - ENEMY_MF_JUSTHIT))
        return 1
    }

    if MOBJ_reactiontime(actor) != 0 {
        return 0
    }

    let targ: ptr<void> = MOBJ_target(actor)
    let mut dist: i32 = P_AproxDistance(
        MOBJ_x(actor) - MOBJ_x(targ),
        MOBJ_y(actor) - MOBJ_y(targ)) - 64 * ENEMY_FRACUNIT

    if MOBJ_info_meleestate(actor) == 0 {
        dist = dist - 128 * ENEMY_FRACUNIT
    }

    dist = dist >> 16

    if MOBJ_type(actor) == ENEMY_MT_VILE {
        if dist > 14 * 64 {
            return 0
        }
    }

    if MOBJ_type(actor) == ENEMY_MT_UNDEAD {
        if dist < 196 {
            return 0
        }
        dist = dist >> 1
    }

    if MOBJ_type(actor) == ENEMY_MT_CYBORG
        or MOBJ_type(actor) == ENEMY_MT_SPIDER
        or MOBJ_type(actor) == ENEMY_MT_SKULL {
        dist = dist >> 1
    }

    if dist > 200 {
        dist = 200
    }
    if MOBJ_type(actor) == ENEMY_MT_CYBORG and dist > 160 {
        dist = 160
    }
    if P_Random() < dist {
        return 0
    }
    return 1
}

# ---- enemy_Move -------------------------------------------------------

function enemy_Move(actor: ptr<void>) -> i32 {
    if MOBJ_movedir(actor) == ENEMY_DI_NODIR {
        return 0
    }
    if (MOBJ_movedir(actor) as u32) >= 8 as u32 {
        I_Error("Weird actor->movedir!")
    }

    let md: i32 = MOBJ_movedir(actor)
    let speed: i32 = MOBJ_info_speed(actor)
    let tryx: i32 = MOBJ_x(actor) + speed * enemy_xspeed[md]
    let tryy: i32 = MOBJ_y(actor) + speed * enemy_yspeed[md]

    let try_ok: i32 = P_TryMove(actor, tryx, tryy)

    if try_ok == 0 {
        if (MOBJ_flags(actor) & ENEMY_MF_FLOAT) != 0 and MAP_floatok() != 0 {
            if MOBJ_z(actor) < MAP_tmfloorz() {
                MOBJ_set_z(actor, MOBJ_z(actor) + ENEMY_FLOATSPEED)
            } else {
                MOBJ_set_z(actor, MOBJ_z(actor) - ENEMY_FLOATSPEED)
            }
            MOBJ_set_flags(actor, MOBJ_flags(actor) | ENEMY_MF_INFLOAT)
            return 1
        }

        if MAP_numspechit() == 0 {
            return 0
        }

        MOBJ_set_movedir(actor, ENEMY_DI_NODIR)
        let mut good: i32 = 0
        while true {
            let cur: i32 = MAP_numspechit()
            MAP_set_numspechit(cur - 1)
            if cur == 0 {
                break
            }
            let ld: ptr<void> = MAP_spechit(MAP_numspechit())
            if P_UseSpecialLine(actor, ld, 0) != 0 {
                good = 1
            }
        }
        return good
    } else {
        MOBJ_set_flags(actor, MOBJ_flags(actor) & (0 - 1 - ENEMY_MF_INFLOAT))
    }

    if (MOBJ_flags(actor) & ENEMY_MF_FLOAT) == 0 {
        MOBJ_set_z(actor, MOBJ_floorz(actor))
    }
    return 1
}

# ---- enemy_TryWalk ----------------------------------------------------

function enemy_TryWalk(actor: ptr<void>) -> i32 {
    if enemy_Move(actor) == 0 {
        return 0
    }
    MOBJ_set_movecount(actor, P_Random() & 15)
    return 1
}

# ---- enemy_NewChaseDir ------------------------------------------------

function enemy_NewChaseDir(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        I_Error("P_NewChaseDir: called with no target")
    }

    let olddir: i32 = MOBJ_movedir(actor)
    let turnaround: i32 = opposite[olddir]

    let targ: ptr<void> = MOBJ_target(actor)
    let deltax: i32 = MOBJ_x(targ) - MOBJ_x(actor)
    let deltay: i32 = MOBJ_y(targ) - MOBJ_y(actor)

    let mut d1: i32 = ENEMY_DI_NODIR
    let mut d2: i32 = ENEMY_DI_NODIR

    if deltax > 10 * ENEMY_FRACUNIT {
        d1 = ENEMY_DI_EAST
    } elif deltax < 0 - 10 * ENEMY_FRACUNIT {
        d1 = ENEMY_DI_WEST
    } else {
        d1 = ENEMY_DI_NODIR
    }

    if deltay < 0 - 10 * ENEMY_FRACUNIT {
        d2 = ENEMY_DI_SOUTH
    } elif deltay > 10 * ENEMY_FRACUNIT {
        d2 = ENEMY_DI_NORTH
    } else {
        d2 = ENEMY_DI_NODIR
    }

    # try direct route
    if d1 != ENEMY_DI_NODIR and d2 != ENEMY_DI_NODIR {
        let mut diag_i: i32 = 0
        if deltay < 0 {
            diag_i = diag_i + 2
        }
        if deltax > 0 {
            diag_i = diag_i + 1
        }
        MOBJ_set_movedir(actor, diags[diag_i])
        if MOBJ_movedir(actor) != turnaround and enemy_TryWalk(actor) != 0 {
            return
        }
    }

    # try other directions
    if P_Random() > 200 or abs(deltay) > abs(deltax) {
        let tdir: i32 = d1
        d1 = d2
        d2 = tdir
    }

    if d1 == turnaround {
        d1 = ENEMY_DI_NODIR
    }
    if d2 == turnaround {
        d2 = ENEMY_DI_NODIR
    }

    if d1 != ENEMY_DI_NODIR {
        MOBJ_set_movedir(actor, d1)
        if enemy_TryWalk(actor) != 0 {
            return
        }
    }

    if d2 != ENEMY_DI_NODIR {
        MOBJ_set_movedir(actor, d2)
        if enemy_TryWalk(actor) != 0 {
            return
        }
    }

    if olddir != ENEMY_DI_NODIR {
        MOBJ_set_movedir(actor, olddir)
        if enemy_TryWalk(actor) != 0 {
            return
        }
    }

    # randomly determine direction of search
    if (P_Random() & 1) != 0 {
        let mut tdir2: i32 = ENEMY_DI_EAST
        while tdir2 <= ENEMY_DI_SOUTHEAST {
            if tdir2 != turnaround {
                MOBJ_set_movedir(actor, tdir2)
                if enemy_TryWalk(actor) != 0 {
                    return
                }
            }
            tdir2 = tdir2 + 1
        }
    } else {
        let mut tdir3: i32 = ENEMY_DI_SOUTHEAST
        while tdir3 != ENEMY_DI_EAST - 1 {
            if tdir3 != turnaround {
                MOBJ_set_movedir(actor, tdir3)
                if enemy_TryWalk(actor) != 0 {
                    return
                }
            }
            tdir3 = tdir3 - 1
        }
    }

    if turnaround != ENEMY_DI_NODIR {
        MOBJ_set_movedir(actor, turnaround)
        if enemy_TryWalk(actor) != 0 {
            return
        }
    }

    MOBJ_set_movedir(actor, ENEMY_DI_NODIR)
}

# ---- enemy_LookForPlayers ---------------------------------------------
# Mirrors for (;; lastlook = (lastlook+1)&3): continue advances lastlook;
# early return false/true does not.

function enemy_LookForPlayers(actor: ptr<void>, allaround: i32) -> i32 {
    let mut c: i32 = 0
    let stop: i32 = (MOBJ_lastlook(actor) - 1) & 3

    while true {
        if STAT_playeringame(MOBJ_lastlook(actor)) != 0 {
            # c++ == 2 || lastlook == stop
            let look: i32 = MOBJ_lastlook(actor)
            let oldc: i32 = c
            c = c + 1
            if oldc == 2 or look == stop {
                return 0
            }

            let player: ptr<void> = PLAYER_at(look)

            if PLAYER_health(player) > 0 {
                let mo: ptr<void> = PLAYER_mo(player)
                if P_CheckSight(actor, mo) != 0 {
                    let mut ok: i32 = 1
                    if allaround == 0 {
                        let an: u32 = R_PointToAngle2(
                            MOBJ_x(actor), MOBJ_y(actor),
                            MOBJ_x(mo), MOBJ_y(mo)) - MOBJ_angle(actor)

                        if an > ENEMY_ANG90 and an < ENEMY_ANG270 {
                            let dist: i32 = P_AproxDistance(
                                MOBJ_x(mo) - MOBJ_x(actor),
                                MOBJ_y(mo) - MOBJ_y(actor))
                            if dist > ENEMY_MELEERANGE {
                                ok = 0
                            }
                        }
                    }
                    if ok != 0 {
                        MOBJ_set_target(actor, mo)
                        return 1
                    }
                }
            }
        }

        # for-loop increment
        MOBJ_set_lastlook(actor, (MOBJ_lastlook(actor) + 1) & 3)
    }
    return 0
}

# ---- A_Fall (needed early) --------------------------------------------

@flow_api
function A_Fall(actor: ptr<void>) -> void {
    MOBJ_set_flags(actor, MOBJ_flags(actor) & (0 - 1 - ENEMY_MF_SOLID))
}

# ---- A_KeenDie --------------------------------------------------------

@flow_api
function A_KeenDie(mo: ptr<void>) -> void {
    A_Fall(mo)

    let cap: ptr<void> = THINKER_cap()
    let mut th: ptr<void> = THINKER_next(cap)
    while (th as i64) != (cap as i64) {
        if THINKER_is_mobj(th) != 0 {
            let mo2: ptr<void> = th
            if (mo2 as i64) != (mo as i64)
                and MOBJ_type(mo2) == MOBJ_type(mo)
                and MOBJ_health(mo2) > 0 {
                return
            }
        }
        th = THINKER_next(th)
    }

    SPEC_ev_do_door_tag(666, ENEMY_VLD_OPEN)
}

# ---- A_Look -----------------------------------------------------------

@flow_api
function A_Look(actor: ptr<void>) -> void {
    MOBJ_set_threshold(actor, 0)

    let mut seeyou: i32 = 0
    let targ: ptr<void> = GEOM_sector_soundtarget(MOBJ_sector(actor))

    if (targ as i64) != 0 and (MOBJ_flags(targ) & ENEMY_MF_SHOOTABLE) != 0 {
        MOBJ_set_target(actor, targ)
        if (MOBJ_flags(actor) & ENEMY_MF_AMBUSH) != 0 {
            if P_CheckSight(actor, MOBJ_target(actor)) != 0 {
                seeyou = 1
            }
        } else {
            seeyou = 1
        }
    }

    if seeyou == 0 {
        if enemy_LookForPlayers(actor, 0) == 0 {
            return
        }
    }

    # seeyou
    if MOBJ_info_seesound(actor) != 0 {
        let mut sound: i32 = 0
        let ss: i32 = MOBJ_info_seesound(actor)
        if ss == ENEMY_SFX_POSIT1 or ss == ENEMY_SFX_POSIT2 or ss == ENEMY_SFX_POSIT3 {
            sound = ENEMY_SFX_POSIT1 + P_Random() % 3
        } elif ss == ENEMY_SFX_BGSIT1 or ss == ENEMY_SFX_BGSIT2 {
            sound = ENEMY_SFX_BGSIT1 + P_Random() % 2
        } else {
            sound = ss
        }

        if MOBJ_type(actor) == ENEMY_MT_SPIDER
            or MOBJ_type(actor) == ENEMY_MT_CYBORG {
            S_StartSound(null, sound)
        } else {
            S_StartSound(actor, sound)
        }
    }

    P_SetMobjState(actor, MOBJ_info_seestate(actor))
}

# ---- A_Chase ----------------------------------------------------------

@flow_api
function A_Chase(actor: ptr<void>) -> void {
    if MOBJ_reactiontime(actor) != 0 {
        MOBJ_set_reactiontime(actor, MOBJ_reactiontime(actor) - 1)
    }

    if MOBJ_threshold(actor) != 0 {
        let t: ptr<void> = MOBJ_target(actor)
        if (t as i64) == 0 or MOBJ_health(t) <= 0 {
            MOBJ_set_threshold(actor, 0)
        } else {
            MOBJ_set_threshold(actor, MOBJ_threshold(actor) - 1)
        }
    }

    # turn towards movement direction if not there yet
    if MOBJ_movedir(actor) < 8 {
        let mut ang: u32 = MOBJ_angle(actor) & ((7 as u32) << 29)
        MOBJ_set_angle(actor, ang)
        let delta: i32 = (ang as i32) - (MOBJ_movedir(actor) << 29)
        if delta > 0 {
            MOBJ_set_angle(actor, MOBJ_angle(actor) - (ENEMY_ANG90 >> 1))
        } elif delta < 0 {
            MOBJ_set_angle(actor, MOBJ_angle(actor) + (ENEMY_ANG90 >> 1))
        }
    }

    let targ: ptr<void> = MOBJ_target(actor)
    if (targ as i64) == 0 or (MOBJ_flags(targ) & ENEMY_MF_SHOOTABLE) == 0 {
        if enemy_LookForPlayers(actor, 1) != 0 {
            return
        }
        P_SetMobjState(actor, MOBJ_info_spawnstate(actor))
        return
    }

    if (MOBJ_flags(actor) & ENEMY_MF_JUSTATTACKED) != 0 {
        MOBJ_set_flags(actor, MOBJ_flags(actor) & (0 - 1 - ENEMY_MF_JUSTATTACKED))
        if STAT_gameskill() != ENEMY_SK_NIGHTMARE and STAT_fastparm() == 0 {
            enemy_NewChaseDir(actor)
        }
        return
    }

    if MOBJ_info_meleestate(actor) != 0 and enemy_CheckMeleeRange(actor) != 0 {
        if MOBJ_info_attacksound(actor) != 0 {
            S_StartSound(actor, MOBJ_info_attacksound(actor))
        }
        P_SetMobjState(actor, MOBJ_info_meleestate(actor))
        return
    }

    if MOBJ_info_missilestate(actor) != 0 {
        let skip: i32 = 0
        if STAT_gameskill() < ENEMY_SK_NIGHTMARE
            and STAT_fastparm() == 0
            and MOBJ_movecount(actor) != 0 {
            skip = 1
        }
        if skip == 0 {
            if enemy_CheckMissileRange(actor) != 0 {
                P_SetMobjState(actor, MOBJ_info_missilestate(actor))
                MOBJ_set_flags(actor, MOBJ_flags(actor) | ENEMY_MF_JUSTATTACKED)
                return
            }
        }
    }

    # nomissile
    if STAT_netgame() != 0
        and MOBJ_threshold(actor) == 0
        and P_CheckSight(actor, MOBJ_target(actor)) == 0 {
        if enemy_LookForPlayers(actor, 1) != 0 {
            return
        }
    }

    let mc: i32 = MOBJ_movecount(actor) - 1
    MOBJ_set_movecount(actor, mc)
    if mc < 0 or enemy_Move(actor) == 0 {
        enemy_NewChaseDir(actor)
    }

    if MOBJ_info_activesound(actor) != 0 and P_Random() < 3 {
        S_StartSound(actor, MOBJ_info_activesound(actor))
    }
}

# ---- A_FaceTarget -----------------------------------------------------

@flow_api
function A_FaceTarget(actor: ptr<void>) -> void {
    let t: ptr<void> = MOBJ_target(actor)
    if (t as i64) == 0 {
        return
    }

    MOBJ_set_flags(actor, MOBJ_flags(actor) & (0 - 1 - ENEMY_MF_AMBUSH))
    MOBJ_set_angle(actor, R_PointToAngle2(
        MOBJ_x(actor), MOBJ_y(actor),
        MOBJ_x(t), MOBJ_y(t)))

    if (MOBJ_flags(t) & ENEMY_MF_SHADOW) != 0 {
        let adj: i32 = (P_Random() - P_Random()) << 21
        MOBJ_set_angle(actor, MOBJ_angle(actor) + (adj as u32))
    }
}

# ---- projectile / melee attacks ---------------------------------------

@flow_api
function A_PosAttack(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    A_FaceTarget(actor)
    let mut angle: u32 = MOBJ_angle(actor)
    let slope: i32 = P_AimLineAttack(actor, angle, ENEMY_MISSILERANGE)
    S_StartSound(actor, ENEMY_SFX_PISTOL)
    let adj: i32 = (P_Random() - P_Random()) << 20
    angle = angle + (adj as u32)
    let damage: i32 = ((P_Random() % 5) + 1) * 3
    P_LineAttack(actor, angle, ENEMY_MISSILERANGE, slope, damage)
}

@flow_api
function A_SPosAttack(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    S_StartSound(actor, ENEMY_SFX_SHOTGN)
    A_FaceTarget(actor)
    let bangle: u32 = MOBJ_angle(actor)
    let slope: i32 = P_AimLineAttack(actor, bangle, ENEMY_MISSILERANGE)
    for i in 0 to 3 {
        let adj: i32 = (P_Random() - P_Random()) << 20
        let angle: u32 = bangle + (adj as u32)
        let damage: i32 = ((P_Random() % 5) + 1) * 3
        P_LineAttack(actor, angle, ENEMY_MISSILERANGE, slope, damage)
    }
}

@flow_api
function A_CPosAttack(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    S_StartSound(actor, ENEMY_SFX_SHOTGN)
    A_FaceTarget(actor)
    let bangle: u32 = MOBJ_angle(actor)
    let slope: i32 = P_AimLineAttack(actor, bangle, ENEMY_MISSILERANGE)
    let adj: i32 = (P_Random() - P_Random()) << 20
