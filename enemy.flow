# ---- Arch-vile --------------------------------------------------------

@flow_api
function PIT_VileCheck(thing: ptr<void>) -> i32 {
    if (MOBJ_flags(thing) & ENEMY_MF_CORPSE) == 0 {
        return 1
    }
    if MOBJ_tics(thing) != 0 - 1 {
        return 1
    }
    if MOBJ_info_raisestate(thing) == ENEMY_S_NULL {
        return 1
    }

    let maxdist: i32 = MOBJ_info_radius(thing) + MOBJINFO_radius(ENEMY_MT_VILE)
    if abs(MOBJ_x(thing) - viletryx) > maxdist
        or abs(MOBJ_y(thing) - viletryy) > maxdist {
        return 1
    }

    corpsehit = thing
    MOBJ_set_momx(corpsehit, 0)
    MOBJ_set_momy(corpsehit, 0)
    MOBJ_set_height(corpsehit, MOBJ_height(corpsehit) << 2)
    let check: i32 = P_CheckPosition(corpsehit, MOBJ_x(corpsehit), MOBJ_y(corpsehit))
    MOBJ_set_height(corpsehit, MOBJ_height(corpsehit) >> 2)

    if check == 0 {
        return 1
    }
    return 0
}

@flow_api
function A_VileChase(actor: ptr<void>) -> void {
    if MOBJ_movedir(actor) != ENEMY_DI_NODIR {
        let speed: i32 = MOBJ_info_speed(actor)
        let md: i32 = MOBJ_movedir(actor)
        viletryx = MOBJ_x(actor) + speed * enemy_xspeed[md]
        viletryy = MOBJ_y(actor) + speed * enemy_yspeed[md]

        let xl: i32 = (viletryx - GEOM_bmaporgx() - ENEMY_MAXRADIUS * 2) >> ENEMY_MAPBLOCKSHIFT
        let xh: i32 = (viletryx - GEOM_bmaporgx() + ENEMY_MAXRADIUS * 2) >> ENEMY_MAPBLOCKSHIFT
        let yl: i32 = (viletryy - GEOM_bmaporgy() - ENEMY_MAXRADIUS * 2) >> ENEMY_MAPBLOCKSHIFT
        let yh: i32 = (viletryy - GEOM_bmaporgy() + ENEMY_MAXRADIUS * 2) >> ENEMY_MAPBLOCKSHIFT

        let mut bx: i32 = xl
        while bx <= xh {
            let mut by: i32 = yl
            while by <= yh {
                if P_BlockThingsIterator(bx, by, PIT_VileCheck) == 0 {
                    let temp: ptr<void> = MOBJ_target(actor)
                    MOBJ_set_target(actor, corpsehit)
                    A_FaceTarget(actor)
                    MOBJ_set_target(actor, temp)

                    P_SetMobjState(actor, ENEMY_S_VILE_HEAL1)
                    S_StartSound(corpsehit, ENEMY_SFX_SLOP)

                    P_SetMobjState(corpsehit, MOBJ_info_raisestate(corpsehit))
                    MOBJ_set_height(corpsehit, MOBJ_height(corpsehit) << 2)
                    MOBJ_set_flags(corpsehit, MOBJ_info_flags(corpsehit))
                    MOBJ_set_health(corpsehit, MOBJ_info_spawnhealth(corpsehit))
                    MOBJ_set_target(corpsehit, null)
                    return
                }
                by = by + 1
            }
            bx = bx + 1
        }
    }

    A_Chase(actor)
}

@flow_api
function A_VileStart(actor: ptr<void>) -> void {
    S_StartSound(actor, ENEMY_SFX_VILATK)
}

@flow_api
function A_Fire(actor: ptr<void>) -> void {
    let dest: ptr<void> = MOBJ_tracer(actor)
    if (dest as i64) == 0 {
        return
    }

    let target: ptr<void> = P_SubstNullMobj(MOBJ_target(actor))
    if P_CheckSight(target, dest) == 0 {
        return
    }

    let an: u32 = MOBJ_angle(dest) >> ENEMY_ANGLETOFINESHIFT
    P_UnsetThingPosition(actor)
    MOBJ_set_x(actor, MOBJ_x(dest) + FixedMul(24 * ENEMY_FRACUNIT, TABLES_finecosine(an as i32)))
    MOBJ_set_y(actor, MOBJ_y(dest) + FixedMul(24 * ENEMY_FRACUNIT, TABLES_finesine(an as i32)))
    MOBJ_set_z(actor, MOBJ_z(dest))
    P_SetThingPosition(actor)
}

@flow_api
function A_StartFire(actor: ptr<void>) -> void {
    S_StartSound(actor, ENEMY_SFX_FLAMST)
    A_Fire(actor)
}

@flow_api
function A_FireCrackle(actor: ptr<void>) -> void {
    S_StartSound(actor, ENEMY_SFX_FLAME)
    A_Fire(actor)
}

@flow_api
function A_VileTarget(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    A_FaceTarget(actor)
    let t: ptr<void> = MOBJ_target(actor)
    # Vanilla quirk: second spawn arg is target->x (not y).
    let fog: ptr<void> = P_SpawnMobj(
        MOBJ_x(t), MOBJ_x(t), MOBJ_z(t), ENEMY_MT_FIRE)
    MOBJ_set_tracer(actor, fog)
    MOBJ_set_target(fog, actor)
    MOBJ_set_tracer(fog, t)
    A_Fire(fog)
}

@flow_api
function A_VileAttack(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    A_FaceTarget(actor)
    if P_CheckSight(actor, MOBJ_target(actor)) == 0 {
        return
    }

    S_StartSound(actor, ENEMY_SFX_BAREXP)
    let t: ptr<void> = MOBJ_target(actor)
    P_DamageMobj(t, actor, actor, 20)
    MOBJ_set_momz(t, 1000 * ENEMY_FRACUNIT / MOBJ_info_mass(t))

    let an: u32 = MOBJ_angle(actor) >> ENEMY_ANGLETOFINESHIFT
    let fire: ptr<void> = MOBJ_tracer(actor)
    if (fire as i64) == 0 {
        return
    }
    MOBJ_set_x(fire, MOBJ_x(t) - FixedMul(24 * ENEMY_FRACUNIT, TABLES_finecosine(an as i32)))
    MOBJ_set_y(fire, MOBJ_y(t) - FixedMul(24 * ENEMY_FRACUNIT, TABLES_finesine(an as i32)))
    P_RadiusAttack(fire, actor, 70)
}

# ---- Mancubus ---------------------------------------------------------

@flow_api
function A_FatRaise(actor: ptr<void>) -> void {
    A_FaceTarget(actor)
    S_StartSound(actor, ENEMY_SFX_MANATK)
}

@flow_api
function A_FatAttack1(actor: ptr<void>) -> void {
    A_FaceTarget(actor)
    MOBJ_set_angle(actor, MOBJ_angle(actor) + ENEMY_FATSPREAD)
    let target: ptr<void> = P_SubstNullMobj(MOBJ_target(actor))
    P_SpawnMissile(actor, target, ENEMY_MT_FATSHOT)
    let mo: ptr<void> = P_SpawnMissile(actor, target, ENEMY_MT_FATSHOT)
    MOBJ_set_angle(mo, MOBJ_angle(mo) + ENEMY_FATSPREAD)
    let an: u32 = MOBJ_angle(mo) >> ENEMY_ANGLETOFINESHIFT
    MOBJ_set_momx(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finecosine(an as i32)))
    MOBJ_set_momy(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finesine(an as i32)))
}

@flow_api
function A_FatAttack2(actor: ptr<void>) -> void {
    A_FaceTarget(actor)
    MOBJ_set_angle(actor, MOBJ_angle(actor) - ENEMY_FATSPREAD)
    let target: ptr<void> = P_SubstNullMobj(MOBJ_target(actor))
    P_SpawnMissile(actor, target, ENEMY_MT_FATSHOT)
    let mo: ptr<void> = P_SpawnMissile(actor, target, ENEMY_MT_FATSHOT)
    MOBJ_set_angle(mo, MOBJ_angle(mo) - (ENEMY_FATSPREAD * (2 as u32)))
    let an: u32 = MOBJ_angle(mo) >> ENEMY_ANGLETOFINESHIFT
    MOBJ_set_momx(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finecosine(an as i32)))
    MOBJ_set_momy(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finesine(an as i32)))
}

@flow_api
function A_FatAttack3(actor: ptr<void>) -> void {
    A_FaceTarget(actor)
    let target: ptr<void> = P_SubstNullMobj(MOBJ_target(actor))

    let mut mo: ptr<void> = P_SpawnMissile(actor, target, ENEMY_MT_FATSHOT)
    MOBJ_set_angle(mo, MOBJ_angle(mo) - (ENEMY_FATSPREAD >> 1))
    let mut an: u32 = MOBJ_angle(mo) >> ENEMY_ANGLETOFINESHIFT
    MOBJ_set_momx(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finecosine(an as i32)))
    MOBJ_set_momy(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finesine(an as i32)))

    mo = P_SpawnMissile(actor, target, ENEMY_MT_FATSHOT)
    MOBJ_set_angle(mo, MOBJ_angle(mo) + (ENEMY_FATSPREAD >> 1))
    an = MOBJ_angle(mo) >> ENEMY_ANGLETOFINESHIFT
    MOBJ_set_momx(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finecosine(an as i32)))
    MOBJ_set_momy(mo, FixedMul(MOBJ_info_speed(mo), TABLES_finesine(an as i32)))
}

# ---- Lost soul / Pain elemental ---------------------------------------

@flow_api
function A_SkullAttack(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    let dest: ptr<void> = MOBJ_target(actor)
    MOBJ_set_flags(actor, MOBJ_flags(actor) | ENEMY_MF_SKULLFLY)
    S_StartSound(actor, MOBJ_info_attacksound(actor))
    A_FaceTarget(actor)
    let an: u32 = MOBJ_angle(actor) >> ENEMY_ANGLETOFINESHIFT
    MOBJ_set_momx(actor, FixedMul(ENEMY_SKULLSPEED, TABLES_finecosine(an as i32)))
    MOBJ_set_momy(actor, FixedMul(ENEMY_SKULLSPEED, TABLES_finesine(an as i32)))
    let mut dist: i32 = P_AproxDistance(
        MOBJ_x(dest) - MOBJ_x(actor),
        MOBJ_y(dest) - MOBJ_y(actor))
    dist = dist / ENEMY_SKULLSPEED
    if dist < 1 {
        dist = 1
    }
    MOBJ_set_momz(actor,
        (MOBJ_z(dest) + (MOBJ_height(dest) >> 1) - MOBJ_z(actor)) / dist)
}

function enemy_PainShootSkull(actor: ptr<void>, angle: u32) -> void {
    let mut count: i32 = 0
    let cap: ptr<void> = THINKER_cap()
    let mut currentthinker: ptr<void> = THINKER_next(cap)
    while (currentthinker as i64) != (cap as i64) {
        if THINKER_is_mobj(currentthinker) != 0
            and MOBJ_type(currentthinker) == ENEMY_MT_SKULL {
            count = count + 1
        }
        currentthinker = THINKER_next(currentthinker)
    }
    if count > 20 {
        return
    }

    let an: u32 = angle >> ENEMY_ANGLETOFINESHIFT
    let prestep: i32 = 4 * ENEMY_FRACUNIT + 3 * (
        MOBJ_info_radius(actor) + MOBJINFO_radius(ENEMY_MT_SKULL)) / 2
    let x: i32 = MOBJ_x(actor) + FixedMul(prestep, TABLES_finecosine(an as i32))
    let y: i32 = MOBJ_y(actor) + FixedMul(prestep, TABLES_finesine(an as i32))
    let z: i32 = MOBJ_z(actor) + 8 * ENEMY_FRACUNIT

    let newmobj: ptr<void> = P_SpawnMobj(x, y, z, ENEMY_MT_SKULL)
    if P_TryMove(newmobj, MOBJ_x(newmobj), MOBJ_y(newmobj)) == 0 {
        P_DamageMobj(newmobj, actor, actor, 10000)
        return
    }
    MOBJ_set_target(newmobj, MOBJ_target(actor))
    A_SkullAttack(newmobj)
}

@flow_api
function A_PainAttack(actor: ptr<void>) -> void {
    if (MOBJ_target(actor) as i64) == 0 {
        return
    }
    A_FaceTarget(actor)
    enemy_PainShootSkull(actor, MOBJ_angle(actor))
}

@flow_api
function A_PainDie(actor: ptr<void>) -> void {
    A_Fall(actor)
    enemy_PainShootSkull(actor, MOBJ_angle(actor) + ENEMY_ANG90)
    enemy_PainShootSkull(actor, MOBJ_angle(actor) + ENEMY_ANG180)
    enemy_PainShootSkull(actor, MOBJ_angle(actor) + ENEMY_ANG270)
}

# ---- death / pain sounds ----------------------------------------------

@flow_api
function A_Scream(actor: ptr<void>) -> void {
    let mut sound: i32 = 0
    let ds: i32 = MOBJ_info_deathsound(actor)
    if ds == 0 {
        return
    }
    if ds == ENEMY_SFX_PODTH1 or ds == ENEMY_SFX_PODTH2 or ds == ENEMY_SFX_PODTH3 {
        sound = ENEMY_SFX_PODTH1 + P_Random() % 3
    } elif ds == ENEMY_SFX_BGDTH1 or ds == ENEMY_SFX_BGDTH2 {
        sound = ENEMY_SFX_BGDTH1 + P_Random() % 2
    } else {
        sound = ds
    }

    if MOBJ_type(actor) == ENEMY_MT_SPIDER
        or MOBJ_type(actor) == ENEMY_MT_CYBORG {
        S_StartSound(null, sound)
    } else {
        S_StartSound(actor, sound)
    }
}

@flow_api
function A_XScream(actor: ptr<void>) -> void {
    S_StartSound(actor, ENEMY_SFX_SLOP)
}

@flow_api
function A_Pain(actor: ptr<void>) -> void {
    if MOBJ_info_painsound(actor) != 0 {
        S_StartSound(actor, MOBJ_info_painsound(actor))
    }
}

@flow_api
function A_Explode(thingy: ptr<void>) -> void {
    P_RadiusAttack(thingy, MOBJ_target(thingy), 128)
}

# ---- Boss death -------------------------------------------------------

function enemy_CheckBossEnd(motype: i32) -> i32 {
    if STAT_gameversion() < ENEMY_EXE_ULTIMATE {
        if STAT_gamemap() != 8 {
            return 0
        }
        if motype == ENEMY_MT_BRUISER and STAT_gameepisode() != 1 {
            return 0
        }
        return 1
    }

    let ep: i32 = STAT_gameepisode()
    if ep == 1 {
        if STAT_gamemap() == 8 and motype == ENEMY_MT_BRUISER {
            return 1
        }
        return 0
    } elif ep == 2 {
        if STAT_gamemap() == 8 and motype == ENEMY_MT_CYBORG {
            return 1
        }
        return 0
    } elif ep == 3 {
        if STAT_gamemap() == 8 and motype == ENEMY_MT_SPIDER {
            return 1
        }
        return 0
    } elif ep == 4 {
        if (STAT_gamemap() == 6 and motype == ENEMY_MT_CYBORG)
            or (STAT_gamemap() == 8 and motype == ENEMY_MT_SPIDER) {
            return 1
        }
        return 0
    }
    if STAT_gamemap() == 8 {
        return 1
    }
    return 0
}

@flow_api
function A_BossDeath(mo: ptr<void>) -> void {
    if STAT_gamemode() == ENEMY_COMMERCIAL {
        if STAT_gamemap() != 7 {
            return
        }
        if MOBJ_type(mo) != ENEMY_MT_FATSO
            and MOBJ_type(mo) != ENEMY_MT_BABY {
            return
        }
    } else {
        if enemy_CheckBossEnd(MOBJ_type(mo)) == 0 {
            return
        }
    }

    let mut i: i32 = 0
    while i < ENEMY_MAXPLAYERS {
        if STAT_playeringame(i) != 0 and PLAYER_health(PLAYER_at(i)) > 0 {
            break
        }
        i = i + 1
    }
    if i == ENEMY_MAXPLAYERS {
        return
    }

    let cap: ptr<void> = THINKER_cap()
    let mut th: ptr<void> = THINKER_next(cap)
    while (th as i64) != (cap as i64) {
        if THINKER_is_mobj(th) != 0 {
            let mo2: ptr<void> = th
            if (mo2 as i64) != (mo as i64)
                and MOBJ_type(mo2) == MOBJ_type(mo)
                and MOBJ_health(mo2) > 0 {
                return
            }
        }
        th = THINKER_next(th)
    }

    if STAT_gamemode() == ENEMY_COMMERCIAL {
        if STAT_gamemap() == 7 {
            if MOBJ_type(mo) == ENEMY_MT_FATSO {
                SPEC_ev_do_floor_tag(666, ENEMY_LOWERFLOORTOLOWEST)
                return
            }
            if MOBJ_type(mo) == ENEMY_MT_BABY {
                SPEC_ev_do_floor_tag(667, ENEMY_RAISETOTEXTURE)
                return
            }
        }
    } else {
        let ep: i32 = STAT_gameepisode()
        if ep == 1 {
            SPEC_ev_do_floor_tag(666, ENEMY_LOWERFLOORTOLOWEST)
            return
        }
        if ep == 4 {
            if STAT_gamemap() == 6 {
                SPEC_ev_do_door_tag(666, ENEMY_VLD_BLAZEOPEN)
                return
            }
            if STAT_gamemap() == 8 {
                SPEC_ev_do_floor_tag(666, ENEMY_LOWERFLOORTOLOWEST)
                return
            }
        }
    }

    G_ExitLevel()
}

