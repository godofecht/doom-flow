# ---- Boss brain -------------------------------------------------------

@flow_api
function A_BrainAwake(mo: ptr<void>) -> void {
    enemy_numbraintargets = 0
    enemy_braintargeton = 0

    let cap: ptr<void> = THINKER_cap()
    let mut thinker: ptr<void> = THINKER_next(cap)
    while (thinker as i64) != (cap as i64) {
        if THINKER_is_mobj(thinker) != 0 {
            let m: ptr<void> = thinker
            if MOBJ_type(m) == ENEMY_MT_BOSSTARGET {
                let n: i32 = enemy_numbraintargets
                enemy_braintargets[n] = m
                enemy_numbraintargets = n + 1
            }
        }
        thinker = THINKER_next(thinker)
    }
    S_StartSound(null, ENEMY_SFX_BOSSIT)
}

@flow_api
function A_BrainPain(mo: ptr<void>) -> void {
    S_StartSound(null, ENEMY_SFX_BOSPN)
}

@flow_api
function A_BrainScream(mo: ptr<void>) -> void {
    let mut x: i32 = MOBJ_x(mo) - 196 * ENEMY_FRACUNIT
    while x < MOBJ_x(mo) + 320 * ENEMY_FRACUNIT {
        let y: i32 = MOBJ_y(mo) - 320 * ENEMY_FRACUNIT
        let z: i32 = 128 + P_Random() * 2 * ENEMY_FRACUNIT
        let th: ptr<void> = P_SpawnMobj(x, y, z, ENEMY_MT_ROCKET)
        MOBJ_set_momz(th, P_Random() * 512)
        P_SetMobjState(th, ENEMY_S_BRAINEXPLODE1)
        MOBJ_set_tics(th, MOBJ_tics(th) - (P_Random() & 7))
        if MOBJ_tics(th) < 1 {
            MOBJ_set_tics(th, 1)
        }
        x = x + ENEMY_FRACUNIT * 8
    }
    S_StartSound(null, ENEMY_SFX_BOSDTH)
}

@flow_api
function A_BrainExplode(mo: ptr<void>) -> void {
    let x: i32 = MOBJ_x(mo) + (P_Random() - P_Random()) * 2048
    let y: i32 = MOBJ_y(mo)
    let z: i32 = 128 + P_Random() * 2 * ENEMY_FRACUNIT
    let th: ptr<void> = P_SpawnMobj(x, y, z, ENEMY_MT_ROCKET)
    MOBJ_set_momz(th, P_Random() * 512)
    P_SetMobjState(th, ENEMY_S_BRAINEXPLODE1)
    MOBJ_set_tics(th, MOBJ_tics(th) - (P_Random() & 7))
    if MOBJ_tics(th) < 1 {
        MOBJ_set_tics(th, 1)
    }
}

@flow_api
function A_BrainDie(mo: ptr<void>) -> void {
    G_ExitLevel()
}

@flow_api
function A_BrainSpit(mo: ptr<void>) -> void {
    enemy_brain_easy = enemy_brain_easy ^ 1
    if STAT_gameskill() <= ENEMY_SK_EASY and enemy_brain_easy == 0 {
        return
    }

    let targ: ptr<void> = enemy_braintargets[enemy_braintargeton]
    let n: i32 = enemy_numbraintargets
    enemy_braintargeton = (enemy_braintargeton + 1) % n

    let newmobj: ptr<void> = P_SpawnMissile(mo, targ, ENEMY_MT_SPAWNSHOT)
    MOBJ_set_target(newmobj, targ)
    MOBJ_set_reactiontime(newmobj,
        ((MOBJ_y(targ) - MOBJ_y(mo)) / MOBJ_momy(newmobj))
        / STATE_tics(MOBJ_state(newmobj)))
    S_StartSound(null, ENEMY_SFX_BOSPIT)
}

@flow_api
function A_SpawnFly(mo: ptr<void>) -> void {
    let rt: i32 = MOBJ_reactiontime(mo) - 1
    MOBJ_set_reactiontime(mo, rt)
    if rt != 0 {
        return
    }

    let targ: ptr<void> = P_SubstNullMobj(MOBJ_target(mo))
    let fog: ptr<void> = P_SpawnMobj(
        MOBJ_x(targ), MOBJ_y(targ), MOBJ_z(targ), ENEMY_MT_SPAWNFIRE)
    S_StartSound(fog, ENEMY_SFX_TELEPT)

    let r: i32 = P_Random()
    let mut typ: i32 = ENEMY_MT_BRUISER
    if r < 50 {
        typ = ENEMY_MT_TROOP
    } elif r < 90 {
        typ = ENEMY_MT_SERGEANT
    } elif r < 120 {
        typ = ENEMY_MT_SHADOWS
    } elif r < 130 {
        typ = ENEMY_MT_PAIN
    } elif r < 160 {
        typ = ENEMY_MT_HEAD
    } elif r < 162 {
        typ = ENEMY_MT_VILE
    } elif r < 172 {
        typ = ENEMY_MT_UNDEAD
    } elif r < 192 {
        typ = ENEMY_MT_BABY
    } elif r < 222 {
        typ = ENEMY_MT_FATSO
    } elif r < 246 {
        typ = ENEMY_MT_KNIGHT
    } else {
        typ = ENEMY_MT_BRUISER
    }

    let newmobj: ptr<void> = P_SpawnMobj(
        MOBJ_x(targ), MOBJ_y(targ), MOBJ_z(targ), typ)
    if enemy_LookForPlayers(newmobj, 1) != 0 {
        P_SetMobjState(newmobj, MOBJ_info_seestate(newmobj))
    }
    P_TeleportMove(newmobj, MOBJ_x(newmobj), MOBJ_y(newmobj))
    P_RemoveMobj(mo)
}

@flow_api
function A_SpawnSound(mo: ptr<void>) -> void {
    S_StartSound(mo, ENEMY_SFX_BOSCUB)
    A_SpawnFly(mo)
}

@flow_api
function A_PlayerScream(mo: ptr<void>) -> void {
    let mut sound: i32 = ENEMY_SFX_PLDETH
    if STAT_gamemode() == ENEMY_COMMERCIAL and MOBJ_health(mo) < 0 - 50 {
        sound = ENEMY_SFX_PDIEHI
    }
    S_StartSound(mo, sound)
}
