#
# R_InitTranslationTables
#
@flow_api
function R_InitTranslationTables() -> void {
    let tables: ptr<u8> = Z_Malloc(256 * 3, DRAW_PU_STATIC, null) as ptr<u8>
    drawshim_translationtables_addr()[0] = tables

    for i in 0 to 256 {
        if i >= 0x70 and i <= 0x7f {
            # map green ramp to gray, brown, red
            tables[i] = (0x60 + (i & 0xf)) as u8
            tables[i + 256] = (0x40 + (i & 0xf)) as u8
            tables[i + 512] = (0x20 + (i & 0xf)) as u8
        } else {
            # Keep all other colors as is.
            let v: u8 = i as u8
            tables[i] = v
            tables[i + 256] = v
            tables[i + 512] = v
        }
    }
}

#
# R_DrawSpan
#
@flow_api
function R_DrawSpan() -> void {
    # RANGECHECK
    if drawshim_ds_x2_addr()[0] < drawshim_ds_x1_addr()[0]
        or drawshim_ds_x1_addr()[0] < 0
        or drawshim_ds_x2_addr()[0] >= DRAW_SCREENWIDTH
        or (drawshim_ds_y_addr()[0] as u32) > (DRAW_SCREENHEIGHT as u32) {
        I_Error("R_DrawSpan: bad range")
    }

    let mut position: u32 = (((drawshim_ds_xfrac_addr()[0] as u32) << 10) & 0xffff0000 as u32)
        | (((drawshim_ds_yfrac_addr()[0] as u32) >> 6) & 0x0000ffff as u32)
    let step: u32 = (((drawshim_ds_xstep_addr()[0] as u32) << 10) & 0xffff0000 as u32)
        | (((drawshim_ds_ystep_addr()[0] as u32) >> 6) & 0x0000ffff as u32)

    let mut dest: ptr<u8> = draw_dest(drawshim_ds_y_addr()[0], drawshim_ds_x1_addr()[0])
    let mut count: i32 = drawshim_ds_x2_addr()[0] - drawshim_ds_x1_addr()[0]
    let colormap: ptr<u8> = drawshim_ds_colormap_addr()[0]
    let source: ptr<u8> = drawshim_ds_source_addr()[0]

    while true {
        let ytemp: u32 = (position >> 4) & 0x0fc0 as u32
        let xtemp: u32 = position >> 26
        let spot: i32 = (xtemp | ytemp) as i32
        dest[0] = colormap[source[spot] as i32]
        dest = draw_addr(dest, 1)
        position = position + step
        if count == 0 {
            break
        }
        count = count - 1
    }
}

#
# R_DrawSpanLow
#
@flow_api
function R_DrawSpanLow() -> void {
    # RANGECHECK
    if drawshim_ds_x2_addr()[0] < drawshim_ds_x1_addr()[0]
        or drawshim_ds_x1_addr()[0] < 0
        or drawshim_ds_x2_addr()[0] >= DRAW_SCREENWIDTH
        or (drawshim_ds_y_addr()[0] as u32) > (DRAW_SCREENHEIGHT as u32) {
        I_Error("R_DrawSpan: bad range")
    }

    let mut position: u32 = (((drawshim_ds_xfrac_addr()[0] as u32) << 10) & 0xffff0000 as u32)
        | (((drawshim_ds_yfrac_addr()[0] as u32) >> 6) & 0x0000ffff as u32)
    let step: u32 = (((drawshim_ds_xstep_addr()[0] as u32) << 10) & 0xffff0000 as u32)
        | (((drawshim_ds_ystep_addr()[0] as u32) >> 6) & 0x0000ffff as u32)

    let mut count: i32 = drawshim_ds_x2_addr()[0] - drawshim_ds_x1_addr()[0]

    # Blocky mode, need to multiply by 2.
    let ds_x1_p: ptr<i32> = drawshim_ds_x1_addr()
    let ds_x2_p: ptr<i32> = drawshim_ds_x2_addr()
    ds_x1_p[0] = ds_x1_p[0] << 1
    ds_x2_p[0] = ds_x2_p[0] << 1

    let mut dest: ptr<u8> = draw_dest(drawshim_ds_y_addr()[0], ds_x1_p[0])
    let colormap: ptr<u8> = drawshim_ds_colormap_addr()[0]
    let source: ptr<u8> = drawshim_ds_source_addr()[0]

    while true {
        let ytemp: u32 = (position >> 4) & 0x0fc0 as u32
        let xtemp: u32 = position >> 26
        let spot: i32 = (xtemp | ytemp) as i32
        let pix: u8 = colormap[source[spot] as i32]
        dest[0] = pix
        dest = draw_addr(dest, 1)
        dest[0] = pix
        dest = draw_addr(dest, 1)
        position = position + step
        if count == 0 {
            break
        }
        count = count - 1
    }
}

#
# R_InitBuffer
#
@flow_api
function R_InitBuffer(width: i32, height: i32) -> void {
    # Handle resize, e.g. smaller view windows with border and/or status bar.
    drawshim_viewwindowx_addr()[0] = (DRAW_SCREENWIDTH - width) >> 1

    # Column offset. For windows.
    let cols: ptr<i32> = drawshim_columnofs()
    let vwx: i32 = drawshim_viewwindowx_addr()[0]
    for i in 0 to width {
        cols[i] = vwx + i
    }

    # Same with base row offset.
    if width == DRAW_SCREENWIDTH {
        drawshim_viewwindowy_addr()[0] = 0
    } else {
        drawshim_viewwindowy_addr()[0] = (DRAW_SCREENHEIGHT - DRAW_SBARHEIGHT - height) >> 1
    }

    # Precalculate all row offsets.
    let rows: ptr<ptr<u8> > = drawshim_ylookup()
    let buf: ptr<u8> = VIDEO_buffer()
    let vwy: i32 = drawshim_viewwindowy_addr()[0]
    for i in 0 to height {
        rows[i] = draw_addr(buf, (i + vwy) * DRAW_SCREENWIDTH)
    }
}

#
# R_FillBackScreen
#
@flow_api
function R_FillBackScreen() -> void {
    # If we are running full screen, there is no need to do any of this,
    # and the background buffer can be freed if it was previously in use.
    if drawshim_scaledviewwidth_addr()[0] == DRAW_SCREENWIDTH {
        if (background_buffer as i64) != 0 {
            Z_Free(background_buffer as ptr<void>)
            background_buffer = null
        }
        return
    }

    # Allocate the background buffer if necessary
    if (background_buffer as i64) == 0 {
        background_buffer = Z_Malloc(
            DRAW_SCREENWIDTH * (DRAW_SCREENHEIGHT - DRAW_SBARHEIGHT),
            DRAW_PU_STATIC,
            null
        ) as ptr<u8>
    }

    # DEH_String is identity without FEATURE_DEHACKED
    let mut name: string = "FLOOR7_2"
    if STAT_gamemode() == DRAW_COMMERCIAL {
        name = "GRNROCK"
    }

    let src: ptr<u8> = W_CacheLumpName(name, DRAW_PU_CACHE) as ptr<u8>
    let mut dest: ptr<u8> = background_buffer

    for y in 0 to (DRAW_SCREENHEIGHT - DRAW_SBARHEIGHT) {
        for x in 0 to (DRAW_SCREENWIDTH / 64) {
            memcpy(dest as ptr<void>, draw_addr(src, (y & 63) << 6) as ptr<void>, 64)
            dest = draw_addr(dest, 64)
        }
        if (DRAW_SCREENWIDTH & 63) != 0 {
            let n: i32 = DRAW_SCREENWIDTH & 63
            memcpy(dest as ptr<void>, draw_addr(src, (y & 63) << 6) as ptr<void>, n as i64)
            dest = draw_addr(dest, n)
        }
    }

    # Draw screen and bezel; this is done to a separate screen buffer.
    V_UseBuffer(background_buffer)

    let vwx: i32 = drawshim_viewwindowx_addr()[0]
    let vwy: i32 = drawshim_viewwindowy_addr()[0]
    let svw: i32 = drawshim_scaledviewwidth_addr()[0]
    let vh: i32 = drawshim_viewheight_addr()[0]

    let mut patch: ptr<void> = W_CacheLumpName("brdr_t", DRAW_PU_CACHE)
    let mut x: i32 = 0
    while x < svw {
        V_DrawPatch(vwx + x, vwy - 8, patch)
        x = x + 8
    }

    patch = W_CacheLumpName("brdr_b", DRAW_PU_CACHE)
    x = 0
    while x < svw {
        V_DrawPatch(vwx + x, vwy + vh, patch)
        x = x + 8
    }

    patch = W_CacheLumpName("brdr_l", DRAW_PU_CACHE)
    let mut y: i32 = 0
    while y < vh {
        V_DrawPatch(vwx - 8, vwy + y, patch)
        y = y + 8
    }

    patch = W_CacheLumpName("brdr_r", DRAW_PU_CACHE)
    y = 0
    while y < vh {
        V_DrawPatch(vwx + svw, vwy + y, patch)
        y = y + 8
    }

    # Draw beveled edge.
    V_DrawPatch(vwx - 8, vwy - 8, W_CacheLumpName("brdr_tl", DRAW_PU_CACHE))
    V_DrawPatch(vwx + svw, vwy - 8, W_CacheLumpName("brdr_tr", DRAW_PU_CACHE))
    V_DrawPatch(vwx - 8, vwy + vh, W_CacheLumpName("brdr_bl", DRAW_PU_CACHE))
    V_DrawPatch(vwx + svw, vwy + vh, W_CacheLumpName("brdr_br", DRAW_PU_CACHE))

    V_RestoreBuffer()
}

#
# R_VideoErase
#
@flow_api
function R_VideoErase(ofs: u32, count: i32) -> void {
    if (background_buffer as i64) != 0 {
        memcpy(
            draw_addr(VIDEO_buffer(), ofs as i32) as ptr<void>,
            draw_addr(background_buffer, ofs as i32) as ptr<void>,
            count as i64
        )
    }
}

#
# R_DrawViewBorder
#
@flow_api
function R_DrawViewBorder() -> void {
    if drawshim_scaledviewwidth_addr()[0] == DRAW_SCREENWIDTH {
        return
    }

    let top: i32 = ((DRAW_SCREENHEIGHT - DRAW_SBARHEIGHT) - drawshim_viewheight_addr()[0]) / 2
    let mut side: i32 = (DRAW_SCREENWIDTH - drawshim_scaledviewwidth_addr()[0]) / 2

    # copy top and one line of left side
    R_VideoErase(0 as u32, top * DRAW_SCREENWIDTH + side)

    # copy one line of right side and bottom
    let mut ofs: i32 = (drawshim_viewheight_addr()[0] + top) * DRAW_SCREENWIDTH - side
    R_VideoErase(ofs as u32, top * DRAW_SCREENWIDTH + side)

    # copy sides using wraparound
    ofs = top * DRAW_SCREENWIDTH + DRAW_SCREENWIDTH - side
    side = side << 1

    for i in 1 to drawshim_viewheight_addr()[0] {
        R_VideoErase(ofs as u32, side)
        ofs = ofs + DRAW_SCREENWIDTH
    }

    V_MarkRect(0, 0, DRAW_SCREENWIDTH, DRAW_SCREENHEIGHT - DRAW_SBARHEIGHT)
}
