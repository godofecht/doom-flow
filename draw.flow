# per-module planeshim_set_ds_* clones.

@flow_api
function DRAW_set_ds_xstep(v: i32) -> void {
    drawshim_ds_xstep_addr()[0] = v
}

@flow_api
function DRAW_set_ds_ystep(v: i32) -> void {
    drawshim_ds_ystep_addr()[0] = v
}

