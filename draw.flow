#
# R_DrawColumn
#
@flow_api
function R_DrawColumn() -> void {
    let mut count: i32 = drawshim_dc_yh_addr()[0] - drawshim_dc_yl_addr()[0]
    if count < 0 {
        return
    }

    # RANGECHECK (doomdef.h)
    if (drawshim_dc_x_addr()[0] as u32) >= (DRAW_SCREENWIDTH as u32)
        or drawshim_dc_yl_addr()[0] < 0
        or drawshim_dc_yh_addr()[0] >= DRAW_SCREENHEIGHT {
        I_Error("R_DrawColumn: bad range")
    }

    let mut dest: ptr<u8> = draw_dest(drawshim_dc_yl_addr()[0], drawshim_dc_x_addr()[0])
    let fracstep: i32 = drawshim_dc_iscale_addr()[0]
    let mut frac: i32 = drawshim_dc_texturemid_addr()[0]
        + (drawshim_dc_yl_addr()[0] - RMAIN_centery()) * fracstep
    let colormap: ptr<u8> = drawshim_dc_colormap_addr()[0]
    let source: ptr<u8> = drawshim_dc_source_addr()[0]

    while true {
        dest[0] = colormap[source[(frac >> DRAW_FRACBITS) & 127] as i32]
        dest = draw_addr(dest, DRAW_SCREENWIDTH)
        frac = frac + fracstep
        if count == 0 {
            break
        }
        count = count - 1
    }
}

#
# R_DrawColumnLow
#
@flow_api
function R_DrawColumnLow() -> void {
    let mut count: i32 = drawshim_dc_yh_addr()[0] - drawshim_dc_yl_addr()[0]
    if count < 0 {
        return
    }

    # RANGECHECK
    if (drawshim_dc_x_addr()[0] as u32) >= (DRAW_SCREENWIDTH as u32)
        or drawshim_dc_yl_addr()[0] < 0
        or drawshim_dc_yh_addr()[0] >= DRAW_SCREENHEIGHT {
        I_Error("R_DrawColumn: bad range")
    }

    let x: i32 = drawshim_dc_x_addr()[0] << 1
    let mut dest: ptr<u8> = draw_dest(drawshim_dc_yl_addr()[0], x)
    let mut dest2: ptr<u8> = draw_dest(drawshim_dc_yl_addr()[0], x + 1)
    let fracstep: i32 = drawshim_dc_iscale_addr()[0]
    let mut frac: i32 = drawshim_dc_texturemid_addr()[0]
        + (drawshim_dc_yl_addr()[0] - RMAIN_centery()) * fracstep
    let colormap: ptr<u8> = drawshim_dc_colormap_addr()[0]
    let source: ptr<u8> = drawshim_dc_source_addr()[0]

    while true {
        let pix: u8 = colormap[source[(frac >> DRAW_FRACBITS) & 127] as i32]
        dest[0] = pix
        dest2[0] = pix
        dest = draw_addr(dest, DRAW_SCREENWIDTH)
        dest2 = draw_addr(dest2, DRAW_SCREENWIDTH)
        frac = frac + fracstep
        if count == 0 {
            break
        }
        count = count - 1
    }
}

#
# R_DrawFuzzColumn
#
@flow_api
function R_DrawFuzzColumn() -> void {
    let dc_yl_p: ptr<i32> = drawshim_dc_yl_addr()
    let dc_yh_p: ptr<i32> = drawshim_dc_yh_addr()

    # Adjust borders. Low...
    if dc_yl_p[0] == 0 {
        dc_yl_p[0] = 1
    }
    # .. and high.
    if dc_yh_p[0] == drawshim_viewheight_addr()[0] - 1 {
        dc_yh_p[0] = drawshim_viewheight_addr()[0] - 2
    }

    let mut count: i32 = dc_yh_p[0] - dc_yl_p[0]
    if count < 0 {
        return
    }

    # RANGECHECK
    if (drawshim_dc_x_addr()[0] as u32) >= (DRAW_SCREENWIDTH as u32)
        or dc_yl_p[0] < 0
        or dc_yh_p[0] >= DRAW_SCREENHEIGHT {
        I_Error("R_DrawFuzzColumn: bad range")
    }

    let mut dest: ptr<u8> = draw_dest(dc_yl_p[0], drawshim_dc_x_addr()[0])
    let fracstep: i32 = drawshim_dc_iscale_addr()[0]
    let mut frac: i32 = drawshim_dc_texturemid_addr()[0]
        + (dc_yl_p[0] - RMAIN_centery()) * fracstep
    let cmaps: ptr<u8> = RDATA_colormaps() as ptr<u8>
    let fuzzoff: ptr<i32> = drawshim_fuzzoffset()
    let fuzzpos_p: ptr<i32> = drawshim_fuzzpos_addr()

    while true {
        let sample: u8 = draw_addr(dest, fuzzoff[fuzzpos_p[0]])[0]
        dest[0] = cmaps[6 * 256 + (sample as i32)]
        fuzzpos_p[0] = fuzzpos_p[0] + 1
        if fuzzpos_p[0] == DRAW_FUZZTABLE {
            fuzzpos_p[0] = 0
        }
        dest = draw_addr(dest, DRAW_SCREENWIDTH)
        frac = frac + fracstep
        if count == 0 {
            break
        }
        count = count - 1
    }
}

#
# R_DrawFuzzColumnLow
#
@flow_api
function R_DrawFuzzColumnLow() -> void {
    let dc_yl_p: ptr<i32> = drawshim_dc_yl_addr()
    let dc_yh_p: ptr<i32> = drawshim_dc_yh_addr()

    if dc_yl_p[0] == 0 {
        dc_yl_p[0] = 1
    }
    if dc_yh_p[0] == drawshim_viewheight_addr()[0] - 1 {
        dc_yh_p[0] = drawshim_viewheight_addr()[0] - 2
    }

    let mut count: i32 = dc_yh_p[0] - dc_yl_p[0]
    if count < 0 {
        return
    }

    let x: i32 = drawshim_dc_x_addr()[0] << 1

    # RANGECHECK
    if (x as u32) >= (DRAW_SCREENWIDTH as u32)
        or dc_yl_p[0] < 0
        or dc_yh_p[0] >= DRAW_SCREENHEIGHT {
        I_Error("R_DrawFuzzColumn: bad range")
    }

    let mut dest: ptr<u8> = draw_dest(dc_yl_p[0], x)
    let mut dest2: ptr<u8> = draw_dest(dc_yl_p[0], x + 1)
    let fracstep: i32 = drawshim_dc_iscale_addr()[0]
    let mut frac: i32 = drawshim_dc_texturemid_addr()[0]
        + (dc_yl_p[0] - RMAIN_centery()) * fracstep
    let cmaps: ptr<u8> = RDATA_colormaps() as ptr<u8>
    let fuzzoff: ptr<i32> = drawshim_fuzzoffset()
    let fuzzpos_p: ptr<i32> = drawshim_fuzzpos_addr()

    while true {
        let fo: i32 = fuzzoff[fuzzpos_p[0]]
        dest[0] = cmaps[6 * 256 + (draw_addr(dest, fo)[0] as i32)]
        dest2[0] = cmaps[6 * 256 + (draw_addr(dest2, fo)[0] as i32)]
        fuzzpos_p[0] = fuzzpos_p[0] + 1
        if fuzzpos_p[0] == DRAW_FUZZTABLE {
            fuzzpos_p[0] = 0
        }
        dest = draw_addr(dest, DRAW_SCREENWIDTH)
        dest2 = draw_addr(dest2, DRAW_SCREENWIDTH)
        frac = frac + fracstep
        if count == 0 {
            break
        }
        count = count - 1
    }
}

#
# R_DrawTranslatedColumn
#
@flow_api
function R_DrawTranslatedColumn() -> void {
    let mut count: i32 = drawshim_dc_yh_addr()[0] - drawshim_dc_yl_addr()[0]
    if count < 0 {
        return
    }

    # RANGECHECK
    if (drawshim_dc_x_addr()[0] as u32) >= (DRAW_SCREENWIDTH as u32)
        or drawshim_dc_yl_addr()[0] < 0
        or drawshim_dc_yh_addr()[0] >= DRAW_SCREENHEIGHT {
        I_Error("R_DrawColumn: bad range")
    }

    let mut dest: ptr<u8> = draw_dest(drawshim_dc_yl_addr()[0], drawshim_dc_x_addr()[0])
    let fracstep: i32 = drawshim_dc_iscale_addr()[0]
    let mut frac: i32 = drawshim_dc_texturemid_addr()[0]
        + (drawshim_dc_yl_addr()[0] - RMAIN_centery()) * fracstep
    let colormap: ptr<u8> = drawshim_dc_colormap_addr()[0]
    let translation: ptr<u8> = drawshim_dc_translation_addr()[0]
    let source: ptr<u8> = drawshim_dc_source_addr()[0]

    while true {
        dest[0] = colormap[translation[source[frac >> DRAW_FRACBITS] as i32] as i32]
        dest = draw_addr(dest, DRAW_SCREENWIDTH)
        frac = frac + fracstep
        if count == 0 {
            break
        }
        count = count - 1
    }
}

