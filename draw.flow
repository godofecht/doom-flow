# Span/column drawing, ported from r_draw.c to Flow.
#
# Public ABI matches r_draw.h. Shared globals (viewwidth, columnofs,
# ylookup, view*/dc_*/ds_*, fuzz*, translationtables) are Flow-owned
# let mut state with @flow_api DRAW_* / drawshim_* accessors. centery
# lives in rmain.flow (RMAIN_centery). background_buffer stays private.

extern { function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void> }
extern { function calloc(n: i64, sz: i64) -> ptr<void> }

extern { function I_Error(msg: string) -> void }
extern { function Z_Malloc(size: i32, tag: i32, user: ptr<void>) -> ptr<void> }
extern { function Z_Free(p: ptr<void>) -> void }
extern { function W_CacheLumpName(name: string, tag: i32) -> ptr<void> }

extern { function V_UseBuffer(buffer: ptr<u8>) -> void }
extern { function V_RestoreBuffer() -> void }
extern { function V_DrawPatch(x: i32, y: i32, patch: ptr<void>) -> void }
extern { function V_MarkRect(x: i32, y: i32, width: i32, height: i32) -> void }

extern { function RMAIN_centery() -> i32 }
extern { function RDATA_colormaps() -> ptr<void> }
extern { function VIDEO_buffer() -> ptr<u8> }

# Shared doomstat-style globals (game.flow / tick.flow)
extern { function STAT_gamemode() -> i32 }
extern { function STAT_set_gamemode(v: i32) -> void }
extern { function STAT_gameversion() -> i32 }
extern { function STAT_set_gameversion(v: i32) -> void }
extern { function STAT_gameepisode() -> i32 }
extern { function STAT_set_gameepisode(v: i32) -> void }
extern { function STAT_gamemap() -> i32 }
extern { function STAT_set_gamemap(v: i32) -> void }
extern { function STAT_deathmatch() -> i32 }
extern { function STAT_set_deathmatch(v: i32) -> void }
extern { function STAT_netgame() -> i32 }
extern { function STAT_set_netgame(v: i32) -> void }
extern { function STAT_playeringame(i: i32) -> i32 }
extern { function STAT_set_playeringame(i: i32, v: i32) -> void }
extern { function STAT_consoleplayer() -> i32 }
extern { function STAT_set_consoleplayer(v: i32) -> void }
extern { function STAT_leveltime() -> i32 }
extern { function STAT_set_leveltime(v: i32) -> void }

# r_draw.c / i_video.h / doomdef.h / m_fixed.h / z_zone.h / d_mode.h
# (prefixed: one Flow TU, const names must be unique)
const DRAW_SCREENWIDTH: i32 = 320
const DRAW_SCREENHEIGHT: i32 = 200
const DRAW_SBARHEIGHT: i32 = 32
const DRAW_FRACBITS: i32 = 16
const DRAW_FUZZTABLE: i32 = 50
const DRAW_FUZZOFF: i32 = 320          # SCREENWIDTH
const DRAW_MAXWIDTH: i32 = 1120
const DRAW_MAXHEIGHT: i32 = 832
const DRAW_PU_STATIC: i32 = 1
const DRAW_PU_CACHE: i32 = 8
const DRAW_COMMERCIAL: i32 = 2

# Backing buffer for the bezel (was static in r_draw.c)
let mut background_buffer: ptr<u8> = null

# ---- shared globals (were DEFINEd in draw_shim.c / r_draw.c) ---------

let mut viewwidth: i32 = 0
let mut scaledviewwidth: i32 = 0
let mut viewheight: i32 = 0
let mut viewwindowx: i32 = 0
let mut viewwindowy: i32 = 0

let mut columnofs: ptr<i32> = null
let mut ylookup: ptr<ptr<u8> > = null

let mut dc_colormap: ptr<u8> = null
let mut dc_x: i32 = 0
let mut dc_yl: i32 = 0
let mut dc_yh: i32 = 0
let mut dc_iscale: i32 = 0
let mut dc_texturemid: i32 = 0
let mut dc_source: ptr<u8> = null
let mut dc_translation: ptr<u8> = null
let mut translationtables: ptr<u8> = null

let mut fuzzpos: i32 = 0
let mut fuzzoffset: array<i32, 50> = [
    320, -320, 320, -320, 320, 320, -320, 320, 320, -320,
    320, 320, 320, -320, 320, 320, 320, -320, -320, -320,
    -320, 320, -320, -320, 320, 320, 320, 320, -320, 320,
    -320, 320, 320, -320, -320, 320, 320, -320, -320, -320,
    -320, 320, 320, 320, 320, -320, 320, 320, -320, 320
]

let mut ds_y: i32 = 0
let mut ds_x1: i32 = 0
let mut ds_x2: i32 = 0
let mut ds_colormap: ptr<u8> = null
let mut ds_xfrac: i32 = 0
let mut ds_yfrac: i32 = 0
let mut ds_xstep: i32 = 0
let mut ds_ystep: i32 = 0
let mut ds_source: ptr<u8> = null

function draw_ensure_buffers() -> void {
    if (columnofs as i64) == 0 {
        columnofs = calloc(DRAW_MAXWIDTH as i64, 4) as ptr<i32>
        ylookup = calloc(DRAW_MAXHEIGHT as i64, 8) as ptr<ptr<u8> >
    }
}

@flow_api
function drawshim_ylookup() -> ptr<ptr<u8> > {
    draw_ensure_buffers()
    return ylookup
}

@flow_api
function drawshim_columnofs() -> ptr<i32> {
    draw_ensure_buffers()
    return columnofs
}

@flow_api
function drawshim_viewwidth_addr() -> ptr<i32> { return &viewwidth }

@flow_api
function drawshim_scaledviewwidth_addr() -> ptr<i32> { return &scaledviewwidth }

@flow_api
function drawshim_viewheight_addr() -> ptr<i32> { return &viewheight }

@flow_api
function drawshim_viewwindowx_addr() -> ptr<i32> { return &viewwindowx }

@flow_api
function drawshim_viewwindowy_addr() -> ptr<i32> { return &viewwindowy }

@flow_api
function drawshim_dc_colormap_addr() -> ptr<ptr<u8> > { return &dc_colormap }

@flow_api
function drawshim_dc_x_addr() -> ptr<i32> { return &dc_x }

@flow_api
function drawshim_dc_yl_addr() -> ptr<i32> { return &dc_yl }

@flow_api
function drawshim_dc_yh_addr() -> ptr<i32> { return &dc_yh }

@flow_api
function drawshim_dc_iscale_addr() -> ptr<i32> { return &dc_iscale }

@flow_api
function drawshim_dc_texturemid_addr() -> ptr<i32> { return &dc_texturemid }

@flow_api
function drawshim_dc_source_addr() -> ptr<ptr<u8> > { return &dc_source }

@flow_api
function drawshim_fuzzoffset() -> ptr<i32> { return &fuzzoffset[0] }

@flow_api
function drawshim_fuzzpos_addr() -> ptr<i32> { return &fuzzpos }

@flow_api
function drawshim_dc_translation_addr() -> ptr<ptr<u8> > { return &dc_translation }

@flow_api
function drawshim_translationtables_addr() -> ptr<ptr<u8> > { return &translationtables }

@flow_api
function drawshim_ds_y_addr() -> ptr<i32> { return &ds_y }

@flow_api
function drawshim_ds_x1_addr() -> ptr<i32> { return &ds_x1 }

@flow_api
function drawshim_ds_x2_addr() -> ptr<i32> { return &ds_x2 }

@flow_api
function drawshim_ds_colormap_addr() -> ptr<ptr<u8> > { return &ds_colormap }

@flow_api
function drawshim_ds_xfrac_addr() -> ptr<i32> { return &ds_xfrac }

@flow_api
function drawshim_ds_yfrac_addr() -> ptr<i32> { return &ds_yfrac }

@flow_api
function drawshim_ds_xstep_addr() -> ptr<i32> { return &ds_xstep }

@flow_api
function drawshim_ds_ystep_addr() -> ptr<i32> { return &ds_ystep }

@flow_api
function drawshim_ds_source_addr() -> ptr<ptr<u8> > { return &ds_source }

function draw_addr(base: ptr<u8>, off: i32) -> ptr<u8> {
    return ((base as i64) + off as i64) as ptr<u8>
}

function draw_dest(yl: i32, x: i32) -> ptr<u8> {
    let rows: ptr<ptr<u8> > = drawshim_ylookup()
    let cols: ptr<i32> = drawshim_columnofs()
    return draw_addr(rows[yl], cols[x])
}

