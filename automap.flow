    -1048576, 0, 1198372, 0,          #  { -R+R/8, 0 }, { R, 0 }
    1198372, 0, 599186, 299593,       #  { R, 0 }, { R-R/2, R/4 }
    1198372, 0, 599186, -299593,      #  { R, 0 }, { R-R/2, -R/4 }
    -1048576, 0, -1348168, 299593,    #  { -R+R/8, 0 }, { -R-R/8, R/4 }
    -1048576, 0, -1348168, -299593,   #  { -R+R/8, 0 }, { -R-R/8, -R/4 }
    -748983, 0, -1048576, 299593,     #  { -R+3*R/8, 0 }, { -R+R/8, R/4 }
    -748983, 0, -1048576, -299593     #  { -R+3*R/8, 0 }, { -R+R/8, -R/4 }
]

