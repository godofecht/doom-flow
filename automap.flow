function AM_set_automapactive(v: i32) -> void { automapactive = v }

function am_marked_spot_message(num: i32) -> string {
    if (am_markmsg_buf as i64) == 0 {
        am_markmsg_buf = calloc(20, 1) as ptr<u8>
    }
    am_markmsg_buf[0] = 77 as u8   # 'M'
    am_markmsg_buf[1] = 97 as u8   # 'a'
    am_markmsg_buf[2] = 114 as u8  # 'r'
    am_markmsg_buf[3] = 107 as u8  # 'k'
    am_markmsg_buf[4] = 101 as u8  # 'e'
    am_markmsg_buf[5] = 100 as u8  # 'd'
    am_markmsg_buf[6] = 32 as u8   # ' '
    am_markmsg_buf[7] = 83 as u8   # 'S'
    am_markmsg_buf[8] = 112 as u8  # 'p'
    am_markmsg_buf[9] = 111 as u8  # 'o'
    am_markmsg_buf[10] = 116 as u8 # 't'
    am_markmsg_buf[11] = 32 as u8  # ' '
    if num >= 10 {
        am_markmsg_buf[12] = (48 + num / 10) as u8
        am_markmsg_buf[13] = (48 + num % 10) as u8
        am_markmsg_buf[14] = 0
    } else {
        am_markmsg_buf[12] = (48 + num) as u8
        am_markmsg_buf[13] = 0
    }
    return am_markmsg_buf as string
}

function am_ammnum_name(i: i32) -> string {
    if (am_ammnum_buf as i64) == 0 {
        am_ammnum_buf = calloc(9, 1) as ptr<u8>
    }
    am_ammnum_buf[0] = 65 as u8   # 'A'
    am_ammnum_buf[1] = 77 as u8   # 'M'
    am_ammnum_buf[2] = 77 as u8   # 'M'
    am_ammnum_buf[3] = 78 as u8   # 'N'
    am_ammnum_buf[4] = 85 as u8   # 'U'
    am_ammnum_buf[5] = 77 as u8   # 'M'
    if i >= 10 {
        am_ammnum_buf[6] = (48 + i / 10) as u8
        am_ammnum_buf[7] = (48 + i % 10) as u8
        am_ammnum_buf[8] = 0
    } else {
        am_ammnum_buf[6] = (48 + i) as u8
        am_ammnum_buf[7] = 0
    }
    return am_ammnum_buf as string
}

