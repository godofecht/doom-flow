@flow_api
function PLAYER_message(p: ptr<void>) -> ptr<u8> { return pl_ptr(p as i64, PLAYER_OFF_MESSAGE) as ptr<u8> }
@flow_api
function PLAYER_psp(p: ptr<void>, i: i32) -> ptr<void> {
    return ((p as i64) + (PLAYER_OFF_PSPRITES + i * PSPDEF_SIZEOF) as i64) as ptr<void>
}

# Player-embedded ticcmd: PLAYER_cmd_* thin-wraps bare CMD_* on &player->cmd.
# Raw ticcmd_t* buffers (demo I/O, BuildTiccmd) call CMD_* directly.

@flow_api
function PLAYER_cmd(p: ptr<void>) -> ptr<void> { return ((p as i64) + PLAYER_OFF_CMD as i64) as ptr<void> }
@flow_api
function PLAYER_cmd_forwardmove(p: ptr<void>) -> i32 { return CMD_forwardmove(PLAYER_cmd(p)) }
@flow_api
function PLAYER_cmd_sidemove(p: ptr<void>) -> i32 { return CMD_sidemove(PLAYER_cmd(p)) }
@flow_api
function PLAYER_cmd_angleturn(p: ptr<void>) -> i32 { return CMD_angleturn(PLAYER_cmd(p)) }
@flow_api
function PLAYER_cmd_buttons(p: ptr<void>) -> i32 { return CMD_buttons(PLAYER_cmd(p)) }
@flow_api
function PLAYER_cmd_consistancy(p: ptr<void>) -> i32 { return CMD_consistancy(PLAYER_cmd(p)) }
@flow_api
function PLAYER_cmd_set_angleturn(p: ptr<void>, v: i32) -> void { CMD_set_angleturn(PLAYER_cmd(p), v) }
@flow_api
function PLAYER_cmd_set_forwardmove(p: ptr<void>, v: i32) -> void { CMD_set_forwardmove(PLAYER_cmd(p), v) }
@flow_api
function PLAYER_cmd_set_sidemove(p: ptr<void>, v: i32) -> void { CMD_set_sidemove(PLAYER_cmd(p), v) }
@flow_api
function PLAYER_cmd_set_buttons(p: ptr<void>, v: i32) -> void { CMD_set_buttons(PLAYER_cmd(p), v) }
@flow_api
function PLAYER_cmd_chatchar(p: ptr<void>) -> i32 { return CMD_chatchar(PLAYER_cmd(p)) }
@flow_api
function PLAYER_cmd_set_chatchar(p: ptr<void>, v: i32) -> void { CMD_set_chatchar(PLAYER_cmd(p), v) }
@flow_api
function PLAYER_i_cmd_buttons(i: i32) -> i32 { return CMD_buttons(PLAYER_cmd(PLAYER_at(i))) }
@flow_api
function PLAYER_i_usedown(i: i32) -> i32 { return PLAYER_usedown(PLAYER_at(i)) }
@flow_api
function PLAYER_i_set_usedown(i: i32, v: i32) -> void { PLAYER_set_usedown(PLAYER_at(i), v) }
@flow_api
function PLAYER_i_attackdown(i: i32) -> i32 { return PLAYER_attackdown(PLAYER_at(i)) }
@flow_api
function PLAYER_i_set_attackdown(i: i32, v: i32) -> void { PLAYER_set_attackdown(PLAYER_at(i), v) }

@flow_api
function PLAYER_clear_frags(p: ptr<void>) -> void {
    let base: i64 = p as i64
    for i in 0 to PLAYER_MAXPLAYERS {
        pl_set_i32(base, PLAYER_OFF_FRAGS + i * 4, 0)
    }
}
@flow_api
function PLAYER_finish_level(p: ptr<void>) -> void {
    let base: i64 = p as i64
    for i in 0 to PLAYER_NUMPOWERS {
        pl_set_i32(base, PLAYER_OFF_POWERS + i * 4, 0)
    }
    for i in 0 to PLAYER_NUMCARDS {
        pl_set_i32(base, PLAYER_OFF_CARDS + i * 4, 0)
    }
    let mo: ptr<void> = PLAYER_mo(p)
    MOBJ_set_flags(mo, MOBJ_flags(mo) & (0 - 1 - USER_MF_SHADOW))
    pl_set_i32(base, PLAYER_OFF_EXTRALIGHT, 0)
    pl_set_i32(base, PLAYER_OFF_FIXEDCOLORMAP, 0)
    pl_set_i32(base, PLAYER_OFF_DAMAGECOUNT, 0)
    pl_set_i32(base, PLAYER_OFF_BONUSCOUNT, 0)
}
@flow_api
function PLAYER_reborn_core(player: i32) -> void {
    let p: ptr<void> = PLAYER_at(player)
    let base: i64 = p as i64

    let f0: i32 = pl_i32(base, PLAYER_OFF_FRAGS + 0 * 4)
    let f1: i32 = pl_i32(base, PLAYER_OFF_FRAGS + 1 * 4)
    let f2: i32 = pl_i32(base, PLAYER_OFF_FRAGS + 2 * 4)
    let f3: i32 = pl_i32(base, PLAYER_OFF_FRAGS + 3 * 4)
    let killcount: i32 = pl_i32(base, PLAYER_OFF_KILLCOUNT)
    let itemcount: i32 = pl_i32(base, PLAYER_OFF_ITEMCOUNT)
    let secretcount: i32 = pl_i32(base, PLAYER_OFF_SECRETCOUNT)

    memset(p, 0, PLAYER_SIZEOF as i64)

    pl_set_i32(base, PLAYER_OFF_FRAGS + 0 * 4, f0)
    pl_set_i32(base, PLAYER_OFF_FRAGS + 1 * 4, f1)
    pl_set_i32(base, PLAYER_OFF_FRAGS + 2 * 4, f2)
    pl_set_i32(base, PLAYER_OFF_FRAGS + 3 * 4, f3)
    pl_set_i32(base, PLAYER_OFF_KILLCOUNT, killcount)
    pl_set_i32(base, PLAYER_OFF_ITEMCOUNT, itemcount)
    pl_set_i32(base, PLAYER_OFF_SECRETCOUNT, secretcount)

    pl_set_i32(base, PLAYER_OFF_USEDOWN, 1)
    pl_set_i32(base, PLAYER_OFF_ATTACKDOWN, 1)
    pl_set_i32(base, PLAYER_OFF_PLAYERSTATE, USER_PST_LIVE)
    pl_set_i32(base, PLAYER_OFF_HEALTH, PLAYER_DEH_INITIAL_HEALTH)
    pl_set_i32(base, PLAYER_OFF_READYWEAPON, USER_WP_PISTOL)
    pl_set_i32(base, PLAYER_OFF_PENDINGWEAPON, USER_WP_PISTOL)
    pl_set_i32(base, PLAYER_OFF_WEAPONOWNED + USER_WP_FIST * 4, 1)
    pl_set_i32(base, PLAYER_OFF_WEAPONOWNED + USER_WP_PISTOL * 4, 1)
    pl_set_i32(base, PLAYER_OFF_AMMO + USER_AM_CLIP * 4, PLAYER_DEH_INITIAL_BULLETS)

    for i in 0 to PLAYER_NUMAMMO {
        pl_set_i32(base, PLAYER_OFF_MAXAMMO + i * 4, INFO_maxammo(i))
    }
}

# ---- P_Thrust ---------------------------------------------------------

function P_Thrust(player: ptr<void>, angle: u32, move: i32) -> void {
    let a: u32 = angle >> USER_ANGLETOFINESHIFT
    let mo: ptr<void> = PLAYER_mo(player)
    MOBJ_set_momx(mo, MOBJ_momx(mo) + FixedMul(move, TABLES_finecosine(a as i32)))
    MOBJ_set_momy(mo, MOBJ_momy(mo) + FixedMul(move, TABLES_finesine(a as i32)))
}

# ---- P_CalcHeight -----------------------------------------------------

function P_CalcHeight(player: ptr<void>) -> void {
    let mo: ptr<void> = PLAYER_mo(player)

    let mut bob: i32 = FixedMul(MOBJ_momx(mo), MOBJ_momx(mo))
        + FixedMul(MOBJ_momy(mo), MOBJ_momy(mo))
    bob = bob >> 2
    if bob > USER_MAXBOB {
        bob = USER_MAXBOB
    }
    PLAYER_set_bob(player, bob)

    if (PLAYER_cheats(player) & USER_CF_NOMOMENTUM) != 0 or onground == 0 {
        PLAYER_set_viewz(player, MOBJ_z(mo) + USER_VIEWHEIGHT)
        if PLAYER_viewz(player) > MOBJ_ceilingz(mo) - 4 * USER_FRACUNIT {
            PLAYER_set_viewz(player, MOBJ_ceilingz(mo) - 4 * USER_FRACUNIT)
        }
        PLAYER_set_viewz(player, MOBJ_z(mo) + PLAYER_viewheight(player))
        return
    }

    let angle: i32 = (USER_FINEANGLES / 20 * STAT_leveltime()) & USER_FINEMASK
    bob = FixedMul(PLAYER_bob(player) / 2, TABLES_finesine(angle as i32))

    if PLAYER_playerstate(player) == USER_PST_LIVE {
        PLAYER_set_viewheight(player,
            PLAYER_viewheight(player) + PLAYER_deltaviewheight(player))

        if PLAYER_viewheight(player) > USER_VIEWHEIGHT {
            PLAYER_set_viewheight(player, USER_VIEWHEIGHT)
            PLAYER_set_deltaviewheight(player, 0)
        }

        if PLAYER_viewheight(player) < USER_VIEWHEIGHT / 2 {
            PLAYER_set_viewheight(player, USER_VIEWHEIGHT / 2)
            if PLAYER_deltaviewheight(player) <= 0 {
                PLAYER_set_deltaviewheight(player, 1)
            }
        }

        if PLAYER_deltaviewheight(player) != 0 {
            PLAYER_set_deltaviewheight(player,
                PLAYER_deltaviewheight(player) + USER_FRACUNIT / 4)
            if PLAYER_deltaviewheight(player) == 0 {
                PLAYER_set_deltaviewheight(player, 1)
            }
        }
    }

    PLAYER_set_viewz(player,
        MOBJ_z(mo) + PLAYER_viewheight(player) + bob)

    if PLAYER_viewz(player) > MOBJ_ceilingz(mo) - 4 * USER_FRACUNIT {
        PLAYER_set_viewz(player, MOBJ_ceilingz(mo) - 4 * USER_FRACUNIT)
    }
}

# ---- P_MovePlayer -----------------------------------------------------

function P_MovePlayer(player: ptr<void>) -> void {
    let mo: ptr<void> = PLAYER_mo(player)

    MOBJ_set_angle(mo,
        MOBJ_angle(mo) + ((PLAYER_cmd_angleturn(player) << 16) as u32))

    if MOBJ_z(mo) <= MOBJ_floorz(mo) {
        onground = 1
    } else {
        onground = 0
    }

    let fwd: i32 = PLAYER_cmd_forwardmove(player)
    let side: i32 = PLAYER_cmd_sidemove(player)

    if fwd != 0 and onground != 0 {
        P_Thrust(player, MOBJ_angle(mo), fwd * 2048)
    }

    if side != 0 and onground != 0 {
        P_Thrust(player, MOBJ_angle(mo) - USER_ANG90, side * 2048)
    }

    if (fwd != 0 or side != 0) and (MOBJ_state(mo) as i64) == (STATE_at(USER_S_PLAY) as i64) {
        P_SetMobjState(mo, USER_S_PLAY_RUN1)
    }
}

# ---- P_DeathThink -----------------------------------------------------

function P_DeathThink(player: ptr<void>) -> void {
    P_MovePsprites(player)

    if PLAYER_viewheight(player) > 6 * USER_FRACUNIT {
        PLAYER_set_viewheight(player, PLAYER_viewheight(player) - USER_FRACUNIT)
    }

    if PLAYER_viewheight(player) < 6 * USER_FRACUNIT {
        PLAYER_set_viewheight(player, 6 * USER_FRACUNIT)
    }

    PLAYER_set_deltaviewheight(player, 0)

    let mo: ptr<void> = PLAYER_mo(player)
    if MOBJ_z(mo) <= MOBJ_floorz(mo) {
        onground = 1
    } else {
        onground = 0
    }
    P_CalcHeight(player)

    let attacker: ptr<void> = PLAYER_attacker(player)
    if (attacker as i64) != 0 and (attacker as i64) != (mo as i64) {
        let angle: u32 = R_PointToAngle2(
            MOBJ_x(mo), MOBJ_y(mo),
            MOBJ_x(attacker), MOBJ_y(attacker))
        let delta: u32 = angle - MOBJ_angle(mo)
        # (unsigned)-ANG5
        let neg_ang5: u32 = (0 as u32) - USER_ANG5

        if delta < USER_ANG5 or delta > neg_ang5 {
            MOBJ_set_angle(mo, angle)
            if PLAYER_damagecount(player) != 0 {
                PLAYER_set_damagecount(player, PLAYER_damagecount(player) - 1)
            }
        } else {
            if delta < USER_ANG180 {
                MOBJ_set_angle(mo, MOBJ_angle(mo) + USER_ANG5)
            } else {
                MOBJ_set_angle(mo, MOBJ_angle(mo) - USER_ANG5)
            }
        }
    } else {
        if PLAYER_damagecount(player) != 0 {
            PLAYER_set_damagecount(player, PLAYER_damagecount(player) - 1)
        }
    }

    if (PLAYER_cmd_buttons(player) & USER_BT_USE) != 0 {
        PLAYER_set_playerstate(player, USER_PST_REBORN)
    }
}

# ---- P_PlayerThink ----------------------------------------------------

@flow_api
function P_PlayerThink(player: ptr<void>) -> void {
    let mo: ptr<void> = PLAYER_mo(player)

    if (PLAYER_cheats(player) & USER_CF_NOCLIP) != 0 {
        MOBJ_set_flags(mo, MOBJ_flags(mo) | USER_MF_NOCLIP)
    } else {
        MOBJ_set_flags(mo, MOBJ_flags(mo) & (0 - 1 - USER_MF_NOCLIP))
    }

    if (MOBJ_flags(mo) & USER_MF_JUSTATTACKED) != 0 {
        PLAYER_cmd_set_angleturn(player, 0)
        PLAYER_cmd_set_forwardmove(player, USER_CHAINSAW_FORWARD)
        PLAYER_cmd_set_sidemove(player, 0)
        MOBJ_set_flags(mo, MOBJ_flags(mo) & (0 - 1 - USER_MF_JUSTATTACKED))
    }

    if PLAYER_playerstate(player) == USER_PST_DEAD {
        P_DeathThink(player)
        return
    }

    if MOBJ_reactiontime(mo) != 0 {
        MOBJ_set_reactiontime(mo, MOBJ_reactiontime(mo) - 1)
    } else {
        P_MovePlayer(player)
    }

    P_CalcHeight(player)

    if GEOM_sector_special(GEOM_subsector_sector(MOBJ_subsector(mo))) != 0 {
        P_PlayerInSpecialSector(player)
    }

    if (PLAYER_cmd_buttons(player) & USER_BT_SPECIAL) != 0 {
        PLAYER_cmd_set_buttons(player, 0)
    }

    if (PLAYER_cmd_buttons(player) & USER_BT_CHANGE) != 0 {
        let mut newweapon: i32 = (PLAYER_cmd_buttons(player) & USER_BT_WEAPONMASK) >> USER_BT_WEAPONSHIFT

        if newweapon == USER_WP_FIST and PLAYER_weaponowned(player, USER_WP_CHAINSAW) != 0 {
            if !(PLAYER_readyweapon(player) == USER_WP_CHAINSAW
                and PLAYER_power(player, USER_PW_STRENGTH) != 0) {
                newweapon = USER_WP_CHAINSAW
            }
        }

        if STAT_gamemode() == USER_COMMERCIAL and newweapon == USER_WP_SHOTGUN
            and PLAYER_weaponowned(player, USER_WP_SUPERSHOTGUN) != 0
            and PLAYER_readyweapon(player) != USER_WP_SUPERSHOTGUN {
            newweapon = USER_WP_SUPERSHOTGUN
        }

        if PLAYER_weaponowned(player, newweapon) != 0
            and newweapon != PLAYER_readyweapon(player) {
            if (newweapon != USER_WP_PLASMA and newweapon != USER_WP_BFG)
                or STAT_gamemode() != USER_SHAREWARE {
                PLAYER_set_pendingweapon(player, newweapon)
            }
        }
    }

    if (PLAYER_cmd_buttons(player) & USER_BT_USE) != 0 {
        if PLAYER_usedown(player) == 0 {
            P_UseLines(player)
            PLAYER_set_usedown(player, 1)
        }
    } else {
        PLAYER_set_usedown(player, 0)
    }

    P_MovePsprites(player)

    if PLAYER_power(player, USER_PW_STRENGTH) != 0 {
        PLAYER_set_power(player, USER_PW_STRENGTH,
            PLAYER_power(player, USER_PW_STRENGTH) + 1)
    }

    if PLAYER_power(player, USER_PW_INVULNERABILITY) != 0 {
        PLAYER_set_power(player, USER_PW_INVULNERABILITY,
            PLAYER_power(player, USER_PW_INVULNERABILITY) - 1)
    }

    if PLAYER_power(player, USER_PW_INVISIBILITY) != 0 {
        let inv: i32 = PLAYER_power(player, USER_PW_INVISIBILITY) - 1
        PLAYER_set_power(player, USER_PW_INVISIBILITY, inv)
        if inv == 0 {
            MOBJ_set_flags(mo, MOBJ_flags(mo) & (0 - 1 - USER_MF_SHADOW))
        }
    }

    if PLAYER_power(player, USER_PW_INFRARED) != 0 {
        PLAYER_set_power(player, USER_PW_INFRARED,
            PLAYER_power(player, USER_PW_INFRARED) - 1)
    }

    if PLAYER_power(player, USER_PW_IRONFEET) != 0 {
        PLAYER_set_power(player, USER_PW_IRONFEET,
            PLAYER_power(player, USER_PW_IRONFEET) - 1)
    }

    if PLAYER_damagecount(player) != 0 {
        PLAYER_set_damagecount(player, PLAYER_damagecount(player) - 1)
    }

    if PLAYER_bonuscount(player) != 0 {
        PLAYER_set_bonuscount(player, PLAYER_bonuscount(player) - 1)
    }

    if PLAYER_power(player, USER_PW_INVULNERABILITY) != 0 {
        let inv2: i32 = PLAYER_power(player, USER_PW_INVULNERABILITY)
        if inv2 > 4 * 32 or (inv2 & 8) != 0 {
            PLAYER_set_fixedcolormap(player, USER_INVERSECOLORMAP)
        } else {
            PLAYER_set_fixedcolormap(player, 0)
        }
    } else {
        if PLAYER_power(player, USER_PW_INFRARED) != 0 {
            let ir: i32 = PLAYER_power(player, USER_PW_INFRARED)
            if ir > 4 * 32 or (ir & 8) != 0 {
                PLAYER_set_fixedcolormap(player, 1)
            } else {
                PLAYER_set_fixedcolormap(player, 0)
            }
        } else {
            PLAYER_set_fixedcolormap(player, 0)
        }
    }
}
