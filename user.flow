# Player movement / thinking, ported from p_user.c to Flow.
#
# Handles bobbing POV height, thrust from ticcmd, death fall-to-face,
# weapon change, use, power-up counters and fixedcolormap.
#
# player_t / ticcmd_t / pspdef_t field access uses LP64 offsetof helpers
# (PLAYER_OFF_*, pl_i32 / pl_ptr). players[] lives in game_state.flow
# (gameshim_player_at). onground is private to this module.
#
# LP64 offsetof tables (PLAYER_OFF_* below):
#
#   player_t (sizeof 328 = PLAYER_SIZEOF)
#     mo 0, playerstate 8, cmd 12, viewz 28, viewheight 32,
#     deltaviewheight 36, bob 40, health 44, armorpoints 48,
#     armortype 52, powers 56, cards 80, backpack 104, frags 108,
#     readyweapon 124, pendingweapon 128, weaponowned 132, ammo 168,
#     maxammo 184, attackdown 200, usedown 204, cheats 208, refire 212,
#     killcount 216, itemcount 220, secretcount 224, message 232,
#     damagecount 240, bonuscount 244, attacker 248, extralight 256,
#     fixedcolormap 260, colormap 264, psprites 272, didsecret 320
#
#   ticcmd_t (sizeof 16 = TICCMD_SIZEOF, embedded at player_t.cmd) —
#   accessors CMD_* / gameshim_cmd_*:
#     forwardmove 0 (i8), sidemove 1 (i8), angleturn 2 (i16),
#     chatchar 4, buttons 5, consistancy 6
#
#   pspdef_t (sizeof 24 = PSPDEF_SIZEOF, embedded in player_t.psprites[]):
#     state 0 (ptr), tics 8, sx 12, sy 16
#
#   weaponinfo_t (sizeof 24 = WEAPONINFO_SIZEOF): see items.flow
#
#   mobj_t: see sight.flow / mobj.flow MOBJ_OFF_*

