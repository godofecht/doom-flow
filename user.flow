@flow_api
function PLAYER_bob(p: ptr<void>) -> i32 { return pl_i32(p as i64, PLAYER_OFF_BOB) }
@flow_api
function PLAYER_set_bob(p: ptr<void>, v: i32) -> void { pl_set_i32(p as i64, PLAYER_OFF_BOB, v) }
@flow_api
function PLAYER_cheats(p: ptr<void>) -> i32 { return pl_i32(p as i64, PLAYER_OFF_CHEATS) }
@flow_api
function PLAYER_set_cheats(p: ptr<void>, v: i32) -> void { pl_set_i32(p as i64, PLAYER_OFF_CHEATS, v) }
@flow_api
function PLAYER_frags(p: ptr<void>, i: i32) -> i32 { return pl_i32(p as i64, PLAYER_OFF_FRAGS + i * 4) }
@flow_api
function PLAYER_inc_frag(p: ptr<void>, idx: i32) -> void {
    let base: i64 = p as i64
    let off: i32 = PLAYER_OFF_FRAGS + idx * 4
    pl_set_i32(base, off, pl_i32(base, off) + 1)
}
@flow_api
