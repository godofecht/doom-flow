# ---- private state ----------------------------------------------------

let mut onground: i32 = 0

# ---- LP64 offsetof helpers (mirrors sg_* in saveg.flow / geom_* in setup.flow)

function pl_i32(base: i64, off: i32) -> i32 {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    return p[0]
}

function pl_set_i32(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    p[0] = v
}

function pl_ptr(base: i64, off: i32) -> ptr<void> {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    return p[0] as ptr<void>
}

function pl_set_ptr(base: i64, off: i32, v: ptr<void>) -> void {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    p[0] = v as i64
}

# Shared player_t field accessors. Prefer these over per-module *shim_player_* clones.

@flow_api
function PLAYER_at(i: i32) -> ptr<void> { return gameshim_player_at(i) }
@flow_api
function PLAYER_index(p: ptr<void>) -> i32 {
    let players0: i64 = gameshim_player_at(0) as i64
    return (((p as i64) - players0) / (PLAYER_SIZEOF as i64)) as i32
}
@flow_api
function PLAYER_index_plus1(pl: ptr<void>) -> i32 {
    if (pl as i64) == 0 {
        return 0
    }
    return PLAYER_index(pl) + 1
}
@flow_api
function PLAYER_mo(p: ptr<void>) -> ptr<void> { return pl_ptr(p as i64, PLAYER_OFF_MO) }
@flow_api
function PLAYER_set_mo(p: ptr<void>, m: ptr<void>) -> void { pl_set_ptr(p as i64, PLAYER_OFF_MO, m) }
@flow_api
function PLAYER_playerstate(p: ptr<void>) -> i32 { return pl_i32(p as i64, PLAYER_OFF_PLAYERSTATE) }
@flow_api
function PLAYER_set_playerstate(p: ptr<void>, v: i32) -> void { pl_set_i32(p as i64, PLAYER_OFF_PLAYERSTATE, v) }
@flow_api
function PLAYER_viewz(p: ptr<void>) -> i32 { return pl_i32(p as i64, PLAYER_OFF_VIEWZ) }
@flow_api
function PLAYER_set_viewz(p: ptr<void>, v: i32) -> void { pl_set_i32(p as i64, PLAYER_OFF_VIEWZ, v) }
@flow_api
function PLAYER_viewheight(p: ptr<void>) -> i32 { return pl_i32(p as i64, PLAYER_OFF_VIEWHEIGHT) }
@flow_api
