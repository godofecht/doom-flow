# ---- offset helpers for C-owned records -------------------------------

function sg_base(p: ptr<void>) -> i64 {
    return p as i64
}

function sg_i8(base: i64, off: i32) -> i32 {
    let p: ptr<i8> = (base + off as i64) as ptr<i8>
    return p[0] as i32
}

function sg_set_i8(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i8> = (base + off as i64) as ptr<i8>
    p[0] = v as i8
}

function sg_u8(base: i64, off: i32) -> i32 {
    let p: ptr<u8> = (base + off as i64) as ptr<u8>
    return p[0] as i32
}

function sg_set_u8(base: i64, off: i32, v: i32) -> void {
    let p: ptr<u8> = (base + off as i64) as ptr<u8>
    p[0] = v as u8
}

function sg_i16(base: i64, off: i32) -> i32 {
    let p: ptr<i16> = (base + off as i64) as ptr<i16>
    return p[0] as i32
}

function sg_set_i16(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i16> = (base + off as i64) as ptr<i16>
    p[0] = v as i16
}

function sg_i32(base: i64, off: i32) -> i32 {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    return p[0]
}

function sg_set_i32(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    p[0] = v
}

function sg_u32(base: i64, off: i32) -> u32 {
    let p: ptr<u32> = (base + off as i64) as ptr<u32>
    return p[0]
}

function sg_set_u32(base: i64, off: i32, v: u32) -> void {
    let p: ptr<u32> = (base + off as i64) as ptr<u32>
    p[0] = v
}

function sg_ptr(base: i64, off: i32) -> ptr<void> {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    return p[0] as ptr<void>
}

function sg_set_ptr(base: i64, off: i32, v: ptr<void>) -> void {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    p[0] = v as i64
}

# ---- endian-safe stream I/O -------------------------------------------

function saveg_read8() -> u8 {
    let mut result: u8 = 0
    let stream: ptr<void> = savegshim_save_stream()
    if fread((&result) as ptr<void>, 1, 1, stream) < 1 {
        if savegshim_savegame_error() == 0 {
            savegshim_stderr_msg("saveg_read8: Unexpected end of file while reading save game\n")
            savegshim_set_savegame_error(1)
        }
    }
    return result
}

function saveg_write8(value: u8) -> void {
    let mut v: u8 = value
    let stream: ptr<void> = savegshim_save_stream()
    if fwrite((&v) as ptr<void>, 1, 1, stream) < 1 {
        if savegshim_savegame_error() == 0 {
            savegshim_stderr_msg("saveg_write8: Error while writing save game\n")
            savegshim_set_savegame_error(1)
        }
    }
}

function saveg_read16() -> i32 {
    let mut result: i32 = saveg_read8() as i32
    result = result | ((saveg_read8() as i32) << 8)
    return (result as i16) as i32
}

function saveg_write16(value: i32) -> void {
    saveg_write8((value & 255) as u8)
    saveg_write8(((value >> 8) & 255) as u8)
}

function saveg_read32() -> i32 {
    let mut result: i32 = saveg_read8() as i32
    result = result | ((saveg_read8() as i32) << 8)
    result = result | ((saveg_read8() as i32) << 16)
    result = result | ((saveg_read8() as i32) << 24)
    return result
}

function saveg_write32(value: i32) -> void {
    saveg_write8((value & 255) as u8)
    saveg_write8(((value >> 8) & 255) as u8)
    saveg_write8(((value >> 16) & 255) as u8)
    saveg_write8(((value >> 24) & 255) as u8)
}

function saveg_read_pad() -> void {
    let pos: i64 = ftell(savegshim_save_stream())
    let padding: i32 = (4 - ((pos as i32) & 3)) & 3
    for _i in 0 to padding {
        let _b: u8 = saveg_read8()
    }
}

function saveg_write_pad() -> void {
    let pos: i64 = ftell(savegshim_save_stream())
    let padding: i32 = (4 - ((pos as i32) & 3)) & 3
    for _i in 0 to padding {
        saveg_write8(0 as u8)
    }
}

function saveg_readp() -> ptr<void> {
    return (saveg_read32() as i64) as ptr<void>
}

function saveg_writep(p: ptr<void>) -> void {
    saveg_write32((p as i64) as i32)
}

# ---- mapthing_t (via shared MTHING_* from mobj.flow) ------------------

function saveg_read_mapthing_t(str: ptr<void>) -> void {
    MTHING_set_x(str, saveg_read16())
    MTHING_set_y(str, saveg_read16())
    MTHING_set_angle(str, saveg_read16())
    MTHING_set_type(str, saveg_read16())
    MTHING_set_options(str, saveg_read16())
}

function saveg_write_mapthing_t(str: ptr<void>) -> void {
    saveg_write16(MTHING_x(str))
    saveg_write16(MTHING_y(str))
    saveg_write16(MTHING_angle(str))
    saveg_write16(MTHING_type(str))
    saveg_write16(MTHING_options(str))
}

# ---- thinker_t / actionf_t --------------------------------------------

function saveg_read_thinker_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    sg_set_ptr(b, 0, saveg_readp())
    sg_set_ptr(b, 8, saveg_readp())
    sg_set_ptr(b, 16, saveg_readp())
}

function saveg_write_thinker_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    saveg_writep(sg_ptr(b, 0))
    saveg_writep(sg_ptr(b, 8))
    saveg_writep(sg_ptr(b, 16))
}

# ---- mobj_t -----------------------------------------------------------

function saveg_read_mobj_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    saveg_read_thinker_t(str)

    sg_set_i32(b, 24, saveg_read32())
    sg_set_i32(b, 28, saveg_read32())
    sg_set_i32(b, 32, saveg_read32())
    sg_set_ptr(b, 40, saveg_readp())
    sg_set_ptr(b, 48, saveg_readp())
    sg_set_u32(b, 56, saveg_read32() as u32)
    sg_set_i32(b, 60, saveg_read32())
    sg_set_i32(b, 64, saveg_read32())
    sg_set_ptr(b, 72, saveg_readp())
    sg_set_ptr(b, 80, saveg_readp())
    sg_set_ptr(b, 88, saveg_readp())
    sg_set_i32(b, 96, saveg_read32())
    sg_set_i32(b, 100, saveg_read32())
    sg_set_i32(b, 104, saveg_read32())
    sg_set_i32(b, 108, saveg_read32())
    sg_set_i32(b, 112, saveg_read32())
    sg_set_i32(b, 116, saveg_read32())
    sg_set_i32(b, 120, saveg_read32())
    sg_set_i32(b, 124, saveg_read32())
    sg_set_i32(b, 128, saveg_read32())
    sg_set_ptr(b, 136, saveg_readp())
    sg_set_i32(b, 144, saveg_read32())
    sg_set_ptr(b, 152, STATE_at(saveg_read32()))
    sg_set_i32(b, 160, saveg_read32())
    sg_set_i32(b, 164, saveg_read32())
    sg_set_i32(b, 168, saveg_read32())
    sg_set_i32(b, 172, saveg_read32())
    sg_set_ptr(b, 176, saveg_readp())
    sg_set_i32(b, 184, saveg_read32())
    sg_set_i32(b, 188, saveg_read32())

    let pl: i32 = saveg_read32()
    if pl > 0 {
        let player: ptr<void> = PLAYER_at(pl - 1)
        sg_set_ptr(b, 192, player)
        PLAYER_set_mo(player, str)
    } else {
        sg_set_ptr(b, 192, null)
    }

    sg_set_i32(b, 200, saveg_read32())
    saveg_read_mapthing_t(((b + 204) as ptr<void>))
    sg_set_ptr(b, 216, saveg_readp())
}

function saveg_write_mobj_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    saveg_write_thinker_t(str)

    saveg_write32(sg_i32(b, 24))
    saveg_write32(sg_i32(b, 28))
    saveg_write32(sg_i32(b, 32))
    saveg_writep(sg_ptr(b, 40))
    saveg_writep(sg_ptr(b, 48))
    saveg_write32(sg_u32(b, 56) as i32)
    saveg_write32(sg_i32(b, 60))
    saveg_write32(sg_i32(b, 64))
    saveg_writep(sg_ptr(b, 72))
    saveg_writep(sg_ptr(b, 80))
    saveg_writep(sg_ptr(b, 88))
    saveg_write32(sg_i32(b, 96))
    saveg_write32(sg_i32(b, 100))
    saveg_write32(sg_i32(b, 104))
    saveg_write32(sg_i32(b, 108))
    saveg_write32(sg_i32(b, 112))
    saveg_write32(sg_i32(b, 116))
    saveg_write32(sg_i32(b, 120))
    saveg_write32(sg_i32(b, 124))
    saveg_write32(sg_i32(b, 128))
    saveg_writep(sg_ptr(b, 136))
    saveg_write32(sg_i32(b, 144))
    saveg_write32(STATE_index(sg_ptr(b, 152)))
    saveg_write32(sg_i32(b, 160))
    saveg_write32(sg_i32(b, 164))
    saveg_write32(sg_i32(b, 168))
    saveg_write32(sg_i32(b, 172))
    saveg_writep(sg_ptr(b, 176))
    saveg_write32(sg_i32(b, 184))
    saveg_write32(sg_i32(b, 188))
    saveg_write32(PLAYER_index_plus1(sg_ptr(b, 192)))
    saveg_write32(sg_i32(b, 200))
    saveg_write_mapthing_t(((b + 204) as ptr<void>))
    saveg_writep(sg_ptr(b, 216))
}

# ---- ticcmd_t (embedded at player+12) ---------------------------------

function saveg_read_ticcmd_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    sg_set_i8(b, 0, saveg_read8() as i32)
    sg_set_i8(b, 1, saveg_read8() as i32)
    sg_set_i16(b, 2, saveg_read16())
    # save format: consistancy as 16-bit, then chatchar, buttons
    let cons: i32 = saveg_read16()
    sg_set_u8(b, 6, cons & 255)
    sg_set_u8(b, 4, saveg_read8() as i32)
    sg_set_u8(b, 5, saveg_read8() as i32)
}

function saveg_write_ticcmd_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    saveg_write8(sg_i8(b, 0) as u8)
    saveg_write8(sg_i8(b, 1) as u8)
    saveg_write16(sg_i16(b, 2))
    saveg_write16(sg_u8(b, 6))
    saveg_write8(sg_u8(b, 4) as u8)
    saveg_write8(sg_u8(b, 5) as u8)
}

# ---- pspdef_t ---------------------------------------------------------

function saveg_read_pspdef_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    let state: i32 = saveg_read32()
    if state > 0 {
        sg_set_ptr(b, 0, STATE_at(state))
    } else {
        sg_set_ptr(b, 0, null)
    }
    sg_set_i32(b, 8, saveg_read32())
    sg_set_i32(b, 12, saveg_read32())
    sg_set_i32(b, 16, saveg_read32())
}

function saveg_write_pspdef_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    let st: ptr<void> = sg_ptr(b, 0)
    if (st as i64) != 0 {
        saveg_write32(STATE_index(st))
    } else {
        saveg_write32(0)
    }
    saveg_write32(sg_i32(b, 8))
    saveg_write32(sg_i32(b, 12))
    saveg_write32(sg_i32(b, 16))
}

# ---- player_t ---------------------------------------------------------

function saveg_read_player_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    sg_set_ptr(b, 0, saveg_readp())
    sg_set_i32(b, 8, saveg_read32())
    saveg_read_ticcmd_t(((b + 12) as ptr<void>))
    sg_set_i32(b, 28, saveg_read32())
    sg_set_i32(b, 32, saveg_read32())
    sg_set_i32(b, 36, saveg_read32())
    sg_set_i32(b, 40, saveg_read32())
    sg_set_i32(b, 44, saveg_read32())
    sg_set_i32(b, 48, saveg_read32())
    sg_set_i32(b, 52, saveg_read32())

    for i in 0 to SAVEG_NUMPOWERS {
        sg_set_i32(b, 56 + i * 4, saveg_read32())
    }
    for i in 0 to SAVEG_NUMCARDS {
        sg_set_i32(b, 80 + i * 4, saveg_read32())
    }
    sg_set_i32(b, 104, saveg_read32())
    for i in 0 to SAVEG_MAXPLAYERS {
        sg_set_i32(b, 108 + i * 4, saveg_read32())
    }
    sg_set_i32(b, 124, saveg_read32())
    sg_set_i32(b, 128, saveg_read32())
    for i in 0 to SAVEG_NUMWEAPONS {
        sg_set_i32(b, 132 + i * 4, saveg_read32())
    }
    for i in 0 to SAVEG_NUMAMMO {
        sg_set_i32(b, 168 + i * 4, saveg_read32())
    }
    for i in 0 to SAVEG_NUMAMMO {
        sg_set_i32(b, 184 + i * 4, saveg_read32())
    }
    sg_set_i32(b, 200, saveg_read32())
    sg_set_i32(b, 204, saveg_read32())
    sg_set_i32(b, 208, saveg_read32())
    sg_set_i32(b, 212, saveg_read32())
    sg_set_i32(b, 216, saveg_read32())
    sg_set_i32(b, 220, saveg_read32())
    sg_set_i32(b, 224, saveg_read32())
    sg_set_ptr(b, 232, saveg_readp())
    sg_set_i32(b, 240, saveg_read32())
    sg_set_i32(b, 244, saveg_read32())
    sg_set_ptr(b, 248, saveg_readp())
    sg_set_i32(b, 256, saveg_read32())
    sg_set_i32(b, 260, saveg_read32())
    sg_set_i32(b, 264, saveg_read32())
    for i in 0 to SAVEG_NUMPSPRITES {
        saveg_read_pspdef_t(((b + 272 + i * 24) as ptr<void>))
    }
    sg_set_i32(b, 320, saveg_read32())
}

function saveg_write_player_t(str: ptr<void>) -> void {
    let b: i64 = sg_base(str)
    saveg_writep(sg_ptr(b, 0))
    saveg_write32(sg_i32(b, 8))
    saveg_write_ticcmd_t(((b + 12) as ptr<void>))
    saveg_write32(sg_i32(b, 28))
    saveg_write32(sg_i32(b, 32))
    saveg_write32(sg_i32(b, 36))
    saveg_write32(sg_i32(b, 40))
    saveg_write32(sg_i32(b, 44))
    saveg_write32(sg_i32(b, 48))
    saveg_write32(sg_i32(b, 52))
    for i in 0 to SAVEG_NUMPOWERS {
        saveg_write32(sg_i32(b, 56 + i * 4))
    }
    for i in 0 to SAVEG_NUMCARDS {
        saveg_write32(sg_i32(b, 80 + i * 4))
    }
    saveg_write32(sg_i32(b, 104))
    for i in 0 to SAVEG_MAXPLAYERS {
        saveg_write32(sg_i32(b, 108 + i * 4))
    }
    saveg_write32(sg_i32(b, 124))
    saveg_write32(sg_i32(b, 128))
    for i in 0 to SAVEG_NUMWEAPONS {
        saveg_write32(sg_i32(b, 132 + i * 4))
    }
    for i in 0 to SAVEG_NUMAMMO {
        saveg_write32(sg_i32(b, 168 + i * 4))
    }
    for i in 0 to SAVEG_NUMAMMO {
        saveg_write32(sg_i32(b, 184 + i * 4))
    }
    saveg_write32(sg_i32(b, 200))
    saveg_write32(sg_i32(b, 204))
    saveg_write32(sg_i32(b, 208))
    saveg_write32(sg_i32(b, 212))
    saveg_write32(sg_i32(b, 216))
    saveg_write32(sg_i32(b, 220))
    saveg_write32(sg_i32(b, 224))
    saveg_writep(sg_ptr(b, 232))
    saveg_write32(sg_i32(b, 240))
    saveg_write32(sg_i32(b, 244))
    saveg_writep(sg_ptr(b, 248))
    saveg_write32(sg_i32(b, 256))
    saveg_write32(sg_i32(b, 260))
    saveg_write32(sg_i32(b, 264))
    for i in 0 to SAVEG_NUMPSPRITES {
        saveg_write_pspdef_t(((b + 272 + i * 24) as ptr<void>))
    }
    saveg_write32(sg_i32(b, 320))
}

