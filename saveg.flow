# Savegame I/O / archiving, ported from p_saveg.c to Flow.
#
# Endian-safe byte stream + structure serializers live here. Globals
# save_stream / savegame_error are Flow-owned. Path / error helpers too.
#
# LP64 offsetof (verified against doomgeneric headers):
#
#   thinker_t: prev 0, next 8, function 16  SIZEOF 24
#   mapthing_t: x 0, y 2, angle 4, type 6, options 8  SIZEOF 10
#   mobj_t SIZEOF 224 — see sight.flow / user.flow
#   ticcmd_t: fm 0, sm 1, angleturn 2, chatchar 4, buttons 5,
#             consistancy 6  SIZEOF 16
#   pspdef_t: state 0, tics 8, sx 12, sy 16  SIZEOF 24
#   player_t SIZEOF 328 — see user.flow
#   sector_t: floorheight 0, ceilingheight 4, floorpic 8, ceilingpic 10,
#             lightlevel 12, special 14, tag 16, specialdata 104,
#             soundtarget 24  SIZEOF 128
#   line_t: flags 24, special 26, tag 28, sidenum 30  SIZEOF 88
#   side_t: textureoffset 0, rowoffset 4, top 8, bot 10, mid 12 SIZEOF 24
#   ceiling_t 72, vldoor_t 64, floormove_t 64, plat_t 72,
#   lightflash_t 56, strobe_t 56, glow_t 48 — see ceiling/doors/floor/
#   plats/lights.flow

