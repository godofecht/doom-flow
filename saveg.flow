# ---- public ABI -------------------------------------------------------

@flow_api
function P_TempSaveGameFile() -> string {
    return savegshim_temp_savegame_file()
}

@flow_api
function P_SaveGameFile(slot: i32) -> string {
    return savegshim_savegame_file(slot)
}

@flow_api
function P_WriteSaveGameHeader(description: string) -> void {
    let desc: ptr<u8> = description as ptr<u8>
    let mut i: i32 = 0
    while desc[i] as i32 != 0 {
        saveg_write8(desc[i])
        i = i + 1
    }
    while i < SAVEG_SAVESTRINGSIZE {
        saveg_write8(0 as u8)
        i = i + 1
    }

    let name: ptr<u8> = malloc(SAVEG_VERSIONSIZE as i64) as ptr<u8>
    savegshim_fill_version_string(name, SAVEG_VERSIONSIZE)
    for j in 0 to SAVEG_VERSIONSIZE {
        saveg_write8(name[j])
    }
    free(name as ptr<void>)

    saveg_write8(STAT_gameskill() as u8)
    saveg_write8(STAT_gameepisode() as u8)
    saveg_write8(STAT_gamemap() as u8)

    for k in 0 to SAVEG_MAXPLAYERS {
        saveg_write8(STAT_playeringame(k) as u8)
    }

    let lt: i32 = STAT_leveltime()
    saveg_write8(((lt >> 16) & 255) as u8)
    saveg_write8(((lt >> 8) & 255) as u8)
    saveg_write8((lt & 255) as u8)
}

@flow_api
function P_ReadSaveGameHeader() -> i32 {
    for _i in 0 to SAVEG_SAVESTRINGSIZE {
        let _b: u8 = saveg_read8()
    }

    let read_vcheck: ptr<u8> = malloc(SAVEG_VERSIONSIZE as i64) as ptr<u8>
    for i in 0 to SAVEG_VERSIONSIZE {
        read_vcheck[i] = saveg_read8()
    }

    let vcheck: ptr<u8> = malloc(SAVEG_VERSIONSIZE as i64) as ptr<u8>
    savegshim_fill_version_string(vcheck, SAVEG_VERSIONSIZE)
    if strcmp(read_vcheck as string, vcheck as string) != 0 {
        free(read_vcheck as ptr<void>)
        free(vcheck as ptr<void>)
        return 0
    }
    free(read_vcheck as ptr<void>)
    free(vcheck as ptr<void>)

    STAT_set_gameskill(saveg_read8() as i32)
    STAT_set_gameepisode(saveg_read8() as i32)
    STAT_set_gamemap(saveg_read8() as i32)

    for i in 0 to SAVEG_MAXPLAYERS {
        STAT_set_playeringame(i, saveg_read8() as i32)
    }

    let a: i32 = saveg_read8() as i32
    let b: i32 = saveg_read8() as i32
    let c: i32 = saveg_read8() as i32
    STAT_set_leveltime((a << 16) + (b << 8) + c)
    return 1
}

@flow_api
function P_ReadSaveGameEOF() -> i32 {
    let value: i32 = saveg_read8() as i32
    if value == SAVEG_EOF {
        return 1
    }
    return 0
}

@flow_api
function P_WriteSaveGameEOF() -> void {
    saveg_write8(SAVEG_EOF as u8)
}

@flow_api
function P_ArchivePlayers() -> void {
    for i in 0 to SAVEG_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            saveg_write_pad()
            saveg_write_player_t(PLAYER_at(i))
        }
    }
}

@flow_api
function P_UnArchivePlayers() -> void {
    for i in 0 to SAVEG_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            saveg_read_pad()
            let pl: ptr<void> = PLAYER_at(i)
            saveg_read_player_t(pl)
            let b: i64 = sg_base(pl)
            sg_set_ptr(b, 0, null)
            sg_set_ptr(b, 232, null)
            sg_set_ptr(b, 248, null)
        }
    }
}

@flow_api
function P_ArchiveWorld() -> void {
    let nsec: i32 = GEOM_numsectors()
    for i in 0 to nsec {
        let sec: i64 = sg_base(GEOM_sector(i))
        saveg_write16(sg_i32(sec, 0) >> SAVEG_FRACBITS)
        saveg_write16(sg_i32(sec, 4) >> SAVEG_FRACBITS)
        saveg_write16(sg_i16(sec, 8))
        saveg_write16(sg_i16(sec, 10))
        saveg_write16(sg_i16(sec, 12))
        saveg_write16(sg_i16(sec, 14))
        saveg_write16(sg_i16(sec, 16))
    }

    let nlines: i32 = GEOM_numlines()
    for i in 0 to nlines {
        let li: i64 = sg_base(GEOM_line(i))
        saveg_write16(sg_i16(li, 24))
        saveg_write16(sg_i16(li, 26))
        saveg_write16(sg_i16(li, 28))
        for j in 0 to 2 {
            let sidenum: i32 = sg_i16(li, 30 + j * 2)
            if sidenum != 0 - 1 {
                let si: i64 = sg_base(GEOM_side(sidenum))
                saveg_write16(sg_i32(si, 0) >> SAVEG_FRACBITS)
                saveg_write16(sg_i32(si, 4) >> SAVEG_FRACBITS)
                saveg_write16(sg_i16(si, 8))
                saveg_write16(sg_i16(si, 10))
                saveg_write16(sg_i16(si, 12))
            }
        }
    }
}

@flow_api
function P_UnArchiveWorld() -> void {
    let nsec: i32 = GEOM_numsectors()
    for i in 0 to nsec {
        let sec: i64 = sg_base(GEOM_sector(i))
        sg_set_i32(sec, 0, saveg_read16() << SAVEG_FRACBITS)
        sg_set_i32(sec, 4, saveg_read16() << SAVEG_FRACBITS)
        sg_set_i16(sec, 8, saveg_read16())
        sg_set_i16(sec, 10, saveg_read16())
        sg_set_i16(sec, 12, saveg_read16())
        sg_set_i16(sec, 14, saveg_read16())
        sg_set_i16(sec, 16, saveg_read16())
        sg_set_ptr(sec, 104, null)
        sg_set_ptr(sec, 24, null)
    }

    let nlines: i32 = GEOM_numlines()
    for i in 0 to nlines {
        let li: i64 = sg_base(GEOM_line(i))
        sg_set_i16(li, 24, saveg_read16())
        sg_set_i16(li, 26, saveg_read16())
        sg_set_i16(li, 28, saveg_read16())
        for j in 0 to 2 {
            let sidenum: i32 = sg_i16(li, 30 + j * 2)
            if sidenum != 0 - 1 {
                let si: i64 = sg_base(GEOM_side(sidenum))
                sg_set_i32(si, 0, saveg_read16() << SAVEG_FRACBITS)
                sg_set_i32(si, 4, saveg_read16() << SAVEG_FRACBITS)
                sg_set_i16(si, 8, saveg_read16())
                sg_set_i16(si, 10, saveg_read16())
                sg_set_i16(si, 12, saveg_read16())
            }
        }
    }
}

@flow_api
function P_ArchiveThinkers() -> void {
    let cap: ptr<void> = THINKER_cap()
    let mut th: ptr<void> = THINKER_next(cap)
    while (th as i64) != (cap as i64) {
        if THINKER_is_mobj(th) != 0 {
            saveg_write8(SAVEG_TC_MOBJ as u8)
            saveg_write_pad()
            saveg_write_mobj_t(th)
        }
        th = THINKER_next(th)
    }
    saveg_write8(SAVEG_TC_END as u8)
}

@flow_api
function P_UnArchiveThinkers() -> void {
    let cap: ptr<void> = THINKER_cap()
    let mut currentthinker: ptr<void> = THINKER_next(cap)
    while (currentthinker as i64) != (cap as i64) {
        let next: ptr<void> = THINKER_next(currentthinker)
        if THINKER_is_mobj(currentthinker) != 0 {
            P_RemoveMobj(currentthinker)
        } else {
            Z_Free(currentthinker)
        }
        currentthinker = next
    }
    P_InitThinkers()

    while 1 == 1 {
        let tclass: i32 = saveg_read8() as i32
        if tclass == SAVEG_TC_END {
            return
        } elif tclass == SAVEG_TC_MOBJ {
            saveg_read_pad()
            let mobj: ptr<void> = Z_Malloc(SAVEG_SIZEOF_MOBJ, SAVEG_PU_LEVEL, null)
            saveg_read_mobj_t(mobj)
            let mb: i64 = sg_base(mobj)
            sg_set_ptr(mb, 176, null)
            sg_set_ptr(mb, 216, null)
            P_SetThingPosition(mobj)
            sg_set_ptr(mb, 136, INFO_mobjinfo_at(sg_i32(mb, 128)))
            let sec: ptr<void> = GEOM_subsector_sector(MOBJ_subsector(mobj))
            MOBJ_set_floorz(mobj, GEOM_sector_floorheight(sec))
            MOBJ_set_ceilingz(mobj, GEOM_sector_ceilingheight(sec))
            THINKER_set_mobj(mobj)
            P_AddThinker(mobj)
        } else {
            savegshim_error_unknown_tclass(tclass)
        }
    }
}

@flow_api
function P_ArchiveSpecials() -> void {
    let cap: ptr<void> = THINKER_cap()
    let mut th: ptr<void> = THINKER_next(cap)
    while (th as i64) != (cap as i64) {
        if THINKER_is_null(th) != 0 {
            let idx: i32 = P_ActiveCeilingIndex(th)
            if idx >= 0 {
                saveg_write8(SAVEG_TC_CEILING as u8)
                saveg_write_pad()
                saveg_write_ceiling_t(th)
            }
        } elif THINKER_is_move_ceiling(th) != 0 {
            saveg_write8(SAVEG_TC_CEILING as u8)
            saveg_write_pad()
            saveg_write_ceiling_t(th)
        } elif THINKER_is_vertical_door(th) != 0 {
            saveg_write8(SAVEG_TC_DOOR as u8)
            saveg_write_pad()
            saveg_write_vldoor_t(th)
        } elif THINKER_is_move_floor(th) != 0 {
            saveg_write8(SAVEG_TC_FLOOR as u8)
            saveg_write_pad()
            saveg_write_floormove_t(th)
        } elif THINKER_is_plat_raise(th) != 0 {
            saveg_write8(SAVEG_TC_PLAT as u8)
            saveg_write_pad()
            saveg_write_plat_t(th)
        } elif THINKER_is_light_flash(th) != 0 {
            saveg_write8(SAVEG_TC_FLASH as u8)
            saveg_write_pad()
            saveg_write_lightflash_t(th)
        } elif THINKER_is_strobe_flash(th) != 0 {
            saveg_write8(SAVEG_TC_STROBE as u8)
            saveg_write_pad()
            saveg_write_strobe_t(th)
        } elif THINKER_is_glow(th) != 0 {
            saveg_write8(SAVEG_TC_GLOW as u8)
            saveg_write_pad()
            saveg_write_glow_t(th)
        }
        th = THINKER_next(th)
    }
    saveg_write8(SAVEG_TC_ENDSPECIALS as u8)
}

@flow_api
function P_UnArchiveSpecials() -> void {
    while 1 == 1 {
        let tclass: i32 = saveg_read8() as i32
        if tclass == SAVEG_TC_ENDSPECIALS {
            return
        } elif tclass == SAVEG_TC_CEILING {
            saveg_read_pad()
            let ceiling: ptr<void> = Z_Malloc(SAVEG_SIZEOF_CEILING, SAVEG_PU_LEVEL, null)
            saveg_read_ceiling_t(ceiling)
            let cb: i64 = sg_base(ceiling)
            let sec: ptr<void> = sg_ptr(cb, 32)
            sg_set_ptr(sg_base(sec), 104, ceiling)
            if (THINKER_acp1(ceiling) as i64) != 0 {
                THINKER_set_move_ceiling(ceiling)
            }
            P_AddThinker(ceiling)
            P_AddActiveCeiling(ceiling)
        } elif tclass == SAVEG_TC_DOOR {
            saveg_read_pad()
            let door: ptr<void> = Z_Malloc(SAVEG_SIZEOF_VLDOOR, SAVEG_PU_LEVEL, null)
            saveg_read_vldoor_t(door)
            let db: i64 = sg_base(door)
            sg_set_ptr(sg_base(sg_ptr(db, 32)), 104, door)
            THINKER_set_vertical_door(door)
            P_AddThinker(door)
        } elif tclass == SAVEG_TC_FLOOR {
            saveg_read_pad()
            let floor: ptr<void> = Z_Malloc(SAVEG_SIZEOF_FLOORMOVE, SAVEG_PU_LEVEL, null)
            saveg_read_floormove_t(floor)
            let fb: i64 = sg_base(floor)
            sg_set_ptr(sg_base(sg_ptr(fb, 32)), 104, floor)
            THINKER_set_move_floor(floor)
            P_AddThinker(floor)
        } elif tclass == SAVEG_TC_PLAT {
            saveg_read_pad()
            let plat: ptr<void> = Z_Malloc(SAVEG_SIZEOF_PLAT, SAVEG_PU_LEVEL, null)
            saveg_read_plat_t(plat)
            let pb: i64 = sg_base(plat)
            sg_set_ptr(sg_base(sg_ptr(pb, 24)), 104, plat)
            if (THINKER_acp1(plat) as i64) != 0 {
                THINKER_set_plat_raise(plat)
            }
            P_AddThinker(plat)
            P_AddActivePlat(plat)
        } elif tclass == SAVEG_TC_FLASH {
            saveg_read_pad()
            let flash: ptr<void> = Z_Malloc(SAVEG_SIZEOF_LIGHTFLASH, SAVEG_PU_LEVEL, null)
            saveg_read_lightflash_t(flash)
            THINKER_set_light_flash(flash)
            P_AddThinker(flash)
        } elif tclass == SAVEG_TC_STROBE {
            saveg_read_pad()
            let strobe: ptr<void> = Z_Malloc(SAVEG_SIZEOF_STROBE, SAVEG_PU_LEVEL, null)
            saveg_read_strobe_t(strobe)
            THINKER_set_strobe_flash(strobe)
            P_AddThinker(strobe)
        } elif tclass == SAVEG_TC_GLOW {
            saveg_read_pad()
            let glow: ptr<void> = Z_Malloc(SAVEG_SIZEOF_GLOW, SAVEG_PU_LEVEL, null)
            saveg_read_glow_t(glow)
            THINKER_set_glow(glow)
            P_AddThinker(glow)
        } else {
            savegshim_error_unknown_special_tclass(tclass)
        }
    }
}
