# Map setup / WAD I/O, ported from p_setup.c to Flow.
#
# Loads VERTEXES, LINEDEFS, SIDEDEFS, SECTORS, SSECTORS, NODES, SEGS,
# BLOCKMAP, REJECT and THINGS, then groups sector line lists. Public ABI
# (p_setup.h): P_SetupLevel, P_Init. Load helpers stay module-private.
#
# Geometry counts/pointers/blockmap/REJECT are Flow-owned (`let mut` +
# @flow_api). deathmatchstarts / deathmatch_p index / playerstarts also
# live here (was setup_data.c). Geometry blobs use doom_layout.h
# GEOM_*_SIZEOF; field writes go through GEOM_OFF_* so this file never
# invents sector_t / line_t / seg_t C types.
#
# LP64 sizes (verified with sizeof against doomgeneric headers):
#   mapvertex_t 4  mapseg_t 12  mapsector_t 26  mapsubsector_t 4
#   mapnode_t 28  maplinedef_t 14  mapsidedef_t 30  mapthing_t 10
#   vertex_t 8  seg_t 56  sector_t 128  subsector_t 16
#   node_t 52  line_t 88  side_t 24
#   → GEOM_*_SIZEOF / doom_layout.h

