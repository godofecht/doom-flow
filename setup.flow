    geom_set_i32(base, GEOM_OFF_SEC_BLOCKBOX + SETUP_BOXTOP * 4, top)
    geom_set_i32(base, GEOM_OFF_SEC_BLOCKBOX + SETUP_BOXBOTTOM * 4, bottom)
    geom_set_i32(base, GEOM_OFF_SEC_BLOCKBOX + SETUP_BOXLEFT * 4, left)
    geom_set_i32(base, GEOM_OFF_SEC_BLOCKBOX + SETUP_BOXRIGHT * 4, right)
}

