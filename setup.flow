    let base: i64 = GEOM_side(i) as i64
    let cur: i32 = geom_i32(base, GEOM_OFF_SIDE_TEXTUREOFFSET)
    geom_set_i32(base, GEOM_OFF_SIDE_TEXTUREOFFSET, cur + delta)
}

