# Blockmap helpers used by maputl.flow (keep setupshim_* names).
@flow_api
function setupshim_blockmap_list_start(x: i32, y: i32) -> i32 {
    if x < 0 or y < 0 or x >= bmapwidth or y >= bmapheight {
        return 0 - 1
    }
    return blockmap[y * bmapwidth + x] as i32
}

@flow_api
function setupshim_blockmaplump_index(offset: i32) -> i32 {
    return blockmaplump[offset] as i32
}

@flow_api
function setupshim_blocklink(x: i32, y: i32) -> ptr<void> {
    if x < 0 or y < 0 or x >= bmapwidth or y >= bmapheight {
        return null
    }
    return blocklinks[y * bmapwidth + x]
}

@flow_api
function setupshim_set_blocklink(x: i32, y: i32, m: ptr<void>) -> void {
    if x >= 0 and x < bmapwidth and y >= 0 and y < bmapheight {
        blocklinks[y * bmapwidth + x] = m
    }
}

