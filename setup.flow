# ---- LP64 offsetof tables (verified against doomgeneric r_defs.h) -----
#
#   sector_t (sizeof 128): floorheight 0, ceilingheight 4, floorpic 8,
#     ceilingpic 10, lightlevel 12, special 14, tag 16, soundtraversed 20,
#     soundtarget 24, blockbox 32, soundorg 48 (degenmobj_t: thinker_t 0-24,
#     x 24, y 28, z 32 within it -> sector-relative x 72, y 76),
#     validcount 88, thinglist 96, specialdata 104, linecount 112, lines 120
#   line_t (sizeof 88): v1 0, v2 8, dx 16, dy 20, flags 24, special 26,
#     tag 28, sidenum 30, bbox 36, slopetype 52, frontsector 56,
#     backsector 64, validcount 72, specialdata 80
#   side_t (sizeof 24): textureoffset 0, rowoffset 4, toptexture 8,
#     bottomtexture 10, midtexture 12, sector 16
#   seg_t (sizeof 56): v1 0, v2 8, offset 16, angle 20, sidedef 24,
#     linedef 32, frontsector 40, backsector 48
#   subsector_t (sizeof 16): sector 0, numlines 8, firstline 10
#   node_t (sizeof 52): x 0, y 4, dx 8, dy 12, bbox 16 (2x4 i32), children 48
#   vertex_t (sizeof 8): x 0, y 4

const GEOM_OFF_SEC_FLOORHEIGHT: i32 = 0
const GEOM_OFF_SEC_CEILINGHEIGHT: i32 = 4
const GEOM_OFF_SEC_FLOORPIC: i32 = 8
const GEOM_OFF_SEC_CEILINGPIC: i32 = 10
const GEOM_OFF_SEC_LIGHTLEVEL: i32 = 12
const GEOM_OFF_SEC_SPECIAL: i32 = 14
const GEOM_OFF_SEC_TAG: i32 = 16
const GEOM_OFF_SEC_SOUNDTRAVERSED: i32 = 20
const GEOM_OFF_SEC_SOUNDTARGET: i32 = 24
const GEOM_OFF_SEC_BLOCKBOX: i32 = 32
const GEOM_OFF_SEC_SOUNDORG: i32 = 48
const GEOM_OFF_SEC_SOUNDORG_X: i32 = 72
const GEOM_OFF_SEC_SOUNDORG_Y: i32 = 76
const GEOM_OFF_SEC_VALIDCOUNT: i32 = 88
const GEOM_OFF_SEC_THINGLIST: i32 = 96
const GEOM_OFF_SEC_SPECIALDATA: i32 = 104
const GEOM_OFF_SEC_LINECOUNT: i32 = 112
const GEOM_OFF_SEC_LINES: i32 = 120

const GEOM_OFF_LINE_V1: i32 = 0
const GEOM_OFF_LINE_V2: i32 = 8
const GEOM_OFF_LINE_DX: i32 = 16
const GEOM_OFF_LINE_DY: i32 = 20
const GEOM_OFF_LINE_FLAGS: i32 = 24
const GEOM_OFF_LINE_SPECIAL: i32 = 26
const GEOM_OFF_LINE_TAG: i32 = 28
const GEOM_OFF_LINE_SIDENUM: i32 = 30
const GEOM_OFF_LINE_BBOX: i32 = 36
const GEOM_OFF_LINE_SLOPETYPE: i32 = 52
const GEOM_OFF_LINE_FRONTSECTOR: i32 = 56
const GEOM_OFF_LINE_BACKSECTOR: i32 = 64
const GEOM_OFF_LINE_VALIDCOUNT: i32 = 72
const GEOM_OFF_LINE_SPECIALDATA: i32 = 80

const GEOM_OFF_SIDE_TEXTUREOFFSET: i32 = 0
const GEOM_OFF_SIDE_ROWOFFSET: i32 = 4
const GEOM_OFF_SIDE_TOPTEXTURE: i32 = 8
const GEOM_OFF_SIDE_BOTTOMTEXTURE: i32 = 10
const GEOM_OFF_SIDE_MIDTEXTURE: i32 = 12
const GEOM_OFF_SIDE_SECTOR: i32 = 16

const GEOM_OFF_SEG_V1: i32 = 0
const GEOM_OFF_SEG_V2: i32 = 8
const GEOM_OFF_SEG_OFFSET: i32 = 16
const GEOM_OFF_SEG_ANGLE: i32 = 20
const GEOM_OFF_SEG_SIDEDEF: i32 = 24
const GEOM_OFF_SEG_LINEDEF: i32 = 32
const GEOM_OFF_SEG_FRONTSECTOR: i32 = 40
const GEOM_OFF_SEG_BACKSECTOR: i32 = 48

const GEOM_OFF_SUBSEC_SECTOR: i32 = 0
const GEOM_OFF_SUBSEC_NUMLINES: i32 = 8
const GEOM_OFF_SUBSEC_FIRSTLINE: i32 = 10

const GEOM_OFF_NODE_X: i32 = 0
const GEOM_OFF_NODE_Y: i32 = 4
const GEOM_OFF_NODE_DX: i32 = 8
const GEOM_OFF_NODE_DY: i32 = 12
const GEOM_OFF_NODE_BBOX: i32 = 16
const GEOM_OFF_NODE_CHILDREN: i32 = 48

const GEOM_OFF_VERTEX_X: i32 = 0
const GEOM_OFF_VERTEX_Y: i32 = 4

# ---- offset helpers for C-owned engine structs (mirrors saveg.flow) ---

function geom_i16(base: i64, off: i32) -> i32 {
    let p: ptr<i16> = (base + off as i64) as ptr<i16>
    return p[0] as i32
}

function geom_set_i16(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i16> = (base + off as i64) as ptr<i16>
    p[0] = v as i16
}

function geom_u16(base: i64, off: i32) -> i32 {
    let p: ptr<u16> = (base + off as i64) as ptr<u16>
    return p[0] as i32
}

function geom_set_u16(base: i64, off: i32, v: i32) -> void {
    let p: ptr<u16> = (base + off as i64) as ptr<u16>
    p[0] = v as u16
}

function geom_i32(base: i64, off: i32) -> i32 {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    return p[0]
}

function geom_set_i32(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    p[0] = v
}

function geom_u32(base: i64, off: i32) -> u32 {
    let p: ptr<u32> = (base + off as i64) as ptr<u32>
    return p[0]
}

function geom_set_u32(base: i64, off: i32, v: u32) -> void {
    let p: ptr<u32> = (base + off as i64) as ptr<u32>
    p[0] = v
}

function geom_ptr(base: i64, off: i32) -> ptr<void> {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    return p[0] as ptr<void>
}

function geom_set_ptr(base: i64, off: i32, v: ptr<void>) -> void {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    p[0] = v as i64
}

# Shared sector_t field accessors (map arrays Flow-owned above;
# field offsets explicit here). Prefer these over per-module
# *shim_sec_* / *shim_sector_* clones.

@flow_api
function GEOM_sector_floorheight(s: ptr<void>) -> i32 {
    return geom_i32(s as i64, GEOM_OFF_SEC_FLOORHEIGHT)
}

@flow_api
function GEOM_sector_ceilingheight(s: ptr<void>) -> i32 {
    return geom_i32(s as i64, GEOM_OFF_SEC_CEILINGHEIGHT)
}

@flow_api
function GEOM_sector_floorpic(s: ptr<void>) -> i32 {
    return geom_i16(s as i64, GEOM_OFF_SEC_FLOORPIC)
}

@flow_api
function GEOM_sector_ceilingpic(s: ptr<void>) -> i32 {
    return geom_i16(s as i64, GEOM_OFF_SEC_CEILINGPIC)
}

@flow_api
function GEOM_sector_lightlevel(s: ptr<void>) -> i32 {
    return geom_i16(s as i64, GEOM_OFF_SEC_LIGHTLEVEL)
}

@flow_api
function GEOM_sector_special(s: ptr<void>) -> i32 {
    return geom_i16(s as i64, GEOM_OFF_SEC_SPECIAL)
}

@flow_api
function GEOM_sector_tag(s: ptr<void>) -> i32 {
    return geom_i16(s as i64, GEOM_OFF_SEC_TAG)
}

@flow_api
function GEOM_sector_set_floorheight(s: ptr<void>, v: i32) -> void {
    geom_set_i32(s as i64, GEOM_OFF_SEC_FLOORHEIGHT, v)
}

@flow_api
function GEOM_sector_set_ceilingheight(s: ptr<void>, v: i32) -> void {
    geom_set_i32(s as i64, GEOM_OFF_SEC_CEILINGHEIGHT, v)
}

@flow_api
function GEOM_sector_set_floorpic(s: ptr<void>, v: i32) -> void {
