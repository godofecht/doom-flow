# Weapon info table, ported from d_items.c to Flow.
#
# Sole storage for weaponinfo[NUMWEAPONS] is it_weaponinfo_tab below.
# Readers use WEAPONINFO_* (pspr.flow) which call psprshim_weapon_* here.
#
# Flattened layout (ammo, up, down, ready, atk, flash) x 9 weapons:
#   index = w * 6 + field. Matches former weaponinfo_t / WEAPONINFO_SIZEOF.

const IT_NUMWEAPONS: i32 = 9
const IT_WI_FIELDS: i32 = 6
const IT_WI_STRIDE: i32 = 6
const IT_WEAPONINFO_SIZEOF: i32 = 24

# ammotype_t from doomdef.h
const IT_AM_CLIP: i32 = 0
const IT_AM_SHELL: i32 = 1
const IT_AM_CELL: i32 = 2
const IT_AM_MISL: i32 = 3
const IT_AM_NOAMMO: i32 = 5

# statenum_t values from info.h (weapon frames used below)
const IT_S_NULL: i32 = 0
const IT_S_PUNCH: i32 = 2
const IT_S_PUNCHDOWN: i32 = 3
const IT_S_PUNCHUP: i32 = 4
const IT_S_PUNCH1: i32 = 5
const IT_S_PISTOL: i32 = 10
const IT_S_PISTOLDOWN: i32 = 11
const IT_S_PISTOLUP: i32 = 12
const IT_S_PISTOL1: i32 = 13
const IT_S_PISTOLFLASH: i32 = 17
const IT_S_SGUN: i32 = 18
const IT_S_SGUNDOWN: i32 = 19
const IT_S_SGUNUP: i32 = 20
const IT_S_SGUN1: i32 = 21
const IT_S_SGUNFLASH1: i32 = 30
const IT_S_DSGUN: i32 = 32
const IT_S_DSGUNDOWN: i32 = 33
const IT_S_DSGUNUP: i32 = 34
const IT_S_DSGUN1: i32 = 35
const IT_S_DSGUNFLASH1: i32 = 47
const IT_S_CHAIN: i32 = 49
const IT_S_CHAINDOWN: i32 = 50
const IT_S_CHAINUP: i32 = 51
const IT_S_CHAIN1: i32 = 52
const IT_S_CHAINFLASH1: i32 = 55
const IT_S_MISSILE: i32 = 57
const IT_S_MISSILEDOWN: i32 = 58
const IT_S_MISSILEUP: i32 = 59
const IT_S_MISSILE1: i32 = 60
const IT_S_MISSILEFLASH1: i32 = 63
const IT_S_SAW: i32 = 67
const IT_S_SAWDOWN: i32 = 69
const IT_S_SAWUP: i32 = 70
const IT_S_SAW1: i32 = 71
const IT_S_PLASMA: i32 = 74
const IT_S_PLASMADOWN: i32 = 75
const IT_S_PLASMAUP: i32 = 76
const IT_S_PLASMA1: i32 = 77
const IT_S_PLASMAFLASH1: i32 = 79
const IT_S_BFG: i32 = 81
const IT_S_BFGDOWN: i32 = 82
const IT_S_BFGUP: i32 = 83
const IT_S_BFG1: i32 = 84
const IT_S_BFGFLASH1: i32 = 88

# Flattened weaponinfo[NUMWEAPONS]: ammo, up, down, ready, atk, flash.
let mut it_weaponinfo_tab: array<i32, 54> = [
    # fist
    5, 4, 3, 2, 5, 0,
    # pistol
    0, 12, 11, 10, 13, 17,
    # shotgun
    1, 20, 19, 18, 21, 30,
    # chaingun
    0, 51, 50, 49, 52, 55,
    # missile launcher
    3, 59, 58, 57, 60, 63,
    # plasma rifle
    2, 76, 75, 74, 77, 79,
    # bfg 9000
    2, 83, 82, 81, 84, 88,
    # chainsaw
    5, 70, 69, 67, 71, 0,
    # super shotgun
    1, 34, 33, 32, 35, 47
]

# Field indices into the flat table (stride IT_WI_STRIDE).
const IT_WI_AMMO: i32 = 0
const IT_WI_UPSTATE: i32 = 1
const IT_WI_DOWNSTATE: i32 = 2
const IT_WI_READYSTATE: i32 = 3
const IT_WI_ATKSTATE: i32 = 4
const IT_WI_FLASHSTATE: i32 = 5

@flow_api
function psprshim_weapon_ammo(w: i32) -> i32 {
    return it_weaponinfo_tab[w * IT_WI_STRIDE + IT_WI_AMMO]
}

@flow_api
function psprshim_weapon_upstate(w: i32) -> i32 {
    return it_weaponinfo_tab[w * IT_WI_STRIDE + IT_WI_UPSTATE]
}

@flow_api
function psprshim_weapon_downstate(w: i32) -> i32 {
    return it_weaponinfo_tab[w * IT_WI_STRIDE + IT_WI_DOWNSTATE]
}

@flow_api
function psprshim_weapon_readystate(w: i32) -> i32 {
    return it_weaponinfo_tab[w * IT_WI_STRIDE + IT_WI_READYSTATE]
}

@flow_api
function psprshim_weapon_atkstate(w: i32) -> i32 {
    return it_weaponinfo_tab[w * IT_WI_STRIDE + IT_WI_ATKSTATE]
}

@flow_api
function psprshim_weapon_flashstate(w: i32) -> i32 {
    return it_weaponinfo_tab[w * IT_WI_STRIDE + IT_WI_FLASHSTATE]
}
