-    r = mx.array(seed)
-    at = mx.array(a_t)
-    for _ in range(max_iters):
-        nxt = mx.maximum(r, at @ r)
-        nxt = (nxt > 0.0).astype(mx.float32)
-        mx.eval(nxt)
-        if bool(mx.all(nxt == r).item()):
-            r = nxt
-            break
-        r = nxt
-    return {i for i, v in enumerate(r.tolist()) if v > 0.0}
