-
-def _propagate_effects_dense(
-    bits0: Sequence[int], adj_np, *, backend: str, max_iters: int = 64
-) -> List[int]:
-    """Bit-sliced monotone OR: for each bit, v ← max(v, Adj @ v) until fixpoint."""
-    F = len(bits0)
-    if F == 0:
-        return []
-    bits_u = [int(b) & 0xFFFFFFFF for b in bits0]
-
-    if backend == "numpy":
-        assert HAS_NUMPY
