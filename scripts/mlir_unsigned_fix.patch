-
-def _lower_block(
-    g: FirG,
-    fid: int,
-    bid: int,
-    block: Optional[Block],
-    i32_ty: int,
-    void_ty: int,
-) -> None:
-    if block is None:
-        return
-    for stmt in block.statements:
-        _lower_stmt(g, fid, bid, stmt, i32_ty, void_ty)
