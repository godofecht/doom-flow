@flow_api
function dmain_apply_turbo(scale: i32) -> void {
    printf("turbo scale: %i%%\n", scale)
    gameshim_set_forwardmove(0, gameshim_forwardmove(0) * scale / 100)
    gameshim_set_forwardmove(1, gameshim_forwardmove(1) * scale / 100)
    gameshim_set_sidemove(0, gameshim_sidemove(0) * scale / 100)
    gameshim_set_sidemove(1, gameshim_sidemove(1) * scale / 100)
}

