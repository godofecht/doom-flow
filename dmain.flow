# ---- D_ProcessEvents --------------------------------------------------

@flow_api
function D_ProcessEvents() -> void {
    if STAT_storedemo() != 0 {
        return
    }
    while true {
        let ev: ptr<void> = D_PopEvent()
        if (ev as i64) == 0 {
            break
        }
        if M_Responder(ev) != 0 {
            continue
        }
        G_Responder(ev)
    }
}

# ---- D_Display --------------------------------------------------------

@flow_api
function D_Display() -> void {
    let mut nowtime: i32 = 0
    let mut tics: i32 = 0
    let mut wipestart: i32 = 0
    let mut y: i32 = 0
    let mut done: i32 = 0
    let mut wipe: i32 = 0
    let mut redrawsbar: i32 = 0

    if STAT_nodrawers() != 0 {
        return
    }

    if dmain_oldgamestate_ready == 0 {
        dmain_oldgamestate = 0 - 1
        dmain_oldgamestate_ready = 1
    }

    redrawsbar = 0

    if STAT_setsizeneeded() != 0 {
        R_ExecuteSetViewSize()
        dmain_oldgamestate = 0 - 1
        dmain_borderdrawcount = 3
    }

    if STAT_gamestate() != STAT_wipegamestate() {
        # Melt wipe sleeps via I_Sleep/ASYNCIFY every tic; under MLIR→wasm
        # that hang/blows the unwind buffer. Skip the effect; still draw.
        wipe = 0
        wipe_StartScreen(0, 0, DMAIN_SCREENWIDTH, DMAIN_SCREENHEIGHT)
        STAT_set_wipegamestate(STAT_gamestate())
    } else {
        wipe = 0
    }

    if STAT_gamestate() == DMAIN_GS_LEVEL and STAT_gametic() != 0 {
        HU_Erase()
    }

    let gs: i32 = STAT_gamestate()
    if gs == DMAIN_GS_LEVEL {
        if STAT_gametic() != 0 {
            if STAT_automapactive() != 0 {
                AM_Drawer()
            }
            if wipe != 0 or (DRAW_viewheight() != 200 and dmain_fullscreen != 0) {
                redrawsbar = 1
            }
            if dmain_inhelpscreensstate != 0 and menushim_inhelpscreens() == 0 {
                redrawsbar = 1
            }
            let fs: i32 = 0
            if DRAW_viewheight() == 200 {
                fs = 1
            }
            ST_Drawer(fs, redrawsbar)
            if DRAW_viewheight() == 200 {
                dmain_fullscreen = 1
            } else {
                dmain_fullscreen = 0
            }
        }
    } elif gs == DMAIN_GS_INTERMISSION {
        WI_Drawer()
    } elif gs == DMAIN_GS_FINALE {
        F_Drawer()
    } elif gs == DMAIN_GS_DEMOSCREEN {
        D_PageDrawer()
    }

    I_UpdateNoBlit()

    if STAT_gamestate() == DMAIN_GS_LEVEL and STAT_automapactive() == 0 and STAT_gametic() != 0 {
        R_RenderPlayerView(PLAYER_at(STAT_displayplayer()))
    }

    if STAT_gamestate() == DMAIN_GS_LEVEL and STAT_gametic() != 0 {
        HU_Drawer()
    }

    if STAT_gamestate() != dmain_oldgamestate and STAT_gamestate() != DMAIN_GS_LEVEL {
        I_SetPalette(W_CacheLumpName("PLAYPAL", DMAIN_PU_CACHE) as ptr<u8>)
    }

    if STAT_gamestate() == DMAIN_GS_LEVEL and dmain_oldgamestate != DMAIN_GS_LEVEL {
        dmain_viewactivestate = 0
        R_FillBackScreen()
    }

    if STAT_gamestate() == DMAIN_GS_LEVEL and STAT_automapactive() == 0 and DRAW_scaledviewwidth() != 320 {
        if STAT_menuactive() != 0 or dmain_menuactivestate != 0 or dmain_viewactivestate == 0 {
            dmain_borderdrawcount = 3
        }
        if dmain_borderdrawcount != 0 {
            R_DrawViewBorder()
            dmain_borderdrawcount = dmain_borderdrawcount - 1
        }
    }

    if STAT_testcontrols() != 0 {
        V_DrawMouseSpeedBox(STAT_testcontrols_mousespeed())
    }

    dmain_menuactivestate = STAT_menuactive()
    dmain_viewactivestate = STAT_viewactive()
    dmain_inhelpscreensstate = menushim_inhelpscreens()
    dmain_oldgamestate = STAT_gamestate()
    STAT_set_wipegamestate(STAT_gamestate())

    if STAT_paused() != 0 {
        if STAT_automapactive() != 0 {
            y = 4
        } else {
            y = RMAIN_viewwindowy() + 4
        }
        V_DrawPatchDirect(
            RMAIN_viewwindowx() + (DRAW_scaledviewwidth() - 68) / 2,
            y,
            W_CacheLumpName("M_PAUSE", DMAIN_PU_CACHE))
    }

    M_Drawer()
    NetUpdate()

    if wipe == 0 {
        I_FinishUpdate()
        return
    }

    wipe_EndScreen(0, 0, DMAIN_SCREENWIDTH, DMAIN_SCREENHEIGHT)
    wipestart = I_GetTime() - 1

    while true {
        while true {
            nowtime = I_GetTime()
            tics = nowtime - wipestart
            I_Sleep(1)
            if tics > 0 {
                break
            }
        }
        wipestart = nowtime
        done = wipe_ScreenWipe(DMAIN_WIPE_MELT, 0, 0, DMAIN_SCREENWIDTH, DMAIN_SCREENHEIGHT, tics)
        I_UpdateNoBlit()
        M_Drawer()
        I_FinishUpdate()
        if done != 0 {
            break
        }
    }
}

# ---- D_BindVariables --------------------------------------------------

@flow_api
function D_BindVariables() -> void {
    M_ApplyPlatformDefaults()

    I_BindVideoVariables()
    I_BindJoystickVariables()
    I_BindSoundVariables()

    M_BindBaseControls()
    M_BindWeaponControls()
    M_BindMapControls()
    M_BindMenuControls()
    M_BindChatControls(DMAIN_MAXPLAYERS as u32)

    ctrlshim_set_key_multi_msgplayer(0, DMAIN_HUSTR_KEYGREEN)
    ctrlshim_set_key_multi_msgplayer(1, DMAIN_HUSTR_KEYINDIGO)
    ctrlshim_set_key_multi_msgplayer(2, DMAIN_HUSTR_KEYBROWN)
    ctrlshim_set_key_multi_msgplayer(3, DMAIN_HUSTR_KEYRED)

    M_BindVariable("mouse_sensitivity", menushim_bind_addr(DMAIN_BIND_MOUSE))
    M_BindVariable("sfx_volume", dmain_bind_addr(DMAIN_BIND_SFX))
    M_BindVariable("music_volume", dmain_bind_addr(DMAIN_BIND_MUSIC))
    M_BindVariable("show_messages", menushim_bind_addr(DMAIN_BIND_SHOWMSG))
    M_BindVariable("screenblocks", menushim_bind_addr(DMAIN_BIND_SCREENBLOCKS))
    M_BindVariable("detaillevel", menushim_bind_addr(DMAIN_BIND_DETAIL))
    M_BindVariable("snd_channels", dmain_bind_addr(DMAIN_BIND_SND_CHANNELS))
    M_BindVariable("vanilla_savegame_limit", dmain_bind_addr(DMAIN_BIND_VANILLA_SAVE))
    M_BindVariable("vanilla_demo_limit", dmain_bind_addr(DMAIN_BIND_VANILLA_DEMO))
    M_BindVariable("show_endoom", dmain_bind_addr(DMAIN_BIND_SHOW_ENDOOM))

    for i in 0 to 10 {
        dmain_bind_chatmacro(i)
    }
}

# ---- D_GrabMouseCallback ----------------------------------------------

@flow_api
function D_GrabMouseCallback() -> i32 {
    if STAT_drone() != 0 {
        return 0
    }
    if STAT_menuactive() != 0 or STAT_paused() != 0 {
        return 0
    }
    if STAT_gamestate() == DMAIN_GS_LEVEL and STAT_demoplayback() == 0 and STAT_advancedemo() == 0 {
        return 1
    }
    return 0
}

# ---- doomgeneric_Tick / D_DoomLoop ------------------------------------

let mut doom_tick_count: i32 = 0

@flow_api
function doomgeneric_Tick() -> void {
    I_StartFrame()
    TryRunTics()
    S_UpdateSounds(PLAYER_mo(PLAYER_at(STAT_consoleplayer())))
    if IVIDEO_screenvisible() != 0 {
        D_Display()
    }
    # Debug: print game state every 256 frames
    let dbgf: i32 = doom_tick_count
    doom_tick_count = dbgf + 1
    if dbgf == 0 or (dbgf & 255) == 0 {
        printf("TICK: f=%d gs=%d gametic=%d maketic=%d\n", dbgf, STAT_gamestate(), STAT_gametic(), loop_maketic())
    }
}

@flow_api
function D_DoomLoop() -> void {
    if STAT_bfgedition() != 0 and (STAT_demorecording() != 0 or STAT_gameaction() == DMAIN_GA_PLAYDEMO or STAT_netgame() != 0) {
        dmain_print_bfg_iwad_warn()
    }

    if STAT_demorecording() != 0 {
        G_BeginRecording()
    }

    dmain_set_main_loop_started(1)

    TryRunTics()

    I_SetWindowTitle(STAT_gamedescription())
    I_GraphicsCheckCommandLine()
    I_SetGrabMouseCallback(D_GrabMouseCallback)
    I_InitGraphics()
    I_EnableLoadingDisk()

    V_RestoreBuffer()
    R_ExecuteSetViewSize()

    D_StartGameLoop()

    if STAT_testcontrols() != 0 {
        STAT_set_wipegamestate(STAT_gamestate())
    }

    # Skip the melt wipe on the first frame. wipe's I_Sleep used to be the
    # first ASYNCIFY point while D_DoomMain was still on the stack.
    STAT_set_wipegamestate(STAT_gamestate())

    # Do not tick here: main()'s loop ticks + gfx_present after D_DoomMain
    # returns, so the first ASYNCIFY unwind is much shallower.
    printf("D_DoomLoop: graphics ready, returning to main\n")
}

# ---- DEMO LOOP --------------------------------------------------------

@flow_api
function D_PageTicker() -> void {
    DEMO_set_pagetic(DEMO_pagetic() - 1)
    if DEMO_pagetic() < 0 {
        D_AdvanceDemo()
    }
}

@flow_api
function D_PageDrawer() -> void {
    V_DrawPatch(0, 0, W_CacheLumpName(DEMO_pagename(), DMAIN_PU_CACHE))
}

@flow_api
function D_AdvanceDemo() -> void {
    STAT_set_advancedemo(1)
}

@flow_api
function D_DoAdvanceDemo() -> void {
    PLAYER_set_playerstate(PLAYER_at(STAT_consoleplayer()), DMAIN_PST_LIVE)
    STAT_set_advancedemo(0)
    STAT_set_usergame(0)
    STAT_set_paused(0)
    STAT_set_gameaction(DMAIN_GA_NOTHING)

    if STAT_gameversion() == DMAIN_EXE_ULTIMATE or STAT_gameversion() == DMAIN_EXE_FINAL {
        DEMO_set_demosequence((DEMO_demosequence() + 1) % 7)
    } else {
        DEMO_set_demosequence((DEMO_demosequence() + 1) % 6)
    }

    let seq: i32 = DEMO_demosequence()
    if seq == 0 {
        if STAT_gamemode() == DMAIN_GM_COMMERCIAL {
            DEMO_set_pagetic(DMAIN_TICRATE * 11)
        } else {
            DEMO_set_pagetic(170)
        }
        STAT_set_gamestate(DMAIN_GS_DEMOSCREEN)
        DEMO_set_pagename("TITLEPIC")
        if STAT_gamemode() == DMAIN_GM_COMMERCIAL {
            S_StartMusic(DMAIN_MUS_DM2TTL)
        } else {
            S_StartMusic(DMAIN_MUS_INTRO)
        }
    } elif seq == 1 {
        G_DeferedPlayDemo("demo1")
    } elif seq == 2 {
        DEMO_set_pagetic(200)
        STAT_set_gamestate(DMAIN_GS_DEMOSCREEN)
        DEMO_set_pagename("CREDIT")
    } elif seq == 3 {
        G_DeferedPlayDemo("demo2")
    } elif seq == 4 {
        STAT_set_gamestate(DMAIN_GS_DEMOSCREEN)
        if STAT_gamemode() == DMAIN_GM_COMMERCIAL {
            DEMO_set_pagetic(DMAIN_TICRATE * 11)
            DEMO_set_pagename("TITLEPIC")
            S_StartMusic(DMAIN_MUS_DM2TTL)
        } else {
            DEMO_set_pagetic(200)
            if STAT_gamemode() == DMAIN_GM_RETAIL {
                DEMO_set_pagename("CREDIT")
            } else {
                DEMO_set_pagename("HELP2")
            }
        }
    } elif seq == 5 {
        G_DeferedPlayDemo("demo3")
    } elif seq == 6 {
        G_DeferedPlayDemo("demo4")
    }

    # BFG Edition TITLEPIC → INTERPIC workaround
    if STAT_bfgedition() != 0 and dmain_strcasecmp(DEMO_pagename(), "TITLEPIC") == 0 and W_CheckNumForName("titlepic") < 0 {
        DEMO_set_pagename("INTERPIC")
    }
}

@flow_api
function D_StartTitle() -> void {
    STAT_set_gameaction(DMAIN_GA_NOTHING)
    DEMO_set_demosequence(0 - 1)
    D_AdvanceDemo()
}

# FEATURE_DEHACKED off: banners never replaced → identity.
function dmain_get_game_name(gamename: string) -> string {
    return gamename
}

function dmain_print_dehacked_banners() -> void {
}

# ---- version / description --------------------------------------------

@flow_api
function D_IdentifyVersion() -> void {
    if STAT_gamemission() == DMAIN_MISSION_NONE {
        dmain_identify_from_lumps()
        if STAT_gamemission() == DMAIN_MISSION_NONE {
            dmain_error_unknown_iwad()
        }
    }

    if STAT_logical_gamemission() == DMAIN_MISSION_DOOM {
        if W_CheckNumForName("E4M1") > 0 {
            STAT_set_gamemode(DMAIN_GM_RETAIL)
        } elif W_CheckNumForName("E3M1") > 0 {
            STAT_set_gamemode(DMAIN_GM_REGISTERED)
        } else {
            STAT_set_gamemode(DMAIN_GM_SHAREWARE)
        }
    } else {
        STAT_set_gamemode(DMAIN_GM_COMMERCIAL)
        let p: i32 = M_CheckParmWithArgs("-pack", 1)
        if p > 0 {
            dmain_set_mission_pack(dmain_argv_str(p + 1))
        }
    }
}

@flow_api
function D_SetGameDescription() -> void {
    let is_freedoom: i32 = 0
    let is_freedm: i32 = 0
    if W_CheckNumForName("FREEDOOM") >= 0 {
        is_freedoom = 1
    }
    if W_CheckNumForName("FREEDM") >= 0 {
        is_freedm = 1
    }

    STAT_set_gamedescription("Unknown")

    if STAT_logical_gamemission() == DMAIN_MISSION_DOOM {
        if is_freedoom != 0 {
            STAT_set_gamedescription(dmain_get_game_name("Freedoom: Phase 1"))
        } elif STAT_gamemode() == DMAIN_GM_RETAIL {
            STAT_set_gamedescription(dmain_get_game_name("The Ultimate DOOM"))
        } elif STAT_gamemode() == DMAIN_GM_REGISTERED {
            STAT_set_gamedescription(dmain_get_game_name("DOOM Registered"))
        } elif STAT_gamemode() == DMAIN_GM_SHAREWARE {
            STAT_set_gamedescription(dmain_get_game_name("DOOM Shareware"))
        }
    } else {
        if is_freedoom != 0 {
            if is_freedm != 0 {
                STAT_set_gamedescription(dmain_get_game_name("FreeDM"))
            } else {
                STAT_set_gamedescription(dmain_get_game_name("Freedoom: Phase 2"))
            }
        } elif STAT_logical_gamemission() == DMAIN_MISSION_DOOM2 {
            STAT_set_gamedescription(dmain_get_game_name("DOOM 2: Hell on Earth"))
        } elif STAT_logical_gamemission() == DMAIN_MISSION_PACK_PLUT {
            STAT_set_gamedescription(dmain_get_game_name("DOOM 2: Plutonia Experiment"))
        } elif STAT_logical_gamemission() == DMAIN_MISSION_PACK_TNT {
            STAT_set_gamedescription(dmain_get_game_name("DOOM 2: TNT - Evilution"))
        }
    }
}

function dmain_add_file(filename: string) -> i32 {
    dmain_print_adding(filename)
    let wad: ptr<void> = W_AddFile(filename)
    if (wad as i64) != 0 {
        return 1
    }
    return 0
}

function dmain_init_game_version() -> void {
    let p: i32 = M_CheckParmWithArgs("-gameversion", 1)

    if p != 0 {
        let ver: i32 = dmain_gameversion_match(dmain_argv_str(p + 1))
        if ver >= 0 {
            STAT_set_gameversion(ver)
        } else {
            dmain_print_supported_versions()
            dmain_error_unknown_version(dmain_argv_str(p + 1))
        }
    } else {
        if STAT_gamemission() == DMAIN_MISSION_PACK_CHEX {
            STAT_set_gameversion(DMAIN_EXE_CHEX)
        } elif STAT_gamemission() == DMAIN_MISSION_PACK_HACX {
            STAT_set_gameversion(DMAIN_EXE_HACX)
        } elif STAT_gamemode() == DMAIN_GM_SHAREWARE or STAT_gamemode() == DMAIN_GM_REGISTERED {
            STAT_set_gameversion(DMAIN_EXE_DOOM_1_9)
        } elif STAT_gamemode() == DMAIN_GM_RETAIL {
            STAT_set_gameversion(DMAIN_EXE_ULTIMATE)
        } elif STAT_gamemode() == DMAIN_GM_COMMERCIAL {
            if STAT_gamemission() == DMAIN_MISSION_DOOM2 {
                STAT_set_gameversion(DMAIN_EXE_DOOM_1_9)
            } else {
                STAT_set_gameversion(DMAIN_EXE_FINAL)
            }
        }
    }

    if STAT_gameversion() < DMAIN_EXE_ULTIMATE and STAT_gamemode() == DMAIN_GM_RETAIL {
        STAT_set_gamemode(DMAIN_GM_REGISTERED)
    }

    if STAT_gameversion() < DMAIN_EXE_FINAL and STAT_gamemode() == DMAIN_GM_COMMERCIAL and (STAT_gamemission() == DMAIN_MISSION_PACK_TNT or STAT_gamemission() == DMAIN_MISSION_PACK_PLUT) {
        STAT_set_gamemission(DMAIN_MISSION_DOOM2)
    }
}

@flow_api
function PrintGameVersion() -> void {
    dmain_print_emulating()
}

function dmain_endoom() -> void {
    if dmain_show_endoom() == 0 or dmain_main_loop_started() == 0 or IVIDEO_screensaver_mode() != 0 or M_CheckParm("-testcontrols") > 0 {
        return
    }
    let endoom: ptr<u8> = W_CacheLumpName("ENDOOM", DMAIN_PU_STATIC) as ptr<u8>
    I_Endoom(endoom)
    exit(0)
}

@flow_api
function D_Endoom() -> void {
    dmain_endoom()
}

# ---- D_DoomMain -------------------------------------------------------

@flow_api
function D_DoomMain() -> void {
    let mut p: i32 = 0

    I_AtExit(D_Endoom, 0)

    I_PrintBanner(DMAIN_PACKAGE_STRING)

    printf("Z_Init: Init zone memory allocation daemon. \n")
    Z_Init()

    STAT_set_nomonsters(M_CheckParm("-nomonsters"))
    STAT_set_respawnparm(M_CheckParm("-respawn"))
    STAT_set_fastparm(M_CheckParm("-fast"))
    STAT_set_devparm(M_CheckParm("-devparm"))

    I_DisplayFPSDots(STAT_devparm())

    if M_CheckParm("-deathmatch") != 0 {
        STAT_set_deathmatch(1)
    }
    if M_CheckParm("-altdeath") != 0 {
        STAT_set_deathmatch(2)
    }

    if STAT_devparm() != 0 {
        dmain_print_devstr()
    }

    dmain_set_config_dir_default()

    p = M_CheckParm("-turbo")
    if p != 0 {
        let mut scale: i32 = 200
        if p < argvflow_argc() - 1 {
            scale = dmain_atoi(dmain_argv_str(p + 1))
        }
        if scale < 10 {
            scale = 10
        }
        if scale > 400 {
            scale = 400
        }
        dmain_apply_turbo(scale)
    }

    printf("V_Init: allocate screens.\n")
    V_Init()

    printf("M_LoadDefaults: Load system defaults.\n")
    M_SetConfigFilenames("default.cfg", DMAIN_PROGRAM_PREFIX_CFG)
    D_BindVariables()
    M_LoadDefaults()

    I_AtExit(M_SaveDefaults, 0)

    dmain_set_iwadfile(D_FindIWAD(DMAIN_IWAD_MASK_DOOM, STAT_gamemission_addr()))

    if (dmain_iwadfile() as ptr<u8> as i64) == 0 {
        dmain_error_no_iwad()
    }

    STAT_set_modifiedgame(0)

    printf("W_Init: Init WADfiles.\n")
    dmain_add_file(dmain_iwadfile())

    W_CheckCorrectIWAD(DMAIN_MISSION_DOOM)

    D_IdentifyVersion()
    dmain_init_game_version()

    if W_CheckNumForName("dmenupic") >= 0 {
        dmain_print_bfg_edition()
        STAT_set_bfgedition(1)
        # DEH_AddStringReplacement no-op without FEATURE_DEHACKED
    }

    STAT_set_modifiedgame(W_ParseCommandLine())

    p = M_CheckParmWithArgs("-playdemo", 1)
    if p == 0 {
        p = M_CheckParmWithArgs("-timedemo", 1)
    }

    if p != 0 {
        let arg: ptr<u8> = dmain_argv_at(p + 1)
        if M_StringEndsWith(arg, ".lmp" as ptr<u8>) != 0 {
            M_StringCopy(dmain_file_ptr(), arg, 256)
        } else {
            dmain_fmt_lmp(dmain_file_ptr(), 256, dmain_argv_str(p + 1))
        }

        if dmain_add_file(dmain_file_ptr() as string) != 0 {
            dmain_copy_lump_name(dmain_demo_ptr(), 9)
        } else {
            M_StringCopy(dmain_demo_ptr(), arg, 9)
        }

        dmain_print_playing_demo(dmain_file_ptr() as string)
    }

    I_AtExit(G_CheckDemoStatus, 1)

    # Hash chains currently misbehave on the MLIR→wasm path (OOB during
    # W_CheckNumForName). Linear scan is correct, just slower at boot.
    # W_GenerateHashTable()

    D_SetGameDescription()

    dmain_set_savegamedir(M_GetSaveGameDir(D_SaveGameIWADName(STAT_gamemission())))

    if STAT_modifiedgame() != 0 {
        if STAT_gamemode() == DMAIN_GM_SHAREWARE {
            dmain_error_shareware_file()
        }
        if STAT_gamemode() == DMAIN_GM_REGISTERED {
            if dmain_check_registered_lumps() == 0 {
                dmain_error_not_registered()
            }
        }
    }

    if W_CheckNumForName("SS_START") >= 0 or W_CheckNumForName("FF_END") >= 0 {
        dmain_print_sprite_warn()
    }

    I_PrintStartupBanner(STAT_gamedescription())
    dmain_print_dehacked_banners()

    if W_CheckNumForName("FREEDOOM") >= 0 and W_CheckNumForName("FREEDM") < 0 {
        dmain_print_freedoom_warn()
    }

    printf("I_Init: Setting up machine state.\n")
    I_CheckIsScreensaver()
    I_InitTimer()
    I_InitJoystick()
    I_InitSound(1)
    I_InitMusic()

    D_ConnectNetGame()

    STAT_set_startskill(DMAIN_SK_MEDIUM)
    STAT_set_startepisode(1)
    STAT_set_startmap(1)
    STAT_set_autostart(0)

    p = M_CheckParmWithArgs("-skill", 1)
    if p != 0 {
        STAT_set_startskill(dmain_argv_byte(p + 1, 0) - 49)
        STAT_set_autostart(1)
    }

    p = M_CheckParmWithArgs("-episode", 1)
    if p != 0 {
        STAT_set_startepisode(dmain_argv_byte(p + 1, 0) - 48)
        STAT_set_startmap(1)
        STAT_set_autostart(1)
    }

    STAT_set_timelimit(0)

    p = M_CheckParmWithArgs("-timer", 1)
    if p != 0 {
        STAT_set_timelimit(dmain_atoi(dmain_argv_str(p + 1)))
    }

    p = M_CheckParm("-avg")
    if p != 0 {
        STAT_set_timelimit(20)
    }

    p = M_CheckParmWithArgs("-warp", 1)
    if p != 0 {
        if STAT_gamemode() == DMAIN_GM_COMMERCIAL {
            STAT_set_startmap(dmain_atoi(dmain_argv_str(p + 1)))
        } else {
            STAT_set_startepisode(dmain_argv_byte(p + 1, 0) - 48)
            if p + 2 < argvflow_argc() {
                STAT_set_startmap(dmain_argv_byte(p + 2, 0) - 48)
            } else {
                STAT_set_startmap(1)
            }
        }
        STAT_set_autostart(1)
    }

    p = M_CheckParm("-testcontrols")
    if p > 0 {
        STAT_set_startepisode(1)
        STAT_set_startmap(1)
        STAT_set_autostart(1)
        STAT_set_testcontrols(1)
    }

    p = M_CheckParmWithArgs("-loadgame", 1)
    if p != 0 {
        STAT_set_startloadgame(dmain_atoi(dmain_argv_str(p + 1)))
    } else {
        STAT_set_startloadgame(0 - 1)
    }

    printf("M_Init: Init miscellaneous info.\n")
    M_Init()

    printf("R_Init: Init DOOM refresh daemon - ")
    R_Init()

    printf("\nP_Init: Init Playloop state.\n")
    P_Init()

    printf("S_Init: Setting up sound.\n")
    S_Init(STAT_sfxVolume() * 8, STAT_musicVolume() * 8)

    printf("D_CheckNetGame: Checking network game status.\n")
    D_CheckNetGame()

    PrintGameVersion()

    printf("HU_Init: Setting up heads up display.\n")
    HU_Init()

    printf("ST_Init: Init status bar.\n")
    ST_Init()

    if STAT_gamemode() == DMAIN_GM_COMMERCIAL and W_CheckNumForName("map01") < 0 {
        STAT_set_storedemo(1)
    }

    if M_CheckParmWithArgs("-statdump", 1) != 0 {
        I_AtExit(StatDump, 1)
        printf("External statistics registered.\n")
    }

    p = M_CheckParmWithArgs("-record", 1)
    if p != 0 {
        G_RecordDemo(dmain_argv_str(p + 1))
        STAT_set_autostart(1)
    }

    p = M_CheckParmWithArgs("-playdemo", 1)
    if p != 0 {
        STAT_set_singledemo(1)
        G_DeferedPlayDemo(dmain_demo_ptr() as string)
        D_DoomLoop()
        return
    }

    p = M_CheckParmWithArgs("-timedemo", 1)
    if p != 0 {
        G_TimeDemo(dmain_demo_ptr() as string)
        D_DoomLoop()
        return
    }

    if STAT_startloadgame() >= 0 {
        dmain_copy_save_path(dmain_file_ptr(), 256, STAT_startloadgame())
        G_LoadGame(dmain_file_ptr() as string)
    }

    if STAT_gameaction() != DMAIN_GA_LOADGAME {
        if STAT_autostart() != 0 or STAT_netgame() != 0 {
            G_InitNew(STAT_startskill(), STAT_startepisode(), STAT_startmap())
        } else {
            D_StartTitle()
        }
    }

    D_DoomLoop()
}
