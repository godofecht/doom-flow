@flow_api
function gameshim_gamekeydown(k: i32) -> i32 {
    if k < 0 or k >= 256 { return 0 }
    return game_gamekeydown[k]
}
@flow_api
function gameshim_set_gamekeydown(k: i32, v: i32) -> void {
    if k < 0 or k >= 256 { return }
    game_gamekeydown[k] = v
}
@flow_api
function gameshim_clear_gamekeydown() -> void {
    memset(&game_gamekeydown[0] as ptr<void>, 0, (256 * 4) as i64)
}

