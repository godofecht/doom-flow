@flow_api
function gameshim_demo_bytes_left() -> i32 {
    return ((game_demoend as i64) - (game_demo_p as i64)) as i32
}
@flow_api
function gameshim_demo_mark() -> ptr<void> { return game_demo_p }
@flow_api
function gameshim_demo_rewind_to(p: ptr<void>) -> void { game_demo_p = p }

@flow_api
function gameshim_increase_demo_buffer() -> void {
    let current_length: i32 = ((game_demoend as i64) - (game_demobuffer as i64)) as i32
    let new_length: i32 = current_length * 2
    let new_demobuffer: ptr<void> = Z_Malloc(new_length, 1, null)
    let new_demop: ptr<void> = ((new_demobuffer as i64) + ((game_demo_p as i64) - (game_demobuffer as i64))) as ptr<void>
    memcpy(new_demobuffer, game_demobuffer, current_length as i64)
    Z_Free(game_demobuffer)
    game_demobuffer = new_demobuffer
    game_demo_p = new_demop
    game_demoend = ((game_demobuffer as i64) + (new_length as i64)) as ptr<void>
}

