function gameshim_weapon_order_len() -> i32 { return 9 }
@flow_api
function gameshim_weapon_order_weapon(i: i32) -> i32 { return game_weapon_order[i * 2] }
@flow_api
function gameshim_weapon_order_num(i: i32) -> i32 { return game_weapon_order[i * 2 + 1] }

@flow_api
function gameshim_player_at(i: i32) -> ptr<void> {
    return (((&game_players[0]) as i64) + ((i * GAME_PLAYER_SIZEOF) as i64)) as ptr<void>
}

@flow_api
function gameshim_copy_netcmd_to_player(i: i32) -> void {
    let cmds: ptr<void> = netshim_netcmds()
    let dst: ptr<void> = (((gameshim_player_at(i) as i64) + (GAME_PLAYER_OFF_CMD as i64)) as ptr<void>)
    let src: ptr<void> = (((cmds as i64) + ((i * GAME_TICCMD_SIZEOF) as i64)) as ptr<void>)
    memcpy(dst, src, GAME_TICCMD_SIZEOF as i64)
}

@flow_api
function gameshim_wminfo() -> ptr<void> { return &game_wminfo[0] as ptr<void> }

@flow_api
function gameshim_wminfo_copy_player_frags(i: i32) -> void {
    let dst: ptr<void> = ((game_wminfo_plyr(i) as i64) + (GAME_WBPLAYER_OFF_FRAGS as i64)) as ptr<void>
    let src: ptr<void> = (((gameshim_player_at(i) as i64) + (GAME_PLAYER_OFF_FRAGS as i64)) as ptr<void>)
    memcpy(dst, src, (4 * 4) as i64)
}

@flow_api
function gameshim_wminfo_didsecret() -> i32 { return game_blob_i32(&game_wminfo[0], GAME_WBSTART_OFF_DIDSECRET) }
@flow_api
function gameshim_wminfo_set_didsecret(v: i32) -> void { game_blob_set_i32(&game_wminfo[0], GAME_WBSTART_OFF_DIDSECRET, v) }
@flow_api
function gameshim_wminfo_epsd() -> i32 { return game_blob_i32(&game_wminfo[0], GAME_WBSTART_OFF_EPSD) }
