    return b[GAME_TICCMD_OFF_CONSISTANCY] as i32
}
@flow_api
function gameshim_cmd_checksum(cmd: ptr<void>) -> i32 {
    let mut sum: i32 = 0
    let mut i: i32 = 0
    let n: i32 = GAME_TICCMD_SIZEOF / 4 - 1
    while i < n {
        sum = sum + game_blob_i32(cmd as ptr<u8>, i * 4)
        i = i + 1
    }
    return sum
}

