@flow_api
function gameshim_error_timedemo(gametics: i32, realtics: i32) -> void {
    let fps: f32 = ((gametics as f32) * 35.0) / (realtics as f32)
    snprintf((&game_errbuf[0]) as string, 256,
             "timed %i gametics in %i realtics (%f fps)",
             gametics, realtics, fps)
    I_Error((&game_errbuf[0]) as string)
}

