function game_atoi(s: string) -> i32 {
    let p: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    while p[i] as i32 == 32 or (p[i] as i32 >= 9 and p[i] as i32 <= 13) {
        i = i + 1
    }
    let mut sign: i32 = 1
    if p[i] as i32 == 45 {
        sign = 0 - 1
        i = i + 1
    } elif p[i] as i32 == 43 {
        i = i + 1
    }
    let mut v: i32 = 0
    let mut c: i32 = p[i] as i32
    while c >= 48 and c <= 57 {
        v = v * 10 + (c - 48)
        i = i + 1
        c = p[i] as i32
    }
    return v * sign
}

@flow_api
function gameshim_maxdemo_kib() -> i32 {
    let i: i32 = M_CheckParmWithArgs("-maxdemo", 1)
    if i != 0 {
        let words: ptr<i64> = argvflow_argv()
        return game_atoi(words[i + 1] as ptr<u8> as string)
    }
    return 0
}

function game_state_tics_ptr(i: i32) -> ptr<i32> {
    return ((info_states_addr() as i64)
            + (i as i64) * (GAME_INFO_STATE_SIZE as i64)
            + (GAME_INFO_STATE_OFF_TICS as i64)) as ptr<i32>
}

function game_mobjinfo_speed_ptr(typ: i32) -> ptr<i32> {
    return ((info_mobjinfo_addr() as i64)
            + (typ as i64) * (GAME_INFO_MOBJINFO_SIZE as i64)
            + (GAME_INFO_MOBJINFO_OFF_SPEED as i64)) as ptr<i32>
}

@flow_api
function gameshim_halve_sarg_tics() -> void {
    let mut i: i32 = GAME_S_SARG_RUN1
    while i <= GAME_S_SARG_PAIN2 {
        let p: ptr<i32> = game_state_tics_ptr(i)
        p[0] = p[0] >> 1
        i = i + 1
    }
    game_mobjinfo_speed_ptr(GAME_MT_BRUISERSHOT)[0] = 20 * GAME_SARG_FRACUNIT
    game_mobjinfo_speed_ptr(GAME_MT_HEADSHOT)[0] = 20 * GAME_SARG_FRACUNIT
    game_mobjinfo_speed_ptr(GAME_MT_TROOPSHOT)[0] = 20 * GAME_SARG_FRACUNIT
}

@flow_api
function gameshim_restore_sarg_tics() -> void {
    let mut i: i32 = GAME_S_SARG_RUN1
    while i <= GAME_S_SARG_PAIN2 {
        let p: ptr<i32> = game_state_tics_ptr(i)
        p[0] = p[0] << 1
        i = i + 1
    }
    game_mobjinfo_speed_ptr(GAME_MT_BRUISERSHOT)[0] = 15 * GAME_SARG_FRACUNIT
    game_mobjinfo_speed_ptr(GAME_MT_HEADSHOT)[0] = 10 * GAME_SARG_FRACUNIT
    game_mobjinfo_speed_ptr(GAME_MT_TROOPSHOT)[0] = 10 * GAME_SARG_FRACUNIT
}

