function game_blob_i32(base: ptr<u8>, off: i32) -> i32 {
    let p: ptr<i32> = ((base as i64) + (off as i64)) as ptr<i32>
    return p[0]
}
function game_blob_set_i32(base: ptr<u8>, off: i32, v: i32) -> void {
    let p: ptr<i32> = ((base as i64) + (off as i64)) as ptr<i32>
    p[0] = v
}
function game_blob_i8(base: ptr<u8>, off: i32) -> i32 {
    return (base[off] as i32)
}
function game_blob_set_i8(base: ptr<u8>, off: i32, v: i32) -> void {
    base[off] = (v as u8)
}
function game_blob_i16(base: ptr<u8>, off: i32) -> i32 {
    let p: ptr<i16> = ((base as i64) + (off as i64)) as ptr<i16>
    return p[0] as i32
}
function game_blob_set_i16(base: ptr<u8>, off: i32, v: i32) -> void {
    let p: ptr<i16> = ((base as i64) + (off as i64)) as ptr<i16>
    p[0] = v as i16
}
function game_wminfo_plyr(i: i32) -> ptr<u8> {
    return (((&game_wminfo[0]) as i64) + (GAME_WBSTART_OFF_PLYR as i64) + ((i * GAME_WBPLAYER_SIZEOF) as i64)) as ptr<u8>
}

