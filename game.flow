# Game loop / ticcmd / demos / save / reborn, ported from g_game.c to Flow.
#
# Public ABI (g_game.h): G_DeathMatchSpawnPlayer, G_InitNew, G_DeferedInitNew,
# G_DeferedPlayDemo, G_LoadGame, G_DoLoadGame, G_SaveGame, G_RecordDemo,
# G_BeginRecording, G_PlayDemo, G_TimeDemo, G_CheckDemoStatus, G_ExitLevel,
# G_SecretExitLevel, G_WorldDone, G_BuildTiccmd, G_Ticker, G_Responder,
# G_ScreenShot, G_DrawMouseSpeedBox, G_VanillaVersionCode.
# Also exported (used by other modules / historically un-headered):
# G_PlayerReborn, G_InitPlayer, G_CmdChecksum, G_Do* helpers as needed.
#
# Storage: game_state.flow (@flow_api gameshim_*). Varargs demo/timedemo
# helpers remain in platform_stub.c. FEATURE_DEHACKED is off — DEH_String
# is identity.
#
# Helpers are game_*; consts use GAME_ prefix.

