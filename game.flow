# ---- level exit / completed / world done ------------------------------

@flow_api
function G_ExitLevel() -> void {
    gameshim_set_secretexit(0)
    STAT_set_gameaction(GAME_GA_COMPLETED)
}

@flow_api
function G_SecretExitLevel() -> void {
    if STAT_gamemode() == GAME_GM_COMMERCIAL and W_CheckNumForName("map31") < 0 {
        gameshim_set_secretexit(0)
    } else {
        gameshim_set_secretexit(1)
    }
    STAT_set_gameaction(GAME_GA_COMPLETED)
}

function game_do_completed() -> void {
    STAT_set_gameaction(GAME_GA_NOTHING)
    for i in 0 to GAME_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            game_player_finish_level(i)
        }
    }
    if STAT_automapactive() != 0 {
        AM_Stop()
    }

    if STAT_gamemode() != GAME_GM_COMMERCIAL {
        if STAT_gameversion() == GAME_EXE_CHEX {
            if STAT_gamemap() == 5 {
                STAT_set_gameaction(GAME_GA_VICTORY)
                return
            }
        } else {
            if STAT_gamemap() == 8 {
                STAT_set_gameaction(GAME_GA_VICTORY)
                return
            }
            if STAT_gamemap() == 9 {
                for i in 0 to GAME_MAXPLAYERS {
                    PLAYER_set_didsecret(PLAYER_at(i), 1)
                }
            }
        }
    }

    # Hmmm block from C (still active despite surrounding comments)
    if STAT_gamemap() == 8 and STAT_gamemode() != GAME_GM_COMMERCIAL {
        STAT_set_gameaction(GAME_GA_VICTORY)
        return
    }
    if STAT_gamemap() == 9 and STAT_gamemode() != GAME_GM_COMMERCIAL {
        for i in 0 to GAME_MAXPLAYERS {
            PLAYER_set_didsecret(PLAYER_at(i), 1)
        }
    }

    WMINFO_set_didsecret(PLAYER_didsecret(PLAYER_at(STAT_consoleplayer())))
    WMINFO_set_epsd(STAT_gameepisode() - 1)
    WMINFO_set_last(STAT_gamemap() - 1)

    if STAT_gamemode() == GAME_GM_COMMERCIAL {
        if gameshim_secretexit() != 0 {
            if STAT_gamemap() == 15 {
                WMINFO_set_next(30)
            } elif STAT_gamemap() == 31 {
                WMINFO_set_next(31)
            }
        } else {
            if STAT_gamemap() == 31 or STAT_gamemap() == 32 {
                WMINFO_set_next(15)
            } else {
                WMINFO_set_next(STAT_gamemap())
            }
        }
    } else {
        if gameshim_secretexit() != 0 {
            WMINFO_set_next(8)
        } elif STAT_gamemap() == 9 {
            if STAT_gameepisode() == 1 {
                WMINFO_set_next(3)
            } elif STAT_gameepisode() == 2 {
                WMINFO_set_next(5)
            } elif STAT_gameepisode() == 3 {
                WMINFO_set_next(6)
            } elif STAT_gameepisode() == 4 {
                WMINFO_set_next(2)
            }
        } else {
            WMINFO_set_next(STAT_gamemap())
        }
    }

    WMINFO_set_maxkills(STAT_totalkills())
    WMINFO_set_maxitems(STAT_totalitems())
    WMINFO_set_maxsecret(STAT_totalsecret())
    WMINFO_set_maxfrags(0)

    if STAT_gamemode() == GAME_GM_COMMERCIAL {
        WMINFO_set_partime(GAME_TICRATE * gameshim_cpars(STAT_gamemap() - 1))
    } elif STAT_gameepisode() < 4 {
        WMINFO_set_partime(GAME_TICRATE * gameshim_pars(STAT_gameepisode(), STAT_gamemap()))
    } else {
        WMINFO_set_partime(GAME_TICRATE * gameshim_cpars(STAT_gamemap()))
    }

    WMINFO_set_pnum(STAT_consoleplayer())
    for i in 0 to GAME_MAXPLAYERS {
        let p: ptr<void> = PLAYER_at(i)
        WMINFO_set_plyr_in(i, STAT_playeringame(i))
        WMINFO_set_plyr_skills(i, PLAYER_killcount(p))
        WMINFO_set_plyr_sitems(i, PLAYER_itemcount(p))
        WMINFO_set_plyr_ssecret(i, PLAYER_secretcount(p))
        WMINFO_set_plyr_stime(i, STAT_leveltime())
        WMINFO_copy_player_frags(i)
    }

    STAT_set_gamestate(GAME_GS_INTERMISSION)
    STAT_set_viewactive(0)
    STAT_set_automapactive(0)
    StatCopy(WMINFO_ptr())
    WI_Start(WMINFO_ptr())
}

@flow_api
function G_WorldDone() -> void {
    STAT_set_gameaction(GAME_GA_WORLDDONE)
    if gameshim_secretexit() != 0 {
        PLAYER_set_didsecret(PLAYER_at(STAT_consoleplayer()), 1)
    }
    if STAT_gamemode() == GAME_GM_COMMERCIAL {
        let m: i32 = STAT_gamemap()
        if m == 15 or m == 31 {
            if gameshim_secretexit() == 0 {
                return
            }
            F_StartFinale()
        } elif m == 6 or m == 11 or m == 20 or m == 30 {
            F_StartFinale()
        }
    }
}

function game_do_world_done() -> void {
    STAT_set_gamestate(GAME_GS_LEVEL)
    STAT_set_gamemap(WMINFO_next() + 1)
    game_do_load_level()
    STAT_set_gameaction(GAME_GA_NOTHING)
    STAT_set_viewactive(1)
}

# ---- save / load ------------------------------------------------------

@flow_api
function G_LoadGame(name: string) -> void {
    gameshim_copy_savename(name)
    STAT_set_gameaction(GAME_GA_LOADGAME)
}

@flow_api
function G_DoLoadGame() -> void {
    STAT_set_gameaction(GAME_GA_NOTHING)
    if gameshim_fopen_savename_rb() == 0 {
        return
    }
    gameshim_clear_savegame_error()
    if P_ReadSaveGameHeader() == 0 {
        gameshim_fclose_save_stream()
        return
    }
    let savedleveltime: i32 = STAT_leveltime()
    G_InitNew(STAT_gameskill(), STAT_gameepisode(), STAT_gamemap())
    STAT_set_leveltime(savedleveltime)
    P_UnArchivePlayers()
    P_UnArchiveWorld()
    P_UnArchiveThinkers()
    P_UnArchiveSpecials()
    if P_ReadSaveGameEOF() == 0 {
        gameshim_error_bad_savegame()
    }
    gameshim_fclose_save_stream()
    if STAT_setsizeneeded() != 0 {
        R_ExecuteSetViewSize()
    }
    R_FillBackScreen()
}

@flow_api
function G_SaveGame(slot: i32, description: string) -> void {
    gameshim_set_savegameslot(slot)
    gameshim_copy_savedescription(description)
    gameshim_set_sendsave(1)
}

function game_do_save_game() -> void {
    let mut recovery_savegame_file: string = ""
    let mut has_recovery: i32 = 0
    let temp_savegame_file: string = P_TempSaveGameFile()
    let savegame_file: string = P_SaveGameFile(gameshim_savegameslot())

    if gameshim_fopen_save_wb(temp_savegame_file) == 0 {
        recovery_savegame_file = gameshim_temp_recovery_path()
        has_recovery = 1
        if gameshim_fopen_save_wb(recovery_savegame_file) == 0 {
            gameshim_error_save_open(temp_savegame_file, recovery_savegame_file)
        }
    }

    gameshim_clear_savegame_error()
    P_WriteSaveGameHeader(gameshim_savedescription())
    P_ArchivePlayers()
    P_ArchiveWorld()
    P_ArchiveThinkers()
    P_ArchiveSpecials()
    P_WriteSaveGameEOF()

    if gameshim_vanilla_savegame_limit() != 0 and gameshim_ftell_save_stream() > GAME_SAVEGAMESIZE as i64 {
        gameshim_error_save_overrun()
    }

    gameshim_fclose_save_stream()

    if has_recovery != 0 {
        gameshim_error_save_recovery(temp_savegame_file, recovery_savegame_file)
    }

    gameshim_remove_rename_save(savegame_file, temp_savegame_file)
    STAT_set_gameaction(GAME_GA_NOTHING)
    gameshim_clear_savedescription()
    PLAYER_set_message(PLAYER_at(STAT_consoleplayer()), gameshim_gg_saved())
    R_FillBackScreen()
}

# ---- new game ---------------------------------------------------------

@flow_api
function G_DeferedInitNew(skill: i32, episode: i32, map: i32) -> void {
    gameshim_set_d_skill(skill)
    gameshim_set_d_episode(episode)
    gameshim_set_d_map(map)
    STAT_set_gameaction(GAME_GA_NEWGAME)
}

function game_do_new_game() -> void {
    STAT_set_demoplayback(0)
    gameshim_set_netdemo(0)
    STAT_set_netgame(0)
    STAT_set_deathmatch(0)
    STAT_set_playeringame(1, 0)
    STAT_set_playeringame(2, 0)
    STAT_set_playeringame(3, 0)
    STAT_set_respawnparm(0)
    STAT_set_fastparm(0)
    STAT_set_nomonsters(0)
    STAT_set_consoleplayer(0)
    G_InitNew(gameshim_d_skill(), gameshim_d_episode(), gameshim_d_map())
    STAT_set_gameaction(GAME_GA_NOTHING)
}

@flow_api
function G_InitNew(skill: i32, episode: i32, map: i32) -> void {
    let mut sk: i32 = skill
    let mut ep: i32 = episode
    let mut mp: i32 = map

    if STAT_paused() != 0 {
        STAT_set_paused(0)
        S_ResumeSound()
    }

    if sk > GAME_SK_NIGHTMARE {
        sk = GAME_SK_NIGHTMARE
    }

    if STAT_gameversion() >= GAME_EXE_ULTIMATE {
        if ep == 0 {
            ep = 4
        }
    } else {
        if ep < 1 {
            ep = 1
        }
        if ep > 3 {
            ep = 3
        }
    }

    if ep > 1 and STAT_gamemode() == GAME_GM_SHAREWARE {
        ep = 1
    }
    if mp < 1 {
        mp = 1
    }
    if mp > 9 and STAT_gamemode() != GAME_GM_COMMERCIAL {
        mp = 9
    }

    M_ClearRandom()

    if sk == GAME_SK_NIGHTMARE or STAT_respawnparm() != 0 {
        STAT_set_respawnmonsters(1)
    } else {
        STAT_set_respawnmonsters(0)
    }

    if STAT_fastparm() != 0 or (sk == GAME_SK_NIGHTMARE and STAT_gameskill() != GAME_SK_NIGHTMARE) {
        gameshim_halve_sarg_tics()
    } elif sk != GAME_SK_NIGHTMARE and STAT_gameskill() == GAME_SK_NIGHTMARE {
        gameshim_restore_sarg_tics()
    }

    for i in 0 to GAME_MAXPLAYERS {
        PLAYER_set_playerstate(PLAYER_at(i), GAME_PST_REBORN)
    }

    STAT_set_usergame(1)
    STAT_set_paused(0)
    STAT_set_demoplayback(0)
    STAT_set_automapactive(0)
    STAT_set_viewactive(1)
    STAT_set_gameepisode(ep)
    STAT_set_gamemap(mp)
    STAT_set_gameskill(sk)
    STAT_set_viewactive(1)

    let mut skytexturename: string = "SKY1"
    if STAT_gamemode() == GAME_GM_COMMERCIAL {
        if STAT_gamemap() < 12 {
            skytexturename = "SKY1"
        } elif STAT_gamemap() < 21 {
            skytexturename = "SKY2"
        } else {
            skytexturename = "SKY3"
        }
    } else {
        if STAT_gameepisode() == 2 {
            skytexturename = "SKY2"
        } elif STAT_gameepisode() == 3 {
            skytexturename = "SKY3"
        } elif STAT_gameepisode() == 4 {
            skytexturename = "SKY4"
        } else {
            skytexturename = "SKY1"
        }
    }
    SKY_set_skytexture(R_TextureNumForName(skytexturename))
    game_do_load_level()
}

# ---- demos ------------------------------------------------------------

@flow_api
function G_RecordDemo(name: string) -> void {
    STAT_set_usergame(0)
    DEMO_alloc_name(name)
    let mut maxsize: i32 = 131072
    let kib: i32 = DEMO_max_kib()
    if kib != 0 {
        maxsize = kib * 1024
    }
    let buf: ptr<void> = Z_Malloc(maxsize, GAME_PU_STATIC, null)
    DEMO_set_buffer(buf)
    DEMO_set_end(((buf as i64) + maxsize as i64) as ptr<void>)
    STAT_set_demorecording(1)
}

@flow_api
function G_VanillaVersionCode() -> i32 {
    let v: i32 = STAT_gameversion()
    if v == GAME_EXE_DOOM_1_2 {
        gameshim_error_doom12_version()
        return 0
    }
    if v == GAME_EXE_DOOM_1_666 {
        return 106
    }
    if v == GAME_EXE_DOOM_1_7 {
        return 107
    }
    if v == GAME_EXE_DOOM_1_8 {
        return 108
    }
    return 109
}

@flow_api
function G_BeginRecording() -> void {
    let longt: i32 = 0
    if M_CheckParm("-longtics") != 0 {
        longt = 1
    }
    gameshim_set_longtics(longt)
    if longt != 0 {
        STAT_set_lowres_turn(0)
    } else {
        STAT_set_lowres_turn(1)
    }

    DEMO_set_p(DEMO_buffer())
    if gameshim_longtics() != 0 {
        DEMO_write_u8(GAME_DOOM_191_VERSION)
    } else {
        DEMO_write_u8(G_VanillaVersionCode())
    }
    DEMO_write_u8(STAT_gameskill())
    DEMO_write_u8(STAT_gameepisode())
    DEMO_write_u8(STAT_gamemap())
    DEMO_write_u8(STAT_deathmatch())
    DEMO_write_u8(STAT_respawnparm())
    DEMO_write_u8(STAT_fastparm())
    DEMO_write_u8(STAT_nomonsters())
    DEMO_write_u8(STAT_consoleplayer())
    for i in 0 to GAME_MAXPLAYERS {
        DEMO_write_u8(STAT_playeringame(i))
    }
}

@flow_api
function G_DeferedPlayDemo(name: string) -> void {
    gameshim_set_defdemoname(name)
    STAT_set_gameaction(GAME_GA_PLAYDEMO)
}

function game_do_play_demo() -> void {
    STAT_set_gameaction(GAME_GA_NOTHING)
    let lump: ptr<void> = W_CacheLumpName(gameshim_defdemoname(), GAME_PU_STATIC)
    DEMO_set_buffer(lump)
    DEMO_set_p(lump)

    let demoversion: i32 = DEMO_read_u8()
    if demoversion == G_VanillaVersionCode() {
        gameshim_set_longtics(0)
    } elif demoversion == GAME_DOOM_191_VERSION {
        gameshim_set_longtics(1)
    } else {
        DEMO_print_version_mismatch(demoversion, G_VanillaVersionCode())
    }

    let skill: i32 = DEMO_read_u8()
    let episode: i32 = DEMO_read_u8()
    let map: i32 = DEMO_read_u8()
    STAT_set_deathmatch(DEMO_read_u8())
    STAT_set_respawnparm(DEMO_read_u8())
    STAT_set_fastparm(DEMO_read_u8())
    STAT_set_nomonsters(DEMO_read_u8())
    STAT_set_consoleplayer(DEMO_read_u8())
    for i in 0 to GAME_MAXPLAYERS {
        STAT_set_playeringame(i, DEMO_read_u8())
    }

    if STAT_playeringame(1) != 0 or M_CheckParm("-solo-net") > 0 or M_CheckParm("-netdemo") > 0 {
        STAT_set_netgame(1)
        gameshim_set_netdemo(1)
    }

    gameshim_set_precache(0)
    G_InitNew(skill, episode, map)
    gameshim_set_precache(1)
    gameshim_set_starttime(I_GetTime())
    STAT_set_usergame(0)
    STAT_set_demoplayback(1)
}

@flow_api
function G_TimeDemo(name: string) -> void {
    if M_CheckParm("-nodraw") != 0 {
        STAT_set_nodrawers(1)
    } else {
        STAT_set_nodrawers(0)
    }
    gameshim_set_timingdemo(1)
    loopshim_set_singletics(1)
    gameshim_set_defdemoname(name)
    STAT_set_gameaction(GAME_GA_PLAYDEMO)
}

@flow_api
function G_PlayDemo(name: string) -> void {
    G_DeferedPlayDemo(name)
}

@flow_api
function G_CheckDemoStatus() -> i32 {
    if gameshim_timingdemo() != 0 {
        let endtime: i32 = I_GetTime()
        let realtics: i32 = endtime - gameshim_starttime()
        gameshim_set_timingdemo(0)
        STAT_set_demoplayback(0)
        gameshim_error_timedemo(STAT_gametic(), realtics)
    }

    if STAT_demoplayback() != 0 {
        W_ReleaseLumpName(gameshim_defdemoname())
        STAT_set_demoplayback(0)
        gameshim_set_netdemo(0)
        STAT_set_netgame(0)
        STAT_set_deathmatch(0)
        STAT_set_playeringame(1, 0)
        STAT_set_playeringame(2, 0)
        STAT_set_playeringame(3, 0)
        STAT_set_respawnparm(0)
        STAT_set_fastparm(0)
        STAT_set_nomonsters(0)
        STAT_set_consoleplayer(0)
        if STAT_singledemo() != 0 {
            I_Quit()
        } else {
            D_AdvanceDemo()
        }
        return 1
    }

    if STAT_demorecording() != 0 {
        DEMO_write_u8(GAME_DEMOMARKER)
        DEMO_write_file()
        Z_Free(DEMO_buffer())
        STAT_set_demorecording(0)
        DEMO_error_recorded()
    }
    return 0
}

# ---- G_Ticker ---------------------------------------------------------

@flow_api
function G_Ticker() -> void {
    for i in 0 to GAME_MAXPLAYERS {
        if STAT_playeringame(i) != 0 and PLAYER_playerstate(PLAYER_at(i)) == GAME_PST_REBORN {
            game_do_reborn(i)
        }
    }

    while STAT_gameaction() != GAME_GA_NOTHING {
        let ga: i32 = STAT_gameaction()
        if ga == GAME_GA_LOADLEVEL {
            game_do_load_level()
        } elif ga == GAME_GA_NEWGAME {
            game_do_new_game()
        } elif ga == GAME_GA_LOADGAME {
            G_DoLoadGame()
        } elif ga == GAME_GA_SAVEGAME {
            game_do_save_game()
        } elif ga == GAME_GA_PLAYDEMO {
            game_do_play_demo()
        } elif ga == GAME_GA_COMPLETED {
            game_do_completed()
        } elif ga == GAME_GA_VICTORY {
            F_StartFinale()
        } elif ga == GAME_GA_WORLDDONE {
            game_do_world_done()
        } elif ga == GAME_GA_SCREENSHOT {
            V_ScreenShot("DOOM%02i.%s")
            PLAYER_set_message(PLAYER_at(STAT_consoleplayer()), gameshim_screenshot_msg())
            STAT_set_gameaction(GAME_GA_NOTHING)
        } else {
            break
        }
    }

    let buf: i32 = (STAT_gametic() / STAT_ticdup()) % GAME_BACKUPTICS
    for i in 0 to GAME_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            let cmd: ptr<void> = PLAYER_cmd(PLAYER_at(i))
            gameshim_copy_netcmd_to_player(i)
            if STAT_demoplayback() != 0 {
                G_ReadDemoTiccmd(cmd)
            }
            if STAT_demorecording() != 0 {
                G_WriteDemoTiccmd(cmd)
            }

            if CMD_forwardmove(cmd) > GAME_TURBOTHRESHOLD {
                gameshim_set_turbodetected(i, 1)
            }
            if (STAT_gametic() & 31) == 0 and ((STAT_gametic() >> 5) % GAME_MAXPLAYERS) == i and gameshim_turbodetected(i) != 0 {
                gameshim_set_turbo_message(i)
                gameshim_set_turbodetected(i, 0)
            }

            if STAT_netgame() != 0 and gameshim_netdemo() == 0 and (STAT_gametic() % STAT_ticdup()) == 0 {
                if STAT_gametic() > GAME_BACKUPTICS and gameshim_consistancy(i, buf) != CMD_consistancy(cmd) {
                    gameshim_error_consistency(CMD_consistancy(cmd), gameshim_consistancy(i, buf))
                }
                let mo: ptr<void> = PLAYER_mo(PLAYER_at(i))
                if (mo as i64) != 0 {
                    gameshim_set_consistancy(i, buf, MOBJ_x(mo))
                } else {
                    gameshim_set_consistancy(i, buf, gameshim_rndindex())
                }
            }
        }
    }

    for i in 0 to GAME_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            let cmd: ptr<void> = PLAYER_cmd(PLAYER_at(i))
            let buttons: i32 = CMD_buttons(cmd)
            if (buttons & GAME_BT_SPECIAL) != 0 {
                let special: i32 = buttons & GAME_BT_SPECIALMASK
                if special == GAME_BTS_PAUSE {
                    STAT_set_paused(STAT_paused() ^ 1)
                    if STAT_paused() != 0 {
                        S_PauseSound()
                    } else {
                        S_ResumeSound()
                    }
                } elif special == GAME_BTS_SAVEGAME {
                    if gameshim_savedescription_empty() != 0 {
                        gameshim_set_savedescription_netgame()
                    }
                    gameshim_set_savegameslot((buttons & GAME_BTS_SAVEMASK) >> GAME_BTS_SAVESHIFT)
                    STAT_set_gameaction(GAME_GA_SAVEGAME)
                }
            }
        }
    }

    if gameshim_oldgamestate() == GAME_GS_INTERMISSION and STAT_gamestate() != GAME_GS_INTERMISSION {
        WI_End()
    }
    gameshim_set_oldgamestate(STAT_gamestate())

    let gs: i32 = STAT_gamestate()
    if gs == GAME_GS_LEVEL {
        P_Ticker()
        ST_Ticker()
        AM_Ticker()
        HU_Ticker()
    } elif gs == GAME_GS_INTERMISSION {
        WI_Ticker()
    } elif gs == GAME_GS_FINALE {
        F_Ticker()
    } elif gs == GAME_GS_DEMOSCREEN {
        D_PageTicker()
    }
}
