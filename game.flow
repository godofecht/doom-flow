const GAME_SFX_TELEPT: i32 = 35

# ---- helpers ----------------------------------------------------------

function game_weapon_selectable(weapon: i32) -> i32 {
    if weapon == GAME_WP_SUPERSHOTGUN and STAT_logical_gamemission() == GAME_MISSION_DOOM {
        return 0
    }
    if (weapon == GAME_WP_PLASMA or weapon == GAME_WP_BFG) and STAT_gamemission() == GAME_MISSION_DOOM and STAT_gamemode() == GAME_GM_SHAREWARE {
        return 0
    }
    let pl: ptr<void> = PLAYER_at(STAT_consoleplayer())
    if PLAYER_weaponowned(pl, weapon) == 0 {
        return 0
    }
    if weapon == GAME_WP_FIST and PLAYER_weaponowned(pl, GAME_WP_CHAINSAW) != 0 and PLAYER_power(pl, GAME_PW_STRENGTH) == 0 {
        return 0
    }
    return 1
}

function game_next_weapon(direction: i32) -> i32 {
    let pl: ptr<void> = PLAYER_at(STAT_consoleplayer())
    let mut weapon: i32 = 0
    if PLAYER_pendingweapon(pl) == GAME_WP_NOCHANGE {
        weapon = PLAYER_readyweapon(pl)
    } else {
        weapon = PLAYER_pendingweapon(pl)
    }
    let n: i32 = gameshim_weapon_order_len()
    let mut i: i32 = 0
    while i < n {
        if gameshim_weapon_order_weapon(i) == weapon {
            break
        }
        i = i + 1
    }
    let start_i: i32 = i
    while true {
        i = i + direction
        i = (i + n) % n
        if i == start_i or game_weapon_selectable(gameshim_weapon_order_weapon(i)) != 0 {
            break
        }
    }
    return gameshim_weapon_order_num(i)
}

function game_set_joy_buttons(buttons_mask: u32) -> void {
    for i in 0 to GAME_MAX_JOY_BUTTONS {
        let button_on: i32 = 0
        if (buttons_mask & ((1 as u32) << (i as u32))) != (0 as u32) {
            button_on = 1
        }
        if gameshim_joybutton(i) == 0 and button_on != 0 {
            if i == gameshim_joybprevweapon() {
                gameshim_set_next_weapon(0 - 1)
            } elif i == gameshim_joybnextweapon() {
                gameshim_set_next_weapon(1)
            }
        }
        gameshim_set_joybutton(i, button_on)
    }
}

function game_set_mouse_buttons(buttons_mask: u32) -> void {
    for i in 0 to GAME_MAX_MOUSE_BUTTONS {
        let button_on: i32 = 0
        if (buttons_mask & ((1 as u32) << (i as u32))) != (0 as u32) {
            button_on = 1
        }
        if gameshim_mousebutton(i) == 0 and button_on != 0 {
            if i == gameshim_mousebprevweapon() {
                gameshim_set_next_weapon(0 - 1)
            } elif i == gameshim_mousebnextweapon() {
                gameshim_set_next_weapon(1)
            }
        }
        gameshim_set_mousebutton(i, button_on)
    }
}

