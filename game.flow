const GAME_WP_PISTOL: i32 = 1
const GAME_WP_SHOTGUN: i32 = 2
const GAME_WP_CHAINGUN: i32 = 3
const GAME_WP_MISSILE: i32 = 4
const GAME_WP_PLASMA: i32 = 5
const GAME_WP_BFG: i32 = 6
const GAME_WP_CHAINSAW: i32 = 7
const GAME_WP_SUPERSHOTGUN: i32 = 8
const GAME_WP_NOCHANGE: i32 = 10
const GAME_PW_STRENGTH: i32 = 1

