@flow_api
function STAT_logical_gamemission() -> i32 {
    let m: i32 = STAT_gamemission()
    if m == GAME_PACK_CHEX {
        return GAME_MISSION_DOOM
    }
    if m == GAME_PACK_HACX {
        return GAME_MISSION_DOOM2
    }
    return m
}
