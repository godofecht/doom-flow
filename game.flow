# ---- G_CmdChecksum ----------------------------------------------------

@flow_api
function G_CmdChecksum(cmd: ptr<void>) -> i32 {
    return CMD_checksum(cmd)
}

# ---- G_BuildTiccmd ----------------------------------------------------

@flow_api
function G_BuildTiccmd(cmd: ptr<void>, maketic: i32) -> void {
    CMD_clear(cmd)
    CMD_set_consistancy(cmd, gameshim_consistancy(STAT_consoleplayer(), maketic % GAME_BACKUPTICS))

    let strafe: i32 = 0
    if gameshim_gamekeydown(KEY_strafe()) != 0 or gameshim_mousebutton(gameshim_mousebstrafe()) != 0 or gameshim_joybutton(gameshim_joybstrafe()) != 0 {
        strafe = 1
    }

    let mut speed: i32 = 0
    if KEY_speed() >= GAME_NUMKEYS or gameshim_joybspeed() >= GAME_MAX_JOY_BUTTONS or gameshim_gamekeydown(KEY_speed()) != 0 or gameshim_joybutton(gameshim_joybspeed()) != 0 {
        speed = 1
    }

    let mut forward: i32 = 0
    let mut side: i32 = 0

    if gameshim_joyxmove() < 0 or gameshim_joyxmove() > 0 or gameshim_gamekeydown(KEY_right()) != 0 or gameshim_gamekeydown(KEY_left()) != 0 {
        gameshim_set_turnheld(gameshim_turnheld() + STAT_ticdup())
    } else {
        gameshim_set_turnheld(0)
    }

    let mut tspeed: i32 = speed
    if gameshim_turnheld() < GAME_SLOWTURNTICS {
        tspeed = 2
    }

    if strafe != 0 {
        if gameshim_gamekeydown(KEY_right()) != 0 {
            side = side + gameshim_sidemove(speed)
        }
        if gameshim_gamekeydown(KEY_left()) != 0 {
            side = side - gameshim_sidemove(speed)
        }
        if gameshim_joyxmove() > 0 {
            side = side + gameshim_sidemove(speed)
        }
        if gameshim_joyxmove() < 0 {
            side = side - gameshim_sidemove(speed)
        }
    } else {
        if gameshim_gamekeydown(KEY_right()) != 0 {
            CMD_add_angleturn(cmd, 0 - gameshim_angleturn(tspeed))
        }
        if gameshim_gamekeydown(KEY_left()) != 0 {
            CMD_add_angleturn(cmd, gameshim_angleturn(tspeed))
        }
        if gameshim_joyxmove() > 0 {
            CMD_add_angleturn(cmd, 0 - gameshim_angleturn(tspeed))
        }
        if gameshim_joyxmove() < 0 {
            CMD_add_angleturn(cmd, gameshim_angleturn(tspeed))
        }
    }

    if gameshim_gamekeydown(KEY_up()) != 0 {
        forward = forward + gameshim_forwardmove(speed)
    }
    if gameshim_gamekeydown(KEY_down()) != 0 {
        forward = forward - gameshim_forwardmove(speed)
    }
    if gameshim_joyymove() < 0 {
        forward = forward + gameshim_forwardmove(speed)
    }
    if gameshim_joyymove() > 0 {
        forward = forward - gameshim_forwardmove(speed)
    }

    if gameshim_gamekeydown(KEY_strafeleft()) != 0 or gameshim_joybutton(gameshim_joybstrafeleft()) != 0 or gameshim_mousebutton(gameshim_mousebstrafeleft()) != 0 or gameshim_joystrafemove() < 0 {
        side = side - gameshim_sidemove(speed)
    }
    if gameshim_gamekeydown(KEY_straferight()) != 0 or gameshim_joybutton(gameshim_joybstraferight()) != 0 or gameshim_mousebutton(gameshim_mousebstraferight()) != 0 or gameshim_joystrafemove() > 0 {
        side = side + gameshim_sidemove(speed)
    }

    CMD_set_chatchar(cmd, HU_dequeueChatChar())

    if gameshim_gamekeydown(KEY_fire()) != 0 or gameshim_mousebutton(gameshim_mousebfire()) != 0 or gameshim_joybutton(gameshim_joybfire()) != 0 {
        CMD_or_buttons(cmd, GAME_BT_ATTACK)
    }

    if gameshim_gamekeydown(KEY_use()) != 0 or gameshim_joybutton(gameshim_joybuse()) != 0 or gameshim_mousebutton(gameshim_mousebuse()) != 0 {
        CMD_or_buttons(cmd, GAME_BT_USE)
        gameshim_set_dclicks(0)
    }

    if STAT_gamestate() == GAME_GS_LEVEL and gameshim_next_weapon() != 0 {
        let i: i32 = game_next_weapon(gameshim_next_weapon())
        CMD_or_buttons(cmd, GAME_BT_CHANGE)
        CMD_or_buttons(cmd, i << GAME_BT_WEAPONSHIFT)
    } else {
        for i in 0 to 8 {
            let key: i32 = KEY_weapon(i)
            if gameshim_gamekeydown(key) != 0 {
                CMD_or_buttons(cmd, GAME_BT_CHANGE)
                CMD_or_buttons(cmd, i << GAME_BT_WEAPONSHIFT)
                break
            }
        }
    }
    gameshim_set_next_weapon(0)

    if gameshim_mousebutton(gameshim_mousebforward()) != 0 {
        forward = forward + gameshim_forwardmove(speed)
    }
    if gameshim_mousebutton(gameshim_mousebbackward()) != 0 {
        forward = forward - gameshim_forwardmove(speed)
    }

    if gameshim_dclick_use() != 0 {
        if gameshim_mousebutton(gameshim_mousebforward()) != gameshim_dclickstate() and gameshim_dclicktime() > 1 {
            gameshim_set_dclickstate(gameshim_mousebutton(gameshim_mousebforward()))
            if gameshim_dclickstate() != 0 {
                gameshim_set_dclicks(gameshim_dclicks() + 1)
            }
            if gameshim_dclicks() == 2 {
                CMD_or_buttons(cmd, GAME_BT_USE)
                gameshim_set_dclicks(0)
            } else {
                gameshim_set_dclicktime(0)
            }
        } else {
            gameshim_set_dclicktime(gameshim_dclicktime() + STAT_ticdup())
            if gameshim_dclicktime() > 20 {
                gameshim_set_dclicks(0)
                gameshim_set_dclickstate(0)
            }
        }

        let mut bstrafe: i32 = 0
        if gameshim_mousebutton(gameshim_mousebstrafe()) != 0 or gameshim_joybutton(gameshim_joybstrafe()) != 0 {
            bstrafe = 1
        }
        if bstrafe != gameshim_dclickstate2() and gameshim_dclicktime2() > 1 {
            gameshim_set_dclickstate2(bstrafe)
            if gameshim_dclickstate2() != 0 {
                gameshim_set_dclicks2(gameshim_dclicks2() + 1)
            }
            if gameshim_dclicks2() == 2 {
                CMD_or_buttons(cmd, GAME_BT_USE)
                gameshim_set_dclicks2(0)
            } else {
                gameshim_set_dclicktime2(0)
            }
        } else {
            gameshim_set_dclicktime2(gameshim_dclicktime2() + STAT_ticdup())
            if gameshim_dclicktime2() > 20 {
                gameshim_set_dclicks2(0)
                gameshim_set_dclickstate2(0)
            }
        }
    }

    forward = forward + gameshim_mousey()
    if strafe != 0 {
        side = side + gameshim_mousex() * 2
    } else {
        CMD_add_angleturn(cmd, 0 - gameshim_mousex() * 8)
    }

    if gameshim_mousex() == 0 {
        STAT_set_testcontrols_mousespeed(0)
    }
    gameshim_set_mousex(0)
    gameshim_set_mousey(0)

    let maxmove: i32 = gameshim_forwardmove(GAME_MAXPLMOVE_IDX)
    if forward > maxmove {
        forward = maxmove
    } elif forward < (0 - maxmove) {
        forward = 0 - maxmove
    }
    if side > maxmove {
        side = maxmove
    } elif side < (0 - maxmove) {
        side = 0 - maxmove
    }

    CMD_add_forwardmove(cmd, forward)
    CMD_add_sidemove(cmd, side)

    if gameshim_sendpause() != 0 {
        gameshim_set_sendpause(0)
        CMD_set_buttons(cmd, GAME_BT_SPECIAL | GAME_BTS_PAUSE)
    }
    if gameshim_sendsave() != 0 {
        gameshim_set_sendsave(0)
        CMD_set_buttons(cmd, GAME_BT_SPECIAL | GAME_BTS_SAVEGAME | (gameshim_savegameslot() << GAME_BTS_SAVESHIFT))
    }

    if STAT_lowres_turn() != 0 {
        let desired: i32 = CMD_angleturn(cmd) + gameshim_lowres_carry()
        let turned: i32 = (desired + 128) & 65280   # 0xff00
        CMD_set_angleturn(cmd, turned)
        gameshim_set_lowres_carry(desired - turned)
    }
}

# ---- G_DoLoadLevel ----------------------------------------------------

function game_do_load_level() -> void {
    SKY_set_skyflatnum(R_FlatNumForName("F_SKY1"))

    if STAT_gamemode() == GAME_GM_COMMERCIAL and (STAT_gameversion() == GAME_EXE_FINAL2 or STAT_gameversion() == GAME_EXE_CHEX) {
        let mut skytexturename: string = "SKY3"
        if STAT_gamemap() < 12 {
            skytexturename = "SKY1"
        } elif STAT_gamemap() < 21 {
            skytexturename = "SKY2"
        }
        SKY_set_skytexture(R_TextureNumForName(skytexturename))
    }

    gameshim_set_levelstarttic(STAT_gametic())
    if STAT_wipegamestate() == GAME_GS_LEVEL {
        STAT_set_wipegamestate(0 - 1)
    }
    STAT_set_gamestate(GAME_GS_LEVEL)

    for i in 0 to GAME_MAXPLAYERS {
        gameshim_set_turbodetected(i, 0)
        let p: ptr<void> = PLAYER_at(i)
        if STAT_playeringame(i) != 0 and PLAYER_playerstate(p) == GAME_PST_DEAD {
            PLAYER_set_playerstate(p, GAME_PST_REBORN)
        }
        PLAYER_clear_frags(p)
    }

    P_SetupLevel(STAT_gameepisode(), STAT_gamemap(), 0, STAT_gameskill())
    STAT_set_displayplayer(STAT_consoleplayer())
    STAT_set_gameaction(GAME_GA_NOTHING)
    Z_CheckHeap()

    gameshim_clear_gamekeydown()
    gameshim_set_joyxmove(0)
    gameshim_set_joyymove(0)
    gameshim_set_joystrafemove(0)
    gameshim_set_mousex(0)
    gameshim_set_mousey(0)
    gameshim_set_sendpause(0)
    gameshim_set_sendsave(0)
    STAT_set_paused(0)
    gameshim_clear_mousearray()
    gameshim_clear_joyarray()

    if STAT_testcontrols() != 0 {
        PLAYER_set_message(PLAYER_at(STAT_consoleplayer()), gameshim_testcontrols_msg())
    }
}

# ---- G_Responder ------------------------------------------------------

@flow_api
function G_Responder(ev: ptr<void>) -> i32 {
    let et: i32 = gameshim_ev_type(ev)
    let d1: i32 = gameshim_ev_data1(ev)

    if STAT_gamestate() == GAME_GS_LEVEL and et == GAME_EV_KEYDOWN and d1 == KEY_spy() and (STAT_singledemo() != 0 or STAT_deathmatch() == 0) {
        while true {
            STAT_set_displayplayer(STAT_displayplayer() + 1)
            if STAT_displayplayer() == GAME_MAXPLAYERS {
                STAT_set_displayplayer(0)
            }
            if STAT_playeringame(STAT_displayplayer()) != 0 or STAT_displayplayer() == STAT_consoleplayer() {
                break
            }
        }
        return 1
    }

    if STAT_gameaction() == GAME_GA_NOTHING and STAT_singledemo() == 0 and (STAT_demoplayback() != 0 or STAT_gamestate() == GAME_GS_DEMOSCREEN) {
        if et == GAME_EV_KEYDOWN or (et == GAME_EV_MOUSE and d1 != 0) or (et == GAME_EV_JOYSTICK and d1 != 0) {
            M_StartControlPanel()
            return 1
        }
        return 0
    }

    if STAT_gamestate() == GAME_GS_LEVEL {
        if HU_Responder(ev) != 0 {
            return 1
        }
        if ST_Responder(ev) != 0 {
            return 1
        }
        if AM_Responder(ev) != 0 {
            return 1
        }
    }

    if STAT_gamestate() == GAME_GS_FINALE {
        if F_Responder(ev) != 0 {
            return 1
        }
    }

    if STAT_testcontrols() != 0 and et == GAME_EV_MOUSE {
        STAT_set_testcontrols_mousespeed(gameshim_iabs(gameshim_ev_data2(ev)))
    }

    if et == GAME_EV_KEYDOWN and d1 == KEY_prevweapon() {
        gameshim_set_next_weapon(0 - 1)
    } elif et == GAME_EV_KEYDOWN and d1 == KEY_nextweapon() {
        gameshim_set_next_weapon(1)
    }

    if et == GAME_EV_KEYDOWN {
        if d1 == KEY_pause() {
            gameshim_set_sendpause(1)
        } elif d1 < GAME_NUMKEYS {
            gameshim_set_gamekeydown(d1, 1)
        }
        return 1
    }
    if et == GAME_EV_KEYUP {
        if d1 < GAME_NUMKEYS {
            gameshim_set_gamekeydown(d1, 0)
        }
        return 0
    }
    if et == GAME_EV_MOUSE {
        game_set_mouse_buttons(d1 as u32)
        let sens: i32 = STAT_mouseSensitivity() + 5
        gameshim_set_mousex(gameshim_ev_data2(ev) * sens / 10)
        gameshim_set_mousey(gameshim_ev_data3(ev) * sens / 10)
        return 1
    }
    if et == GAME_EV_JOYSTICK {
        game_set_joy_buttons(d1 as u32)
        gameshim_set_joyxmove(gameshim_ev_data2(ev))
        gameshim_set_joyymove(gameshim_ev_data3(ev))
        gameshim_set_joystrafemove(gameshim_ev_data4(ev))
        return 1
    }
    return 0
}

# ---- forward decls via function order: demos / reborn helpers first ---

@flow_api
function G_ReadDemoTiccmd(cmd: ptr<void>) -> void {
    if DEMO_peek_u8() == GAME_DEMOMARKER {
        G_CheckDemoStatus()
        return
    }
    let fm: i32 = DEMO_read_u8()
    if fm > 127 {
        fm = fm - 256
    }
    CMD_set_forwardmove(cmd, fm)
    let sm: i32 = DEMO_read_u8()
    if sm > 127 {
        sm = sm - 256
    }
    CMD_set_sidemove(cmd, sm)

    if gameshim_longtics() != 0 {
        let low: i32 = DEMO_read_u8()
        let high: i32 = DEMO_read_u8()
        CMD_set_angleturn(cmd, low | (high << 8))
    } else {
        CMD_set_angleturn(cmd, DEMO_read_u8() << 8)
    }
    CMD_set_buttons(cmd, DEMO_read_u8())
}

@flow_api
function G_WriteDemoTiccmd(cmd: ptr<void>) -> void {
    if gameshim_gamekeydown(KEY_demo_quit()) != 0 {
        G_CheckDemoStatus()
    }
    let demo_start: ptr<void> = DEMO_mark()
    DEMO_write_u8(CMD_forwardmove(cmd))
    DEMO_write_u8(CMD_sidemove(cmd))
    if gameshim_longtics() != 0 {
        let at: i32 = CMD_angleturn(cmd)
        DEMO_write_u8(at & 255)
        DEMO_write_u8((at >> 8) & 255)
    } else {
        DEMO_write_u8(CMD_angleturn(cmd) >> 8)
    }
    DEMO_write_u8(CMD_buttons(cmd))
    DEMO_rewind_to(demo_start)

    if DEMO_bytes_left() < 16 {
        if DEMO_vanilla_limit() != 0 {
            G_CheckDemoStatus()
            return
        }
        DEMO_increase_buffer()
    }
    G_ReadDemoTiccmd(cmd)
}

@flow_api
function G_PlayerReborn(player: i32) -> void {
    PLAYER_reborn_core(player)
}

@flow_api
function G_InitPlayer(player: i32) -> void {
    G_PlayerReborn(player)
}

function game_player_finish_level(player: i32) -> void {
    PLAYER_finish_level(PLAYER_at(player))
}

function game_check_spot(playernum: i32, mthing: ptr<void>) -> i32 {
    let pl: ptr<void> = PLAYER_at(playernum)
    let mo0: ptr<void> = PLAYER_mo(pl)
    if (mo0 as i64) == 0 {
        for i in 0 to playernum {
            let omo: ptr<void> = PLAYER_mo(PLAYER_at(i))
            if MOBJ_x(omo) == (MTHING_x(mthing) << GAME_FRACBITS) and MOBJ_y(omo) == (MTHING_y(mthing) << GAME_FRACBITS) {
                return 0
            }
        }
        return 1
    }

    let x: i32 = MTHING_x(mthing) << GAME_FRACBITS
    let y: i32 = MTHING_y(mthing) << GAME_FRACBITS
    if P_CheckPosition(mo0, x, y) == 0 {
        return 0
    }

    if gameshim_bodyqueslot() >= GAME_BODYQUESIZE {
        P_RemoveMobj(gameshim_bodyque(gameshim_bodyqueslot() % GAME_BODYQUESIZE))
    }
    gameshim_set_bodyque(gameshim_bodyqueslot() % GAME_BODYQUESIZE, mo0)
    gameshim_set_bodyqueslot(gameshim_bodyqueslot() + 1)

    let ss: ptr<void> = R_PointInSubsector(x, y)
    let an: i32 = ((GAME_ANG45 >> GAME_ANGLETOFINESHIFT) as i32) * (MTHING_angle(mthing) / 45)
    let mut xa: i32 = 0
    let mut ya: i32 = 0
    if an == 4096 {
        xa = TABLES_finetangent(2048 as i32)
        ya = TABLES_finetangent(0 as i32)
    } elif an == 5120 {
        xa = TABLES_finetangent(3072 as i32)
        ya = TABLES_finetangent(1024 as i32)
    } elif an == 6144 {
        xa = TABLES_finesine(0 as i32)
        ya = TABLES_finetangent(2048 as i32)
    } elif an == 7168 {
        xa = TABLES_finesine(1024 as i32)
        ya = TABLES_finetangent(3072 as i32)
    } elif an == 0 or an == 1024 or an == 2048 or an == 3072 {
        xa = TABLES_finecosine(an as i32)
        ya = TABLES_finesine(an as i32)
    } else {
        gameshim_error_checkspot_angle(an)
        xa = 0
        ya = 0
    }

    let mo: ptr<void> = P_SpawnMobj(x + 20 * xa, y + 20 * ya, GEOM_sector_floorheight(GEOM_subsector_sector(ss)), GAME_MT_TFOG)
    if PLAYER_viewz(PLAYER_at(STAT_consoleplayer())) != 1 {
        S_StartSound(mo, GAME_SFX_TELEPT)
    }
    return 1
}

@flow_api
function G_DeathMatchSpawnPlayer(playernum: i32) -> void {
    let selections: i32 = gameshim_deathmatch_selections()
    if selections < 4 {
        gameshim_error_dm_spots(selections)
    }
    for j in 0 to 20 {
        let i: i32 = P_Random() % selections
        let spot: ptr<void> = gameshim_deathmatchstart(i)
        if game_check_spot(playernum, spot) != 0 {
            MTHING_set_type(spot, playernum + 1)
            P_SpawnPlayer(spot)
            return
        }
    }
    P_SpawnPlayer(gameshim_playerstart(playernum))
}

function game_do_reborn(playernum: i32) -> void {
    if STAT_netgame() == 0 {
        STAT_set_gameaction(GAME_GA_LOADLEVEL)
        return
    }
    MOBJ_set_player(PLAYER_mo(PLAYER_at(playernum)), null)
    if STAT_deathmatch() != 0 {
        G_DeathMatchSpawnPlayer(playernum)
        return
    }
    if game_check_spot(playernum, gameshim_playerstart(playernum)) != 0 {
        P_SpawnPlayer(gameshim_playerstart(playernum))
        return
    }
    for i in 0 to GAME_MAXPLAYERS {
        if game_check_spot(playernum, gameshim_playerstart(i)) != 0 {
            MTHING_set_type(gameshim_playerstart(i), playernum + 1)
            P_SpawnPlayer(gameshim_playerstart(i))
            MTHING_set_type(gameshim_playerstart(i), i + 1)
            return
        }
    }
    P_SpawnPlayer(gameshim_playerstart(playernum))
}

@flow_api
function G_ScreenShot() -> void {
    STAT_set_gameaction(GAME_GA_SCREENSHOT)
}

@flow_api
function G_DrawMouseSpeedBox() -> void {
    # Declared in g_game.h but not implemented in this doomgeneric tree.
