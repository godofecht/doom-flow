# wminfo fields: WMINFO_* (game.flow)

function lnode_x(epsd: i32, n: i32) -> i32 {
    return lnodes_x[epsd * WI_NUMMAPS + n]
}

function lnode_y(epsd: i32, n: i32) -> i32 {
    return lnodes_y[epsd * WI_NUMMAPS + n]
}

function wi_num_patch(i: i32) -> ptr<void> {
    if i == 0 { return num0 }
    elif i == 1 { return num1 }
    elif i == 2 { return num2 }
    elif i == 3 { return num3 }
    elif i == 4 { return num4 }
    elif i == 5 { return num5 }
    elif i == 6 { return num6 }
    elif i == 7 { return num7 }
    elif i == 8 { return num8 }
    return num9
}

function wi_set_num_patch(i: i32, p: ptr<void>) -> void {
    if i == 0 { num0 = p }
    elif i == 1 { num1 = p }
    elif i == 2 { num2 = p }
    elif i == 3 { num3 = p }
    elif i == 4 { num4 = p }
    elif i == 5 { num5 = p }
    elif i == 6 { num6 = p }
    elif i == 7 { num7 = p }
    elif i == 8 { num8 = p }
    else { num9 = p }
}

function wi_p_patch(i: i32) -> ptr<void> {
    if i == 0 { return p0 }
    elif i == 1 { return p1 }
    elif i == 2 { return p2 }
    return p3
}

function wi_set_p_patch(i: i32, p: ptr<void>) -> void {
    if i == 0 { p0 = p }
    elif i == 1 { p1 = p }
    elif i == 2 { p2 = p }
    else { p3 = p }
}

function wi_set_bp_patch(i: i32, p: ptr<void>) -> void {
    if i == 0 { bp0 = p }
    elif i == 1 { bp1 = p }
    elif i == 2 { bp2 = p }
    else { bp3 = p }
}

function wi_lname(i: i32) -> ptr<void> {
    return lnames[i] as ptr<void>
}

function wi_set_lname(i: i32, p: ptr<void>) -> void {
    lnames[i] = p as i64
}

function wi_anim_get(epsd: i32, i: i32) -> Anim {
    if epsd == 0 {
        return epsd0anims[i]
    } elif epsd == 1 {
        return epsd1anims[i]
    }
    return epsd2anims[i]
}

function wi_anim_set(epsd: i32, i: i32, a: Anim) -> void {
    if epsd == 0 {
        epsd0anims[i] = a
    } elif epsd == 1 {
        epsd1anims[i] = a
    } else {
        epsd2anims[i] = a
    }
}

function wi_anim_frame(a: Anim, ctr: i32) -> ptr<void> {
    if ctr == 0 {
        return a.p0
    } elif ctr == 1 {
        return a.p1
    }
    return a.p2
}

function wi_anim_set_frame(a: Anim, i: i32, p: ptr<void>) -> Anim {
    let mut r: Anim = a
    if i == 0 {
        r.p0 = p
    } elif i == 1 {
        r.p1 = p
    } else {
        r.p2 = p
    }
    return r
}

function wi_load_one(name: string) -> ptr<void> {
    return W_CacheLumpName(name, WI_PU_STATIC)
}

function wi_unload_one(name: string) -> ptr<void> {
    W_ReleaseLumpName(name)
    return null
}

#
# WI_slamBackground
#
function WI_slamBackground() -> void {
    V_DrawPatch(0, 0, background)
}

#
# WI_Responder (not in public header; always false)
#
function WI_Responder(ev: ptr<i32>) -> i32 {
    return 0
}

#
# WI_drawLF
#
function WI_drawLF() -> void {
    let mut y: i32 = WI_TITLEY
    let last: i32 = WMINFO_last()

    if STAT_gamemode() != WI_GM_COMMERCIAL or last < NUMCMAPS {
        let ln: ptr<void> = wi_lname(last)
        V_DrawPatch((WI_SCREENWIDTH - PATCH_width(ln)) / 2, y, ln)
        y = y + (5 * PATCH_height(ln)) / 4
        V_DrawPatch((WI_SCREENWIDTH - PATCH_width(finished)) / 2, y, finished)
    } elif last == NUMCMAPS {
        # MAP33 - nothing
        return
    } else {
        wishim_draw_bad_patch(y)
    }
}

#
# WI_drawEL
#
function WI_drawEL() -> void {
    let mut y: i32 = WI_TITLEY
    V_DrawPatch((WI_SCREENWIDTH - PATCH_width(entering)) / 2, y, entering)
    let ln: ptr<void> = wi_lname(WMINFO_next())
    y = y + (5 * PATCH_height(ln)) / 4
    V_DrawPatch((WI_SCREENWIDTH - PATCH_width(ln)) / 2, y, ln)
}

#
# WI_drawOnLnode
#
function WI_drawOnLnode(n: i32, c0: ptr<void>, c1: ptr<void>) -> void {
    let mut i: i32 = 0
    let mut fits: i32 = 0
    let epsd: i32 = WMINFO_epsd()

    while 1 == 1 {
        let c: ptr<void> = c0
        if i != 0 {
            c = c1
        }
        if (c as i64) == 0 {
            break
        }
        let left: i32 = lnode_x(epsd, n) - PATCH_leftoffset(c)
        let top: i32 = lnode_y(epsd, n) - PATCH_topoffset(c)
        let right: i32 = left + PATCH_width(c)
        let bottom: i32 = top + PATCH_height(c)
        if left >= 0 and right < WI_SCREENWIDTH and top >= 0 and bottom < WI_SCREENHEIGHT {
            fits = 1
            break
        }
        i = i + 1
        if i == 2 {
            break
        }
        if i != 0 and (c1 as i64) == 0 {
            break
        }
    }

    if fits != 0 and i < 2 {
        let c: ptr<void> = c0
        if i != 0 {
            c = c1
        }
        V_DrawPatch(lnode_x(epsd, n), lnode_y(epsd, n), c)
    } else {
        wishim_patch_place_debug(n)
    }
}

#
# WI_initAnimatedBack
#
function WI_initAnimatedBack() -> void {
    if STAT_gamemode() == WI_GM_COMMERCIAL {
        return
    }
    let epsd: i32 = WMINFO_epsd()
    if epsd > 2 {
        return
    }
    let n: i32 = wi_numanims[epsd]
    for i in 0 to n {
        let mut a: Anim = wi_anim_get(epsd, i)
        a.ctr = 0 - 1
        if a.atype == WI_ANIM_ALWAYS {
            a.nexttic = bcnt + 1 + (M_Random() % a.period)
        } elif a.atype == WI_ANIM_RANDOM {
            a.nexttic = bcnt + 1 + a.data2 + (M_Random() % a.data1)
        } elif a.atype == WI_ANIM_LEVEL {
            a.nexttic = bcnt + 1
        }
        wi_anim_set(epsd, i, a)
    }
}

#
# WI_updateAnimatedBack
#
function WI_updateAnimatedBack() -> void {
    if STAT_gamemode() == WI_GM_COMMERCIAL {
        return
    }
    let epsd: i32 = WMINFO_epsd()
    if epsd > 2 {
        return
    }
    let n: i32 = wi_numanims[epsd]
    for i in 0 to n {
        let mut a: Anim = wi_anim_get(epsd, i)
        if bcnt == a.nexttic {
            if a.atype == WI_ANIM_ALWAYS {
                a.ctr = a.ctr + 1
                if a.ctr >= a.nanims {
                    a.ctr = 0
                }
                a.nexttic = bcnt + a.period
            } elif a.atype == WI_ANIM_RANDOM {
                a.ctr = a.ctr + 1
                if a.ctr == a.nanims {
                    a.ctr = 0 - 1
                    a.nexttic = bcnt + a.data2 + (M_Random() % a.data1)
                } else {
                    a.nexttic = bcnt + a.period
                }
            } elif a.atype == WI_ANIM_LEVEL {
                if !(state == WI_STATCOUNT and i == 7) and WMINFO_next() == a.data1 {
                    a.ctr = a.ctr + 1
                    if a.ctr == a.nanims {
                        a.ctr = a.ctr - 1
                    }
                    a.nexttic = bcnt + a.period
                }
            }
            wi_anim_set(epsd, i, a)
        }
    }
}

#
# WI_drawAnimatedBack
#
function WI_drawAnimatedBack() -> void {
    if STAT_gamemode() == WI_GM_COMMERCIAL {
        return
    }
    let epsd: i32 = WMINFO_epsd()
    if epsd > 2 {
        return
    }
    let n: i32 = wi_numanims[epsd]
    for i in 0 to n {
        let a: Anim = wi_anim_get(epsd, i)
        if a.ctr >= 0 {
            V_DrawPatch(a.loc_x, a.loc_y, wi_anim_frame(a, a.ctr))
        }
    }
}

#
# WI_drawNum
#
function WI_drawNum(x_in: i32, y: i32, n_in: i32, digits_in: i32) -> i32 {
    let fontwidth: i32 = PATCH_width(num0)
    let mut x: i32 = x_in
    let mut n: i32 = n_in
    let mut digits: i32 = digits_in

    if digits < 0 {
        if n == 0 {
            digits = 1
        } else {
            digits = 0
            let mut temp: i32 = n
            while temp != 0 {
                temp = temp / 10
                digits = digits + 1
            }
        }
    }

    let mut neg: i32 = 0
    if n < 0 {
        neg = 1
        n = 0 - n
    }

    if n == 1994 {
        return 0
    }

    while digits != 0 {
        digits = digits - 1
        x = x - fontwidth
        V_DrawPatch(x, y, wi_num_patch(n % 10))
        n = n / 10
    }

    if neg != 0 {
        x = x - 8
        V_DrawPatch(x, y, wiminus)
    }
    return x
}

#
# WI_drawPercent
#
function WI_drawPercent(x: i32, y: i32, p: i32) -> void {
    if p < 0 {
        return
    }
    V_DrawPatch(x, y, percent)
    let _x: i32 = WI_drawNum(x, y, p, 0 - 1)
}

#
# WI_drawTime
#
function WI_drawTime(x_in: i32, y: i32, t: i32) -> void {
    if t < 0 {
        return
    }
    let mut x: i32 = x_in
    if t <= 61 * 59 {
        let mut div: i32 = 1
        while 1 == 1 {
            let n: i32 = (t / div) % 60
            x = WI_drawNum(x, y, n, 2) - PATCH_width(colon)
            div = div * 60
            if div == 60 or t / div != 0 {
                V_DrawPatch(x, y, colon)
            }
            if t / div == 0 {
                break
            }
        }
    } else {
        V_DrawPatch(x - PATCH_width(sucks), y, sucks)
    }
}

#
# WI_End
#
@flow_api
function WI_End() -> void {
    WI_unloadData()
}

#
# WI_initNoState
#
function WI_initNoState() -> void {
    state = WI_NOSTATE
    acceleratestage = 0
    cnt = 10
}

#
# WI_updateNoState
#
function WI_updateNoState() -> void {
    WI_updateAnimatedBack()
    cnt = cnt - 1
    if cnt == 0 {
        G_WorldDone()
    }
}

#
# WI_initShowNextLoc
#
function WI_initShowNextLoc() -> void {
    state = WI_SHOWNEXTLOC
    acceleratestage = 0
    cnt = WI_SHOWNEXTLOCDELAY * WI_TICRATE
    WI_initAnimatedBack()
}

#
# WI_updateShowNextLoc
#
function WI_updateShowNextLoc() -> void {
    WI_updateAnimatedBack()
    cnt = cnt - 1
    if cnt == 0 or acceleratestage != 0 {
        WI_initNoState()
    } else {
        if (cnt & 31) < 20 {
            snl_pointeron = 1
        } else {
            snl_pointeron = 0
        }
    }
}

#
# WI_drawShowNextLoc
#
function WI_drawShowNextLoc() -> void {
    WI_slamBackground()
    WI_drawAnimatedBack()

    if STAT_gamemode() != WI_GM_COMMERCIAL {
        if WMINFO_epsd() > 2 {
            WI_drawEL()
            return
        }
        let mut last: i32 = WMINFO_last()
        if last == 8 {
            last = WMINFO_next() - 1
        }
        for i in 0 to last + 1 {
            WI_drawOnLnode(i, splat0, null)
        }
        if WMINFO_didsecret() != 0 {
            WI_drawOnLnode(8, splat0, null)
        }
        if snl_pointeron != 0 {
            WI_drawOnLnode(WMINFO_next(), yah0, yah1)
        }
    }

    if STAT_gamemode() != WI_GM_COMMERCIAL or WMINFO_next() != 30 {
        WI_drawEL()
    }
}

#
# WI_drawNoState
#
function WI_drawNoState() -> void {
    snl_pointeron = 1
    WI_drawShowNextLoc()
}

#
# WI_fragSum
#
function WI_fragSum(playernum: i32) -> i32 {
    let mut frags_sum: i32 = 0
    for i in 0 to WI_MAXPLAYERS {
        if STAT_playeringame(i) != 0 and i != playernum {
            frags_sum = frags_sum + WMINFO_plyr_frag(playernum, i)
        }
    }
    frags_sum = frags_sum - WMINFO_plyr_frag(playernum, playernum)
    return frags_sum
}

function dm_frag(i: i32, j: i32) -> i32 {
    return dm_frags[i * WI_MAXPLAYERS + j]
}

function dm_set_frag(i: i32, j: i32, v: i32) -> void {
    dm_frags[i * WI_MAXPLAYERS + j] = v
}

#
# WI_initDeathmatchStats
#
function WI_initDeathmatchStats() -> void {
    state = WI_STATCOUNT
    acceleratestage = 0
    dm_state = 1
    cnt_pause = WI_TICRATE
    for i in 0 to WI_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            for j in 0 to WI_MAXPLAYERS {
                if STAT_playeringame(j) != 0 {
                    dm_set_frag(i, j, 0)
                }
            }
            dm_totals[i] = 0
        }
    }
    WI_initAnimatedBack()
}

#
# WI_updateDeathmatchStats
#
function WI_updateDeathmatchStats() -> void {
    WI_updateAnimatedBack()

    if acceleratestage != 0 and dm_state != 4 {
        acceleratestage = 0
        for i in 0 to WI_MAXPLAYERS {
            if STAT_playeringame(i) != 0 {
                for j in 0 to WI_MAXPLAYERS {
                    if STAT_playeringame(j) != 0 {
                        dm_set_frag(i, j, WMINFO_plyr_frag(i, j))
                    }
                }
                dm_totals[i] = WI_fragSum(i)
            }
        }
        S_StartSound(null, WI_SFX_BAREXP)
        dm_state = 4
    }

    if dm_state == 2 {
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let mut stillticking: i32 = 0
        for i in 0 to WI_MAXPLAYERS {
            if STAT_playeringame(i) != 0 {
                for j in 0 to WI_MAXPLAYERS {
                    if STAT_playeringame(j) != 0 and dm_frag(i, j) != WMINFO_plyr_frag(i, j) {
                        if WMINFO_plyr_frag(i, j) < 0 {
                            dm_set_frag(i, j, dm_frag(i, j) - 1)
                        } else {
                            dm_set_frag(i, j, dm_frag(i, j) + 1)
                        }
                        if dm_frag(i, j) > 99 {
                            dm_set_frag(i, j, 99)
                        }
                        if dm_frag(i, j) < 0 - 99 {
                            dm_set_frag(i, j, 0 - 99)
                        }
                        stillticking = 1
                    }
                }
                dm_totals[i] = WI_fragSum(i)
                if dm_totals[i] > 99 {
                    dm_totals[i] = 99
                }
                if dm_totals[i] < 0 - 99 {
                    dm_totals[i] = 0 - 99
                }
            }
        }
        if stillticking == 0 {
            S_StartSound(null, WI_SFX_BAREXP)
            dm_state = dm_state + 1
        }
    } elif dm_state == 4 {
        if acceleratestage != 0 {
            S_StartSound(null, WI_SFX_SLOP)
            if STAT_gamemode() == WI_GM_COMMERCIAL {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif (dm_state & 1) != 0 {
        cnt_pause = cnt_pause - 1
        if cnt_pause == 0 {
            dm_state = dm_state + 1
            cnt_pause = WI_TICRATE
        }
    }
}

#
# WI_drawDeathmatchStats
#
function WI_drawDeathmatchStats() -> void {
    WI_slamBackground()
    WI_drawAnimatedBack()
    WI_drawLF()

    V_DrawPatch(WI_DM_TOTALSX - PATCH_width(total) / 2,
                WI_DM_MATRIXY - WI_SPACINGY + 10, total)
    V_DrawPatch(WI_DM_KILLERSX, WI_DM_KILLERSY, killers)
    V_DrawPatch(WI_DM_VICTIMSX, WI_DM_VICTIMSY, victims)

    let mut x: i32 = WI_DM_MATRIXX + WI_DM_SPACINGX
    let mut y: i32 = WI_DM_MATRIXY
    for i in 0 to WI_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            let pi: ptr<void> = wi_p_patch(i)
            V_DrawPatch(x - PATCH_width(pi) / 2, WI_DM_MATRIXY - WI_SPACINGY, pi)
            V_DrawPatch(WI_DM_MATRIXX - PATCH_width(pi) / 2, y, pi)
            if i == me {
                V_DrawPatch(x - PATCH_width(pi) / 2, WI_DM_MATRIXY - WI_SPACINGY, bstar)
                V_DrawPatch(WI_DM_MATRIXX - PATCH_width(pi) / 2, y, star)
            }
        }
        x = x + WI_DM_SPACINGX
        y = y + WI_SPACINGY
    }

    y = WI_DM_MATRIXY + 10
    let w: i32 = PATCH_width(num0)
    for i in 0 to WI_MAXPLAYERS {
        x = WI_DM_MATRIXX + WI_DM_SPACINGX
        if STAT_playeringame(i) != 0 {
            for j in 0 to WI_MAXPLAYERS {
                if STAT_playeringame(j) != 0 {
                    let _x: i32 = WI_drawNum(x + w, y, dm_frag(i, j), 2)
                }
                x = x + WI_DM_SPACINGX
            }
            let _x2: i32 = WI_drawNum(WI_DM_TOTALSX + w, y, dm_totals[i], 2)
        }
        y = y + WI_SPACINGY
    }
}

#
# WI_initNetgameStats
#
function WI_initNetgameStats() -> void {
    state = WI_STATCOUNT
    acceleratestage = 0
    ng_state = 1
    cnt_pause = WI_TICRATE
    # dofrags is a C static; not cleared here (quirk: carries across calls)
    for i in 0 to WI_MAXPLAYERS {
        if STAT_playeringame(i) == 0 {
            continue
        }
        cnt_kills[i] = 0
        cnt_items[i] = 0
        cnt_secret[i] = 0
        cnt_frags[i] = 0
        dofrags = dofrags + WI_fragSum(i)
    }
    if dofrags != 0 {
        dofrags = 1
    } else {
        dofrags = 0
    }
    WI_initAnimatedBack()
}

#
# WI_updateNetgameStats
#
function WI_updateNetgameStats() -> void {
    WI_updateAnimatedBack()

    if acceleratestage != 0 and ng_state != 10 {
        acceleratestage = 0
        for i in 0 to WI_MAXPLAYERS {
            if STAT_playeringame(i) == 0 {
                continue
            }
            cnt_kills[i] = (WMINFO_plyr_skills(i) * 100) / WMINFO_maxkills()
            cnt_items[i] = (WMINFO_plyr_sitems(i) * 100) / WMINFO_maxitems()
            cnt_secret[i] = (WMINFO_plyr_ssecret(i) * 100) / WMINFO_maxsecret()
            if dofrags != 0 {
                cnt_frags[i] = WI_fragSum(i)
            }
        }
        S_StartSound(null, WI_SFX_BAREXP)
        ng_state = 10
    }

    if ng_state == 2 {
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let mut stillticking: i32 = 0
        for i in 0 to WI_MAXPLAYERS {
            if STAT_playeringame(i) == 0 {
                continue
            }
            cnt_kills[i] = cnt_kills[i] + 2
            let target: i32 = (WMINFO_plyr_skills(i) * 100) / WMINFO_maxkills()
            if cnt_kills[i] >= target {
                cnt_kills[i] = target
            } else {
                stillticking = 1
            }
        }
        if stillticking == 0 {
            S_StartSound(null, WI_SFX_BAREXP)
            ng_state = ng_state + 1
        }
    } elif ng_state == 4 {
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let mut stillticking2: i32 = 0
        for i in 0 to WI_MAXPLAYERS {
            if STAT_playeringame(i) == 0 {
                continue
            }
            cnt_items[i] = cnt_items[i] + 2
            let target2: i32 = (WMINFO_plyr_sitems(i) * 100) / WMINFO_maxitems()
            if cnt_items[i] >= target2 {
                cnt_items[i] = target2
            } else {
                stillticking2 = 1
            }
        }
        if stillticking2 == 0 {
            S_StartSound(null, WI_SFX_BAREXP)
            ng_state = ng_state + 1
        }
    } elif ng_state == 6 {
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let mut stillticking3: i32 = 0
        for i in 0 to WI_MAXPLAYERS {
            if STAT_playeringame(i) == 0 {
                continue
            }
            cnt_secret[i] = cnt_secret[i] + 2
            let target3: i32 = (WMINFO_plyr_ssecret(i) * 100) / WMINFO_maxsecret()
            if cnt_secret[i] >= target3 {
                cnt_secret[i] = target3
            } else {
                stillticking3 = 1
            }
        }
        if stillticking3 == 0 {
            S_StartSound(null, WI_SFX_BAREXP)
            let skip: i32 = 0
            if dofrags == 0 {
                skip = 2
            }
            ng_state = ng_state + 1 + skip
        }
    } elif ng_state == 8 {
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let mut stillticking4: i32 = 0
        for i in 0 to WI_MAXPLAYERS {
            if STAT_playeringame(i) == 0 {
                continue
            }
            cnt_frags[i] = cnt_frags[i] + 1
            let fsum: i32 = WI_fragSum(i)
            if cnt_frags[i] >= fsum {
                cnt_frags[i] = fsum
            } else {
                stillticking4 = 1
            }
        }
        if stillticking4 == 0 {
            S_StartSound(null, WI_SFX_PLDETH)
            ng_state = ng_state + 1
        }
    } elif ng_state == 10 {
        if acceleratestage != 0 {
            S_StartSound(null, WI_SFX_SGCOCK)
            if STAT_gamemode() == WI_GM_COMMERCIAL {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif (ng_state & 1) != 0 {
        cnt_pause = cnt_pause - 1
        if cnt_pause == 0 {
            ng_state = ng_state + 1
            cnt_pause = WI_TICRATE
        }
    }
}

#
# WI_drawNetgameStats
#
function WI_drawNetgameStats() -> void {
    let pwidth: i32 = PATCH_width(percent)
    let ng_statsx: i32 = 32 + PATCH_width(star) / 2
    if dofrags == 0 {
        ng_statsx = ng_statsx + 32
    }

    WI_slamBackground()
    WI_drawAnimatedBack()
    WI_drawLF()

    V_DrawPatch(ng_statsx + WI_NG_SPACINGX - PATCH_width(kills), WI_NG_STATSY, kills)
    V_DrawPatch(ng_statsx + 2 * WI_NG_SPACINGX - PATCH_width(items), WI_NG_STATSY, items)
    V_DrawPatch(ng_statsx + 3 * WI_NG_SPACINGX - PATCH_width(secret), WI_NG_STATSY, secret)
    if dofrags != 0 {
        V_DrawPatch(ng_statsx + 4 * WI_NG_SPACINGX - PATCH_width(frags), WI_NG_STATSY, frags)
    }

    let mut y: i32 = WI_NG_STATSY + PATCH_height(kills)
    for i in 0 to WI_MAXPLAYERS {
        if STAT_playeringame(i) == 0 {
            continue
        }
        let mut x: i32 = ng_statsx
        let pi: ptr<void> = wi_p_patch(i)
        V_DrawPatch(x - PATCH_width(pi), y, pi)
        if i == me {
            V_DrawPatch(x - PATCH_width(pi), y, star)
        }
        x = x + WI_NG_SPACINGX
        WI_drawPercent(x - pwidth, y + 10, cnt_kills[i])
        x = x + WI_NG_SPACINGX
        WI_drawPercent(x - pwidth, y + 10, cnt_items[i])
        x = x + WI_NG_SPACINGX
        WI_drawPercent(x - pwidth, y + 10, cnt_secret[i])
        x = x + WI_NG_SPACINGX
        if dofrags != 0 {
            let _x: i32 = WI_drawNum(x, y + 10, cnt_frags[i], 0 - 1)
        }
        y = y + WI_SPACINGY
    }
}

#
# WI_initStats
#
function WI_initStats() -> void {
    state = WI_STATCOUNT
    acceleratestage = 0
    sp_state = 1
    cnt_kills[0] = 0 - 1
    cnt_items[0] = 0 - 1
    cnt_secret[0] = 0 - 1
    cnt_time = 0 - 1
    cnt_par = 0 - 1
    cnt_pause = WI_TICRATE
    WI_initAnimatedBack()
}

#
# WI_updateStats
#
function WI_updateStats() -> void {
    WI_updateAnimatedBack()

    if acceleratestage != 0 and sp_state != 10 {
        acceleratestage = 0
        cnt_kills[0] = (WMINFO_plyr_skills(me) * 100) / WMINFO_maxkills()
        cnt_items[0] = (WMINFO_plyr_sitems(me) * 100) / WMINFO_maxitems()
        cnt_secret[0] = (WMINFO_plyr_ssecret(me) * 100) / WMINFO_maxsecret()
        cnt_time = WMINFO_plyr_stime(me) / WI_TICRATE
        cnt_par = WMINFO_partime() / WI_TICRATE
        S_StartSound(null, WI_SFX_BAREXP)
        sp_state = 10
    }

    if sp_state == 2 {
        cnt_kills[0] = cnt_kills[0] + 2
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let target: i32 = (WMINFO_plyr_skills(me) * 100) / WMINFO_maxkills()
        if cnt_kills[0] >= target {
            cnt_kills[0] = target
            S_StartSound(null, WI_SFX_BAREXP)
            sp_state = sp_state + 1
        }
    } elif sp_state == 4 {
        cnt_items[0] = cnt_items[0] + 2
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let target2: i32 = (WMINFO_plyr_sitems(me) * 100) / WMINFO_maxitems()
        if cnt_items[0] >= target2 {
            cnt_items[0] = target2
            S_StartSound(null, WI_SFX_BAREXP)
            sp_state = sp_state + 1
        }
    } elif sp_state == 6 {
        cnt_secret[0] = cnt_secret[0] + 2
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        let target3: i32 = (WMINFO_plyr_ssecret(me) * 100) / WMINFO_maxsecret()
        if cnt_secret[0] >= target3 {
            cnt_secret[0] = target3
            S_StartSound(null, WI_SFX_BAREXP)
            sp_state = sp_state + 1
        }
    } elif sp_state == 8 {
        if (bcnt & 3) == 0 {
            S_StartSound(null, WI_SFX_PISTOL)
        }
        cnt_time = cnt_time + 3
        if cnt_time >= WMINFO_plyr_stime(me) / WI_TICRATE {
            cnt_time = WMINFO_plyr_stime(me) / WI_TICRATE
        }
        cnt_par = cnt_par + 3
        if cnt_par >= WMINFO_partime() / WI_TICRATE {
            cnt_par = WMINFO_partime() / WI_TICRATE
            if cnt_time >= WMINFO_plyr_stime(me) / WI_TICRATE {
                S_StartSound(null, WI_SFX_BAREXP)
                sp_state = sp_state + 1
            }
        }
    } elif sp_state == 10 {
        if acceleratestage != 0 {
            S_StartSound(null, WI_SFX_SGCOCK)
            if STAT_gamemode() == WI_GM_COMMERCIAL {
                WI_initNoState()
            } else {
                WI_initShowNextLoc()
            }
        }
    } elif (sp_state & 1) != 0 {
        cnt_pause = cnt_pause - 1
        if cnt_pause == 0 {
            sp_state = sp_state + 1
            cnt_pause = WI_TICRATE
        }
    }
}

#
# WI_drawStats
#
function WI_drawStats() -> void {
    let lh: i32 = (3 * PATCH_height(num0)) / 2
    WI_slamBackground()
    WI_drawAnimatedBack()
    WI_drawLF()

    V_DrawPatch(WI_SP_STATSX, WI_SP_STATSY, kills)
    WI_drawPercent(WI_SCREENWIDTH - WI_SP_STATSX, WI_SP_STATSY, cnt_kills[0])

    V_DrawPatch(WI_SP_STATSX, WI_SP_STATSY + lh, items)
    WI_drawPercent(WI_SCREENWIDTH - WI_SP_STATSX, WI_SP_STATSY + lh, cnt_items[0])

    V_DrawPatch(WI_SP_STATSX, WI_SP_STATSY + 2 * lh, sp_secret)
    WI_drawPercent(WI_SCREENWIDTH - WI_SP_STATSX, WI_SP_STATSY + 2 * lh, cnt_secret[0])

    V_DrawPatch(WI_SP_TIMEX, WI_SP_TIMEY, timepatch)
    WI_drawTime(WI_SCREENWIDTH / 2 - WI_SP_TIMEX, WI_SP_TIMEY, cnt_time)

    if WMINFO_epsd() < 3 {
        V_DrawPatch(WI_SCREENWIDTH / 2 + WI_SP_TIMEX, WI_SP_TIMEY, par)
        WI_drawTime(WI_SCREENWIDTH - WI_SP_TIMEX, WI_SP_TIMEY, cnt_par)
    }
}

#
# WI_checkForAccelerate
#
function WI_checkForAccelerate() -> void {
    for i in 0 to WI_MAXPLAYERS {
        if STAT_playeringame(i) != 0 {
            if (PLAYER_i_cmd_buttons(i) & WI_BT_ATTACK) != 0 {
                if PLAYER_i_attackdown(i) == 0 {
                    acceleratestage = 1
                }
                PLAYER_i_set_attackdown(i, 1)
            } else {
                PLAYER_i_set_attackdown(i, 0)
            }
            if (PLAYER_i_cmd_buttons(i) & WI_BT_USE) != 0 {
                if PLAYER_i_usedown(i) == 0 {
                    acceleratestage = 1
                }
                PLAYER_i_set_usedown(i, 1)
            } else {
                PLAYER_i_set_usedown(i, 0)
            }
        }
    }
}

#
# WI_Ticker
#
@flow_api
function WI_Ticker() -> void {
    bcnt = bcnt + 1
    if bcnt == 1 {
        if STAT_gamemode() == WI_GM_COMMERCIAL {
            S_ChangeMusic(WI_MUS_DM2INT, 1)
        } else {
            S_ChangeMusic(WI_MUS_INTER, 1)
        }
    }
    WI_checkForAccelerate()
    if state == WI_STATCOUNT {
        if STAT_deathmatch() != 0 {
            WI_updateDeathmatchStats()
        } elif STAT_netgame() != 0 {
            WI_updateNetgameStats()
        } else {
            WI_updateStats()
        }
    } elif state == WI_SHOWNEXTLOC {
        WI_updateShowNextLoc()
    } elif state == WI_NOSTATE {
        WI_updateNoState()
    }
}

#
# WI_loadUnloadData
#
function WI_loadUnloadData(do_load: i32) -> void {
    let epsd: i32 = WMINFO_epsd()

    if STAT_gamemode() == WI_GM_COMMERCIAL {
        for i in 0 to NUMCMAPS {
            if do_load != 0 {
                wi_set_lname(i, wi_load_one(wishim_name_cwilv(i)))
            } else {
                wi_set_lname(i, wi_unload_one(wishim_name_cwilv(i)))
            }
        }
    } else {
        for i in 0 to WI_NUMMAPS {
            if do_load != 0 {
                wi_set_lname(i, wi_load_one(wishim_name_wilv(epsd, i)))
            } else {
                wi_set_lname(i, wi_unload_one(wishim_name_wilv(epsd, i)))
            }
        }
        if do_load != 0 {
            yah0 = wi_load_one("WIURH0")
            yah1 = wi_load_one("WIURH1")
            splat0 = wi_load_one("WISPLAT")
        } else {
            yah0 = wi_unload_one("WIURH0")
            yah1 = wi_unload_one("WIURH1")
            splat0 = wi_unload_one("WISPLAT")
        }
        if epsd < 3 {
            let nanims: i32 = wi_numanims[epsd]
            for j in 0 to nanims {
                let mut a: Anim = wi_anim_get(epsd, j)
                for i in 0 to a.nanims {
                    if epsd != 1 or j != 8 {
                        let name: string = wishim_name_wia(epsd, j, i)
                        if do_load != 0 {
                            a = wi_anim_set_frame(a, i, wi_load_one(name))
                        } else {
                            a = wi_anim_set_frame(a, i, wi_unload_one(name))
                        }
                    } else {
                        # MONDO HACK: share frames with anims[1][4]
                        let src: Anim = wi_anim_get(1, 4)
                        a = wi_anim_set_frame(a, i, wi_anim_frame(src, i))
                    }
                }
                wi_anim_set(epsd, j, a)
            }
        }
    }

    if do_load != 0 {
        wiminus = wi_load_one("WIMINUS")
    } else {
        wiminus = wi_unload_one("WIMINUS")
    }

    for i in 0 to 10 {
        if do_load != 0 {
            wi_set_num_patch(i, wi_load_one(wishim_name_winum(i)))
        } else {
            wi_set_num_patch(i, wi_unload_one(wishim_name_winum(i)))
        }
    }

    if do_load != 0 {
        percent = wi_load_one("WIPCNT")
        finished = wi_load_one("WIF")
        entering = wi_load_one("WIENTER")
        kills = wi_load_one("WIOSTK")
        secret = wi_load_one("WIOSTS")
        sp_secret = wi_load_one("WISCRT2")
        if W_CheckNumForName("WIOBJ") >= 0 {
            if STAT_netgame() != 0 and STAT_deathmatch() == 0 {
                items = wi_load_one("WIOBJ")
            } else {
                items = wi_load_one("WIOSTI")
            }
        } else {
            items = wi_load_one("WIOSTI")
        }
        frags = wi_load_one("WIFRGS")
        colon = wi_load_one("WICOLON")
        timepatch = wi_load_one("WITIME")
        sucks = wi_load_one("WISUCKS")
        par = wi_load_one("WIPAR")
        killers = wi_load_one("WIKILRS")
        victims = wi_load_one("WIVCTMS")
        total = wi_load_one("WIMSTT")
    } else {
        percent = wi_unload_one("WIPCNT")
        finished = wi_unload_one("WIF")
        entering = wi_unload_one("WIENTER")
        kills = wi_unload_one("WIOSTK")
        secret = wi_unload_one("WIOSTS")
        sp_secret = wi_unload_one("WISCRT2")
        if W_CheckNumForName("WIOBJ") >= 0 {
            if STAT_netgame() != 0 and STAT_deathmatch() == 0 {
                items = wi_unload_one("WIOBJ")
            } else {
                items = wi_unload_one("WIOSTI")
            }
        } else {
            items = wi_unload_one("WIOSTI")
        }
        frags = wi_unload_one("WIFRGS")
        colon = wi_unload_one("WICOLON")
        timepatch = wi_unload_one("WITIME")
        sucks = wi_unload_one("WISUCKS")
        par = wi_unload_one("WIPAR")
        killers = wi_unload_one("WIKILRS")
        victims = wi_unload_one("WIVCTMS")
        total = wi_unload_one("WIMSTT")
    }

    for i in 0 to WI_MAXPLAYERS {
        if do_load != 0 {
            wi_set_p_patch(i, wi_load_one(wishim_name_stpb(i)))
            wi_set_bp_patch(i, wi_load_one(wishim_name_wibp(i)))
        } else {
            wi_set_p_patch(i, wi_unload_one(wishim_name_stpb(i)))
            wi_set_bp_patch(i, wi_unload_one(wishim_name_wibp(i)))
        }
    }

    let mut bgname: string = "INTERPIC"
    if STAT_gamemode() == WI_GM_COMMERCIAL {
        bgname = "INTERPIC"
    } elif STAT_gamemode() == WI_GM_RETAIL and epsd == 3 {
        bgname = "INTERPIC"
    } else {
        bgname = wishim_name_wimap(epsd)
    }
    if do_load != 0 {
        background = wi_load_one(bgname)
    } else {
        background = wi_unload_one(bgname)
    }
}

function WI_loadData() -> void {
    if STAT_gamemode() == WI_GM_COMMERCIAL {
        NUMCMAPS = 32
        lnames = Z_Malloc(8 * NUMCMAPS, WI_PU_STATIC, null) as ptr<i64>
    } else {
        lnames = Z_Malloc(8 * WI_NUMMAPS, WI_PU_STATIC, null) as ptr<i64>
    }
    WI_loadUnloadData(1)
    star = W_CacheLumpName("STFST01", WI_PU_STATIC)
    bstar = W_CacheLumpName("STFDEAD0", WI_PU_STATIC)
}

function WI_unloadData() -> void {
    WI_loadUnloadData(0)
}

#
# WI_Drawer
#
@flow_api
function WI_Drawer() -> void {
    if state == WI_STATCOUNT {
        if STAT_deathmatch() != 0 {
            WI_drawDeathmatchStats()
        } elif STAT_netgame() != 0 {
            WI_drawNetgameStats()
        } else {
            WI_drawStats()
        }
    } elif state == WI_SHOWNEXTLOC {
        WI_drawShowNextLoc()
    } elif state == WI_NOSTATE {
        WI_drawNoState()
    }
}

#
# WI_initVariables
#
function WI_initVariables(wbstartstruct: ptr<void>) -> void {
    # wbstartstruct is always &wminfo from G_DoCompleted; fields via WMINFO_*.
    if wbstartstruct == null {
        return
    }
    acceleratestage = 0
    cnt = 0
    bcnt = 0
    firstrefresh = 1
    me = WMINFO_pnum()

    if WMINFO_maxkills() == 0 {
        WMINFO_set_maxkills(1)
    }
    if WMINFO_maxitems() == 0 {
        WMINFO_set_maxitems(1)
    }
    if WMINFO_maxsecret() == 0 {
        WMINFO_set_maxsecret(1)
    }
    if STAT_gamemode() != WI_GM_RETAIL {
        if WMINFO_epsd() > 2 {
            WMINFO_set_epsd(WMINFO_epsd() - 3)
        }
    }
}

#
# WI_Start
#
@flow_api
function WI_Start(wbstartstruct: ptr<void>) -> void {
    WI_initVariables(wbstartstruct)
    WI_loadData()
    if STAT_deathmatch() != 0 {
        WI_initDeathmatchStats()
    } elif STAT_netgame() != 0 {
        WI_initNetgameStats()
    } else {
        WI_initStats()
    }
}
