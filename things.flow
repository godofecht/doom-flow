const THINGS_SCREENWIDTH: i32 = 320
const THINGS_SIZEOF_VISSPRITE: i32 = 80
const THINGS_FRACUNIT: i32 = 65536
const THINGS_FRACBITS: i32 = 16
const THINGS_MINZ: i32 = 262144              # FRACUNIT*4
const THINGS_BASEYCENTER: i32 = 100
const THINGS_PU_STATIC: i32 = 1
const THINGS_PU_CACHE: i32 = 8
