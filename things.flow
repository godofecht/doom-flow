const THINGS_SIL_BOTTOM: i32 = 1
const THINGS_SIL_TOP: i32 = 2
const THINGS_SIL_BOTH: i32 = 3

const THINGS_WAD_LUMP_STRIDE: i32 = 40
const THINGS_SPRTEMP_FRAMES: i32 = 29

