const THINGS_INT_MAX: i32 = 2147483647
const THINGS_NUMPSPRITES: i32 = 2

# spriteframe_t / spritedef_t LP64 offsetof (verified vs r_defs.h)
const THINGS_SIZEOF_SPRITEFRAME: i32 = 28
const THINGS_SF_ROTATE: i32 = 0
const THINGS_SF_LUMP: i32 = 4
const THINGS_SF_FLIP: i32 = 20
const THINGS_SIZEOF_SPRITEDEF: i32 = 16
const THINGS_SD_NUMFRAMES: i32 = 0
const THINGS_SD_SPRITEFRAMES: i32 = 8

# p_mobj.h / p_pspr.h / doomdef.h
const THINGS_MF_SHADOW: i32 = 262144         # 0x40000
const THINGS_MF_TRANSLATION: i32 = 201326592 # 0xc000000
const THINGS_MF_TRANSSHIFT: i32 = 26
const THINGS_FF_FULLBRIGHT: i32 = 32768      # 0x8000
const THINGS_FF_FRAMEMASK: i32 = 32767       # 0x7fff
