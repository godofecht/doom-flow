function things_ensure_sprtemp() -> void {
    if (things_sprtemp as i64) == 0 {
        things_sprtemp = calloc(
            THINGS_SPRTEMP_FRAMES as i64,
            THINGS_SIZEOF_SPRITEFRAME as i64)
    }
}

function things_tolower(c: i32) -> i32 {
    if c >= 65 and c <= 90 {
        return c + 32
    }
    return c
}

function things_lump_name_char(lump: i32, idx: i32) -> i32 {
    let base: ptr<u8> = wadflow_lumpinfo()
    return base[lump * THINGS_WAD_LUMP_STRIDE + idx] as i32
}

function things_lump_name_ptr(lump: i32) -> ptr<u8> {
    return ((wadflow_lumpinfo() as i64) + (lump * THINGS_WAD_LUMP_STRIDE) as i64) as ptr<u8>
}

function things_lump_name_ncasecmp4(lump: i32, name: ptr<void>) -> i32 {
    let ln: ptr<u8> = things_lump_name_ptr(lump)
    let nm: ptr<u8> = name as ptr<u8>
    for i in 0 to 4 {
        let ca: i32 = things_tolower(ln[i] as i32)
        let cb: i32 = things_tolower(nm[i] as i32)
        if ca != cb {
            return 0
        }
    }
    return 1
}

function things_sf_temp(frame: i32) -> ptr<u8> {
    return ((things_sprtemp as i64)
        + (frame * THINGS_SIZEOF_SPRITEFRAME) as i64) as ptr<u8>
}

function things_sd_at(i: i32) -> ptr<u8> {
    return ((things_sprites as i64)
        + (i * THINGS_SIZEOF_SPRITEDEF) as i64) as ptr<u8>
}

function things_sf_installed(sprite: i32, frame: i32) -> ptr<u8> {
    let frames_ptr: ptr<ptr<void> > = ((things_sd_at(sprite) as i64)
        + THINGS_SD_SPRITEFRAMES as i64) as ptr<ptr<void> >
    let frames: ptr<u8> = frames_ptr[0] as ptr<u8>
    return ((frames as i64) + (frame * THINGS_SIZEOF_SPRITEFRAME) as i64) as ptr<u8>
}

function things_sf_rotate(sf: ptr<u8>) -> i32 {
    let p: ptr<i32> = sf as ptr<i32>
    return p[0]
}

function things_sf_set_rotate(sf: ptr<u8>, v: i32) -> void {
    let p: ptr<i32> = sf as ptr<i32>
    p[0] = v
}

function things_sf_lump(sf: ptr<u8>, rot: i32) -> i32 {
    let p: ptr<i16> = ((sf as i64) + THINGS_SF_LUMP as i64) as ptr<i16>
    return p[rot] as i32
}

function things_sf_set_lump(sf: ptr<u8>, rot: i32, v: i32) -> void {
    let p: ptr<i16> = ((sf as i64) + THINGS_SF_LUMP as i64) as ptr<i16>
    p[rot] = v as i16
}

function things_sf_flip(sf: ptr<u8>, rot: i32) -> i32 {
    let p: ptr<u8> = ((sf as i64) + THINGS_SF_FLIP as i64) as ptr<u8>
    return p[rot] as i32
}

function things_sf_set_flip(sf: ptr<u8>, rot: i32, v: i32) -> void {
    let p: ptr<u8> = ((sf as i64) + THINGS_SF_FLIP as i64) as ptr<u8>
    p[rot] = v as u8
}

function things_sd_numframes(i: i32) -> i32 {
    let sd: ptr<i32> = things_sd_at(i) as ptr<i32>
    return sd[0]
}

function things_sd_set_numframes(i: i32, n: i32) -> void {
    let sd: ptr<i32> = things_sd_at(i) as ptr<i32>
    sd[0] = n
}

function things_clip_at(clip: ptr<void>, x: i32) -> i16 {
    let p: ptr<i16> = clip as ptr<i16>
    return p[x]
}

function things_clip_set(clip: ptr<void>, x: i32, v: i32) -> void {
    let p: ptr<i16> = clip as ptr<i16>
    p[x] = v as i16
}

function things_translation_for_flags(flags: i32) -> ptr<void> {
    let tables: ptr<u8> = drawshim_translationtables_addr()[0]
    let shift: i32 = THINGS_MF_TRANSSHIFT - 8
    return ((tables as i64) - 256
        + (((flags & THINGS_MF_TRANSLATION) >> shift) as i64)) as ptr<void>
}

@flow_api
function thingshim_numsprites() -> i32 { return things_numsprites }

@flow_api
function thingshim_sprite_numframes(i: i32) -> i32 { return things_sd_numframes(i) }

@flow_api
function thingshim_sprite_frame_rotate(sprite: i32, frame: i32) -> i32 {
    return things_sf_rotate(things_sf_installed(sprite, frame))
}

@flow_api
function thingshim_sprite_frame_lump(sprite: i32, frame: i32, rot: i32) -> i32 {
    return things_sf_lump(things_sf_installed(sprite, frame), rot)
}

@flow_api
function thingshim_sprite_frame_flip(sprite: i32, frame: i32, rot: i32) -> i32 {
    return things_sf_flip(things_sf_installed(sprite, frame), rot)
}

# Matches C vissprite_t (LP64 sizeof 80): ptr padding after patch.
struct VisSprite {
    prev: ptr<VisSprite>,
    next: ptr<VisSprite>,
    x1: i32,
    x2: i32,
    gx: i32,
    gy: i32,
    gz: i32,
    gzt: i32,
    startfrac: i32,
    scale: i32,
    xiscale: i32,
    texturemid: i32,
    patch: i32,
    colormap: ptr<void>,
    mobjflags: i32
}

# ---- private module state ---------------------------------------------

let mut vissprites: ptr<VisSprite> = null
let mut vissprite_p: ptr<VisSprite> = null
let mut vissprites_end: ptr<VisSprite> = null
let mut spritelights: ptr<ptr<void> > = null

function things_scalelight_row(lightnum: i32) -> ptr<ptr<void> > {
    if lightnum < 0 {
        return RMAIN_scalelight_row(0)
    } elif lightnum >= THINGS_LIGHTLEVELS {
        return RMAIN_scalelight_row(THINGS_LIGHTLEVELS - 1)
    } else {
        return RMAIN_scalelight_row(lightnum)
    }
}

let mut overflowsprite: VisSprite = VisSprite {
    prev: null, next: null, x1: 0, x2: 0, gx: 0, gy: 0, gz: 0, gzt: 0,
    startfrac: 0, scale: 0, xiscale: 0, texturemid: 0, patch: 0,
    colormap: null, mobjflags: 0
}

