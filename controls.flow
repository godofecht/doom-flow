@flow_api
function M_BindStrifeControls() -> void {
    # Shared keys with different Strife defaults:
    set_var(C_KEY_MESSAGE_REFRESH, 47)   # '/'
    set_var(C_KEY_JUMP, 97)              # 'a'
    set_var(C_KEY_LOOKUP, KEY_PGUP)
    set_var(C_KEY_LOOKDOWN, KEY_PGDN)
    set_var(C_KEY_INVLEFT, KEY_INS)
    set_var(C_KEY_INVRIGHT, KEY_DEL)

    bind("key_jump", C_KEY_JUMP)
    bind("key_lookUp", C_KEY_LOOKUP)
    bind("key_lookDown", C_KEY_LOOKDOWN)
    bind("key_invLeft", C_KEY_INVLEFT)
    bind("key_invRight", C_KEY_INVRIGHT)

    bind("key_useHealth", C_KEY_USEHEALTH)
    bind("key_invquery", C_KEY_INVQUERY)
    bind("key_mission", C_KEY_MISSION)
    bind("key_invPop", C_KEY_INVPOP)
    bind("key_invKey", C_KEY_INVKEY)
    bind("key_invHome", C_KEY_INVHOME)
    bind("key_invEnd", C_KEY_INVEND)
    bind("key_invUse", C_KEY_INVUSE)
    bind("key_invDrop", C_KEY_INVDROP)

    bind("mouseb_jump", C_MOUSEBJUMP)
    bind("joyb_jump", C_JOYBJUMP)
}

