@flow_api
function KEY_map_maxzoom() -> i32 { return key_of(C_KEY_MAP_MAXZOOM) }
@flow_api
function KEY_map_follow() -> i32 { return key_of(C_KEY_MAP_FOLLOW) }
@flow_api
function KEY_map_grid() -> i32 { return key_of(C_KEY_MAP_GRID) }
@flow_api
function KEY_map_mark() -> i32 { return key_of(C_KEY_MAP_MARK) }
@flow_api
function KEY_map_clearmark() -> i32 { return key_of(C_KEY_MAP_CLEARMARK) }
@flow_api
function KEY_demo_quit() -> i32 { return key_of(C_KEY_DEMO_QUIT) }
@flow_api
function KEY_spy() -> i32 { return key_of(C_KEY_SPY) }
@flow_api
function KEY_multi_msg() -> i32 { return key_of(C_KEY_MULTI_MSG) }
@flow_api
function KEY_weapon(i: i32) -> i32 { return key_of(C_KEY_WEAPON1 + i) }
@flow_api
function KEY_multi_msgplayer(i: i32) -> i32 { return key_multi_msgplayer[i] }

@flow_api
function M_BindBaseControls() -> void {
    bind("key_right", C_KEY_RIGHT)
    bind("key_left", C_KEY_LEFT)
    bind("key_up", C_KEY_UP)
    bind("key_down", C_KEY_DOWN)
    bind("key_strafeleft", C_KEY_STRAFELEFT)
    bind("key_straferight", C_KEY_STRAFERIGHT)
    bind("key_fire", C_KEY_FIRE)
    bind("key_use", C_KEY_USE)
    bind("key_strafe", C_KEY_STRAFE)
    bind("key_speed", C_KEY_SPEED)

    bind("mouseb_fire", C_MOUSEBFIRE)
    bind("mouseb_strafe", C_MOUSEBSTRAFE)
    bind("mouseb_forward", C_MOUSEBFORWARD)

    bind("joyb_fire", C_JOYBFIRE)
    bind("joyb_strafe", C_JOYBSTRAFE)
    bind("joyb_use", C_JOYBUSE)
    bind("joyb_speed", C_JOYBSPEED)

    bind("joyb_menu_activate", C_JOYBMENU)

    bind("joyb_strafeleft", C_JOYBSTRAFELEFT)
    bind("joyb_straferight", C_JOYBSTRAFERIGHT)
    bind("mouseb_strafeleft", C_MOUSEBSTRAFELEFT)
    bind("mouseb_straferight", C_MOUSEBSTRAFERIGHT)
    bind("mouseb_use", C_MOUSEBUSE)
    bind("mouseb_backward", C_MOUSEBBACKWARD)
    bind("dclick_use", C_DCLICK_USE)
    bind("key_pause", C_KEY_PAUSE)
    bind("key_message_refresh", C_KEY_MESSAGE_REFRESH)
}

