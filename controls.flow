    if id == C_KEY_MENU_RIGHT { return &key_menu_right }
    if id == C_KEY_MENU_BACK { return &key_menu_back }
    if id == C_KEY_MENU_FORWARD { return &key_menu_forward }
    if id == C_KEY_MENU_CONFIRM { return &key_menu_confirm }
    if id == C_KEY_MENU_ABORT { return &key_menu_abort }
    if id == C_KEY_MENU_HELP { return &key_menu_help }
    if id == C_KEY_MENU_SAVE { return &key_menu_save }
    if id == C_KEY_MENU_LOAD { return &key_menu_load }
    if id == C_KEY_MENU_VOLUME { return &key_menu_volume }
    if id == C_KEY_MENU_DETAIL { return &key_menu_detail }
    if id == C_KEY_MENU_QSAVE { return &key_menu_qsave }
    if id == C_KEY_MENU_ENDGAME { return &key_menu_endgame }
    if id == C_KEY_MENU_MESSAGES { return &key_menu_messages }
    if id == C_KEY_MENU_QLOAD { return &key_menu_qload }
    if id == C_KEY_MENU_QUIT { return &key_menu_quit }
    if id == C_KEY_MENU_GAMMA { return &key_menu_gamma }
    if id == C_KEY_MENU_INCSCREEN { return &key_menu_incscreen }
    if id == C_KEY_MENU_DECSCREEN { return &key_menu_decscreen }
    if id == C_KEY_MENU_SCREENSHOT { return &key_menu_screenshot }
    if id == C_KEY_DEMO_QUIT { return &key_demo_quit }
    if id == C_KEY_SPY { return &key_spy }
    if id == C_KEY_MULTI_MSG { return &key_multi_msg }
    return &key_right
}

@flow_api
function ctrlshim_bind_msgplayer(i: i32) -> void {
    M_BindVariable(ctrl_bindname("key_multi_msgplayer", i + 1),
                 &key_multi_msgplayer[i] as ptr<void>)
}

@flow_api
function ctrlshim_key_multi_msgplayer(i: i32) -> i32 {
    return key_multi_msgplayer[i]
}

@flow_api
function ctrlshim_set_key_multi_msgplayer(i: i32, v: i32) -> void {
    key_multi_msgplayer[i] = v
}

function bind(name: string, id: i32) -> void {
    M_BindVariable(name, ctrlshim_var(id) as ptr<void>)
}

function set_var(id: i32, v: i32) -> void {
    ctrlshim_var(id)[0] = v
}

# Shared key-binding readers. Callers in automap/game/hud use KEY_*.
function key_of(id: i32) -> i32 {
    return ctrlshim_var(id)[0]
}

