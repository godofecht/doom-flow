    if id == C_KEY_MAP_MAXZOOM { return &key_map_maxzoom }
    if id == C_KEY_MAP_FOLLOW { return &key_map_follow }
    if id == C_KEY_MAP_GRID { return &key_map_grid }
    if id == C_KEY_MAP_MARK { return &key_map_mark }
    if id == C_KEY_MAP_CLEARMARK { return &key_map_clearmark }
    if id == C_KEY_MENU_ACTIVATE { return &key_menu_activate }
    if id == C_KEY_MENU_UP { return &key_menu_up }
    if id == C_KEY_MENU_DOWN { return &key_menu_down }
