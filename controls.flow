# Input bindings, ported from m_controls.c to Flow.
#
# key_*/mouseb*/joyb* globals live here as let mut; unported C and
# M_BindVariable reach them through ctrlshim_var(id). IDs below must
# stay in lockstep with ctrlshim_var().

extern { function M_BindVariable(name: string, location: ptr<void>) -> void }
extern { function calloc(n: i64, size: i64) -> ptr<void> }
extern { function strlen(s: string) -> i64 }

