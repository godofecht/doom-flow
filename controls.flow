    if id == C_KEY_MAP_NORTH { return &key_map_north }
    if id == C_KEY_MAP_SOUTH { return &key_map_south }
    if id == C_KEY_MAP_EAST { return &key_map_east }
    if id == C_KEY_MAP_WEST { return &key_map_west }
