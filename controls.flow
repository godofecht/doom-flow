let mut joybmenu: i32 = 0 - 1

let mut dclick_use: i32 = 1

let mut ctrl_bindname_buf: ptr<u8> = null

function ctrl_bindname(base: string, digit: i32) -> string {
    if (ctrl_bindname_buf as i64) == 0 {
        ctrl_bindname_buf = calloc(32, 1) as ptr<u8>
    }
    let bp: ptr<u8> = base as ptr<u8>
    let n: i32 = strlen(base) as i32
    let mut i: i32 = 0
    while i < n {
        ctrl_bindname_buf[i] = bp[i]
        i = i + 1
    }
    if digit >= 10 {
        ctrl_bindname_buf[i] = (48 + digit / 10) as u8
        i = i + 1
    }
    ctrl_bindname_buf[i] = (48 + digit % 10) as u8
    i = i + 1
    ctrl_bindname_buf[i] = 0
    return ctrl_bindname_buf as string
}

@flow_api
function ctrlshim_var(id: i32) -> ptr<i32> {
    if id == C_KEY_RIGHT { return &key_right }
    if id == C_KEY_LEFT { return &key_left }
    if id == C_KEY_UP { return &key_up }
    if id == C_KEY_DOWN { return &key_down }
    if id == C_KEY_STRAFELEFT { return &key_strafeleft }
    if id == C_KEY_STRAFERIGHT { return &key_straferight }
    if id == C_KEY_FIRE { return &key_fire }
    if id == C_KEY_USE { return &key_use }
    if id == C_KEY_STRAFE { return &key_strafe }
    if id == C_KEY_SPEED { return &key_speed }
    if id == C_MOUSEBFIRE { return &mousebfire }
    if id == C_MOUSEBSTRAFE { return &mousebstrafe }
    if id == C_MOUSEBFORWARD { return &mousebforward }
    if id == C_JOYBFIRE { return &joybfire }
    if id == C_JOYBSTRAFE { return &joybstrafe }
    if id == C_JOYBUSE { return &joybuse }
    if id == C_JOYBSPEED { return &joybspeed }
    if id == C_JOYBMENU { return &joybmenu }
    if id == C_JOYBSTRAFELEFT { return &joybstrafeleft }
    if id == C_JOYBSTRAFERIGHT { return &joybstraferight }
    if id == C_MOUSEBSTRAFELEFT { return &mousebstrafeleft }
    if id == C_MOUSEBSTRAFERIGHT { return &mousebstraferight }
    if id == C_MOUSEBUSE { return &mousebuse }
    if id == C_MOUSEBBACKWARD { return &mousebbackward }
    if id == C_DCLICK_USE { return &dclick_use }
    if id == C_KEY_PAUSE { return &key_pause }
    if id == C_KEY_MESSAGE_REFRESH { return &key_message_refresh }
    if id == C_KEY_FLYUP { return &key_flyup }
    if id == C_KEY_FLYDOWN { return &key_flydown }
    if id == C_KEY_FLYCENTER { return &key_flycenter }
    if id == C_KEY_LOOKUP { return &key_lookup }
    if id == C_KEY_LOOKDOWN { return &key_lookdown }
    if id == C_KEY_LOOKCENTER { return &key_lookcenter }
    if id == C_KEY_INVLEFT { return &key_invleft }
    if id == C_KEY_INVRIGHT { return &key_invright }
    if id == C_KEY_USEARTIFACT { return &key_useartifact }
    if id == C_KEY_JUMP { return &key_jump }
    if id == C_MOUSEBJUMP { return &mousebjump }
    if id == C_JOYBJUMP { return &joybjump }
    if id == C_KEY_ARTI_ALL { return &key_arti_all }
    if id == C_KEY_ARTI_HEALTH { return &key_arti_health }
    if id == C_KEY_ARTI_POISONBAG { return &key_arti_poisonbag }
    if id == C_KEY_ARTI_BLASTRADIUS { return &key_arti_blastradius }
    if id == C_KEY_ARTI_TELEPORT { return &key_arti_teleport }
    if id == C_KEY_ARTI_TELEPORTOTHER { return &key_arti_teleportother }
    if id == C_KEY_ARTI_EGG { return &key_arti_egg }
    if id == C_KEY_ARTI_INVULNERABILITY { return &key_arti_invulnerability }
    if id == C_KEY_USEHEALTH { return &key_usehealth }
    if id == C_KEY_INVQUERY { return &key_invquery }
    if id == C_KEY_MISSION { return &key_mission }
    if id == C_KEY_INVPOP { return &key_invpop }
    if id == C_KEY_INVKEY { return &key_invkey }
    if id == C_KEY_INVHOME { return &key_invhome }
    if id == C_KEY_INVEND { return &key_invend }
    if id == C_KEY_INVUSE { return &key_invuse }
    if id == C_KEY_INVDROP { return &key_invdrop }
    if id == C_KEY_WEAPON1 { return &key_weapon1 }
    if id == C_KEY_WEAPON2 { return &key_weapon2 }
    if id == C_KEY_WEAPON3 { return &key_weapon3 }
