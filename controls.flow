@flow_api
function M_BindChatControls(num_players: u32) -> void {
    bind("key_multi_msg", C_KEY_MULTI_MSG)
    let mut i: u32 = 0
    while i < num_players {
        ctrlshim_bind_msgplayer(i as i32)
        i = i + (1 as u32)
    }
}

@flow_api
function M_ApplyPlatformDefaults() -> void {
    # no-op. Add your platform-specific patches here.
    return
}
