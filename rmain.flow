#
# R_ScaleFromGlobalAngle
# Texture mapping scale for the current line at the given angle.
# rw_distance must be calculated first.
#

@flow_api
function R_ScaleFromGlobalAngle(visangle: u32) -> i32 {
    let anglea: u32 = RMAIN_ANG90 + (visangle - rmainshim_viewangle_addr()[0])
    let angleb: u32 = RMAIN_ANG90 + (visangle - SEGS_rw_normalangle())

    let sinea: i32 = TABLES_finesine((anglea >> RMAIN_ANGLETOFINESHIFT) as i32)
    let sineb: i32 = TABLES_finesine((angleb >> RMAIN_ANGLETOFINESHIFT) as i32)
    let num: i32 = FixedMul(rmainshim_projection_addr()[0], sineb) << rmainshim_detailshift_addr()[0]
    let den: i32 = FixedMul(SEGS_rw_distance(), sinea)

    let mut scale: i32 = 0
    if den > (num >> 16) {
        scale = FixedDiv(num, den)
        if scale > 64 * RMAIN_FRACUNIT {
            scale = 64 * RMAIN_FRACUNIT
        } elif scale < 256 {
            scale = 256
        }
    } else {
        scale = 64 * RMAIN_FRACUNIT
    }
    return scale
}

#
# R_InitTextureMapping
#

function rmain_init_texture_mapping() -> void {
    let vat: ptr<i32> = rmainshim_viewangletox()
    let xtv: ptr<u32> = rmainshim_xtoviewangle()
    let centerxfrac: i32 = rmainshim_centerxfrac_addr()[0]
    let centerx: i32 = rmainshim_centerx_addr()[0]
    let viewwidth: i32 = DRAW_viewwidth()
    let half: i32 = RMAIN_FINEANGLES / 2

    # focallength so FIELDOFVIEW angles covers SCREENWIDTH
    let focallength: i32 = FixedDiv(
        centerxfrac,
        TABLES_finetangent(RMAIN_FINEANGLES / 4 + RMAIN_FIELDOFVIEW / 2))

    for i in 0 to half {
        let mut t: i32 = 0
        let ft: i32 = TABLES_finetangent(i)
        if ft > RMAIN_FRACUNIT * 2 {
            t = 0 - 1
        } elif ft < (0 - RMAIN_FRACUNIT * 2) {
            t = viewwidth + 1
        } else {
            t = FixedMul(ft, focallength)
            t = (centerxfrac - t + RMAIN_FRACUNIT - 1) >> RMAIN_FRACBITS
            if t < (0 - 1) {
                t = 0 - 1
            } elif t > viewwidth + 1 {
                t = viewwidth + 1
            }
        }
        vat[i] = t
    }

    # Scan viewangletox[] to generate xtoviewangle[]
    for x in 0 to viewwidth + 1 {
        let mut i: i32 = 0
        while vat[i] > x {
            i = i + 1
        }
        xtv[x] = ((i as u32) << (RMAIN_ANGLETOFINESHIFT as u32)) - RMAIN_ANG90
    }

    # Take out the fencepost cases from viewangletox.
    for i2 in 0 to half {
        if vat[i2] == (0 - 1) {
            vat[i2] = 0
        } elif vat[i2] == viewwidth + 1 {
            vat[i2] = viewwidth
        }
    }

    rmainshim_clipangle_addr()[0] = xtv[0]
}

#
# R_InitLightTables
# Only inits the zlight table; scalelight changes with view size.
#

function rmain_init_light_tables() -> void {
    let cmaps: ptr<void> = RDATA_colormaps()
    for i in 0 to RMAIN_LIGHTLEVELS {
        let startmap: i32 = ((RMAIN_LIGHTLEVELS - 1 - i) * 2) * RMAIN_NUMCOLORMAPS / RMAIN_LIGHTLEVELS
        for j in 0 to RMAIN_MAXLIGHTZ {
            let mut scale: i32 = FixedDiv(
                (RMAIN_SCREENWIDTH / 2) * RMAIN_FRACUNIT,
                (j + 1) << RMAIN_LIGHTZSHIFT)
            scale = scale >> RMAIN_LIGHTSCALESHIFT
            let mut level: i32 = startmap - scale / RMAIN_DISTMAP
            if level < 0 {
                level = 0
            }
            if level >= RMAIN_NUMCOLORMAPS {
                level = RMAIN_NUMCOLORMAPS - 1
            }
            let p: ptr<void> = ((cmaps as i64) + (level as i64) * 256) as ptr<void>
            rmainshim_set_zlight(i, j, p)
        }
    }
}

#
# R_SetViewSize
# Deferred; change takes effect next refresh.
#

@flow_api
function R_SetViewSize(blocks: i32, detail: i32) -> void {
    STAT_set_setsizeneeded(1)
    rmainshim_setblocks_addr()[0] = blocks
    rmainshim_setdetail_addr()[0] = detail
}

#
# R_ExecuteSetViewSize
#

@flow_api
function R_ExecuteSetViewSize() -> void {
    STAT_set_setsizeneeded(0)

    let setblocks: i32 = rmainshim_setblocks_addr()[0]
    let setdetail: i32 = rmainshim_setdetail_addr()[0]

    if setblocks == 11 {
        DRAW_set_scaledviewwidth(RMAIN_SCREENWIDTH)
        DRAW_set_viewheight(RMAIN_SCREENHEIGHT)
    } else {
        DRAW_set_scaledviewwidth(setblocks * 32)
        DRAW_set_viewheight((setblocks * 168 / 10) & (0 - 8))
    }

    rmainshim_detailshift_addr()[0] = setdetail
    let scaledviewwidth: i32 = DRAW_scaledviewwidth()
    DRAW_set_viewwidth(scaledviewwidth >> setdetail)

    let viewwidth: i32 = DRAW_viewwidth()
    let viewheight: i32 = DRAW_viewheight()
    let detailshift: i32 = rmainshim_detailshift_addr()[0]

    rmainshim_centery_addr()[0] = viewheight / 2
    rmainshim_centerx_addr()[0] = viewwidth / 2
    rmainshim_centerxfrac_addr()[0] = rmainshim_centerx_addr()[0] << RMAIN_FRACBITS
    rmainshim_centeryfrac_addr()[0] = rmainshim_centery_addr()[0] << RMAIN_FRACBITS
    rmainshim_projection_addr()[0] = rmainshim_centerxfrac_addr()[0]

    if detailshift == 0 {
        rmainshim_set_drawfuncs_hi()
    } else {
        rmainshim_set_drawfuncs_lo()
    }

    R_InitBuffer(scaledviewwidth, viewheight)
    rmain_init_texture_mapping()

    # psprite scales
    THINGS_set_pspritescale(RMAIN_FRACUNIT * viewwidth / RMAIN_SCREENWIDTH)
    THINGS_set_pspriteiscale(RMAIN_FRACUNIT * RMAIN_SCREENWIDTH / viewwidth)

    # thing clipping
    for i in 0 to viewwidth {
        THINGS_set_screenheightarray(i, viewheight)
    }

    # planes
    for i2 in 0 to viewheight {
        let mut dy: i32 = ((i2 - viewheight / 2) << RMAIN_FRACBITS) + RMAIN_FRACUNIT / 2
        dy = abs(dy)
        PLANES_set_yslope(i2, FixedDiv(
            ((viewwidth << detailshift) / 2) * RMAIN_FRACUNIT, dy))
    }

    let xtv: ptr<u32> = rmainshim_xtoviewangle()
    for i3 in 0 to viewwidth {
        let cosadj: i32 = abs(TABLES_finecosine((xtv[i3] >> RMAIN_ANGLETOFINESHIFT) as i32))
        PLANES_set_distscale(i3, FixedDiv(RMAIN_FRACUNIT, cosadj))
    }

    # light levels for each level / scale combination
    let cmaps: ptr<void> = RDATA_colormaps()
    for i4 in 0 to RMAIN_LIGHTLEVELS {
        let startmap: i32 = ((RMAIN_LIGHTLEVELS - 1 - i4) * 2) * RMAIN_NUMCOLORMAPS / RMAIN_LIGHTLEVELS
        for j in 0 to RMAIN_MAXLIGHTSCALE {
            let mut level: i32 = startmap - j * RMAIN_SCREENWIDTH / (viewwidth << detailshift) / RMAIN_DISTMAP
            if level < 0 {
                level = 0
            }
            if level >= RMAIN_NUMCOLORMAPS {
                level = RMAIN_NUMCOLORMAPS - 1
            }
            let p: ptr<void> = ((cmaps as i64) + (level as i64) * 256) as ptr<void>
            rmainshim_set_scalelight(i4, j, p)
        }
    }
}

#
# R_Init
#

@flow_api
function R_Init() -> void {
    R_InitData()
    printf(".")
    rmain_init_point_to_angle()
    printf(".")
    rmain_init_tables()
    printf(".")

    R_SetViewSize(STAT_screenblocks(), STAT_detailLevel())
    R_InitPlanes()
    printf(".")
    rmain_init_light_tables()
    printf(".")
    R_InitSkyMap()
    R_InitTranslationTables()
    printf(".")

    rmainshim_framecount_addr()[0] = 0
}

#
# R_PointInSubsector
#

@flow_api
function R_PointInSubsector(x: i32, y: i32) -> ptr<void> {
    if GEOM_numnodes() == 0 {
        return GEOM_subsector(0)
    }

    let mut nodenum: i32 = GEOM_numnodes() - 1
    while (nodenum & RMAIN_NF_SUBSECTOR) == 0 {
        let node: ptr<void> = GEOM_node(nodenum)
        let side: i32 = R_PointOnSide(x, y, node)
        nodenum = GEOM_node_child(node, side)
    }

    return GEOM_subsector(nodenum & (0 - 1 - RMAIN_NF_SUBSECTOR))
}

#
# R_SetupFrame
#

function rmain_setup_frame(player: ptr<void>) -> void {
    rmainshim_viewplayer_addr()[0] = player
    let mo: ptr<void> = PLAYER_mo(player)
    rmainshim_viewx_addr()[0] = MOBJ_x(mo)
    rmainshim_viewy_addr()[0] = MOBJ_y(mo)
    rmainshim_viewangle_addr()[0] = MOBJ_angle(mo)
        + (rmainshim_viewangleoffset_addr()[0] as u32)
    RMAIN_set_extralight(PLAYER_extralight(player))
    rmainshim_viewz_addr()[0] = PLAYER_viewz(player)

    let va: u32 = rmainshim_viewangle_addr()[0]
    rmainshim_viewsin_addr()[0] = TABLES_finesine((va >> RMAIN_ANGLETOFINESHIFT) as i32)
    rmainshim_viewcos_addr()[0] = TABLES_finecosine((va >> RMAIN_ANGLETOFINESHIFT) as i32)

    rmainshim_sscount_addr()[0] = 0

    let fcmap: i32 = PLAYER_fixedcolormap(player)
    if fcmap != 0 {
        # Exact C: colormaps + fixedcolormap*256*sizeof(lighttable_t)
        # lighttable_t is byte, so *1.
        let base: ptr<void> = RDATA_colormaps()
        RMAIN_set_fixedcolormap(
            ((base as i64) + (fcmap as i64) * 256) as ptr<void>)
        SEGS_set_walllights_fixed()
        let fc: ptr<void> = RMAIN_fixedcolormap()
        for i in 0 to RMAIN_MAXLIGHTSCALE {
            rmainshim_set_scalelightfixed(i, fc)
        }
    } else {
        RMAIN_set_fixedcolormap(null)
    }

    rmainshim_framecount_addr()[0] = rmainshim_framecount_addr()[0] + 1
    RMAIN_set_validcount(RMAIN_validcount() + 1)
}

#
# R_RenderPlayerView
#

@flow_api
function R_RenderPlayerView(player: ptr<void>) -> void {
    rmain_setup_frame(player)

    R_ClearClipSegs()
    R_ClearDrawSegs()
    R_ClearPlanes()
    R_ClearSprites()

    NetUpdate()

    R_RenderBSPNode(GEOM_numnodes() - 1)

    NetUpdate()

    R_DrawPlanes()

    NetUpdate()

    R_DrawMasked()

    NetUpdate()
}
