#
# R_AddPointToBox
# Expand a given bbox so that it encloses a given point.
#

@flow_api
function R_AddPointToBox(x: i32, y: i32, box: ptr<i32>) -> void {
    if x < box[RMAIN_BOXLEFT] {
        box[RMAIN_BOXLEFT] = x
    }
    if x > box[RMAIN_BOXRIGHT] {
        box[RMAIN_BOXRIGHT] = x
    }
    if y < box[RMAIN_BOXBOTTOM] {
        box[RMAIN_BOXBOTTOM] = y
    }
    if y > box[RMAIN_BOXTOP] {
        box[RMAIN_BOXTOP] = y
    }
}

#
# R_PointOnSide
# Traverse BSP (sub) tree, check point against partition plane.
# Returns side 0 (front) or 1 (back).
#

@flow_api
function R_PointOnSide(x: i32, y: i32, node: ptr<void>) -> i32 {
    let ndx: i32 = GEOM_node_dx(node)
    let ndy: i32 = GEOM_node_dy(node)
    let nx: i32 = GEOM_node_x(node)
    let ny: i32 = GEOM_node_y(node)

    if ndx == 0 {
        if x <= nx {
            if ndy > 0 {
                return 1
            }
            return 0
        }
        if ndy < 0 {
            return 1
        }
        return 0
    }
    if ndy == 0 {
        if y <= ny {
            if ndx < 0 {
                return 1
            }
            return 0
        }
        if ndx > 0 {
            return 1
        }
        return 0
    }

    let dx: i32 = x - nx
    let dy: i32 = y - ny

    # Try to quickly decide by looking at sign bits.
    if ((ndy ^ ndx ^ dx ^ dy) & RMAIN_SIGNBIT) != 0 {
        if ((ndy ^ dx) & RMAIN_SIGNBIT) != 0 {
            return 1
        }
        return 0
    }

    let left: i32 = FixedMul(ndy >> RMAIN_FRACBITS, dx)
    let right: i32 = FixedMul(dy, ndx >> RMAIN_FRACBITS)

    if right < left {
        return 0
    }
    return 1
}

@flow_api
function R_PointOnSegSide(x: i32, y: i32, line: ptr<void>) -> i32 {
    let v1: ptr<void> = GEOM_seg_v1(line)
    let v2: ptr<void> = GEOM_seg_v2(line)
    let lx: i32 = GEOM_vertex_x(v1)
    let ly: i32 = GEOM_vertex_y(v1)
    let ldx: i32 = GEOM_vertex_x(v2) - lx
    let ldy: i32 = GEOM_vertex_y(v2) - ly

    if ldx == 0 {
        if x <= lx {
            if ldy > 0 {
                return 1
            }
            return 0
        }
        if ldy < 0 {
            return 1
        }
        return 0
    }
    if ldy == 0 {
        if y <= ly {
            if ldx < 0 {
                return 1
            }
            return 0
        }
        if ldx > 0 {
            return 1
        }
        return 0
    }

    let dx: i32 = x - lx
    let dy: i32 = y - ly

    if ((ldy ^ ldx ^ dx ^ dy) & RMAIN_SIGNBIT) != 0 {
        if ((ldy ^ dx) & RMAIN_SIGNBIT) != 0 {
            return 1
        }
        return 0
    }

    let left: i32 = FixedMul(ldy >> RMAIN_FRACBITS, dx)
    let right: i32 = FixedMul(dy, ldx >> RMAIN_FRACBITS)

    if right < left {
        return 0
    }
    return 1
}

#
# R_PointToAngle
# Global angle from cartesian coords relative to viewx/viewy.
#

@flow_api
function R_PointToAngle(x_in: i32, y_in: i32) -> u32 {
    let mut x: i32 = x_in - rmainshim_viewx_addr()[0]
    let mut y: i32 = y_in - rmainshim_viewy_addr()[0]

    if x == 0 and y == 0 {
        return 0 as u32
    }

    if x >= 0 {
        if y >= 0 {
            if x > y {
                # octant 0
                return TABLES_tantoangle(SlopeDiv(y as u32, x as u32))
            } else {
                # octant 1
                return RMAIN_ANG90 - (1 as u32) - TABLES_tantoangle(SlopeDiv(x as u32, y as u32))
            }
        } else {
            y = 0 - y
            if x > y {
                # octant 8
                return (0 as u32) - TABLES_tantoangle(SlopeDiv(y as u32, x as u32))
            } else {
                # octant 7
                return RMAIN_ANG270 + TABLES_tantoangle(SlopeDiv(x as u32, y as u32))
            }
        }
    } else {
        x = 0 - x
        if y >= 0 {
            if x > y {
                # octant 3
                return RMAIN_ANG180 - (1 as u32) - TABLES_tantoangle(SlopeDiv(y as u32, x as u32))
            } else {
                # octant 2
                return RMAIN_ANG90 + TABLES_tantoangle(SlopeDiv(x as u32, y as u32))
            }
        } else {
            y = 0 - y
            if x > y {
                # octant 4
                return RMAIN_ANG180 + TABLES_tantoangle(SlopeDiv(y as u32, x as u32))
            } else {
                # octant 5
                return RMAIN_ANG270 - (1 as u32) - TABLES_tantoangle(SlopeDiv(x as u32, y as u32))
            }
        }
    }
}

@flow_api
function R_PointToAngle2(x1: i32, y1: i32, x2: i32, y2: i32) -> u32 {
    # Exact C: temporarily clobbers viewx/viewy.
    rmainshim_viewx_addr()[0] = x1
    rmainshim_viewy_addr()[0] = y1
    return R_PointToAngle(x2, y2)
}

@flow_api
function R_PointToDist(x: i32, y: i32) -> i32 {
    let mut dx: i32 = abs(x - rmainshim_viewx_addr()[0])
    let mut dy: i32 = abs(y - rmainshim_viewy_addr()[0])

    if dy > dx {
        let temp: i32 = dx
        dx = dy
        dy = temp
    }

    let mut frac: i32 = 0
    if dx != 0 {
        frac = FixedDiv(dy, dx)
    }

    let angle: i32 = ((TABLES_tantoangle(frac >> RMAIN_DBITS) + RMAIN_ANG90)
        >> (RMAIN_ANGLETOFINESHIFT as u32)) as i32

    return FixedDiv(dx, TABLES_finesine(angle as i32))
}

