let mut transcolfunc: ptr<void> = null
let mut spanfunc: ptr<void> = null

@flow_api
function rmainshim_set_drawfuncs_hi() -> void {
    colfunc = R_DrawColumn as ptr<void>
    basecolfunc = R_DrawColumn as ptr<void>
    fuzzcolfunc = R_DrawFuzzColumn as ptr<void>
    transcolfunc = R_DrawTranslatedColumn as ptr<void>
    spanfunc = R_DrawSpan as ptr<void>
}

@flow_api
function rmainshim_set_drawfuncs_lo() -> void {
    colfunc = R_DrawColumnLow as ptr<void>
    basecolfunc = R_DrawColumnLow as ptr<void>
    fuzzcolfunc = R_DrawFuzzColumnLow as ptr<void>
    transcolfunc = R_DrawTranslatedColumnLow as ptr<void>
    spanfunc = R_DrawSpanLow as ptr<void>
}

@flow_api
function rmainshim_call_spanfunc() -> void { sysshim_call_void(spanfunc) }

@flow_api
function rmainshim_call_colfunc() -> void { sysshim_call_void(colfunc) }

