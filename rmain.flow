# Rendering main loop / setup / geometry utils, ported from r_main.c.
#
# Shared POV / lighting / clip-table globals are Flow-owned let mut state
# with @flow_api RMAIN_* / rmainshim_* accessors. node_t / seg_t /
# player_t / mobj_t stay C-owned; field access goes through rmainshim_*.
# Draw-func pointers stored as ptr<void> here; map geom via GEOM_*.

