let mut setdetail: i32 = 0

let mut viewangletox: ptr<i32> = null
let mut xtoviewangle: ptr<u32> = null
let mut scalelight: ptr<ptr<void> > = null
let mut scalelightfixed: ptr<ptr<void> > = null
let mut zlight: ptr<ptr<void> > = null

function rmain_ensure_tables() -> void {
    if (viewangletox as i64) == 0 {
        viewangletox = calloc(RMAIN_VIEWANGLETOX_LEN as i64, 4) as ptr<i32>
        xtoviewangle = calloc(RMAIN_XTOVIEWANGLE_LEN as i64, 4) as ptr<u32>
        scalelight = calloc(RMAIN_SCALELIGHT_LEN as i64, 8) as ptr<ptr<void> >
        scalelightfixed = calloc(RMAIN_MAXLIGHTSCALE as i64, 8) as ptr<ptr<void> >
        zlight = calloc(RMAIN_ZLIGHT_LEN as i64, 8) as ptr<ptr<void> >
    }
}

function rmain_zlight_idx(light: i32, index: i32) -> i32 {
    return light * RMAIN_MAXLIGHTZ + index
}

function rmain_scalelight_idx(light: i32, index: i32) -> i32 {
    return light * RMAIN_MAXLIGHTSCALE + index
}

