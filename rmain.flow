# ---- constants (r_main.h / tables.h / m_fixed.h / m_bbox.h / doomdata.h)

const RMAIN_FIELDOFVIEW: i32 = 2048
const RMAIN_FINEANGLES: i32 = 8192
const RMAIN_ANGLETOFINESHIFT: i32 = 19
const RMAIN_FRACBITS: i32 = 16
const RMAIN_FRACUNIT: i32 = 65536
const RMAIN_SCREENWIDTH: i32 = 320
const RMAIN_SCREENHEIGHT: i32 = 200
const RMAIN_LIGHTLEVELS: i32 = 16
const RMAIN_MAXLIGHTSCALE: i32 = 48
const RMAIN_LIGHTSCALESHIFT: i32 = 12
const RMAIN_MAXLIGHTZ: i32 = 128
const RMAIN_LIGHTZSHIFT: i32 = 20
const RMAIN_NUMCOLORMAPS: i32 = 32
const RMAIN_DISTMAP: i32 = 2
const RMAIN_DBITS: i32 = 5                  # FRACBITS - SLOPEBITS
const RMAIN_NF_SUBSECTOR: i32 = 32768       # 0x8000
const RMAIN_SIGNBIT: i32 = 0 - 2147483648   # 0x80000000
const RMAIN_BOXLEFT: i32 = 2
const RMAIN_BOXRIGHT: i32 = 3
const RMAIN_BOXBOTTOM: i32 = 1
const RMAIN_BOXTOP: i32 = 0
const RMAIN_ANG90: u32 = 1073741824 as u32  # 0x40000000
const RMAIN_ANG180: u32 = 2147483648 as u32 # 0x80000000
const RMAIN_ANG270: u32 = 3221225472 as u32 # 0xc0000000

const RMAIN_VIEWANGLETOX_LEN: i32 = 4096    # FINEANGLES/2
const RMAIN_XTOVIEWANGLE_LEN: i32 = 321       # SCREENWIDTH+1
const RMAIN_SCALELIGHT_LEN: i32 = 768         # LIGHTLEVELS*MAXLIGHTSCALE
const RMAIN_ZLIGHT_LEN: i32 = 2048            # LIGHTLEVELS*MAXLIGHTZ

