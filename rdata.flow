# ---- constants (RDATA_ prefix; sources in comments) -------------------

# z_zone.h
const RDATA_PU_STATIC: i32 = 1
const RDATA_PU_CACHE: i32 = 8

# m_fixed.h
const RDATA_FRACBITS: i32 = 16

# texture_t / texpatch_t sizes (LP64)
const RDATA_SIZEOF_TEXTURE: i32 = 40
const RDATA_SIZEOF_TEXPATCH: i32 = 8
const RDATA_TEX_NAME: i32 = 0
const RDATA_TEX_WIDTH: i32 = 8
const RDATA_TEX_HEIGHT: i32 = 10
const RDATA_TEX_INDEX: i32 = 12
const RDATA_TEX_NEXT: i32 = 16
const RDATA_TEX_PATCHCOUNT: i32 = 24
const RDATA_TEX_PATCHES: i32 = 28
const RDATA_TP_ORIGINX: i32 = 0
const RDATA_TP_ORIGINY: i32 = 2
const RDATA_TP_PATCH: i32 = 4

# maptexture_t / mappatch_t (PACKEDATTR)
const RDATA_MT_WIDTH: i32 = 12
const RDATA_MT_HEIGHT: i32 = 14
const RDATA_MT_PATCHCOUNT: i32 = 20
const RDATA_MT_PATCHES: i32 = 22
const RDATA_SIZEOF_MAPPATCH: i32 = 10
const RDATA_MP_ORIGINX: i32 = 0
const RDATA_MP_ORIGINY: i32 = 2
const RDATA_MP_PATCH: i32 = 4

# patch_t
const RDATA_PATCH_WIDTH: i32 = 0
const RDATA_PATCH_LEFTOFFSET: i32 = 4
const RDATA_PATCH_TOPOFFSET: i32 = 6
const RDATA_PATCH_COLUMNOFS: i32 = 8

# ---- module-private texture tables ------------------------------------

let mut rdata_numtextures: i32 = 0
let mut rdata_textures: ptr<i64> = null
let mut rdata_textures_hashtable: ptr<i64> = null
let mut rdata_texturewidthmask: ptr<i32> = null
let mut rdata_texturecompositesize: ptr<i32> = null
let mut rdata_texturecolumnlump: ptr<i64> = null
let mut rdata_texturecolumnofs: ptr<i64> = null
let mut rdata_texturecomposite: ptr<i64> = null

let mut rdata_flatmemory: i32 = 0
let mut rdata_texturememory: i32 = 0
let mut rdata_spritememory: i32 = 0

# Scratch 9-byte name buffers (null-terminated copies of 8-char names).
let mut rdata_namebuf: array<u8, 9> = [0, 0, 0, 0, 0, 0, 0, 0, 0]

# Shared r_data / r_state globals.
let mut rdata_firstflat: i32 = 0
let mut rdata_lastflat: i32 = 0
let mut rdata_numflats: i32 = 0
let mut rdata_firstpatch: i32 = 0
let mut rdata_lastpatch: i32 = 0
let mut rdata_numpatches: i32 = 0
let mut rdata_firstspritelump: i32 = 0
let mut rdata_lastspritelump: i32 = 0
let mut rdata_numspritelumps: i32 = 0
let mut rdata_colormaps: ptr<void> = null
let mut rdata_textureheight: ptr<void> = null
let mut rdata_spritewidth: ptr<void> = null
let mut rdata_spriteoffset: ptr<void> = null
let mut rdata_spritetopoffset: ptr<void> = null
let mut rdata_flattranslation: ptr<void> = null
let mut rdata_texturetranslation: ptr<void> = null

