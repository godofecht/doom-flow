# ---- SHORT() / LONG() on little-endian --------------------------------

function rdata_short_at(p: ptr<u8>, off: i32) -> i32 {
    # Mask to 0..255: MLIR sign-extends `u8 as i32`, which breaks LE loads
    # whenever a byte has the high bit set (e.g. TEXTURE1 offset 504).
    let mut v: i32 = ((p[off] as i32) & 255) | (((p[off + 1] as i32) & 255) << 8)
    if v >= 32768 {
        v = v - 65536
    }
    return v
}

function rdata_long_at(p: ptr<u8>, off: i32) -> i32 {
    return ((p[off] as i32) & 255)
        | (((p[off + 1] as i32) & 255) << 8)
        | (((p[off + 2] as i32) & 255) << 16)
        | (((p[off + 3] as i32) & 255) << 24)
}

function rdata_write_i16(p: ptr<u8>, off: i32, v: i32) -> void {
    p[off] = (v & 255) as u8
    p[off + 1] = ((v >> 8) & 255) as u8
}

function rdata_write_i32(p: ptr<u8>, off: i32, v: i32) -> void {
    p[off] = (v & 255) as u8
    p[off + 1] = ((v >> 8) & 255) as u8
    p[off + 2] = ((v >> 16) & 255) as u8
    p[off + 3] = ((v >> 24) & 255) as u8
}

# ---- texture_t field accessors ----------------------------------------

function rdata_tex(i: i32) -> ptr<u8> {
    return rdata_textures[i] as ptr<u8>
}

function rdata_tex_name_ptr(tex: ptr<u8>) -> ptr<u8> {
    return tex
}

function rdata_tex_width(tex: ptr<u8>) -> i32 {
    return rdata_short_at(tex, RDATA_TEX_WIDTH)
}

function rdata_tex_height(tex: ptr<u8>) -> i32 {
    return rdata_short_at(tex, RDATA_TEX_HEIGHT)
}

function rdata_tex_patchcount(tex: ptr<u8>) -> i32 {
    return rdata_short_at(tex, RDATA_TEX_PATCHCOUNT)
}

function rdata_tex_set_index(tex: ptr<u8>, v: i32) -> void {
    rdata_write_i32(tex, RDATA_TEX_INDEX, v)
}

function rdata_tex_index(tex: ptr<u8>) -> i32 {
    return rdata_long_at(tex, RDATA_TEX_INDEX)
}

function rdata_tex_hash_key(name: ptr<u8>) -> i32 {
    # Keep the modulo in u32. MLIR lowers `u32 as i32` then signed `%`,
    # which can yield a negative bucket and OOB on the hash table.
    let h: u32 = W_LumpNameHash(name)
    let n: u32 = rdata_numtextures as u32
    let k: u32 = h % n
    return k as i32
}

function rdata_tex_next(tex: ptr<u8>) -> ptr<u8> {
    let words: ptr<i64> = tex as ptr<i64>
    return words[2] as ptr<u8>
}

function rdata_tex_set_next(tex: ptr<u8>, n: ptr<u8>) -> void {
    let words: ptr<i64> = tex as ptr<i64>
    words[2] = n as i64
}

function rdata_tex_patch_ptr(tex: ptr<u8>, j: i32) -> ptr<u8> {
    return ((tex as i64) + (RDATA_TEX_PATCHES + j * RDATA_SIZEOF_TEXPATCH) as i64) as ptr<u8>
}

function rdata_tp_originx(tp: ptr<u8>) -> i32 {
    return rdata_short_at(tp, RDATA_TP_ORIGINX)
}

function rdata_tp_originy(tp: ptr<u8>) -> i32 {
    return rdata_short_at(tp, RDATA_TP_ORIGINY)
}

function rdata_tp_patch(tp: ptr<u8>) -> i32 {
    return rdata_long_at(tp, RDATA_TP_PATCH)
}

function rdata_copy_name8(dst: ptr<u8>, src: ptr<u8>) -> void {
    for i in 0 to 8 {
        dst[i] = src[i]
    }
    dst[8] = 0 as u8
}

function rdata_tolower(c: i32) -> i32 {
    if c >= 65 and c <= 90 {
        return c + 32
    }
    return c
}

# strncasecmp(a, b, 8) == 0
function rdata_name_ieq8(a: ptr<u8>, b: ptr<u8>) -> bool {
    for i in 0 to 8 {
        let ca: i32 = rdata_tolower(a[i] as i32)
        let cb: i32 = rdata_tolower(b[i] as i32)
        if ca != cb {
            return false
        }
        if ca == 0 {
            return true
        }
    }
    return true
}

function rdata_collump(texnum: i32) -> ptr<i16> {
    return rdata_texturecolumnlump[texnum] as ptr<i16>
}

function rdata_colofs(texnum: i32) -> ptr<u16> {
    return rdata_texturecolumnofs[texnum] as ptr<u16>
}

# ---- R_DrawColumnInCache ----------------------------------------------

function rdata_draw_column_in_cache(
    patch: ptr<u8>, cache: ptr<u8>, originy: i32, cacheheight: i32
) -> void {
    let mut col: ptr<u8> = patch
    while col[0] as i32 != 255 {
        let source: ptr<u8> = ((col as i64) + 3) as ptr<u8>
        let mut count: i32 = col[1] as i32
        let mut position: i32 = originy + (col[0] as i32)

        if position < 0 {
            count = count + position
            position = 0
        }

        if position + count > cacheheight {
            count = cacheheight - position
        }

        if count > 0 {
            # Avoid libc memcpy under MLIR→wasm+ASYNCIFY.
            let dst: ptr<u8> = ((cache as i64) + (position as i64)) as ptr<u8>
            for ci in 0 to count {
                dst[ci] = source[ci]
            }
        }

        col = ((col as i64) + ((col[1] as i32) + 4) as i64) as ptr<u8>
    }
}

# ---- R_GenerateComposite ----------------------------------------------

function rdata_generate_composite(texnum: i32) -> void {
    let texture: ptr<u8> = rdata_tex(texnum)
    let user: ptr<void> = ((rdata_texturecomposite as i64) + (texnum as i64) * 8) as ptr<void>
    let block: ptr<u8> = Z_Malloc(
        rdata_texturecompositesize[texnum], RDATA_PU_STATIC, user) as ptr<u8>

    let collump: ptr<i16> = rdata_collump(texnum)
    let colofs: ptr<u16> = rdata_colofs(texnum)
    let tw: i32 = rdata_tex_width(texture)
    let th: i32 = rdata_tex_height(texture)
    let pc: i32 = rdata_tex_patchcount(texture)

    for i in 0 to pc {
        let tp: ptr<u8> = rdata_tex_patch_ptr(texture, i)
        let realpatch: ptr<u8> = W_CacheLumpNum(rdata_tp_patch(tp), RDATA_PU_CACHE) as ptr<u8>
        let x1: i32 = rdata_tp_originx(tp)
        let mut x2: i32 = x1 + rdata_short_at(realpatch, RDATA_PATCH_WIDTH)
        let mut x: i32 = 0

        if x1 < 0 {
            x = 0
        } else {
            x = x1
        }

        if x2 > tw {
            x2 = tw
        }

        while x < x2 {
            if (collump[x] as i32) >= 0 {
                x = x + 1
            } else {
                let col_off: i32 = rdata_long_at(
                    realpatch, RDATA_PATCH_COLUMNOFS + (x - x1) * 4)
                let patchcol: ptr<u8> = ((realpatch as i64) + (col_off as i64)) as ptr<u8>
                rdata_draw_column_in_cache(
                    patchcol,
                    ((block as i64) + (colofs[x] as i64)) as ptr<u8>,
                    rdata_tp_originy(tp),
                    th)
                x = x + 1
            }
        }
    }

    Z_ChangeTag2(block as ptr<void>, RDATA_PU_CACHE, "rdata.flow", 0)
}

# ---- R_GenerateLookup -------------------------------------------------

function rdata_generate_lookup(texnum: i32) -> void {
    let texture: ptr<u8> = rdata_tex(texnum)
    rdata_texturecomposite[texnum] = 0
    rdata_texturecompositesize[texnum] = 0

    let collump: ptr<i16> = rdata_collump(texnum)
    let colofs: ptr<u16> = rdata_colofs(texnum)
    let tw: i32 = rdata_tex_width(texture)
    let th: i32 = rdata_tex_height(texture)
    let pc: i32 = rdata_tex_patchcount(texture)

    let patchcount: ptr<u8> = Z_Malloc(tw, RDATA_PU_STATIC, null) as ptr<u8>
    # Avoid libc memset — same MLIR→wasm+ASYNCIFY trap class as memcpy.
    for zi in 0 to tw {
        patchcount[zi] = 0 as u8
    }

    for i in 0 to pc {
        let tp: ptr<u8> = rdata_tex_patch_ptr(texture, i)
        let plump: i32 = rdata_tp_patch(tp)
        if plump < 0 {
            I_Error("R_GenerateLookup: bad patch lump")
        }
        let realpatch: ptr<u8> = W_CacheLumpNum(plump, RDATA_PU_CACHE) as ptr<u8>
        let x1: i32 = rdata_tp_originx(tp)
        let mut x2: i32 = x1 + rdata_short_at(realpatch, RDATA_PATCH_WIDTH)
        let mut x: i32 = 0

        if x1 < 0 {
            x = 0
        } else {
            x = x1
        }

        if x2 > tw {
            x2 = tw
        }

        while x < x2 {
            patchcount[x] = (patchcount[x] as i32 + 1) as u8
            collump[x] = rdata_tp_patch(tp) as i16
            colofs[x] = (rdata_long_at(
                realpatch, RDATA_PATCH_COLUMNOFS + (x - x1) * 4) + 3) as u16
            x = x + 1
        }
    }

    for x in 0 to tw {
        if patchcount[x] as i32 == 0 {
            # Vanilla returns without Z_Free(patchcount) — keep that leak.
            rdata_copy_name8(rdata_namebuf as ptr<u8>, rdata_tex_name_ptr(texture))
            printf("R_GenerateLookup: column without a patch (%s)\n",
                rdata_namebuf as string)
            return
        }

        if patchcount[x] as i32 > 1 {
            collump[x] = (0 - 1) as i16
            colofs[x] = rdata_texturecompositesize[texnum] as u16

            if rdata_texturecompositesize[texnum] > 65536 - th {
                I_Error("R_GenerateLookup: texture is >64k")
            }

            rdata_texturecompositesize[texnum] =
                rdata_texturecompositesize[texnum] + th
        }
    }

    Z_Free(patchcount as ptr<void>)
}

# ---- R_GetColumn ------------------------------------------------------

@flow_api
function R_GetColumn(tex: i32, col_in: i32) -> ptr<u8> {
    let mut col: i32 = col_in & rdata_texturewidthmask[tex]
    let lump: i32 = rdata_collump(tex)[col] as i32
    let ofs: i32 = rdata_colofs(tex)[col] as i32

    if lump > 0 {
        return ((W_CacheLumpNum(lump, RDATA_PU_CACHE) as i64) + (ofs as i64)) as ptr<u8>
    }

    if rdata_texturecomposite[tex] == 0 {
        rdata_generate_composite(tex)
    }

    return ((rdata_texturecomposite[tex] as i64) + (ofs as i64)) as ptr<u8>
}

# ---- GenerateTextureHashTable -----------------------------------------

function rdata_generate_texture_hash_table() -> void {
    printf("R_InitTextures: hash begin n=%d\n", rdata_numtextures)
    rdata_textures_hashtable = Z_Malloc(
        rdata_numtextures * 8, RDATA_PU_STATIC, null) as ptr<i64>
    # Avoid libc memset under MLIR→wasm+ASYNCIFY.
    let hb: ptr<u8> = rdata_textures_hashtable as ptr<u8>
    let hbytes: i32 = rdata_numtextures * 8
    for zi in 0 to hbytes {
        hb[zi] = 0 as u8
    }
    printf("R_InitTextures: hash table zeroed\n")

    for i in 0 to rdata_numtextures {
        if i < 3 or (i & 31) == 0 {
            printf("R_InitTextures: hash i=%d\n", i)
        }
        let tex: ptr<u8> = rdata_tex(i)
        if (tex as i64) == 0 {
            printf("R_InitTextures: null tex at %d\n", i)
            I_Error("R_InitTextures: null texture")
        }
        rdata_tex_set_index(tex, i)
        rdata_tex_set_next(tex, null)

        # Append at end of chain so earlier array entries win (vanilla).
        let key: i32 = rdata_tex_hash_key(rdata_tex_name_ptr(tex))
        if i < 3 {
            printf("R_InitTextures: hash key=%d\n", key)
        }
        if key < 0 or key >= rdata_numtextures {
            printf("R_InitTextures: bad hash key=%d at i=%d\n", key, i)
            I_Error("R_InitTextures: bad hash key")
        }
        let mut rover: ptr<i64> = ((rdata_textures_hashtable as i64) + (key as i64) * 8) as ptr<i64>

        let mut hops: i32 = 0
        while rover[0] != 0 {
            hops = hops + 1
            if hops > rdata_numtextures + 2 {
                printf("R_InitTextures: hash cycle at i=%d key=%d\n", i, key)
                I_Error("R_InitTextures: hash cycle")
            }
            rover = ((rover[0] + (RDATA_TEX_NEXT as i64)) as ptr<i64>)
        }

        rover[0] = tex as i64
    }
    printf("R_InitTextures: hash filled\n")
}

# ---- R_InitTextures ---------------------------------------------------

function rdata_init_textures() -> void {
    # FEATURE_DEHACKED off: DEH_String is identity.
    let names: ptr<u8> = W_CacheLumpName("PNAMES", RDATA_PU_STATIC) as ptr<u8>
    let nummappatches: i32 = rdata_long_at(names, 0)
    let name_p: ptr<u8> = ((names as i64) + 4) as ptr<u8>
    let patchlookup: ptr<i32> = Z_Malloc(
        nummappatches * 4, RDATA_PU_STATIC, null) as ptr<i32>

    rdata_namebuf[8] = 0 as u8
    for i in 0 to nummappatches {
        # Avoid libc memcpy here — it has trapped under MLIR→wasm+ASYNCIFY.
        let src: ptr<u8> = ((name_p as i64) + (i * 8) as i64) as ptr<u8>
        for b in 0 to 8 {
            rdata_namebuf[b] = src[b]
        }
        rdata_namebuf[8] = 0 as u8
        patchlookup[i] = W_CheckNumForName(rdata_namebuf as string)
    }
    W_ReleaseLumpName("PNAMES")

    printf("R_InitTextures: TEXTURE1\n")
    let mut maptex: ptr<u8> = W_CacheLumpName("TEXTURE1", RDATA_PU_STATIC) as ptr<u8>
    printf("R_InitTextures: maptex=%d b0=%d b1=%d b2=%d b3=%d\n",
           maptex as i32, maptex[0] as i32, maptex[1] as i32, maptex[2] as i32, maptex[3] as i32)
    let numtextures1: i32 = rdata_long_at(maptex, 0)
    printf("R_InitTextures: numtextures1=%d\n", numtextures1)
    let mut maxoff: i32 = W_LumpLength(W_GetNumForName("TEXTURE1") as u32)
    printf("R_InitTextures: maxoff=%d\n", maxoff)
    let mut directory: ptr<u8> = ((maptex as i64) + 4) as ptr<u8>

    let mut maptex2: ptr<u8> = null
    let mut numtextures2: i32 = 0
    let mut maxoff2: i32 = 0

    printf("R_InitTextures: check TEXTURE2\n")
    if W_CheckNumForName("TEXTURE2") != 0 - 1 {
        maptex2 = W_CacheLumpName("TEXTURE2", RDATA_PU_STATIC) as ptr<u8>
        numtextures2 = rdata_long_at(maptex2, 0)
        maxoff2 = W_LumpLength(W_GetNumForName("TEXTURE2") as u32)
    }
    printf("R_InitTextures: numtextures2=%d total=%d\n", numtextures2, numtextures1 + numtextures2)

    rdata_numtextures = numtextures1 + numtextures2

    printf("R_InitTextures: alloc tables\n")
    rdata_textures = Z_Malloc(rdata_numtextures * 8, RDATA_PU_STATIC, null) as ptr<i64>
    rdata_texturecolumnlump = Z_Malloc(rdata_numtextures * 8, RDATA_PU_STATIC, null) as ptr<i64>
    rdata_texturecolumnofs = Z_Malloc(rdata_numtextures * 8, RDATA_PU_STATIC, null) as ptr<i64>
    rdata_texturecomposite = Z_Malloc(rdata_numtextures * 8, RDATA_PU_STATIC, null) as ptr<i64>
    rdata_texturecompositesize = Z_Malloc(rdata_numtextures * 4, RDATA_PU_STATIC, null) as ptr<i32>
    rdata_texturewidthmask = Z_Malloc(rdata_numtextures * 4, RDATA_PU_STATIC, null) as ptr<i32>
    rdata_textureheight = Z_Malloc(rdata_numtextures * 4, RDATA_PU_STATIC, null)
    printf("R_InitTextures: tables ok\n")

    let temp1: i32 = W_GetNumForName("S_START")
    let temp2: i32 = W_GetNumForName("S_END") - 1
    let temp3: i32 = ((temp2 - temp1 + 63) / 64) + ((rdata_numtextures + 63) / 64)
    printf("R_InitTextures: S_START=%d S_END=%d\n", temp1, temp2 + 1)

    # Classic vanilla "filling box" uses backspace. I_ConsoleStdout is always
    # 0 in this port (system.flow), so the branch never runs; omit \b which
    # Flow string literals reject.
    if I_ConsoleStdout() != 0 {
        printf("[")
        for i in 0 to temp3 + 9 {
            printf(" ")
        }
        printf("]")
    }

    let height_tbl: ptr<i32> = rdata_textureheight as ptr<i32>
    printf("R_InitTextures: enter tex loop n=%d\n", rdata_numtextures)

    for i in 0 to rdata_numtextures {
        if i < 3 or (i & 63) == 0 {
            printf("R_InitTextures: tex i=%d\n", i)
        }

        if i == numtextures1 {
            maptex = maptex2
            maxoff = maxoff2
            directory = ((maptex as i64) + 4) as ptr<u8>
        }

        let offset: i32 = rdata_long_at(directory, 0)
        directory = ((directory as i64) + 4) as ptr<u8>
        if i < 3 {
            printf("R_InitTextures: off=%d\n", offset)
        }

        if offset > maxoff {
            I_Error("R_InitTextures: bad texture directory")
        }

        let mtexture: ptr<u8> = ((maptex as i64) + (offset as i64)) as ptr<u8>
        let mpatchcount: i32 = rdata_short_at(mtexture, RDATA_MT_PATCHCOUNT)
        if i < 3 {
            printf("R_InitTextures: patches=%d\n", mpatchcount)
        }
        if mpatchcount < 1 or mpatchcount > 4096 {
            printf("R_InitTextures: bad mpatchcount=%d at i=%d\n", mpatchcount, i)
            I_Error("R_InitTextures: bad mpatchcount")
        }
        let tex: ptr<u8> = Z_Malloc(
            RDATA_SIZEOF_TEXTURE + RDATA_SIZEOF_TEXPATCH * (mpatchcount - 1),
            RDATA_PU_STATIC, null) as ptr<u8>
        rdata_textures[i] = tex as i64

        rdata_write_i16(tex, RDATA_TEX_WIDTH, rdata_short_at(mtexture, RDATA_MT_WIDTH))
        rdata_write_i16(tex, RDATA_TEX_HEIGHT, rdata_short_at(mtexture, RDATA_MT_HEIGHT))
        rdata_write_i16(tex, RDATA_TEX_PATCHCOUNT, mpatchcount)
        # Avoid libc memcpy — trap under MLIR→wasm for some sizes.
        for b in 0 to 8 {
            tex[b] = mtexture[b]
        }

        let mut mpatch: ptr<u8> = ((mtexture as i64) + (RDATA_MT_PATCHES as i64)) as ptr<u8>
        for j in 0 to mpatchcount {
            let tp: ptr<u8> = rdata_tex_patch_ptr(tex, j)
            rdata_write_i16(tp, RDATA_TP_ORIGINX, rdata_short_at(mpatch, RDATA_MP_ORIGINX))
            rdata_write_i16(tp, RDATA_TP_ORIGINY, rdata_short_at(mpatch, RDATA_MP_ORIGINY))
            let pidx: i32 = rdata_short_at(mpatch, RDATA_MP_PATCH)
            let lump: i32 = patchlookup[pidx]
            rdata_write_i32(tp, RDATA_TP_PATCH, lump)
            if lump == 0 - 1 {
                rdata_copy_name8(rdata_namebuf as ptr<u8>, rdata_tex_name_ptr(tex))
                I_Error("R_InitTextures: Missing patch in texture")
            }
            mpatch = ((mpatch as i64) + (RDATA_SIZEOF_MAPPATCH as i64)) as ptr<u8>
        }

        let tw: i32 = rdata_tex_width(tex)
        rdata_texturecolumnlump[i] = Z_Malloc(tw * 2, RDATA_PU_STATIC, null) as i64
        rdata_texturecolumnofs[i] = Z_Malloc(tw * 2, RDATA_PU_STATIC, null) as i64

        let mut jmask: i32 = 1
        while jmask * 2 <= tw {
            jmask = jmask << 1
        }
        rdata_texturewidthmask[i] = jmask - 1
        height_tbl[i] = ((rdata_tex_height(tex) as u32) << RDATA_FRACBITS) as i32
        if i < 3 {
            printf("R_InitTextures: tex i=%d done tw=%d\n", i, tw)
        }
    }
    printf("R_InitTextures: tex defs done\n")

    Z_Free(patchlookup as ptr<void>)
    printf("R_InitTextures: freed patchlookup\n")
    W_ReleaseLumpName("TEXTURE1")
    printf("R_InitTextures: released TEXTURE1\n")
    if (maptex2 as i64) != 0 {
        W_ReleaseLumpName("TEXTURE2")
    }

    printf("R_InitTextures: generate lookups n=%d\n", rdata_numtextures)
    for i in 0 to rdata_numtextures {
        if i < 3 or (i & 31) == 0 {
            printf("R_InitTextures: lookup i=%d\n", i)
        }
        rdata_generate_lookup(i)
    }
    printf("R_InitTextures: lookups done\n")

    let ttrans: ptr<i32> = Z_Malloc(
        (rdata_numtextures + 1) * 4, RDATA_PU_STATIC, null) as ptr<i32>
    rdata_texturetranslation = ttrans as ptr<void>
    for i in 0 to rdata_numtextures {
        ttrans[i] = i
    }
    printf("R_InitTextures: translation ok\n")

    rdata_generate_texture_hash_table()
    printf("R_InitTextures: hash ok\n")
}

# ---- R_InitFlats ------------------------------------------------------

function rdata_init_flats() -> void {
    rdata_firstflat = W_GetNumForName("F_START") + 1
    rdata_lastflat = W_GetNumForName("F_END") - 1
    rdata_numflats = RDATA_lastflat() - RDATA_firstflat() + 1

    let n: i32 = RDATA_numflats()
    let ft: ptr<i32> = Z_Malloc((n + 1) * 4, RDATA_PU_STATIC, null) as ptr<i32>
    rdata_flattranslation = ft as ptr<void>
    for i in 0 to n {
        ft[i] = i
    }
}

# ---- R_InitSpriteLumps ------------------------------------------------

function rdata_init_sprite_lumps() -> void {
    rdata_firstspritelump = W_GetNumForName("S_START") + 1
    rdata_lastspritelump = W_GetNumForName("S_END") - 1
    let n: i32 = RDATA_lastspritelump() - RDATA_firstspritelump() + 1
    rdata_numspritelumps = n

    rdata_spritewidth = Z_Malloc(n * 4, RDATA_PU_STATIC, null)
    rdata_spriteoffset = Z_Malloc(n * 4, RDATA_PU_STATIC, null)
    rdata_spritetopoffset = Z_Malloc(n * 4, RDATA_PU_STATIC, null)

    let sw: ptr<i32> = rdata_spritewidth as ptr<i32>
    let so: ptr<i32> = rdata_spriteoffset as ptr<i32>
    let st: ptr<i32> = rdata_spritetopoffset as ptr<i32>
    let first: i32 = RDATA_firstspritelump()

    for i in 0 to n {
        if (i & 63) == 0 {
            printf(".")
        }
        let patch: ptr<u8> = W_CacheLumpNum(first + i, RDATA_PU_CACHE) as ptr<u8>
        sw[i] = ((rdata_short_at(patch, RDATA_PATCH_WIDTH) as u32) << RDATA_FRACBITS) as i32
        so[i] = ((rdata_short_at(patch, RDATA_PATCH_LEFTOFFSET) as u32) << RDATA_FRACBITS) as i32
        st[i] = ((rdata_short_at(patch, RDATA_PATCH_TOPOFFSET) as u32) << RDATA_FRACBITS) as i32
    }
}

# ---- R_InitColormaps --------------------------------------------------

function rdata_init_colormaps() -> void {
    let lump: i32 = W_GetNumForName("COLORMAP")
    rdata_colormaps = W_CacheLumpNum(lump, RDATA_PU_STATIC)
}

# ---- R_InitData -------------------------------------------------------

@flow_api
function R_InitData() -> void {
    rdata_init_textures()
    printf(".")
    rdata_init_flats()
    printf(".")
    rdata_init_sprite_lumps()
    printf(".")
    rdata_init_colormaps()
}

# ---- R_FlatNumForName -------------------------------------------------

@flow_api
function R_FlatNumForName(name: string) -> i32 {
    let i: i32 = W_CheckNumForName(name)
    if i == 0 - 1 {
        rdata_namebuf[8] = 0 as u8
        memcpy(rdata_namebuf as ptr<void>, name as ptr<void>, 8)
        I_Error("R_FlatNumForName: flat not found")
    }
    return i - RDATA_firstflat()
}

# ---- R_CheckTextureNumForName -----------------------------------------

@flow_api
function R_CheckTextureNumForName(name: string) -> i32 {
    let np: ptr<u8> = name as ptr<u8>
    if np[0] as i32 == 45 {
        # '-' NoTexture marker
        return 0
    }

    let key: i32 = rdata_tex_hash_key(np)
    let mut texture: ptr<u8> = rdata_textures_hashtable[key] as ptr<u8>

    while (texture as i64) != 0 {
        if rdata_name_ieq8(rdata_tex_name_ptr(texture), np) {
            return rdata_tex_index(texture)
        }
        texture = rdata_tex_next(texture)
    }

    return 0 - 1
}

# ---- R_TextureNumForName ----------------------------------------------

@flow_api
function R_TextureNumForName(name: string) -> i32 {
    let i: i32 = R_CheckTextureNumForName(name)
    if i == 0 - 1 {
        I_Error("R_TextureNumForName: texture not found")
    }
    return i
}

# ---- R_PrecacheLevel --------------------------------------------------

@flow_api
function R_PrecacheLevel() -> void {
    if STAT_demoplayback() != 0 {
        return
    }

    let numflats: i32 = RDATA_numflats()
    let flatpresent: ptr<u8> = Z_Malloc(numflats, RDATA_PU_STATIC, null) as ptr<u8>
    memset(flatpresent as ptr<void>, 0, numflats as i64)

    let nsec: i32 = GEOM_numsectors()
    for i in 0 to nsec {
        flatpresent[GEOM_sector_floorpic(GEOM_sector(i))] = 1 as u8
        flatpresent[GEOM_sector_ceilingpic(GEOM_sector(i))] = 1 as u8
    }

    rdata_flatmemory = 0
    let firstflat: i32 = RDATA_firstflat()
    for i in 0 to numflats {
        if flatpresent[i] as i32 != 0 {
            let lump: i32 = firstflat + i
            rdata_flatmemory = rdata_flatmemory + W_LumpLength(lump as u32)
            W_CacheLumpNum(lump, RDATA_PU_CACHE)
        }
    }
    Z_Free(flatpresent as ptr<void>)

    let texturepresent: ptr<u8> = Z_Malloc(rdata_numtextures, RDATA_PU_STATIC, null) as ptr<u8>
    memset(texturepresent as ptr<void>, 0, rdata_numtextures as i64)

    let nsides: i32 = GEOM_numsides()
    for i in 0 to nsides {
        texturepresent[GEOM_side_i_toptexture(i)] = 1 as u8
        texturepresent[GEOM_side_i_midtexture(i)] = 1 as u8
        texturepresent[GEOM_side_i_bottomtexture(i)] = 1 as u8
    }
    texturepresent[SKY_skytexture()] = 1 as u8

    rdata_texturememory = 0
    for i in 0 to rdata_numtextures {
        if texturepresent[i] as i32 != 0 {
            let texture: ptr<u8> = rdata_tex(i)
            let pc: i32 = rdata_tex_patchcount(texture)
            for j in 0 to pc {
                let lump: i32 = rdata_tp_patch(rdata_tex_patch_ptr(texture, j))
                rdata_texturememory = rdata_texturememory + W_LumpLength(lump as u32)
                W_CacheLumpNum(lump, RDATA_PU_CACHE)
            }
        }
    }
    Z_Free(texturepresent as ptr<void>)

    let numsprites: i32 = thingshim_numsprites()
    let spritepresent: ptr<u8> = Z_Malloc(numsprites, RDATA_PU_STATIC, null) as ptr<u8>
    memset(spritepresent as ptr<void>, 0, numsprites as i64)

    let cap: ptr<void> = THINKER_cap()
    let mut th: ptr<void> = THINKER_next(cap)
    while (th as i64) != (cap as i64) {
        if THINKER_is_mobj(th) != 0 {
            spritepresent[MOBJ_sprite(th)] = 1 as u8
        }
        th = THINKER_next(th)
    }

    rdata_spritememory = 0
    let firstspr: i32 = RDATA_firstspritelump()
    for i in 0 to numsprites {
        if spritepresent[i] as i32 != 0 {
            let nframes: i32 = thingshim_sprite_numframes(i)
            for j in 0 to nframes {
                for k in 0 to 8 {
                    let lump: i32 = firstspr + thingshim_sprite_frame_lump(i, j, k)
                    rdata_spritememory = rdata_spritememory + W_LumpLength(lump as u32)
                    W_CacheLumpNum(lump, RDATA_PU_CACHE)
                }
            }
        }
    }
    Z_Free(spritepresent as ptr<void>)
}
