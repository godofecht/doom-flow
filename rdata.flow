# Texture / flat / sprite-lump / colormap data, ported from r_data.c.
#
# Shared globals (firstflat/lastflat/numflats, first/last/numspritelumps,
# colormaps, textureheight, spritewidth/offset/topoffset, flattranslation,
# texturetranslation, …) are Flow-owned below. Module-private texture_t
# tables stay here.
#
# texture_t LP64 layout (verified offsetof):
#   name[8] 0, width 8, height 10, index 12, next 16,
#   patchcount 24, patches[] 28.
#   sizeof(texture_t with 1 patch) = 40
# texpatch_t: originx 0, originy 2, patch 4; sizeof 8.
# maptexture_t / mappatch_t are PACKEDATTR from the WAD.

extern { function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void> }
extern { function memset(dst: ptr<void>, c: i32, n: i64) -> ptr<void> }
extern { function printf(fmt: string) -> i32 }
extern { function printf(fmt: string, s: string) -> i32 }
extern { function printf(fmt: string, a: i32) -> i32 }
extern { function printf(fmt: string, a: i32, b: i32) -> i32 }
extern { function printf(fmt: string, a: i32, b: i32, c: i32) -> i32 }
extern { function printf(fmt: string, a: i32, b: i32, c: i32, d: i32) -> i32 }
extern { function printf(fmt: string, a: i32, b: i32, c: i32, d: i32, e: i32) -> i32 }

extern { function Z_Malloc(size: i32, tag: i32, user: ptr<void>) -> ptr<void> }
extern { function Z_Free(p: ptr<void>) -> void }
extern { function Z_ChangeTag2(p: ptr<void>, tag: i32, file: string, line: i32) -> void }

extern { function W_CacheLumpName(name: string, tag: i32) -> ptr<void> }
extern { function W_CacheLumpNum(lumpnum: i32, tag: i32) -> ptr<void> }
extern { function W_ReleaseLumpName(name: string) -> void }
extern { function W_CheckNumForName(name: string) -> i32 }
extern { function W_GetNumForName(name: string) -> i32 }
extern { function W_LumpLength(lump: u32) -> i32 }
extern { function W_LumpNameHash(s: ptr<u8>) -> u32 }

extern { function M_StringCopy(dest: ptr<u8>, src: ptr<u8>, dest_size: i64) -> i32 }
extern { function I_Error(msg: string) -> void }
extern { function I_ConsoleStdout() -> i32 }

# ---- engine struct accessors (things_shim / setup) --------------------

extern { function GEOM_sector(secnum: i32) -> ptr<void> }
extern { function GEOM_sector_floorpic(s: ptr<void>) -> i32 }
extern { function GEOM_sector_ceilingpic(s: ptr<void>) -> i32 }
