# Constants from p_spec.h / sounds.h / doomdata.h / d_mode.h / p_spec enums.
const SWITCH_MAXSWITCHES: i32 = 50
const SWITCH_MAXBUTTONS: i32 = 16
const SWITCH_BUTTONTIME: i32 = 35
const SWITCH_SIZEOF_BUTTON: i32 = 32
const SWITCH_ML_SECRET: i32 = 32

# GameMode_t
const SWITCH_REGISTERED: i32 = 1
const SWITCH_COMMERCIAL: i32 = 2
const SWITCH_RETAIL: i32 = 3

# bwhere_e
const SWITCH_TOP: i32 = 0
const SWITCH_MIDDLE: i32 = 1
const SWITCH_BOTTOM: i32 = 2

# sfxenum_t
const SWITCH_SFX_SWTCHN: i32 = 23
const SWITCH_SFX_SWTCHX: i32 = 24

# Re-export enum values used by P_UseSpecialLine callers into this module
# (floor_e / vldoor_e / stair_e / plattype_e / ceiling_e from p_spec.h).
const SWITCH_BUILD8: i32 = 0
const SWITCH_TURBO16: i32 = 1
const SWITCH_RAISEFLOORTONEAREST: i32 = 4
const SWITCH_LOWERFLOORTOLOWEST: i32 = 1
const SWITCH_TURBOLOWER: i32 = 2
