extern { function GEOM_side_i_midtexture(i: i32) -> i32 }
extern { function GEOM_side_i_set_bottomtexture(i: i32, v: i32) -> void }
extern { function GEOM_side_i_set_midtexture(i: i32, v: i32) -> void }
extern { function GEOM_side_i_set_toptexture(i: i32, v: i32) -> void }
extern { function GEOM_side_i_toptexture(i: i32) -> i32 }

