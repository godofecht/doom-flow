const SWITCH_RAISEFLOORTURBO: i32 = 10
const SWITCH_RAISEFLOOR512: i32 = 12
const SWITCH_VLD_NORMAL: i32 = 0
const SWITCH_VLD_CLOSE: i32 = 2
const SWITCH_VLD_OPEN: i32 = 3
const SWITCH_VLD_BLAZERAISE: i32 = 5
const SWITCH_VLD_BLAZEOPEN: i32 = 6
const SWITCH_VLD_BLAZECLOSE: i32 = 7
const SWITCH_PLAT_DOWNWAITUPSTAY: i32 = 1
const SWITCH_PLAT_RAISEANDCHANGE: i32 = 2
const SWITCH_PLAT_RAISETONEARESTANDCHANGE: i32 = 3
const SWITCH_PLAT_BLAZEDWUS: i32 = 4
const SWITCH_CEIL_LOWERTOFLOOR: i32 = 0
const SWITCH_CEIL_CRUSHANDRAISE: i32 = 3

