# Switches and buttons, ported from p_switch.c to Flow.
#
# button_t layout on LP64 (verified with offsetof) — the array itself is
# Flow-owned in spec.flow (SWITCH_buttonlist):
#
#   line_t*       line;      offset  0
#   bwhere_e      where;     offset  8
#   int           btexture;  offset 12
#   int           btimer;    offset 16
#   (4 bytes padding)               20
#   degenmobj_t*  soundorg; offset 24
#                       sizeof = 32
#
# switchlist_t (alphSwitchList source data) on LP64:
#   char name1[9];  offset 0
#   char name2[9];  offset 9
#   short episode;  offset 18
#              sizeof = 20
# Stored here as parallel string/episode arrays.
#
# switchlist[] / numswitches are private to this module (Flow statics).

