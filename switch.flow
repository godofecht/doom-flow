}

# ---- P_UseSpecialLine -------------------------------------------------

@flow_api
function P_UseSpecialLine(thing: ptr<void>, line: ptr<void>, side: i32) -> i32 {
    let special: i32 = GEOM_line_special(line)

    # Use the back sides of VERY SPECIAL lines...
    if side != 0 {
        if special == 124 {
            # Sliding door open&close — UNUSED
        } else {
            return 0
        }
    }

    # Switches that other things can activate.
    if (MOBJ_player(thing) as i64) == 0 {
        if (GEOM_line_flags(line) & SWITCH_ML_SECRET) != 0 {
            return 0
        }
        if special == 1 or special == 32 or special == 33 or special == 34 {
            # ok
        } else {
            return 0
        }
    }

    # MANUALS
    if special == 1 or special == 26 or special == 27 or special == 28 or special == 31 or special == 32 or special == 33 or special == 34 or special == 117 or special == 118 {
        EV_VerticalDoor(line, thing)
    } else {
        if special == 7 {
            if EV_BuildStairs(line, SWITCH_BUILD8) != 0 {
                P_ChangeSwitchTexture(line, 0)
            }
        } else {
            if special == 9 {
                if EV_DoDonut(line) != 0 {
                    P_ChangeSwitchTexture(line, 0)
                }
            } else {
                if special == 11 {
                    P_ChangeSwitchTexture(line, 0)
                    G_ExitLevel()
                } else {
                    if special == 14 {
                        if EV_DoPlat(line, SWITCH_PLAT_RAISEANDCHANGE, 32) != 0 {
                            P_ChangeSwitchTexture(line, 0)
                        }
                    } else {
                        if special == 15 {
                            if EV_DoPlat(line, SWITCH_PLAT_RAISEANDCHANGE, 24) != 0 {
                                P_ChangeSwitchTexture(line, 0)
                            }
                        } else {
                            if special == 18 {
                                if EV_DoFloor(line, SWITCH_RAISEFLOORTONEAREST) != 0 {
                                    P_ChangeSwitchTexture(line, 0)
                                }
                            } else {
                                if special == 20 {
                                    if EV_DoPlat(line, SWITCH_PLAT_RAISETONEARESTANDCHANGE, 0) != 0 {
                                        P_ChangeSwitchTexture(line, 0)
                                    }
                                } else {
                                    if special == 21 {
                                        if EV_DoPlat(line, SWITCH_PLAT_DOWNWAITUPSTAY, 0) != 0 {
                                            P_ChangeSwitchTexture(line, 0)
                                        }
                                    } else {
                                        if special == 23 {
                                            if EV_DoFloor(line, SWITCH_LOWERFLOORTOLOWEST) != 0 {
                                                P_ChangeSwitchTexture(line, 0)
                                            }
                                        } else {
                                            if special == 29 {
                                                if EV_DoDoor(line, SWITCH_VLD_NORMAL) != 0 {
                                                    P_ChangeSwitchTexture(line, 0)
                                                }
                                            } else {
                                                if special == 41 {
                                                    if EV_DoCeiling(line, SWITCH_CEIL_LOWERTOFLOOR) != 0 {
                                                        P_ChangeSwitchTexture(line, 0)
                                                    }
                                                } else {
                                                    if special == 71 {
                                                        if EV_DoFloor(line, SWITCH_TURBOLOWER) != 0 {
                                                            P_ChangeSwitchTexture(line, 0)
                                                        }
                                                    } else {
                                                        if special == 49 {
                                                            if EV_DoCeiling(line, SWITCH_CEIL_CRUSHANDRAISE) != 0 {
                                                                P_ChangeSwitchTexture(line, 0)
                                                            }
                                                        } else {
                                                            if special == 50 {
                                                                if EV_DoDoor(line, SWITCH_VLD_CLOSE) != 0 {
                                                                    P_ChangeSwitchTexture(line, 0)
                                                                }
                                                            } else {
                                                                if special == 51 {
                                                                    P_ChangeSwitchTexture(line, 0)
                                                                    G_SecretExitLevel()
                                                                } else {
                                                                    switch_use_rest(thing, line, special)
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return 1
}
