]

let mut numswitches: i32 = 0

# ---- button_t field access --------------------------------------------

function btn_at(i: i32) -> ptr<u8> {
    return ((SWITCH_buttonlist() as i64) + (i as i64) * (SWITCH_SIZEOF_BUTTON as i64)) as ptr<u8>
}

function btn_line(i: i32) -> ptr<void> {
    let p: ptr<i64> = btn_at(i) as ptr<i64>
    return p[0] as ptr<void>
}

function btn_set_line(i: i32, line: ptr<void>) -> void {
    let p: ptr<i64> = btn_at(i) as ptr<i64>
    p[0] = line as i64
}

function btn_where(i: i32) -> i32 {
    let p: ptr<i32> = ((btn_at(i) as i64) + 8) as ptr<i32>
    return p[0]
}

function btn_set_where(i: i32, v: i32) -> void {
    let p: ptr<i32> = ((btn_at(i) as i64) + 8) as ptr<i32>
    p[0] = v
}

function btn_btexture(i: i32) -> i32 {
    let p: ptr<i32> = ((btn_at(i) as i64) + 12) as ptr<i32>
    return p[0]
}

function btn_set_btexture(i: i32, v: i32) -> void {
    let p: ptr<i32> = ((btn_at(i) as i64) + 12) as ptr<i32>
    p[0] = v
}

function btn_btimer(i: i32) -> i32 {
    let p: ptr<i32> = ((btn_at(i) as i64) + 16) as ptr<i32>
    return p[0]
}

function btn_set_btimer(i: i32, v: i32) -> void {
    let p: ptr<i32> = ((btn_at(i) as i64) + 16) as ptr<i32>
    p[0] = v
}

function btn_soundorg(i: i32) -> ptr<void> {
    let p: ptr<i64> = ((btn_at(i) as i64) + 24) as ptr<i64>
    return p[0] as ptr<void>
}

function btn_set_soundorg(i: i32, org: ptr<void>) -> void {
    let p: ptr<i64> = ((btn_at(i) as i64) + 24) as ptr<i64>
    p[0] = org as i64
}

# ---- P_InitSwitchList -------------------------------------------------

@flow_api
function P_InitSwitchList() -> void {
    let mut episode: i32 = 1
    let gm: i32 = STAT_gamemode()
    if gm == SWITCH_REGISTERED or gm == SWITCH_RETAIL {
        episode = 2
    } else {
        if gm == SWITCH_COMMERCIAL {
            episode = 3
        }
    }

    let mut index: i32 = 0
    let mut i: i32 = 0
    while i < SWITCH_MAXSWITCHES {
        if switch_episode[i] == 0 {
            numswitches = index / 2
            switchlist[index] = 0 - 1
            i = SWITCH_MAXSWITCHES
        } else {
            if switch_episode[i] <= episode {
                switchlist[index] = R_TextureNumForName(switch_name1[i])
                index = index + 1
                switchlist[index] = R_TextureNumForName(switch_name2[i])
                index = index + 1
            }
            i = i + 1
        }
    }
}

# ---- P_StartButton (module-private in C; kept unexported) -------------

function P_StartButton(line: ptr<void>, w: i32, texture: i32, time: i32) -> void {
    let mut i: i32 = 0
    while i < SWITCH_MAXBUTTONS {
        if btn_btimer(i) != 0 and (btn_line(i) as i64) == (line as i64) {
            return
        }
        i = i + 1
    }

    i = 0
    while i < SWITCH_MAXBUTTONS {
        if btn_btimer(i) == 0 {
            btn_set_line(i, line)
            btn_set_where(i, w)
            btn_set_btexture(i, texture)
            btn_set_btimer(i, time)
            btn_set_soundorg(i, GEOM_sector_soundorg(GEOM_line_frontsector(line)))
            return
        }
        i = i + 1
    }

    I_Error("P_StartButton: no button slots left!")
}

# ---- P_ChangeSwitchTexture --------------------------------------------

@flow_api
function P_ChangeSwitchTexture(line: ptr<void>, useAgain: i32) -> void {
    if useAgain == 0 {
        GEOM_line_set_special(line, 0)
    }

    let sn0: i32 = GEOM_line_sidenum(line, 0)
    let texTop: i32 = GEOM_side_i_toptexture(sn0)
    let texMid: i32 = GEOM_side_i_midtexture(sn0)
    let texBot: i32 = GEOM_side_i_bottomtexture(sn0)
    let mut sound: i32 = SWITCH_SFX_SWTCHN

    if GEOM_line_special(line) == 11 {
        sound = SWITCH_SFX_SWTCHX
    }

    let mut i: i32 = 0
    while i < numswitches * 2 {
        if switchlist[i] == texTop {
            # Vanilla quirk: always buttonlist[0].soundorg (not the matching slot).
            S_StartSound(btn_soundorg(0), sound)
            GEOM_side_i_set_toptexture(sn0, switchlist[i ^ 1])
            if useAgain != 0 {
                P_StartButton(line, SWITCH_TOP, switchlist[i], SWITCH_BUTTONTIME)
            }
            return
        } else {
            if switchlist[i] == texMid {
                S_StartSound(btn_soundorg(0), sound)
                GEOM_side_i_set_midtexture(sn0, switchlist[i ^ 1])
                if useAgain != 0 {
                    P_StartButton(line, SWITCH_MIDDLE, switchlist[i], SWITCH_BUTTONTIME)
                }
                return
            } else {
                if switchlist[i] == texBot {
                    S_StartSound(btn_soundorg(0), sound)
                    GEOM_side_i_set_bottomtexture(sn0, switchlist[i ^ 1])
                    if useAgain != 0 {
                        P_StartButton(line, SWITCH_BOTTOM, switchlist[i], SWITCH_BUTTONTIME)
                    }
                    return
                }
            }
        }
        i = i + 1
    }
}

# Helpers for P_UseSpecialLine (defined first — Flow has no forward refs).

function switch_use_buttons2(thing: ptr<void>, line: ptr<void>, special: i32) -> void {
    if special == 114 {
        if EV_DoDoor(line, SWITCH_VLD_BLAZERAISE) != 0 {
            P_ChangeSwitchTexture(line, 1)
        }
    } else {
        if special == 115 {
            if EV_DoDoor(line, SWITCH_VLD_BLAZEOPEN) != 0 {
                P_ChangeSwitchTexture(line, 1)
            }
        } else {
            if special == 116 {
                if EV_DoDoor(line, SWITCH_VLD_BLAZECLOSE) != 0 {
                    P_ChangeSwitchTexture(line, 1)
                }
            } else {
                if special == 123 {
                    if EV_DoPlat(line, SWITCH_PLAT_BLAZEDWUS, 0) != 0 {
                        P_ChangeSwitchTexture(line, 1)
                    }
                } else {
                    if special == 132 {
                        if EV_DoFloor(line, SWITCH_RAISEFLOORTURBO) != 0 {
                            P_ChangeSwitchTexture(line, 1)
                        }
                    } else {
                        if special == 99 or special == 134 or special == 136 {
                            if EV_DoLockedDoor(line, SWITCH_VLD_BLAZEOPEN, thing) != 0 {
                                P_ChangeSwitchTexture(line, 1)
                            }
                        } else {
                            if special == 138 {
                                EV_LightTurnOn(line, 255)
                                P_ChangeSwitchTexture(line, 1)
                            } else {
                                if special == 139 {
                                    EV_LightTurnOn(line, 35)
                                    P_ChangeSwitchTexture(line, 1)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

function switch_use_buttons(thing: ptr<void>, line: ptr<void>, special: i32) -> void {
    if special == 42 {
        if EV_DoDoor(line, SWITCH_VLD_CLOSE) != 0 {
            P_ChangeSwitchTexture(line, 1)
        }
    } else {
        if special == 43 {
            if EV_DoCeiling(line, SWITCH_CEIL_LOWERTOFLOOR) != 0 {
                P_ChangeSwitchTexture(line, 1)
            }
        } else {
            if special == 45 {
                if EV_DoFloor(line, SWITCH_LOWERFLOOR) != 0 {
                    P_ChangeSwitchTexture(line, 1)
                }
            } else {
                if special == 60 {
                    if EV_DoFloor(line, SWITCH_LOWERFLOORTOLOWEST) != 0 {
                        P_ChangeSwitchTexture(line, 1)
                    }
                } else {
                    if special == 61 {
                        if EV_DoDoor(line, SWITCH_VLD_OPEN) != 0 {
                            P_ChangeSwitchTexture(line, 1)
                        }
                    } else {
                        if special == 62 {
                            if EV_DoPlat(line, SWITCH_PLAT_DOWNWAITUPSTAY, 1) != 0 {
                                P_ChangeSwitchTexture(line, 1)
                            }
                        } else {
                            if special == 63 {
                                if EV_DoDoor(line, SWITCH_VLD_NORMAL) != 0 {
                                    P_ChangeSwitchTexture(line, 1)
                                }
                            } else {
                                if special == 64 {
                                    if EV_DoFloor(line, SWITCH_RAISEFLOOR) != 0 {
                                        P_ChangeSwitchTexture(line, 1)
                                    }
                                } else {
                                    if special == 66 {
                                        if EV_DoPlat(line, SWITCH_PLAT_RAISEANDCHANGE, 24) != 0 {
                                            P_ChangeSwitchTexture(line, 1)
                                        }
                                    } else {
                                        if special == 67 {
                                            if EV_DoPlat(line, SWITCH_PLAT_RAISEANDCHANGE, 32) != 0 {
                                                P_ChangeSwitchTexture(line, 1)
                                            }
                                        } else {
                                            if special == 65 {
                                                if EV_DoFloor(line, SWITCH_RAISEFLOORCRUSH) != 0 {
                                                    P_ChangeSwitchTexture(line, 1)
                                                }
                                            } else {
                                                if special == 68 {
                                                    if EV_DoPlat(line, SWITCH_PLAT_RAISETONEARESTANDCHANGE, 0) != 0 {
                                                        P_ChangeSwitchTexture(line, 1)
                                                    }
                                                } else {
                                                    if special == 69 {
                                                        if EV_DoFloor(line, SWITCH_RAISEFLOORTONEAREST) != 0 {
                                                            P_ChangeSwitchTexture(line, 1)
                                                        }
                                                    } else {
                                                        if special == 70 {
                                                            if EV_DoFloor(line, SWITCH_TURBOLOWER) != 0 {
                                                                P_ChangeSwitchTexture(line, 1)
                                                            }
                                                        } else {
                                                            switch_use_buttons2(thing, line, special)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

function switch_use_rest(thing: ptr<void>, line: ptr<void>, special: i32) -> void {
    if special == 55 {
        if EV_DoFloor(line, SWITCH_RAISEFLOORCRUSH) != 0 {
            P_ChangeSwitchTexture(line, 0)
        }
    } else {
        if special == 101 {
            if EV_DoFloor(line, SWITCH_RAISEFLOOR) != 0 {
                P_ChangeSwitchTexture(line, 0)
            }
        } else {
            if special == 102 {
                if EV_DoFloor(line, SWITCH_LOWERFLOOR) != 0 {
                    P_ChangeSwitchTexture(line, 0)
                }
            } else {
                if special == 103 {
                    if EV_DoDoor(line, SWITCH_VLD_OPEN) != 0 {
                        P_ChangeSwitchTexture(line, 0)
                    }
                } else {
                    if special == 111 {
                        if EV_DoDoor(line, SWITCH_VLD_BLAZERAISE) != 0 {
                            P_ChangeSwitchTexture(line, 0)
                        }
                    } else {
                        if special == 112 {
                            if EV_DoDoor(line, SWITCH_VLD_BLAZEOPEN) != 0 {
                                P_ChangeSwitchTexture(line, 0)
                            }
                        } else {
                            if special == 113 {
                                if EV_DoDoor(line, SWITCH_VLD_BLAZECLOSE) != 0 {
                                    P_ChangeSwitchTexture(line, 0)
                                }
                            } else {
                                if special == 122 {
                                    if EV_DoPlat(line, SWITCH_PLAT_BLAZEDWUS, 0) != 0 {
                                        P_ChangeSwitchTexture(line, 0)
                                    }
                                } else {
                                    if special == 127 {
                                        if EV_BuildStairs(line, SWITCH_TURBO16) != 0 {
                                            P_ChangeSwitchTexture(line, 0)
                                        }
                                    } else {
                                        if special == 131 {
                                            if EV_DoFloor(line, SWITCH_RAISEFLOORTURBO) != 0 {
                                                P_ChangeSwitchTexture(line, 0)
                                            }
                                        } else {
                                            if special == 133 or special == 135 or special == 137 {
                                                if EV_DoLockedDoor(line, SWITCH_VLD_BLAZEOPEN, thing) != 0 {
                                                    P_ChangeSwitchTexture(line, 0)
                                                }
                                            } else {
                                                if special == 140 {
                                                    if EV_DoFloor(line, SWITCH_RAISEFLOOR512) != 0 {
