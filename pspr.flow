extern { function STATE_action(st: ptr<void>) -> ptr<void> }
extern { function STATE_call_acp2(st: ptr<void>, arg1: ptr<void>, arg2: ptr<void>) -> void }

extern { function psprshim_weapon_ammo(w: i32) -> i32 }
extern { function psprshim_weapon_upstate(w: i32) -> i32 }
extern { function psprshim_weapon_downstate(w: i32) -> i32 }
extern { function psprshim_weapon_readystate(w: i32) -> i32 }
