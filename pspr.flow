extern { function psprshim_weapon_flashstate(w: i32) -> i32 }

# Shared weaponinfo[w] field accessors. Table lives in items.flow.

@flow_api
function WEAPONINFO_ammo(w: i32) -> i32 { return psprshim_weapon_ammo(w) }
@flow_api
function WEAPONINFO_upstate(w: i32) -> i32 { return psprshim_weapon_upstate(w) }
@flow_api
function WEAPONINFO_downstate(w: i32) -> i32 { return psprshim_weapon_downstate(w) }
@flow_api
function WEAPONINFO_readystate(w: i32) -> i32 { return psprshim_weapon_readystate(w) }
@flow_api
function WEAPONINFO_atkstate(w: i32) -> i32 { return psprshim_weapon_atkstate(w) }
@flow_api
function WEAPONINFO_flashstate(w: i32) -> i32 { return psprshim_weapon_flashstate(w) }

# Shared pspdef_t field accessors (LP64 offsetof). Slot pointer is
# PLAYER_psp(player, pos).

const PSPDEF_OFF_STATE: i32 = 0
const PSPDEF_OFF_TICS: i32 = 8
const PSPDEF_OFF_SX: i32 = 12
const PSPDEF_OFF_SY: i32 = 16

function psp_i32(base: i64, off: i32) -> i32 {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    return p[0]
}

function psp_set_i32(base: i64, off: i32, v: i32) -> void {
    let p: ptr<i32> = (base + off as i64) as ptr<i32>
    p[0] = v
}

function psp_ptr(base: i64, off: i32) -> ptr<void> {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    return p[0] as ptr<void>
}

function psp_set_ptr(base: i64, off: i32, v: ptr<void>) -> void {
    let p: ptr<i64> = (base + off as i64) as ptr<i64>
    p[0] = v as i64
}

@flow_api
function PSP_state(psp: ptr<void>) -> ptr<void> { return psp_ptr(psp as i64, PSPDEF_OFF_STATE) }
@flow_api
function PSP_set_state(psp: ptr<void>, st: ptr<void>) -> void { psp_set_ptr(psp as i64, PSPDEF_OFF_STATE, st) }
@flow_api
function PSP_tics(psp: ptr<void>) -> i32 { return psp_i32(psp as i64, PSPDEF_OFF_TICS) }
@flow_api
function PSP_set_tics(psp: ptr<void>, v: i32) -> void { psp_set_i32(psp as i64, PSPDEF_OFF_TICS, v) }
@flow_api
function PSP_sx(psp: ptr<void>) -> i32 { return psp_i32(psp as i64, PSPDEF_OFF_SX) }
@flow_api
function PSP_set_sx(psp: ptr<void>, v: i32) -> void { psp_set_i32(psp as i64, PSPDEF_OFF_SX, v) }
@flow_api
function PSP_sy(psp: ptr<void>) -> i32 { return psp_i32(psp as i64, PSPDEF_OFF_SY) }
@flow_api
function PSP_set_sy(psp: ptr<void>, v: i32) -> void { psp_set_i32(psp as i64, PSPDEF_OFF_SY, v) }

