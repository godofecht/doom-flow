# Weapon sprite animation / attacks, ported from p_pspr.c to Flow.
#
# bulletslope and swingx/swingy are private module state (bulletslope has
# a psprshim_bulletslope_addr @flow_api export for maputl.flow's blockmap-
# overrun poke). player_t / mobj_t / state_t stay C-owned; pspdef_t field
# access is LP64 offsetof arithmetic (psp_i32/psp_ptr helpers below).
# weaponinfo table lives in items.flow (it_weaponinfo_tab); readers here
# go through WEAPONINFO_*. State actions dispatch via STATE_call_acp2.
#
# DecreaseAmmo quirk preserved: ammo index >= NUMAMMO overflows into
# maxammo[] (Dehacked compatibility).
#
# pspdef_t (sizeof 24, LP64, verified with offsetof): state 0 (ptr),
# tics 8, sx 12, sy 16 — PSPDEF_OFF_* constants below mirror this.

# ---- externs: fixed-point / engine ------------------------------------

extern { function FixedMul(a: i32, b: i32) -> i32 }
extern { function P_Random() -> i32 }
extern { function S_StartSound(origin: ptr<void>, sound_id: i32) -> void }
extern { function P_SetMobjState(mobj: ptr<void>, state: i32) -> i32 }
extern { function P_NoiseAlert(target: ptr<void>, emitter: ptr<void>) -> void }
extern { function P_AimLineAttack(t1: ptr<void>, angle: u32, distance: i32) -> i32 }
extern { function P_LineAttack(t1: ptr<void>, angle: u32, distance: i32, slope: i32, damage: i32) -> void }
extern { function P_SpawnPlayerMissile(source: ptr<void>, typ: i32) -> void }
extern { function P_SpawnMobj(x: i32, y: i32, z: i32, typ: i32) -> ptr<void> }
extern { function P_DamageMobj(target: ptr<void>, inflictor: ptr<void>, source: ptr<void>, damage: i32) -> void }
extern { function R_PointToAngle2(x1: i32, y1: i32, x2: i32, y2: i32) -> u32 }
extern { function TABLES_finesine(idx: i32) -> i32 }
extern { function TABLES_finecosine(idx: i32) -> i32 }
extern { function TABLES_finetangent(idx: i32) -> i32 }

# ---- items.flow -------------------------------------------------------

const PSPR_DEH_BFG_CELLS: i32 = 40

extern { function MAP_linetarget() -> ptr<void> }
extern { function STATE_at(i: i32) -> ptr<void> }
extern { function STATE_index(st: ptr<void>) -> i32 }
