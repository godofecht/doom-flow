extern { function dg_screen() -> ptr<u8> }
extern { function dg_push_key(pressed: i32, key: i32) -> void }
extern { function dg_resx() -> i32 }
extern { function dg_resy() -> i32 }
extern { function calloc(nmemb: i64, size: i64) -> ptr<void> }
