# Movement / collision utilities, ported from p_maputl.c to Flow.
#
# Shared C globals (opentop/openbottom/openrange/lowfloor, intercepts[],
# intercept_p, trace) are Flow-owned let mut state with @flow_api MAPUTL_*
# accessors. Traverser fnptr calls use sysshim_call_* (platform_stub.c).
# Blockmap iteration uses setupshim_* (@flow_api in setup.flow).
# Local divline temps use Flow DivLine.
#
# LP64 offsetof (verified against doomgeneric headers):
#
#   divline_t (sizeof 16): x 0, y 4, dx 8, dy 12
#   intercept_t (sizeof 16): frac 0, isaline 4, d 8
#   line_t (sizeof 88): v1 0, v2 8, dx 16, dy 20, sidenum 30,
#     slopetype 52, frontsector 56, backsector 64, validcount 72
#   mobj_t (sizeof 224): x 24, y 28, snext 40, sprev 48,
#     bnext 72, bprev 80, subsector 88, radius 104, flags 160
#   sector_t: floorheight 0, ceilingheight 4, thinglist 96
#   subsector_t.sector 0
#   vertex_t: x 0, y 4

# ---- fixed-point (fixp.flow) ------------------------------------------

extern { function FixedMul(a: i32, b: i32) -> i32 }
extern { function FixedDiv(a: i32, b: i32) -> i32 }

