extern { function GEOM_seg_sidedef(seg: ptr<void>) -> ptr<void> }
extern { function GEOM_seg_linedef(seg: ptr<void>) -> ptr<void> }

extern { function GEOM_side_rowoffset(side: ptr<void>) -> i32 }

extern { function GEOM_line_flags(ld: ptr<void>) -> i32 }
extern { function GEOM_line_set_flags(ld: ptr<void>, v: i32) -> void }

function segs_line_or_flags(line: ptr<void>, bits: i32) -> void {
    GEOM_line_set_flags(line, GEOM_line_flags(line) | bits)
}

function segs_maskedcol_at(col: ptr<void>, x: i32) -> i32 {
    let p: ptr<i16> = ((col as i64) + (x as i64) * 2) as ptr<i16>
    return p[0] as i32
}

function segs_maskedcol_set(col: ptr<void>, x: i32, v: i32) -> void {
    let p: ptr<i16> = ((col as i64) + (x as i64) * 2) as ptr<i16>
    p[0] = v as i16
}

